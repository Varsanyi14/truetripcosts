{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://truetripcosts.com/schemas/germany-tax-regions.schema.json",
  "title": "Germany tax regions (CMS proof slice)",
  "description": "Schema for src/data/facts/germany-tax-regions.json. Covers only the three keys in this proof slice: berlin, munich, frankfurt. Not the general Stage 2 fact schema.",
  "type": "object",
  "required": [
    "berlin",
    "munich",
    "frankfurt"
  ],
  "additionalProperties": false,
  "properties": {
    "berlin": {
      "$ref": "#/definitions/region"
    },
    "munich": {
      "$ref": "#/definitions/region"
    },
    "frankfurt": {
      "$ref": "#/definitions/region"
    }
  },
  "definitions": {
    "region": {
      "type": "object",
      "required": [
        "label",
        "note",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "pct": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "percentOfRoom",
            "perPersonPerNight"
          ]
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "allOf": [
        {
          "$comment": "Frankfurt-shape (unit + rate) and percent-shape (pct) are mutually exclusive, matching the two shapes already live in germany.js.",
          "oneOf": [
            {
              "required": [
                "pct"
              ],
              "not": {
                "required": [
                  "unit",
                  "rate"
                ]
              }
            },
            {
              "required": [
                "unit",
                "rate"
              ],
              "not": {
                "required": [
                  "pct"
                ]
              }
            }
          ]
        },
        {
          "$comment": "Date-honesty gate: a verified fact must carry the fields that back up that status. A legacy fact must not fake them.",
          "if": {
            "properties": {
              "provenance": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "required": [
                  "checked_date",
                  "source_url",
                  "source_name",
                  "source_type"
                ],
                "properties": {
                  "checked_date": {
                    "type": "string"
                  },
                  "source_url": {
                    "type": "string"
                  },
                  "source_name": {
                    "type": "string"
                  },
                  "source_type": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "properties": {
                  "checked_date": {
                    "type": "null"
                  },
                  "source_url": {
                    "type": "null"
                  },
                  "source_name": {
                    "type": "null"
                  },
                  "source_type": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "status",
        "checked_date",
        "changed_date",
        "source_url",
        "source_name",
        "source_type",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "legacy",
            "verified"
          ]
        },
        "checked_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "changed_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "official-government",
            "operator-official",
            "reputable-secondary",
            null
          ]
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        }
      }
    }
  }
}