// The TTC brand marks, taken from the official export as vector paths.
//
// Nothing here depends on a font. The TTC letters and the TRUE TRIP COSTS wordmark are
// both outlined glyphs lifted straight out of the exported SVG, so the lockup renders
// identically everywhere: no webfont to download, no flash of the wrong shape, no drift
// if the site's typefaces change, and correct offline. That last point matters for a
// brand whose pages get saved to phones before a trip.
//
// Amber is #F0A83C, the value in the official export. This is NOT the site's global
// --amber token (#B45309), which is tuned for amber text on cream paper and goes muddy
// as a signature bar on ink, so it is set here rather than pulled from a var that means
// something else.
//
// VARIANTS
//   mark        the contained square alone. Favicons, app icons, tight headers.
//   stacked     square with the wordmark centred beneath it. This is the exact export
//               geometry, reproduced to the unit.
//   horizontal  square with the wordmark to its right. NOTE: the export does not define
//               a horizontal lockup, so this arrangement is an extension, sized so the
//               wordmark's cap height reads as a balanced companion to the square rather
//               than a caption. Use it where vertical space is short, like the site nav.
//
// `size` always means the height of the square in px. Widths follow from the geometry.
const {
  variant = 'mark',
  size = 40,
  title = 'True Trip Costs',
  class: klass = '',
} = Astro.props;

// Export artboard reference points, all in the file's own coordinate space:
//   square      x 487.5 to 1012.5, y 427.5 to 952.5  (525 units square)
//   wordmark    x 503.45 to 995,   baseline y 1038.324851, cap height 34.2 units
const BOX = {
  mark:       { vb: '0 0 100 100',  ratio: 1 },
  stacked:    { vb: '0 0 100 118',  ratio: 100 / 118 },
  horizontal: { vb: '0 0 500 100',  ratio: 5 },
};
const b = BOX[variant] || BOX.mark;
const h = variant === 'stacked' ? Math.round(size * 1.18) : size;
const w = Math.round(h * (variant === 'stacked' ? 100 / 118 : variant === 'horizontal' ? 5 : 1));

// Stacked keeps the export's own relative scale, so the square and the wordmark sit in
// one shared transform. Horizontal re-scales the wordmark, so it needs its own.
const sharedScale = 'translate(2,2) scale(0.18285714) translate(-487.5,-427.5)';
// Cap height 26 of a 96 square, baseline on the square's centre line.
const horizWordmark = 'translate(118,63) scale(0.76023) translate(-503.447919,-1038.324851)';

// The 13 outlined wordmark glyphs, defined once. Both the stacked and horizontal
// variants render this same string, so there is no second copy to fall out of step.
