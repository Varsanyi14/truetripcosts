---
// Reusable per-night-cost-vs-stay-length chart, rendered as SVG at build time. Feeds
// both new viz on /airbnb-real-cost: the three-line version (Viz 2, one line each for
// hotel, a solo/couple rental and a group rental) and the two-band version (Viz 3, the
// same shape drawn as a shaded spread instead of a single line, against the same flat
// hotel reference). Same build-time rules as StackBar.astro and BandBar.astro: no
// runtime chart library, no external request, SVG for the geometry and HTML text for
// anything a reader has to read, that split explained fully in StackBar's own header.
//
// This component draws whatever `series` it is given; it holds no opinion about hotels,
// rentals, cleaning fees or nights. The page computes every number from its own single
// declared engine and hands this component the finished points, the same division of
// labour every other chart component on this site already uses.
//
// ---------------------------------------------------------------------------
// THREE SERIES KINDS.
// ---------------------------------------------------------------------------
//   kind: 'reference'  a flat dashed line, one value repeated at every night. The hotel
//                      in both Viz 2 and Viz 3.
//   kind: 'line'       one value per night, drawn as a solid line. Viz 2's two rental
//                      series.
//   kind: 'band'       a {low, high} pair per night, drawn as a filled, low-opacity
//                      shape between the two edges. Viz 3's two rental series. Where a
//                      band's own low/high straddle the reference line's value, the
//                      general rule (hotel wins short, rental wins long) genuinely
//                      bends, which is the whole reason Viz 3 exists.
//
// Props:
//   id        so a page can carry more than one of these
//   nights    the x-axis values the points are plotted at, ascending
//   xTicks    a (usually shorter) subset of nights to LABEL on the x-axis; every value
//             in nights is still plotted, this only thins the printed labels so 14
//             points do not produce 14 crowded numbers underneath
//   series    [{ key, label, kind, color, values, dash, note }], values is a number[]
//             for 'line'/'reference' (one per night) or a {low,high}[] for 'band'
//   axisMax   the y-axis maximum, in the same index units every value is expressed in
//   ticks     y-axis tick values, same units
//   unitWord  what the y unit means in words, for the accessible description

const {
  id = 'costcurve',
  nights = [],
  xTicks,
  series = [],
  axisMax = 250,
  ticks = [0, 50, 100, 150, 200, 250],
  unitWord = 'index points, the hotel held at 100',
} = Astro.props;

const H = 62;
const xMin = nights[0] ?? 0;
const xMax = nights[nights.length - 1] ?? 1;
const xPct = (n) => (xMax === xMin ? 0 : ((n - xMin) / (xMax - xMin)) * 100);
const yPct = (v) => H - Math.max(0, Math.min(H, (v / axisMax) * H));
const labelX = (xTicks && xTicks.length ? xTicks : nights);

function lineD(values) {
  return nights.map((n, i) => `${i === 0 ? 'M' : 'L'} ${xPct(n).toFixed(2)} ${yPct(values[i]).toFixed(2)}`).join(' ');
}
function bandPoints(values) {
  const top = nights.map((n, i) => `${xPct(n).toFixed(2)},${yPct(values[i].high).toFixed(2)}`);
  const bottom = nights.map((n, i) => `${xPct(n).toFixed(2)},${yPct(values[i].low).toFixed(2)}`).reverse();
  return [...top, ...bottom].join(' ');
}

// THE ACCESSIBLE DESCRIPTION, built from the plotted values rather than hand-written,
// the same rule StackBar's own `described` follows: a caption typed by hand can drift
// from the chart it describes, a caption computed from the same array it draws cannot.
// For a 'line' or 'band' series this also states whether it stays above, stays below,
// or crosses the reference line, and if it crosses, at which night, since that crossing
// is usually the entire point of drawing the chart.
const refSeries = series.find((s) => s.kind === 'reference');
const refValue = refSeries ? refSeries.values[0] : null;

function crossingWord(values, isBand) {
  if (refValue == null) return '';
  const at = (i) => (isBand ? (values[i].low + values[i].high) / 2 : values[i]);
  const above = (i) => (isBand ? values[i].low > refValue : values[i] > refValue);
  const below = (i) => (isBand ? values[i].high < refValue : values[i] < refValue);
  if (nights.every((_, i) => above(i))) return 'stays above the hotel line throughout';
  if (nights.every((_, i) => below(i))) return 'stays below the hotel line throughout';
  const firstBelowIdx = nights.findIndex((_, i) => below(i));
  if (firstBelowIdx > 0) return `crosses below the hotel line by night ${nights[firstBelowIdx]}`;
  return 'crosses the hotel line partway through the range shown';
}

const described = series.map((s) => {
  if (s.kind === 'reference') return `${s.label}, a flat reference at ${s.values[0]}`;
  if (s.kind === 'band') {
    const first = s.values[0], last = s.values[s.values.length - 1];
    return `${s.label}, a band from ${first.low} to ${first.high} at night ${nights[0]}, narrowing to ${last.low} to ${last.high} by night ${nights[nights.length - 1]}, and it ${crossingWord(s.values, true)}`;
  }
  const first = s.values[0], last = s.values[s.values.length - 1];
  return `${s.label}, starting at ${first} on night ${nights[0]}, ending at ${last} by night ${nights[nights.length - 1]}, and it ${crossingWord(s.values, false)}`;
}).join('. ');
---

<div class="cc" id={id}>
  <p class="cc-sr" role="img" aria-label={`Chart, ${unitWord}. ${described}.`}></p>

  <div class="cc-plot-wrap" aria-hidden="true">
    <div class="cc-yaxis">
      {ticks.slice().reverse().map((v) => (
        <span class="cc-ytick" style={`top:${(yPct(v) / H) * 100}%`}>{v}</span>
      ))}
    </div>
    <div class="cc-plot">
      <svg class="cc-svg" viewBox={`0 0 100 ${H}`} preserveAspectRatio="none"
           xmlns="http://www.w3.org/2000/svg" focusable="false">
        <g class="cc-grid">
          {ticks.map((v) => (
            <line x1="0" y1={yPct(v)} x2="100" y2={yPct(v)} stroke="#E5E3DB" stroke-width="0.3" vector-effect="non-scaling-stroke" />
          ))}
        </g>
        {series.map((s) => {
          if (s.kind === 'band') {
            return (
              <polygon points={bandPoints(s.values)} fill={s.color} fill-opacity="0.28" stroke="none" />
            );
          }
          return null;
        })}
        {series.map((s) => {
          if (s.kind === 'reference') {
            const y = yPct(s.values[0]);
            return (
              <line x1="0" y1={y} x2="100" y2={y} stroke={s.color} stroke-width="1.6"
                    stroke-dasharray="3,2.2" vector-effect="non-scaling-stroke" />
            );
          }
          if (s.kind === 'line') {
            return (
              <path d={lineD(s.values)} fill="none" stroke={s.color} stroke-width="1.8"
                    stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            );
          }
          if (s.kind === 'band') {
            return (
              <>
                <path d={lineD(s.values.map((v) => v.high))} fill="none" stroke={s.color} stroke-width="0.9" stroke-dasharray="1.4,1.4" vector-effect="non-scaling-stroke" />
                <path d={lineD(s.values.map((v) => v.low))} fill="none" stroke={s.color} stroke-width="0.9" stroke-dasharray="1.4,1.4" vector-effect="non-scaling-stroke" />
              </>
            );
          }
          return null;
        })}
      </svg>
    </div>
  </div>

  <div class="cc-xaxis" aria-hidden="true">
    <div class="cc-xaxis-spacer"></div>
    <div class="cc-xaxis-track">
      {labelX.map((n) => (
        <span class="cc-xtick" style={`left:${xPct(n)}%`}>{n}</span>
      ))}
    </div>
  </div>
  <p class="cc-xlab" aria-hidden="true">Nights</p>

  <ol class="cc-legend">
    {series.map((s) => (
      <li class="cc-leg-item">
        <span class:list={['cc-leg-sw', { 'is-band': s.kind === 'band', 'is-ref': s.kind === 'reference' }]} style={`background:${s.color}`}></span>
        <span class="cc-leg-l">{s.label}</span>
        {s.note && <span class="cc-leg-n">{s.note}</span>}
      </li>
    ))}
  </ol>
</div>

<style>
  .cc{margin:0}
  .cc-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;margin:0}

  .cc-plot-wrap{display:flex;gap:8px}
  .cc-yaxis{position:relative;flex:none;width:30px;height:190px}
  .cc-ytick{position:absolute;left:0;transform:translateY(-50%);font-family:var(--mono);font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}
  .cc-plot{flex:1;min-width:0;height:190px;position:relative}
  .cc-svg{width:100%;height:100%;display:block}

  .cc-xaxis{display:flex;gap:8px;margin:4px 0 0}
  .cc-xaxis-spacer{flex:none;width:30px}
  .cc-xaxis-track{position:relative;flex:1;min-width:0;height:14px}
  .cc-xtick{position:absolute;top:0;transform:translateX(-50%);font-family:var(--mono);font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums}
  .cc-xlab{margin:2px 0 0 38px;font-family:var(--mono);font-size:9.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}

  .cc-legend{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:7px}
  .cc-leg-item{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 9px;font-size:12.5px;line-height:1.5;color:var(--muted)}
  .cc-leg-sw{width:15px;height:9px;border-radius:2px;flex:none;transform:translateY(-1px);display:inline-block}
  .cc-leg-sw.is-ref{height:3px;border-radius:0;background-image:linear-gradient(90deg,currentColor 60%,transparent 0);background-size:6px 3px;transform:translateY(1px)}
  .cc-leg-sw.is-band{opacity:.55}
  .cc-leg-l{font-weight:700;color:var(--ink)}
  .cc-leg-n{color:var(--muted)}

  @media (max-width:560px){
    .cc-yaxis{width:26px;height:170px}
    .cc-plot{height:170px}
    .cc-ytick,.cc-xtick{font-size:9px}
    .cc-xaxis-spacer{width:26px}
    .cc-xlab{margin-left:34px}
  }
</style>
