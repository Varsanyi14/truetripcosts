---
import { clusters, regionMetaCompare } from '../data/region-comparisons.js';
import LogoMark from './LogoMark.astro';

// Group the region comparisons by continent for the Guides menu, so the list stays
// scannable as it grows. Order is fixed; each cluster slots into its parent continent,
// and a continent's capstone (Which part of Europe?) leads its group.
const CONTINENTS = ['Europe', 'Asia', 'Americas', 'Middle East', 'Africa'];
const regionGroups = CONTINENTS
  .map(key => ({ key, capstone: regionMetaCompare[key] || null, items: clusters.filter(c => c.parent === key) }))
  .filter(g => g.capstone || g.items.length);

// The topic side of the menu, grouped into three clusters so it reads as a trip
// sequence (plan it, land in it, compare across it) instead of one flat list of 13.
// Order inside each group is deliberate: the country hub leads, then the per-country
// spokes traffic-first, then the cross-country comparison tools with the authority
// page last. Labels and hrefs are unchanged from the flat list; grouping and order
// are the only difference. Each group carries an id so the header can name the group
// for assistive tech, matching how the region column labels its own groups visually.
const topicGroups = [
  {
    id: 'gm-topics-before',
    label: 'Before you go',
    items: [
      { href: '/rules', label: 'Money rules, country by country' },
      { href: '/passports-and-visas', label: 'Passports and visas' },
    ],
  },
  {
    id: 'gm-topics-in-country',
    label: 'In each country',
    items: [
      { href: '/cash-or-card', label: 'Cash or card' },
      { href: '/tipping-compared', label: 'Tipping, country by country' },
      { href: '/taxis-and-ride-hailing', label: 'Taxis and ride-hailing' },
      { href: '/driving-and-car-rental', label: 'Driving and car rental' },
      { href: '/staying-connected', label: 'Staying connected' },
      { href: '/money-scams', label: 'Money scams' },
      { href: '/hotel-taxes-and-fees', label: 'Hotel taxes and fees' },
    ],
  },
  {
    id: 'gm-topics-compare',
    label: 'Compare across countries',
    items: [
      { href: '/cost-comparison', label: 'Cost of a day, compared' },
      { href: '/when-to-go', label: 'When to go, cheaper and pricier months' },
      { href: '/rail-passes', label: 'Rail passes, worth it or not' },
      { href: '/tourist-taxes', label: 'Tourist taxes and fees' },
      { href: '/us-outbound-travelers', label: 'Where Americans travel, ranked' },
    ],
  },
];
---
<nav class="topnav">
  <div class="wrap navin">
    <a class="logo" href="/" style="text-decoration:none;color:inherit">
      <LogoMark size={30} title="True Trip Costs" />
      <span>True Trip Costs<small>The money side of travel</small></span>
    </a>
    <div class="navlinks">
      <details class="gmenu">
        <summary class="gmenu-sum">Guides<svg class="gmenu-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <div class="gmenu-panel">
          <div class="gm-cols">
            <div class="gm-col gm-col-regions">
              <p class="gm-zone">By region</p>
              {regionGroups.map(g => (
                <div class="gm-group" data-cont={g.key}>
                  <p class="gm-group-h"><span class="gm-dot" aria-hidden="true"></span>{g.key}</p>
                  {g.capstone && <a class="gm-link gm-cap" href={g.capstone.href}>{g.capstone.label}</a>}
                  {g.items.map(c => <a class="gm-link" href={c.href}>{c.region}</a>)}
                </div>
              ))}
            </div>
            <div class="gm-col gm-col-topics">
              {topicGroups.map(g => (
                <div class="gm-tgroup" role="group" aria-labelledby={g.id}>
                  <p class="gm-zone" id={g.id}>{g.label}</p>
                  {g.items.map(t => <a class="gm-link" href={t.href}>{t.label}</a>)}
                </div>
              ))}
            </div>
          </div>
          <a class="gm-all" href="/countries"><span>All country guides</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </details>
      <a class="navcta" href="#" data-open-signup>Get updates</a>
    </div>
  </div>

  <style>
    .navlinks{display:flex;align-items:center;gap:16px}
    .gmenu{position:relative}
    .gmenu-sum{display:inline-flex;align-items:center;gap:5px;font-size:14px;font-weight:500;color:var(--ink);cursor:pointer;list-style:none;white-space:nowrap}
    .gmenu-sum::-webkit-details-marker{display:none}
    .gmenu-sum:hover{color:var(--teal-deep)}
    .gmenu-chev{transition:transform .15s ease}
    .gmenu[open] .gmenu-chev{transform:rotate(180deg)}
    .gmenu-panel{position:absolute;top:calc(100% + 8px);right:0;width:540px;max-width:calc(100vw - 32px);max-height:calc(100vh - 96px);overflow-y:auto;background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:16px 18px;z-index:60}
    .gm-cols{display:grid;grid-template-columns:1fr 1fr}
    .gm-col-regions{padding-right:16px}
    .gm-col-topics{border-left:1px solid var(--line);padding-left:18px}
    .gm-zone{margin:2px 0 10px 8px;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--teal-deep)}
    .gm-col-topics .gm-zone{margin-left:8px}
    .gm-tgroup{margin:0 0 13px}
    .gm-tgroup:last-child{margin-bottom:0}
    .gm-group{margin:0 0 13px}
    .gm-group:last-child{margin-bottom:0}
    .gm-group-h{display:flex;align-items:center;gap:7px;margin:0 0 3px;padding:0 8px;font-family:var(--serif);font-weight:600;font-size:13.5px;color:var(--ink)}
    .gm-dot{width:8px;height:8px;border-radius:50%;flex:none;background:var(--muted)}
    .gm-group[data-cont="Europe"] .gm-dot{background:#0E7A5F}
    .gm-group[data-cont="Asia"] .gm-dot{background:#C0592B}
    .gm-group[data-cont="Americas"] .gm-dot{background:#3A6EA5}
    .gm-group[data-cont="Middle East"] .gm-dot{background:#C99A2E}
    .gm-group[data-cont="Africa"] .gm-dot{background:#6F8F3E}
    .gm-link{display:block;padding:6px 8px 6px 22px;border-radius:8px;font-size:13.5px;color:#3B4A46;text-decoration:none;line-height:1.3}
    .gm-col-topics .gm-link{padding-left:8px}
    .gm-link:hover{background:var(--paper);color:var(--teal-deep)}
    .gm-cap{color:var(--teal-deep);font-weight:600}
    .gm-all{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:16px;padding:12px 14px;background:var(--green-bg);border-radius:10px;font-size:13.5px;font-weight:600;color:var(--teal-deep);text-decoration:none;transition:color .15s ease}
    .gm-all:hover{color:var(--ink)}
    .gm-all svg{transition:transform .15s ease}
    .gm-all:hover svg{transform:translateX(3px)}
    @media(max-width:640px){
      .gmenu-panel{width:min(92vw,320px);padding:14px;max-height:calc(100vh - 84px);overflow-y:auto;-webkit-overflow-scrolling:touch}
      .gm-cols{grid-template-columns:1fr}
      .gm-col-regions{padding-right:0}
      .gm-col-topics{border-left:none;border-top:1px solid var(--line);padding-left:0;padding-top:13px;margin-top:11px}
    }
  </style>
</nav>

<script>
  (function () {
    var menus = document.querySelectorAll('details.gmenu');
    if (!menus.length) return;
    // Close an open menu when clicking anywhere outside it.
    document.addEventListener('click', function (e) {
      menus.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; });
    });
    // Close on Escape.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') menus.forEach(function (m) { m.open = false; });
    });
    // Close after choosing an item, which matters for same-page anchors like /#guides.
    menus.forEach(function (m) {
      m.querySelectorAll('.gmenu-panel a').forEach(function (a) {
        a.addEventListener('click', function () { m.open = false; });
      });
    });
  })();
</script>
