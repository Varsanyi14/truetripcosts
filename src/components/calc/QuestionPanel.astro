---
// QuestionPanel (spec section 3 "Wizard", section 11 component split). One instance per
// step, pre-rendered at build time with that step's real copy and controls (see
// CalcWizard.astro): "Do not fix the question-panel height... Scrolling is preferable to
// clipped helper text" is satisfied for free by never fixing a height here.
//
// stepNumber/totalSteps/stepLabel feed WizardProgress. isFirst drops the Back action and
// widens Continue to the full row (wizard-actions.one-action, matching the reference).
// isLast swaps the Continue label for "See trip estimate" (spec section 6, verbatim).
const { stepKey, stepNumber, totalSteps = 8, stepLabel, title, intro, isFirst = false, isLast = false, initiallyVisible = false,
  // BRIEF-calc-tier1-review-fixes, Fix 4: the footer used to repeat on all seven steps;
  // it now only renders where a caller opts in (step 1 and the two money steps), so it
  // registers where it matters instead of becoming wallpaper.
  showFootnote = false,
  // Fix 4, step 5: an optional real "skip" action next to Continue, for the one step
  // (airfare) where the review found a caveat doing a button's job in prose. Presentation
  // only: the click behavior lives in CalcWizard.astro's own script and only ever checks
  // the existing "exclude" radio and resubmits this same form, so calc-wizard.js's already-
  // tested validation and step-advance logic still does all the real work, unchanged.
  skipLabel = null,
  // BRIEF-input-step2a, FIX 1 and FIX 2: icon is a raw SVG string built once per step in
  // CalcWizard.astro's own frontmatter (see that file's QUESTION_ICON map); flagSrc is the
  // destination's flag path (or the globe fallback), same on every step. Both optional so
  // this component still works for any caller that does not pass them.
  icon = null, flagSrc = null } = Astro.props;
import WizardProgress from './WizardProgress.astro';
---
<section class="wizard" data-wizard-step={stepKey} hidden={!initiallyVisible}>
  <WizardProgress stepNumber={stepNumber} totalSteps={totalSteps} stepLabel={stepLabel} />
  <div class="question-panel">
    <form class="question-form" data-step-form={stepKey} novalidate>
      {(icon || flagSrc) && (
        <div class="qpanel-meta">
          {icon && <span class="qpanel-icon" set:html={icon} />}
          {flagSrc && <img class="qpanel-flag" src={flagSrc} alt="" width="22" height="16" loading="lazy" decoding="async" />}
        </div>
      )}
      <h1 tabindex="-1">{title}</h1>
      <p class="question-intro">{intro}</p>
      <div class="question-controls">
        <slot />
      </div>
      <div class={'wizard-actions' + (isFirst ? ' one-action' : '')}>
        <button class="btn btn-primary" type="submit">{isLast ? 'See trip estimate' : 'Continue'} <span aria-hidden="true">&rarr;</span></button>
        {skipLabel && <button type="button" class="btn btn-secondary wizard-actions-skip" data-wizard-skip>{skipLabel}</button>}
        {!isFirst && <button type="button" class="wizard-back" data-wizard-back>&larr; Back</button>}
      </div>
    </form>
  </div>
  {showFootnote && <p class="wizard-footnote">No sign-up. No card details.</p>}
</section>
