---
// DestinationChoice (spec section 6, step 1): "Labeled search field followed by large
// country radio rows... A search query is not a committed country. Filtering out the
// selected item must not silently submit the hidden selection."
//
// REUSES THE EXISTING SITE TYPEAHEAD, not a new dropdown and not a new selector built from
// scratch (brief's production-blocker instruction). The filter/rank behaviour below is the
// same one src/pages/index.astro already ships for the homepage hero search (type-to-filter,
// name-starts-with ranked above name-contains ranked above alias-only), and the keyboard/ARIA
// handling reuses src/scripts/combobox-list.js, the exact module the homepage hero, the
// hotel-tax map and the rate-parity finder already share. The one real difference: those
// three commit by following a link; a destination commit here is a radio selection plus this
// step's own Continue button (see QuestionPanel), never on typing alone and never on an
// arrow-key move alone, which avoids a real hazard the homepage pattern does not have to
// think about: this step's commit is a full navigation to /calculator/<slug>, so firing it on
// mere keyboard browsing through the radio group would take a keyboard user to a country they
// were only passing through with the arrow key. See CalcWizard.astro's client script for why
// this step submits only on an explicit Continue, unlike the pure-choice steps.
const { countries, selectedSlug } = Astro.props;
// countries: [{ slug, name }]
---
<label class="field-label" for="q-destination-search">Find a country</label>
<input class="form-input" id="q-destination-search" type="search" autocomplete="off" placeholder="Search countries" aria-controls="q-destination-countries" aria-describedby="q-destination-error" data-destination-search />
<fieldset class="choice-list country-options" id="q-destination-countries" data-destination-list>
  <legend class="sr-only">Destination</legend>
  {countries.map(c => (
    <label class="choice" data-name={c.name.toLowerCase()}>
      <input type="radio" name="destination" value={c.slug} checked={c.slug === selectedSlug} />
      <span class="choice-face"><span><strong>{c.name}</strong></span></span>
    </label>
  ))}
</fieldset>
<p class="country-empty" hidden data-destination-empty>No guide matches that search yet. Try a different spelling, or browse <a href="/countries">every country guide</a>.</p>
<p class="field-error" id="q-destination-error" role="alert"></p>
