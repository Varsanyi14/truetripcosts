---
// THE "OUR CALL" CARD. Sits at the foot of a country-cluster region page (e.g.
// /compare/gulf) and names the winner on each money dimension the page already
// rates: easiest money experience, cheapest day, most cash-dependent, and so on.
//
// This component is a presentation layer only, same rule as VerdictCard.astro. It
// composes no sentences of its own beyond the fixed labels; every `lines` entry
// (label, country, why) is generated by the page from its own `rate` object and
// verdicts, and is not allowed to introduce a fact the page does not already
// carry. See BRIEF-region-our-call.md for the no-invention rule this exists under.
//
// Visual language borrows from VerdictCard.astro (.tvc) and UtilityBox.astro
// (.utilbox): card surface, hairline border, --radius, --shadow, a mono
// uppercase eyebrow. Deliberately not a new pattern.
//
// Self-contained styling (a scoped <style> here, not global.css) because unlike
// UtilityBox this component owns its own content rather than taking a slot, so
// there is no caller-scope mismatch to work around.
const { heading, intro, lines = [] } = Astro.props;
---
{lines.length > 0 && (
  <section class="rv-sec">
    <div class="rv">
      <p class="rv-eyebrow">Our call</p>
      <h2 class="rv-heading">{heading}</h2>
      {intro && <p class="rv-intro">{intro}</p>}
      <dl class="rv-lines">
        {lines.map(l => (
          <div class="rv-line">
            <dt class="rv-label">{l.label}</dt>
            <dd class="rv-val"><b class="rv-country">{l.country}</b>{l.why && <>, {l.why}</>}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style>
  /* The section wrapper matches the top-border rhythm every other section on
     these pages uses (each page defines its own .se-sec locally), so the card
     reads as the next section down rather than an afterthought glued to the
     verdicts above it. */
  .rv-sec{padding:30px 0 0;border-top:1px solid var(--line);margin-top:34px}

  .rv{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:22px 24px 20px;max-width:720px}

  .rv-eyebrow{font-family:var(--mono);font-size:11.5px;font-weight:600;color:var(--teal-deep);text-transform:uppercase;letter-spacing:.09em;margin:0 0 8px}
  .rv-heading{font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.2;letter-spacing:-.01em;color:var(--ink);margin:0 0 8px}
  .rv-intro{font-size:14.5px;color:var(--muted);line-height:1.55;margin:0 0 16px}
  .rv-intro + .rv-lines{margin-top:0}

  .rv-lines{display:flex;flex-direction:column;gap:12px;margin:16px 0 0;padding:16px 0 0;border-top:1px solid var(--line)}
  .rv-line{display:grid;grid-template-columns:180px 1fr;gap:2px 16px;align-items:baseline}
  .rv-label{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.04em;color:var(--teal-deep);margin:0}
  .rv-val{font-size:15px;color:#3B4A46;line-height:1.5;margin:0}
  .rv-country{color:var(--ink);font-weight:600}

  @media (max-width:600px){
    .rv{padding:18px 18px 16px}
    .rv-heading{font-size:20px}
    .rv-line{grid-template-columns:1fr;gap:2px}
  }
</style>
