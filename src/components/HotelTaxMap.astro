---
// The hotel-tax world choropleth. Renders pre-generated, projected SVG paths (built by
// scripts/build-world-map.mjs from public-domain Natural Earth data) filled from
// src/data/hotel-tax-map.js. No mapping library, no runtime geometry, no tiles: the same
// pattern RegionMap.astro uses, scaled to the whole world.
//
// TWO THINGS THIS COMPONENT DELIBERATELY IS NOT.
//
// It is not the content. Every figure the map encodes is also written out below it as real
// HTML, one row per country, present in the document whether or not JavaScript runs. The
// map is a discovery surface, so the indexable, linkable, screen-readable version of the
// answer is the list, exactly as RegionMap's note says of the cluster maps. Clicking a
// country moves you to its row; that is the only thing the script does.
//
// It is not a judge of the data. It cannot promote a country into a colour. `colours()` in
// the data file is the single gate, and everything here routes through it, so a country
// with a half-written entry falls to the not-yet-checked fill by default rather than by a
// branch here remembering to check.
import { BANDS, STATES, bandFor, colours, hasModelledFlat, hasNotInFill, isNoBedTax, isCheckedShape, isChecked, SHAPE_WORDS, REFERENCE_STAY, hotelTaxMap, hotelTaxWatchlist, byIso, hotelTaxMapChecked } from '../data/hotel-tax-map.js';
import world from '../data/maps/world.js';
import { countries } from '../data/index.js';

// DERIVED ENTRIES. The site already holds a researched, dated tax position for every live
// country, and for 26 of them the finding is "there is no hotel or tourist tax". The first
// version of this map ignored that and rendered them as not-yet-checked, which told a reader
// TTC had looked at two countries when it had looked at all 59. So those entries are derived
// here from the same field the guides publish rather than transcribed into the data file:
//   - no second home for the same fact, so a guide correction reaches the map for free
//   - a new country appears on the map the day its guide goes live, with no hand-editing
//   - it cannot fabricate, because the country must exist in src/data/index.js to appear
// A hand-written entry in hotel-tax-map.js always wins, so MAIN can override any of these
// by adding a real entry for that ISO.
const derived = countries
  .filter(c => c.live && c.tax && !byIso[(c.iso2 || '').toUpperCase()])
  .map(c => {
    // Resolve the link from the country's OWN spokes rather than guessing a path. Guessing
    // is what shipped a 404 to /netherlands/hotel-taxes-and-fees.
    const taxSpoke = (c.spokes || []).find(s => s && s.live === true && s.topic === 'taxes');
    // "There is a charge" must be tested against the FIGURES, not just the absence of a
    // tax.none flag. Costa Rica, the Dominican Republic and India carry unit:"flatPerNight"
    // with every region at rate 0 and a note saying no nightly tourist tax applies: the flag
    // is missing but the finding is the same as tax.none. Reading the flag alone made the map
    // tell a reader "a government charge applies here, levied as a flat amount per night" for
    // three countries whose own guides say the opposite. Test the numbers.
    const regions = Array.isArray(c.tax.regions) ? c.tax.regions : [];
    const anyCharge = typeof c.tax.pct === 'number' ? c.tax.pct > 0
      : regions.some(r => (typeof r.pct === 'number' && r.pct > 0) || (typeof r.rate === 'number' && r.rate > 0));
    const none = c.tax.none === true || (regions.length > 0 && !anyCharge);
    return {
      iso: (c.iso2 || '').toUpperCase(),
      country: c.name,
      slug: c.slug,
      spoke: taxSpoke ? taxSpoke.slug : null,
      state: none ? 'noBedTax' : 'checkedShape',
      note: c.tax.note,
      shape: none ? null : (c.tax.unit || null),
      checkedISO: c.checkedISO,
      derived: true,
    };
  })
  .filter(e => e.iso);

const entries = [...hotelTaxMap, ...derived];
const entryByIso = Object.fromEntries(entries.map(e => [e.iso, e]));

// variant 'full' is the page this component was built for and is the default, so
// /hotel-tax-map renders byte for byte what it rendered before this prop existed.
//
// variant 'embed' is the stripped-down rendering that goes inside an iframe on someone
// else's article. It keeps the head, the map and the colour scale, and drops the six
// how-to-read cards, the 61 country rows, the change block and the unmappable warning.
//
// WHY A VARIANT RATHER THAN A SECOND MAP COMPONENT. The alternative was rebuilding the SVG
// in the embed page, and that would put the fills, the band logic, the dot threshold and the
// stipple rules in two places. The whole argument for reusing this component is that the
// embed can never drift from the real map, and a copy drifts the first time MAIN tunes a
// band. So the geometry and the colour decisions stay in one file and the embed asks for
// less of it.
//
// WHY NOT SIMPLY RENDER EVERYTHING AND LET THE IFRAME SCROLL. The full section is about
// 300KB of HTML and many screens tall. Inside a 720px box it would scroll a reader through
// 61 country rows on a page that is not TTC's, which is not an embed anyone accepts, and it
// would load a quarter of a megabyte onto a host article to show a map. The sourced detail
// is not lost: the legend says where it is and the credit bar links straight to it.
const { anchor = 'hotel-tax-map', variant = 'full', canonicalUrl = null } = Astro.props;
const embed = variant === 'embed';

// A drawn country under this many square units of the 1000-unit-wide projection gets a
// locator dot on top of its fill, because the fill alone is not findable. THIS IS THE ONE
// NUMBER TO TUNE, and it lives here rather than in the geometry so moving it does not mean
// regenerating 130KB of paths.
//
// Why 45 and not something tighter. At the roughly 700px this renders on a desktop, a
// 45-unit country is about 22 square pixels, a 4.7px square; on a phone it is a fifth of
// that. That is visible as a tint if you already know where to look and useless if you do
// not, and "can a reader see that we checked this country" is the whole job. 45 catches
// the ones that matter to this particular map: the Netherlands is 34.8 and Switzerland
// 40.2, and both carry data today. For scale, Luxembourg is 2.1, Qatar 9.9, Jamaica 10.9,
// Kuwait 14.6, Slovenia 16.7, Denmark 37.2, Croatia 50.1, Ireland 50.9.
//
// The trade this buys is clutter: 53 countries sit under 60 units and most of them are
// European, so if Phase 2 lights up a dozen European countries at once the dots there will
// start to collide. The fix at that point is a Europe inset panel using this same geometry
// and these same fills, not a smaller dot, and it is worth building against the real
// distribution rather than guessing at it now.
const DOT_BELOW = 45;

// Fill for one country. The ONLY place a colour is chosen.
function fillFor(entry) {
  if (colours(entry)) return bandFor(entry.addedPct).fill;
  if (isNoBedTax(entry)) return STATES.noBedTax.fill;
  if (isCheckedShape(entry)) return STATES.checkedShape.fill;
  if (entry && entry.state === 'varies') return 'url(#htm-hatch)';
  return STATES.unchecked.fill;
}

// WHICH STIPPLE, AND WHY THERE ARE TWO OF THEM. The stipple now marks a fill modelled at
// the declared reference stay (Rail 3), and Phase 2 made that the common case rather than the
// rare one: six of the eleven coloured countries carry it, and most of them sit in the
// lightest band. Phase 1's single stipple was pale specks designed for the Maldives' dark
// green, and pale specks on the near-white bottom band are invisible, which would have
// silently dropped the marker from exactly the countries that most need it. So the speck
// takes its tone from the band underneath: dark on the three light bands, light on the two
// dark ones. Same mark, same meaning, legible on both.
const LIGHT_BANDS = new Set(['b1', 'b2', 'b3']);
const stippleFor = (e, small) => {
  const band = bandFor(e.addedPct);
  const dark = !band || LIGHT_BANDS.has(band.key);
  return `url(#htm-stipple${dark ? '-d' : ''}${small ? '-sm' : ''})`;
};

// Countries with no polygon at 110m (the Maldives, Bahrain, Singapore, Malta, Aruba, Hong
// Kong and about 55 more). For those a dot is the only mark possible.
const microByIso = Object.fromEntries(world.micro.map(m => [m.iso, m]));
const drawnIso = new Set(world.countries.map(c => c.iso).filter(Boolean));

// Every entry that should carry a locator dot: it is either not drawn at all, or drawn too
// small to see. Only entries we actually hold something for, so the map never speckles.
const dots = entries
  .map(e => {
    const poly = world.countries.find(c => c.iso === e.iso);
    const src = poly && poly.area >= DOT_BELOW ? null : (poly || microByIso[e.iso]);
    if (!src) return null;
    return { iso: e.iso, cx: src.cx, cy: src.cy, fill: fillFor(e), stipple: colours(e) && hasModelledFlat(e) ? stippleFor(e) : null };
  })
  .filter(Boolean);

// Any entry whose ISO has neither a polygon nor a centroid cannot be marked at all. That
// would be silent data loss, so it is surfaced as a visible note rather than swallowed.
const unmappable = entries.filter(e => !drawnIso.has(e.iso) && !microByIso[e.iso]);

// Rows for the list under the map. Coloured countries first, darkest band first, because
// that is the order a reader scanning for "where does this bite hardest" wants. Then the
// varies countries, then the entries we are holding without a figure.
// Order: countries with a figure (darkest first), then the varies countries, then the
// checked no-bed-tax findings alphabetically, then the entries we are still holding open.
const RANK = { checked: 0, varies: 1, checkedShape: 2, noBedTax: 3, pending: 4 };
const rows = entries.slice().sort((a, b) => {
  const ra = RANK[a.state] ?? 5, rb = RANK[b.state] ?? 5;
  if (ra !== rb) return ra - rb;
  if (a.state === 'checked' && b.state === 'checked') return (b.addedPct || 0) - (a.addedPct || 0);
  return a.country.localeCompare(b.country);
});

const figureCount = entries.filter(colours).length;
const modelledCount = entries.filter(e => colours(e) && hasModelledFlat(e)).length;
const noTaxCount = entries.filter(isNoBedTax).length;
const shapeCount = entries.filter(isCheckedShape).length;
const variesCount = entries.filter(e => e.state === 'varies').length;
const checkedCount = entries.filter(isChecked).length;
// COUNT COVERED COUNTRIES AGAINST THE COVERED DENOMINATOR. The map also carries entries for
// places TTC has no guide for yet (the Maldives, the US), so counting every entry against 59
// produced "61 of the 59 countries we cover". Same mistake as the original "2 of 234", just
// from the other direction: mixing two populations in one fraction.
const coveredIsos = new Set(countries.filter(c => c.live).map(c => (c.iso2 || '').toUpperCase()));
const coveredChecked = entries.filter(e => coveredIsos.has(e.iso) && isChecked(e)).length;
const beyondCovered = entries.filter(e => !coveredIsos.has(e.iso) && isChecked(e)).length;
// THE DENOMINATOR IS THE COUNTRIES TTC COVERS, not every country and territory on earth.
// The first version divided by 234, the full Natural Earth list including dependencies,
// which made the page read as 99 percent ignorant no matter how much work landed behind it.
// TTC has never claimed to cover 234 countries. It covers these, on purpose.
const coveredCount = countries.filter(c => c.live).length;

// A country's own page, where one exists. Never invented: a null slug renders as plain
// text rather than a link into a 404.
const hrefFor = (e) => !e.slug ? null : (e.spoke ? `/${e.slug}/${e.spoke}` : `/${e.slug}`);

// Only sourced watchlist entries are ever shown. Unsourced ones exist for the staleness
// scanner and stay off the page. In Phase 1 that means this block renders one row.
const shownWatch = hotelTaxWatchlist.filter(w => w.source && w.source.url);

const fmtDate = (iso) => {
  if (!iso) return null;
  const d = new Date(iso + 'T00:00:00Z');
  if (isNaN(d.getTime())) return null;
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
};

const unitWords = { perPersonPerNight: 'per person, per night', perRoomPerNight: 'per room, per night', flatPerNight: 'per room, per night' };

// NATIVE <title> IDENTIFICATION, one line per shape and per dot.
//
// WHY THIS IS NOT THE TOOLTIP THE SCRIPT BELOW ARGUES AGAINST. That comment rules out a JS
// hover card for three reasons: it cannot be tapped on a phone, it cannot be read by
// assistive tech, and it cannot be indexed. A native <title> has none of those failings. It
// is markup rather than behaviour, it needs no JavaScript, it ships inside the embed at no
// extra request, and it does not replace anything: the click still goes to the sourced row,
// which remains the only place the figure is explained. This answers the one question the
// map could not previously answer without a click, which is "which country is that speck".
//
// THE ONE RULE. A title may only restate what this map already claims. Every branch keys off
// the SAME predicate the fill uses, in the same order, so a title cannot disagree with the
// colour beside it. It never invents a figure, it never turns a modelled percentage into a
// rate a government sets, and for the foreigner-exempt countries it never names the resident
// rate, because that is precisely the number a US traveler does not pay.
//
// KNOWN LIMIT, worth stating rather than discovering later: the parent <svg> carries
// role="img" with its own aria-label, which makes the whole map one atomic image to
// assistive tech and stops it walking into these titles. So this is a HOVER win today, not
// yet a screen-reader win. Exposing the subtree would mean dropping role="img", and that
// would set a screen reader walking 176 shapes, which is worse than the rows it already has.
// That trade is MAIN's to make, not this helper's.
function titleFor(entry, name) {
  const who = (entry && entry.country) || name;
  if (!who) return null;
  // A country with no entry gets its name and nothing else. Naming a shape is identification;
  // anything beyond that would imply a finding where there is none.
  if (!entry) return who;
  const when = entry.checkedISO ? `, checked ${fmtDate(entry.checkedISO)}` : '';

  if (colours(entry)) {
    // Inclusive first, because these carry addedPct 0 and would otherwise read as "about 0%
    // added on top", which is arithmetically true and explains nothing.
    if (entry.display === 'inclusive') {
      return `${who}: the tax is inside the quoted price, so about nothing is added at checkout${when}`;
    }
    // A representative figure stands for one rung of several, so the title says which rung
    // and that the others differ. Without that it would read as a national rate.
    if (entry.representative) {
      const how = hasModelledFlat(entry)
        ? `A flat charge modelled at about ${entry.addedPct}% of the reference room`
        : `About ${entry.addedPct}% added on top of the quoted rate`;
      return `${who}: ${entry.representative}. ${how}, other rungs differ${when}`;
    }
    // cityBasis is carried through for the same reason Rail 5 exists: without it the
    // Netherlands title would state a national figure that describes Amsterdam only.
    const where = entry.cityBasis ? ` on the ${entry.cityBasis} basis` : '';
    if (hasModelledFlat(entry)) {
      return `${who}: a flat charge modelled at about ${entry.addedPct}% of the reference room${where}${when}`;
    }
    return `${who}: about ${entry.addedPct}% added on top of the quoted rate${where}${when}`;
  }
  if (isNoBedTax(entry)) return `${who}: checked, no tourist or hotel tax`;
  if (isCheckedShape(entry)) return `${who}: a government charge applies, its shape is known but not yet a figure on this scale`;
  if (entry.state === 'varies') return `${who}: it depends on the city or on who you are, tap through for the detail`;
  return who;
}
---
<section class:list={['htm', embed && 'htm-embed']} id={anchor}>

  <div class="htm-head">
    <p class="lab">The map</p>
    <h2>What government adds on top of the room rate.</h2>
    <p class="htm-sub">Darker means more is added at checkout, on top of the price you were quoted. It does not mean more tax: in most of Europe and in Japan the tax is already inside the rate you compared, which is why some heavily taxed countries sit at the light end. Hotel charges like resort fees are never in the colour, because no government sets them.</p>
  </div>

  <figure class="htm-fig">
    <div class="htm-mapwrap">
      <svg class="htm-svg" viewBox={world.viewBox} xmlns="http://www.w3.org/2000/svg"
           preserveAspectRatio="xMidYMid meet"
           role="img"
           data-embed-href={embed && canonicalUrl ? canonicalUrl : undefined}
           aria-label={`World map shading each country by the share a government adds on top of a quoted hotel room rate. ${figureCount} countries carry a percentage figure, ${shapeCount} have a charge whose shape is known but no figure on this scale, ${noTaxCount} have been checked and have no tourist or hotel tax at all, and ${variesCount} vary too much internally for a single figure. Everything is written out in the list below this map.`}>
        <defs>
          {/* Hatch = varies too much within the country for one figure. Distinct from every
              band and from the not-yet-checked fill, so the three can never be confused. */}
          <pattern id="htm-hatch" width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
            <rect width="7" height="7" fill={STATES.varies.fill} />
            <line x1="0" y1="0" x2="0" y2="7" stroke="#8C9A94" stroke-width="2.2" />
          </pattern>
          {/* Stipple = there is a flat government charge here that a percentage fill
              cannot show. Overlaid on the band, so the band still reads.
              TWO DENSITIES, ONE MEANING. A 6-unit pattern is right across a country and
              lands about four specks inside a 13-unit locator dot, which reads as a face
              rather than as texture. The fine variant is the same mark at a density that
              survives being shrunk into a dot. */}
          <pattern id="htm-stipple" width="6" height="6" patternUnits="userSpaceOnUse">
            <circle cx="3" cy="3" r="1.15" fill="#F5F4EF" fill-opacity=".85" />
          </pattern>
          <pattern id="htm-stipple-sm" width="3" height="3" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.5" r="0.55" fill="#F5F4EF" fill-opacity=".9" />
          </pattern>
          {/* The same mark in the dark tone, for the light bands. */}
          <pattern id="htm-stipple-d" width="6" height="6" patternUnits="userSpaceOnUse">
            <circle cx="3" cy="3" r="1.15" fill="#16302C" fill-opacity=".38" />
          </pattern>
          <pattern id="htm-stipple-d-sm" width="3" height="3" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.5" r="0.55" fill="#16302C" fill-opacity=".45" />
          </pattern>
          {/* Hairlines = checked, there is a charge, no figure on this scale yet. Horizontal
              so it cannot be confused with the 45 degree hatch that means "varies", and laid
              over the grey base so it reads as the unchecked tone with content added. */}
          <pattern id="htm-lines" width="4" height="4" patternUnits="userSpaceOnUse">
            <rect width="4" height="4" fill={STATES.checkedShape.swatch} />
            <line x1="0" y1="1" x2="4" y2="1" stroke="#A8A79C" stroke-width="1" />
          </pattern>
        </defs>

        <g class="htm-countries">
          {world.countries.map(c => {
            const e = c.iso ? entryByIso[c.iso] : null;
            const t = titleFor(e, c.name);
            // <title> FIRST, because that is what browsers show on hover and what an
            // accessible-name calculation reads. Not a self-closing path any more.
            return <path d={c.d} fill={fillFor(e)} data-iso={c.iso || undefined} data-htm={e ? e.state : 'unchecked'}>{t ? <title>{t}</title> : null}</path>;
          })}
        </g>

        {/* Stipple pass, drawn over the bands so a flat-fee country shows both. */}
        <g class="htm-stip" aria-hidden="true">
          {world.countries.filter(c => c.iso && colours(entryByIso[c.iso]) && hasModelledFlat(entryByIso[c.iso]))
            .map(c => <path d={c.d} fill={stippleFor(entryByIso[c.iso])} />)}
        </g>

        {/* Locator dots for the specks and for countries 110m does not draw.
            r=6.5 is a compromise measured against the closest pair this map actually has:
            the Netherlands and Switzerland centroids are 17.8 units apart, so a 7.5 radius
            leaves them touching. 6.5 clears them and still reads at phone width. */}
        <g class="htm-dots">
          {dots.map(d => {
            const t = titleFor(entryByIso[d.iso], null);
            return [
              // The dot is the ONLY mark for a country 110m does not draw, so this title is
              // the whole of its identification. The stipple overlay below is decoration and
              // deliberately carries none: two titles on one spot would read twice.
              <circle cx={d.cx} cy={d.cy} r="6.5" fill={d.fill} stroke="#F5F4EF" stroke-width="1.6" data-iso={d.iso}>{t ? <title>{t}</title> : null}</circle>,
              d.stipple ? <circle cx={d.cx} cy={d.cy} r="6.5" fill={d.stipple.replace(')', '-sm)')} /> : null,
            ];
          })}
        </g>
      </svg>

      <p class="htm-stamp"><b>True Trip Costs</b><span>Government charges only. Checked {hotelTaxMapChecked}.</span></p>
    </div>

    <figcaption class="htm-cap">
      Equal-area projection, so a country's size on the map matches its size on the ground rather than being inflated by its latitude. Countries too small to draw at this scale are marked with a dot where we hold a figure.
    </figcaption>
  </figure>

  <div class="htm-legend">
    <p class="htm-lk">Added on top of the quoted rate, by government</p>
    {!embed && <p class="htm-basket">Some of these charges are not percentages at all. Most of Europe asks for a flat few euros a night rather than a share of the room, and a flat fee has no percentage until you pick a room rate. So we picked one and we are telling you what it is: <b>{REFERENCE_STAY.words}</b>. Every flat fee on this map is shown as its share of that room. The consequence is worth holding on to, because it runs the opposite way to intuition: a cheaper room feels a flat fee harder than this map shows, and an expensive room barely notices it. Each country's row carries the real charge in its own currency, which is the number to use if your room is nothing like 150 euros.</p>}
    <ul class="htm-bands">
      {BANDS.map(b => (
        <li><span class="htm-sw" style={`background:${b.fill}`}></span>{b.label}</li>
      ))}
    </ul>
    {!embed && <ul class="htm-states">
      <li><span class="htm-sw htm-sw-hatch"></span><span class="htm-st"><b>{STATES.varies.label}.</b> No single national figure would be right anywhere in it, so we give representative cities instead of one colour.</span></li>
      <li><span class="htm-sw htm-sw-stip"></span><span class="htm-st"><b>This colour is modelled, not measured.</b> The charge here is a flat amount per night, converted at the reference room above rather than read off a real percentage. The fee in its own currency is on the country's row, and it is the more useful number of the two.</span></li>
      <li><span class="htm-sw htm-sw-lines"></span><span class="htm-st"><b>{STATES.checkedShape.label}.</b> We checked, there is a government charge, and its shape is on the country's row. Getting it onto this percentage scale needs one more step, so it sits off the scale rather than being guessed onto it.</span></li>
      <li><span class="htm-sw" style={`background:${STATES.noBedTax.fill}`}></span><span class="htm-st"><b>{STATES.noBedTax.label}.</b> We looked and found no tourist or hotel tax at all. This is a finding, not a gap. It is off the colour scale rather than at the light end of it, because VAT and property charges are separate questions and this map does not claim to have answered them here yet.</span></li>
      <li><span class="htm-sw" style={`background:${STATES.unchecked.fill}`}></span><span class="htm-st"><b>{STATES.unchecked.label}.</b> Almost all of the grey is countries outside the {coveredCount} we cover, not countries we looked at and gave up on. Either way it never means there is nothing to pay: grey is the absence of our work, not the absence of a tax.</span></li>
    </ul>}

    {/* The embed's version of the five state definitions above. It is short because the box
        is 720px tall, and it keeps the two things the map is actively misleading without:
        that a light country can still be heavily taxed, and that grey means unchecked
        rather than untaxed. Everything else is one click away and the link is right below. */}
    {embed && (
      <p class="htm-embed-note">
        Hatching means the rate varies too much inside the country for one national figure.
        Specks mean the charge is a flat fee per night, converted at one declared room rather
        than measured as a percentage. Hairlines mean there is a charge we have checked but
        not yet put on this scale. Grey never means untaxed: it means we have not checked it
        yet. The reference room behind the modelled colours, and every country's sourced and
        dated figures, are on the full map.
      </p>
    )}
  </div>

  {/* Everything from here down is the full page only. These four blocks are the map's
      sourced detail and its reason to be trusted, and they are exactly what makes the
      section too tall and too heavy to sit in an iframe. The embed points at them. */}
  {!embed && <Fragment>
  <div class="htm-honest">
    <p class="htm-lk">How to read this without being misled</p>
    <div class="htm-hgrid">
      <div class="htm-hcard">
        <span class="htm-hk">Light is not the same as cheap</span>
        <p>The colour answers one question: how much lands on the bill that you did not see when you compared prices. Where VAT is embedded in the sticker price, as it is across most of Europe and in Japan, almost nothing is added at checkout even though the tax is heavy. Those countries are light here. The tax is real, it is just already in the number you were quoted.</p>
      </div>
      <div class="htm-hcard">
        <span class="htm-hk">A stippled colour rests on an assumption</span>
        <p>A flat fee of 4 euros a night is 2.7% of a 150 euro room, 8% of a 50 euro room and under 1% of a 500 euro suite. It is the same fee. Where a country's charge works that way we convert it at one declared room, state that room in the legend, mark the country with specks and print the real fee on its row. The colour is then comparable between countries, which is the only reason to do it, and it is not a measurement of your bill.</p>
      </div>
      <div class="htm-hcard">
        <span class="htm-hk">Only government charges are coloured</span>
        <p>A resort fee or a service charge is set by the property, and there is no national figure for either. They can easily outweigh the tax, so where we hold a range it is stated on the country's row and labelled as the property's. It never touches the colour, because colouring a country by a charge one hotel invented would be a guess wearing a number's clothes.</p>
      </div>
      <div class="htm-hcard">
        <span class="htm-hk">Some countries colour lower than their real stack</span>
        <p>A country colours only on the charges we can point you at a government page for. Several here have a further charge that is well attested, that we believe is real, and that we could not source to the authority that sets it. Those are named on the country's row with the reason they are not counted, and the row is tagged. It means a handful of these figures are floors rather than totals, which is the safer way round to be wrong.</p>
      </div>
      <div class="htm-hcard">
        <span class="htm-hk">Grey means unchecked, not untaxed</span>
        <p>We colour a country when a person has read the rate off the authority that sets it and dated it. Everything else stays grey. That leaves most of the world grey today, which is the honest state of the work rather than a design choice, and it is better than a full map with one wrong number on it.</p>
      </div>
      <div class="htm-hcard">
        <span class="htm-hk">Announced is not collected</span>
        <p>Several countries have levies that were announced, reported widely and then deferred or dropped. A charge that is not being collected is excluded from the colour and named on the country's row, and a rise with a future date is listed as scheduled rather than folded into today's figure.</p>
      </div>
    </div>
  </div>

  <div class="htm-list">
    <p class="htm-lk">Every country we hold something for</p>
    <p class="htm-note">We hold a checked, dated position on {coveredChecked === coveredCount ? `all ${coveredCount}` : `${coveredChecked} of the ${coveredCount}`} countries we cover{beyondCovered > 0 ? `, plus ${beyondCovered} beyond them` : ''}: {noTaxCount} with no tourist or hotel tax at all, {shapeCount} where there is a charge and its shape is known, {figureCount} pinned to a percentage on the scale above, of which {modelledCount} are flat charges modelled at the reference room rather than real percentages, and {variesCount} where the rate varies too much inside the country for one national number to be honest. This list is the map's real content, with the government charges separated from the property's own, and each one dated.</p>

    {rows.map(e => {
      const band = colours(e) ? bandFor(e.addedPct) : null;
      const href = hrefFor(e);
      return (
        <div class="htm-row" id={`htm-${e.iso}`}>
          <div class="htm-rhead">
            <span class="htm-chip" style={band ? `background:${band.fill}` : (isNoBedTax(e) ? `background:${STATES.noBedTax.fill}` : undefined)} data-state={e.state}></span>
            <span class="htm-rname">{href ? <a href={href}>{e.country}</a> : e.country}</span>
            {e.cityBasis && <span class="htm-tag">{e.cityBasis} basis</span>}
            {e.representative && <span class="htm-tag">Representative: {e.representative}</span>}
            {colours(e) && hasModelledFlat(e) && <span class="htm-tag htm-tag-m">Modelled at the reference room</span>}
            {colours(e) && hasNotInFill(e) && <span class="htm-tag htm-tag-o">More here than this figure counts</span>}
            {e.display === 'inclusive' && <span class="htm-tag htm-tag-q">Already in the price</span>}
            {e.display === 'mixed' && <span class="htm-tag htm-tag-q">Part in the price, part added</span>}
            {e.state === 'varies' && <span class="htm-tag htm-tag-v">Varies within the country</span>}
            {isNoBedTax(e) && <span class="htm-tag htm-tag-n">No tourist or hotel tax</span>}
            {isCheckedShape(e) && <span class="htm-tag">Figure not yet on the scale</span>}
          </div>

          {colours(e) && (
            <p class="htm-fig-line"><b class="num">{e.addedPct}%</b> added on top of the quoted rate{hasModelledFlat(e) ? <span class="htm-native">, modelled from {e.modelled.map(f => `${f.amount} ${f.currency} ${unitWords[f.unit] || f.unit}`).join(' and ')}</span> : null}</p>
          )}
          {colours(e) && hasModelledFlat(e) && (
            <p class="htm-modelled"><b>The charge is not a percentage.</b> It is {e.modelled.map(f => `${f.amount} ${f.currency} ${unitWords[f.unit] || f.unit}`).join(' and ')}{e.basePct ? `, on top of a real ${e.basePct}%` : ''}. The {e.addedPct}% above is that fee measured against one room at {REFERENCE_STAY.nightly} euros for {REFERENCE_STAY.guests === 1 ? 'one guest' : `${REFERENCE_STAY.guests} guests`}, so use the figure in its own currency if your room costs anything else.</p>
          )}
          {e.addedBasis && <p class="htm-why">{e.addedBasis}</p>}
          {e.cityBasisNote && <p class="htm-why">{e.cityBasisNote}</p>}
          {e.representativeNote && <p class="htm-why">{e.representativeNote}</p>}
          {e.displayNote && <p class="htm-why">{e.displayNote}</p>}
          {e.variesNote && <p class="htm-why">{e.variesNote}</p>}
          {isCheckedShape(e) && (
            <p class="htm-fig-line">A government charge applies here, levied as <b class="shape">{SHAPE_WORDS[e.shape] || 'a charge set locally'}</b></p>
          )}
          {(isNoBedTax(e) || isCheckedShape(e)) && <p class="htm-why">{e.note}</p>}
          {isCheckedShape(e) && !e.pendingVerification && (
            <p class="htm-partial">Why this is not shaded on the scale: the rate is written out on this country's own page, and moving it onto a single comparable percentage needs a person to check the base it applies to and whether it is already inside the quoted rate. Until that is done it would be a guess, so it stays off the scale.</p>
          )}
          {isNoBedTax(e) && (
            <p class="htm-partial">What this row does not tell you: whether VAT is added on top of a quoted rate here, or already inside it. That is the question this map colours, and it has not been checked for this country yet. The finding above is that there is no separate tourist or hotel tax to add.</p>
          )}

          {typeof e.governmentTotalPct === 'number' && (
            <p class="htm-total">Total government take on the room, whether you see it added or not: about <b class="num">{e.governmentTotalPct}%</b>. This is not what colours the map, and it is not a simple sum of the parts below, because one charge is levied on the other's base.</p>
          )}

          {Array.isArray(e.government) && e.government.length > 0 && (
            <div class="htm-comp">
              <span class="htm-ck">Government charges</span>
              <ul>
                {e.government.map(g => (
                  <li>
                    <b>{g.label}, {g.figure}.</b>
                    {' '}{g.inQuotedPrice === true ? 'Inside the rate you are quoted. ' : g.inQuotedPrice === false ? 'Added at checkout. ' : ''}
                    {g.note}
                    {g.effective && <span class="htm-eff"> In force from {fmtDate(g.effective)}.</span>}
                    {g.source && g.source.url
                      ? <span class="htm-src"> <a href={g.source.url} rel="nofollow noopener" target="_blank">{g.source.label}</a>{g.checkedISO ? `, checked ${fmtDate(g.checkedISO)}` : ''}.</span>
                      : <span class="htm-nosrc"> Official source not yet attached, so treat this figure as unconfirmed.</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {hasNotInFill(e) && (
            <div class="htm-comp htm-comp-out">
              <span class="htm-ck">Government charges we know about and did not count</span>
              <ul>
                {e.notInFill.map(n => (
                  <li><b>{n.label}, {n.figure}.</b> {n.why}</li>
                ))}
              </ul>
            </div>
          )}

          {Array.isArray(e.property) && e.property.length > 0 && (
            <div class="htm-comp htm-comp-prop">
              <span class="htm-ck">Set by the property, not the government</span>
              <ul>
                {e.property.map(p => (
                  <li><b>{p.label}{p.range ? `, ${p.range}` : ''}.</b> {p.note}</li>
                ))}
              </ul>
            </div>
          )}

          {Array.isArray(e.cities) && e.cities.length > 0 && (
            <div class="htm-comp">
              <span class="htm-ck">Representative cities</span>
              <ul>{e.cities.map(c => <li><b>{c.city}, {c.figure}.</b> {c.note}</li>)}</ul>
            </div>
          )}

          {Array.isArray(e.watch) && e.watch.length > 0 && (
            <div class="htm-comp htm-comp-watch">
              <span class="htm-ck">Not in the figure above</span>
              <ul>
                {e.watch.map(w => (
                  <li>
                    <b>{w.label}.</b> {w.note}
                    {w.effective && <span class="htm-eff"> Scheduled for {fmtDate(w.effective)}, so it is not counted yet.</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {e.pendingVerification && <p class="htm-pend"><b>Not yet coloured.</b> {e.pendingVerification}</p>}
          {e.checkedISO && <p class="htm-checked">Checked {fmtDate(e.checkedISO)}</p>}
        </div>
      );
    })}
  </div>

  {shownWatch.length > 0 && (
    <div class="htm-list htm-watchblock">
      <p class="htm-lk">Changes with a date on them</p>
      <p class="htm-note">Rates that have moved or are due to move, so a figure on this page can be checked against the day it changed. Only changes we have an official source for appear here.</p>
      {shownWatch.map(w => (
        <p class="htm-wrow">
          <b>{w.where}, {w.label}.</b>{' '}
          {w.status === 'proposed'
            ? 'Announced and not collected, so it is excluded from the map.'
            : w.effective ? `${w.status === 'in-force' ? 'In force from' : 'Scheduled for'} ${fmtDate(w.effective)}${w.ends ? ` until ${fmtDate(w.ends)}` : ''}.` : ''}
          <span class="htm-src"> <a href={w.source.url} rel="nofollow noopener" target="_blank">{w.source.label}</a>.</span>
        </p>
      ))}
    </div>
  )}

  {unmappable.length > 0 && (
    <p class="htm-warn">Held but not markable on this map: {unmappable.map(e => e.country).join(', ')}. The geometry carries no shape or centroid for these, so their figures appear in the list above but nowhere on the map. Regenerate with scripts/build-world-map.mjs if that is wrong.</p>
  )}
  </Fragment>}
</section>

<script>
  // The only behaviour on this page: clicking a country moves you to its row. Everything
  // the map encodes is already in the document, so with JavaScript off nothing is lost and
  // no figure goes missing. Deliberately not a tooltip: a hover card cannot be tapped on a
  // phone, cannot be read by a screen reader and cannot be indexed, and this map's whole
  // argument is that the sourced detail has to be reachable.
  //
  // IN THE EMBED there are no rows to scroll to, so the same click opens the country's row
  // on the real page in a new tab instead. Without this the embed would ship a pointer
  // cursor over every country and do nothing when tapped, which reads as broken. The
  // fallback is gated on data-embed-href, an attribute only the embed variant sets, so
  // clicking an unshaded country on /hotel-tax-map still does nothing exactly as before.
  // A new tab rather than a top-level navigation: the frame is on somebody else's article,
  // and replacing that article with a TTC page is both rude and blocked cross-origin.
  (() => {
    const svg = document.querySelector('.htm-svg');
    if (!svg) return;
    const canonical = svg.getAttribute('data-embed-href');
    svg.addEventListener('click', (ev) => {
      const el = ev.target.closest('[data-iso]');
      if (!el) return;
      const iso = el.getAttribute('data-iso');
      const row = document.getElementById('htm-' + iso);
      if (!row) {
        // Only countries we actually hold something for lead anywhere. An unchecked country
        // has no row on the real page either, so sending a reader there would land them at
        // the top of a page they did not ask for.
        if (canonical && el.getAttribute('data-htm') !== 'unchecked') {
          window.open(canonical + '#htm-' + iso, '_blank', 'noopener');
        }
        return;
      }
      row.scrollIntoView({ behavior: 'smooth', block: 'center' });
      row.classList.add('htm-row-lit');
      setTimeout(() => row.classList.remove('htm-row-lit'), 1600);
    });
  })();
</script>

<style>
  .htm{border-top:1px solid var(--line);padding:30px 0 0;margin-top:30px}
  .htm-head{max-width:720px}
  .htm-sub{font-size:15.5px;color:#3B4A46;line-height:1.55;margin:8px 0 0}

  /* The map goes full-bleed on a phone. At 380px the content column would leave it about
     336px wide, and an equal-area world map is inherently wide (1000 by 439), so every
     pixel of width is a pixel of legibility. The list below carries the detail regardless. */
  .htm-fig{margin:24px 0 0}
  .htm-mapwrap{position:relative;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);padding:10px 12px 34px;overflow:hidden}
  .htm-svg{width:100%;height:auto;display:block;overflow:hidden}
  .htm-countries path{stroke:#F5F4EF;stroke-width:.5;stroke-linejoin:round;vector-effect:non-scaling-stroke}
  .htm-countries path[data-iso]{cursor:pointer}
  .htm-stip path{pointer-events:none}
  .htm-dots circle{cursor:pointer}

  /* The screenshot signature. A screenshot of this map has to carry the wordmark and the
     basis of the number with it, or it travels as an unattributed claim. Same reasoning as
     the Verdict card. */
  .htm-stamp{position:absolute;left:14px;bottom:10px;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin:0;font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .htm-stamp b{color:var(--teal-deep);font-weight:600}
  .htm-cap{font-size:13.5px;color:var(--muted);line-height:1.5;margin:10px 0 0;max-width:720px}

  .htm-legend{margin:26px 0 0;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);padding:16px 18px}
  .htm-lk{font-family:var(--mono);font-size:11.5px;font-weight:600;color:var(--teal-deep);text-transform:uppercase;letter-spacing:.09em;margin:0 0 10px}
  .htm-basket{font-size:13.5px;color:#3B4A46;line-height:1.55;margin:0 0 12px;padding:0 0 12px;border-bottom:1px solid var(--line)}
  .htm-basket b{color:var(--ink)}
  .htm-bands{list-style:none;margin:0 0 14px;padding:0;display:flex;flex-wrap:wrap;gap:6px 16px}
  .htm-bands li{display:flex;align-items:center;gap:7px;font-size:13.5px;color:#3B4A46}
  .htm-states{list-style:none;margin:0;padding:14px 0 0;border-top:1px solid var(--line);display:grid;gap:10px}
  /* Two columns, and therefore EXACTLY TWO CHILDREN. The prose must stay wrapped in
     .htm-st: a bare text node beside the swatch and the <b> is a third child, and CSS grid
     wraps loose text in an anonymous grid item, which then lands in row 2 of the 18px
     column and renders one word per line. That shipped once. Do not unwrap it. */
  .htm-states li{display:grid;grid-template-columns:18px 1fr;gap:9px;font-size:13.5px;color:#3B4A46;line-height:1.5}
  .htm-st{min-width:0}
  .htm-states b{color:var(--ink)}
  .htm-sw{width:18px;height:14px;border-radius:3px;border:1px solid rgba(22,48,44,.16);flex:none;margin-top:2px}
  .htm-sw-hatch{background:repeating-linear-gradient(45deg,#CFD8D3 0 2px,#8C9A94 2px 4px)}
  .htm-sw-lines{background:repeating-linear-gradient(180deg,#E7E4DC 0 2px,#A8A79C 2px 3px)}
  /* Shows the light-band variant, because after Phase 2 that is what most stippled
     countries actually look like on the map. */
  .htm-sw-stip{background:#B6D4C9;background-image:radial-gradient(rgba(22,48,44,.42) 1.1px,transparent 1.2px);background-size:5px 5px}

  .htm-honest{margin:26px 0 0}
  .htm-hgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .htm-hcard{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);padding:15px 17px}
  .htm-hk{display:block;font-weight:600;font-size:14px;color:var(--teal-deep);margin:0 0 6px}
  .htm-hcard p{font-size:14px;color:#3B4A46;line-height:1.55;margin:0}

  .htm-list{margin:30px 0 0}
  .htm-note{font-size:14.5px;color:var(--muted);line-height:1.5;margin:0 0 16px;max-width:720px}
  .htm-row{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);padding:15px 17px;margin:0 0 12px;scroll-margin-top:70px;transition:border-color .3s ease,box-shadow .3s ease}
  .htm-row-lit{border-color:var(--teal);box-shadow:0 0 0 3px rgba(14,122,95,.14)}
  .htm-rhead{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin:0 0 8px}
  .htm-chip{width:16px;height:16px;border-radius:4px;border:1px solid rgba(22,48,44,.18);flex:none;background:#E7E4DC}
  .htm-chip[data-state=varies]{background:repeating-linear-gradient(45deg,#CFD8D3 0 2px,#8C9A94 2px 4px)}
  .htm-chip[data-state=checkedShape]{background:repeating-linear-gradient(180deg,#E7E4DC 0 2px,#A8A79C 2px 3px)}
  .htm-rname{font-family:var(--serif);font-weight:500;font-size:17px;color:var(--ink)}
  .htm-rname a{color:var(--teal-deep);text-decoration:none}
  .htm-rname a:hover{text-decoration:underline}
  .htm-tag{font-family:var(--mono);font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:3px 8px}
  .htm-tag-q{color:#7A3D08;background:var(--amber-bg);border-color:#F0D6AE}
  .htm-tag-v{color:#3B4A46}
  .htm-tag-m{color:var(--teal-deep);border-color:#BFD8CF}
  .htm-tag-o{color:#7A3D08;background:var(--amber-bg);border-color:#F0D6AE}
  .htm-tag-n{color:#7A3D08;background:var(--amber-bg);border-color:#F0D6AE}
  .htm-fig-line{font-size:16px;color:var(--ink);margin:0 0 6px}
  .htm-fig-line b{font-size:20px;font-weight:600;color:var(--teal-deep)}
  .htm-fig-line b.shape{font-size:16px;font-weight:600}
  .htm-why{font-size:14px;color:#3B4A46;line-height:1.55;margin:0 0 6px}
  .htm-native{color:var(--muted);font-size:15px}
  .htm-modelled{font-size:13.5px;color:#3B4A46;line-height:1.55;margin:2px 0 8px;padding:9px 11px;background:var(--paper);border-radius:10px}
  .htm-modelled b{color:var(--teal-deep)}
  .htm-total{font-size:14px;color:#3B4A46;line-height:1.55;margin:8px 0 6px;padding:10px 12px;background:var(--paper);border-radius:10px}
  .htm-comp{margin:10px 0 0;padding:10px 0 0;border-top:1px solid var(--line)}
  .htm-ck{display:block;font-family:var(--mono);font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--teal-deep);margin:0 0 6px}
  .htm-comp-prop .htm-ck{color:var(--muted)}
  .htm-comp-watch .htm-ck{color:#7A3D08}
  .htm-comp-out .htm-ck{color:#7A3D08}
  .htm-comp ul{margin:0;padding:0 0 0 17px}
  .htm-comp li{font-size:14px;color:#3B4A46;line-height:1.55;margin:0 0 6px}
  .htm-comp li:last-child{margin-bottom:0}
  .htm-eff{color:var(--muted)}
  .htm-src{color:var(--muted);font-size:13px}
  .htm-src a{color:var(--teal-deep)}
  .htm-nosrc{color:#7A3D08;font-size:13px}
  .htm-pend{font-size:14px;color:#3B4A46;line-height:1.55;margin:10px 0 0;padding:10px 12px;background:var(--amber-bg);border:1px solid #F0D6AE;border-radius:10px}
  .htm-pend b{color:#7A3D08}
  .htm-partial{font-size:13.5px;color:var(--muted);line-height:1.55;margin:8px 0 0;padding-left:11px;border-left:2px solid var(--line)}
  .htm-checked{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:10px 0 0}
  .htm-wrow{font-size:14px;color:#3B4A46;line-height:1.55;margin:0 0 10px}
  .htm-warn{font-size:13.5px;color:#7A3D08;background:var(--amber-bg);border:1px solid #F0D6AE;border-radius:10px;padding:11px 13px;margin:18px 0 0}

  @media (max-width:700px){
    .htm-hgrid{grid-template-columns:1fr}
  }
  @media (max-width:560px){
    .htm-fig{margin-left:-22px;margin-right:-22px}
    .htm-mapwrap{border-radius:0;border-left:0;border-right:0;padding:8px 8px 32px}
    .htm-cap{padding:0 22px}
    .htm-sub{font-size:15px}
    .htm-bands{gap:6px 12px}
    .htm-row{padding:14px 15px}
  }

  /* THE EMBED VARIANT. Overrides only, so the full page is untouched by anything below.
     Three things have to change for this to sit inside a 720px iframe on a foreign page. */

  /* 1. The section rule assumes it follows page copy, so it carries a top border and 30px
        of separation. In the embed it is the first thing in the box. */
  .htm-embed{border-top:0;padding:0;margin-top:0}

  /* 2. Tighter vertical rhythm and a smaller heading. The embed has one job in a short box,
        so the head does not need page-scale type. */
  .htm-embed .htm-head h2{font-size:clamp(18px,2.6vw,22px);line-height:1.2}
  .htm-embed .htm-sub{font-size:13px;margin:6px 0 0}
  .htm-embed .htm-fig{margin:12px 0 0}
  .htm-embed .htm-cap{font-size:11.5px;margin:8px 0 0}
  .htm-embed .htm-legend{margin:12px 0 0;padding:12px 14px}
  .htm-embed .htm-bands{margin:0;font-size:13px}

  .htm-embed-note{font-size:12px;color:#3B4A46;line-height:1.5;margin:10px 0 0;padding:10px 0 0;border-top:1px solid var(--line)}

  /* 3. Kill the phone full-bleed. Those negative margins exist to cancel the 22px gutter of
        .wrap on the real page. There is no .wrap in the embed, so at narrow widths they
        would hang the map over the edge of the frame instead. */
  @media (max-width:560px){
    .htm-embed .htm-fig{margin-left:0;margin-right:0}
    .htm-embed .htm-mapwrap{border-radius:var(--radius);border-left:1px solid var(--line);border-right:1px solid var(--line);padding:8px 8px 30px}
    .htm-embed .htm-cap{padding:0}
  }

  /* An unchecked country leads nowhere from the embed, so it must not offer a pointer.
     See the click handler: the same condition gates the navigation. */
  .htm-embed .htm-countries path[data-htm="unchecked"]{cursor:default}
</style>
