---
// Breadcrumb trail for comparison pages. Renders a visual trail plus
// BreadcrumbList structured data so Google can use it. Pass `items` as an
// ordered array [{ label, href? }, ...]; the last item is the current page and
// should omit href. Mirrors the real URL path (Home / Compare / Region), not an
// invented hierarchy, since country hubs are flat and belong to many clusters.
const { items = [] } = Astro.props;
const site = 'https://truetripcosts.com';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    ...(it.href ? { item: site + it.href } : {})
  }))
};
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href
          ? <a href={it.href}>{it.label}</a>
          : <span aria-current="page">{it.label}</span>}
        {i < items.length - 1 && <span class="crumb-sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

<style>
  .crumbs{margin:24px 0 0}
  .crumbs ol{list-style:none;display:flex;flex-wrap:wrap;align-items:center;margin:0;padding:0;font-family:var(--mono);font-size:11.5px;letter-spacing:.01em}
  .crumbs li{display:inline-flex;align-items:center}
  .crumbs a{color:var(--muted);text-decoration:none}
  .crumbs a:hover{color:var(--teal-deep);text-decoration:underline}
  .crumbs span[aria-current]{color:var(--ink);font-weight:500}
  .crumb-sep{color:var(--muted);margin:0 9px;opacity:.55}
</style>
