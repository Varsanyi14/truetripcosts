---
// THE CALCULATOR WIZARD, rebuilt to TTC-design-specification.md (BRIEF-calculator-final-build.md).
//
// THE CENTRAL FACT, unchanged from every prior pass: the honest calc engine
// (src/scripts/calc-engine.js) already exists and does all the math. This component is a
// front end that feeds it and reads it back, one question at a time. It does not compute
// anything itself.
//
// ARCHITECTURE. Two DOM trees live on this page at all times:
//   1. THE REAL ENGINE, permanently hidden (`data-engine-root hidden`): the exact same
//      estimator inputs and the exact same <CalcResult country={c} hideWizardCta={true} />
//      the site has always used, byte-for-byte the same markup, ids and classes
//      calc-regression-test.mjs already asserts against every country page. It is never
//      shown to a reader. Its only job is to be a correct, already-tested calculator that
//      happens to render its inputs and outputs as real DOM nodes instead of returning a
//      value from a function.
//   2. THE NEW SURFACE, everything the reader actually sees: the seven QuestionPanel steps,
//      the result view, the edit dialog. It is pre-rendered at build time (every step's real
//      copy and controls are known per-country before any JS runs) and a single client
//      script (src/scripts/calc-wizard.js) shows/hides the right step, wires each control's
//      native events into the hidden engine's inputs via the same apply()-style event
//      simulation the site has always used, and MIRRORS the hidden engine's already-computed
//      output text into the new surface's own elements. That mirror step is a plain text
//      copy, never a recomputation: see calc-wizard.js's own header for the full accounting
//      of which hidden id feeds which new element, and which few things (input provenance,
//      the flights-excluded flag, the calm-outcome trigger) are the surface's own state
//      because the engine has no such concept and none should be invented for it.
//
// WHY NOT REGENERATE STEP MARKUP FROM A CLIENT TEMPLATE, unlike the specialist's own
// framework-free reference (which has no server and so must build every screen from a JS
// string at runtime): this site is fully static and every country's data is already known
// at build time, so Astro renders the real, semantic, server-rendered controls for all seven
// steps up front. The client only ever toggles which one is visible. QuantityControl,
// PriceControl, ChoiceRows and DestinationChoice are literally the same DOM node whether a
// step is showing in the wizard or has been relocated into the edit dialog (see
// calc-wizard.js's openEdit()): there is exactly one control per question, never two
// differently-styled copies, matching the spec's explicit instruction on this point.
// BRIEF-calc-result-registry-rebuild: this file used to hand-assemble three separate
// wizard-gated systems (carrier's option list, rail's country gate, rental's constant)
// plus its own hard/soft split of avoidableFor(c)'s static items. All four are now ONE
// registry, read from src/data/avoidable.js: avoidableRegistryFor(c) for the HARD/SOFT
// tier pool (country-only items, byte-identical to avoidableFor(c)'s own output), and
// carrierRegistryEntryFor/railRegistryEntryFor/rentalRegistryEntry for the three
// wizard-gated items, which keep their own dedicated result slot (see that section's own
// header in avoidable.js for why) but now share ONE step generator and ONE QuestionPanel
// loop below instead of three hand-authored blocks.
import CalcResult from './CalcResult.astro';
import QuestionPanel from './calc/QuestionPanel.astro';
import QuantityControl from './calc/QuantityControl.astro';
import PriceControl from './calc/PriceControl.astro';
import ChoiceRows from './calc/ChoiceRows.astro';
import DestinationChoice from './calc/DestinationChoice.astro';
// BRIEF-result-card-step1: one small icon per row, from the site's own existing icon set
// rather than a new one drawn for this card. See calculator.css's own note on this: the
// card's brand colors already match what Symbol.astro draws every route icon in, so the
// row icons read as the same visual language, not a fourth one.
import Symbol from './Symbol.astro';
import { calcSetupFor } from '../data/calc-setup.js';
import { calcLinesFor } from '../data/calc-lines.js';
import {
  avoidableRegistryFor,
  carrierRegistryEntryFor,
  railRegistryEntryFor,
  rentalRegistryEntry,
  // BRIEF-result-card-step3: the five new soft-tier row builders, wiring pet, goods,
  // medical, the new Airbnb hotel-booking option and the leaving date into the result
  // card for the first time (Step 2b only ever collected these answers).
  petAvoidableCard,
  goodsVatCardFor,
  medicalAvoidableCard,
  airbnbAvoidableCard,
  leavingDateCardFor,
} from '../data/avoidable.js';
import { flightPlaceholderFor } from '../data/flight-defaults.js';
import { countries } from '../data/index.js';
// FIX 1 (BRIEF-input-step2a): node:fs, for the exact same flag-with-fallback pattern every
// other component on this site already duplicates locally (CountryBriefing.astro, Hub.astro,
// countries.astro and others each carry their own copy of this same two-line snippet rather
// than importing a shared helper), so this file matches that convention instead of adding a
// new one.
import fs from 'node:fs';

const { country: c } = Astro.props;
const { calcJson, tipCalc } = calcSetupFor(c);
const styles = (c.cash && c.cash.styles) || [];
const defaultStyleIndex = (c.cash && c.cash.defaultIndex) || 0;

// FIX 1 (BRIEF-input-step2a): the destination's flag, shown on every wizard step so a
// reader who lands mid-flow (the same concern FIX 3 addresses in words) has a constant
// visual anchor too. Same fallback every guide already uses: a missing flag file never
// 404s, it just falls back to the globe.
const flagDir = process.cwd() + '/public/flags/';
const flagSrc = (slug) => fs.existsSync(flagDir + slug + '.svg') ? '/flags/' + slug + '.svg' : '/flags/world.svg';
const destinationFlag = flagSrc(c.slug);

// Flight and hotel starting figures. Flight uses this country's own verified round-trip
// range where one exists; otherwise the SAME rough, region-derived placeholder
// calc-engine.js itself will prefill into the hidden #hnFlight field (flightPlaceholderFor,
// from src/data/flight-defaults.js), so the wizard's displayed "typical" figure can never
// drift from what the engine actually holds if the reader never touches this step.
const flightData = c.flight || null;
const flightRough = flightPlaceholderFor(c);
const flightTypical = flightData
  ? Math.round((flightData.low + flightData.high) / 2 / 10) * 10
  : (flightRough ? flightRough.usd : 700);
const roomTypical = (styles[defaultStyleIndex] && styles[defaultStyleIndex].room) || 150;

// FIX 4 (BRIEF-input-step2a): the airfare placeholder now respects whichever travel style
// the reader already picked, instead of always showing the same flat figure regardless of
// style. Every country carries exactly three styles in fixed order (Budget, Mid-range,
// Comfort; confirmed for all 59 live countries, see the STYLE_HELP comment below), so index
// 0/1/2 map onto them directly, with NO per-style fare invented: where this country has a
// tracked flight.low/flight.high range (a real, sourced pair of figures, not a guess), Budget
// seeds from the low end and Comfort from the high end, exactly the same range the "typical"
// figure already came from; Mid-range keeps today's midpoint unchanged. Where no range is
// tracked (flightRough, a single flat regional placeholder with nothing to spread across
// styles), every style gets the SAME figure, because scaling an unsourced number by style
// would be inventing fare data, which this brief explicitly rules out.
const flightByStyle = styles.map((s, i) => {
  if (!flightData) return flightTypical;
  if (i === 0) return Math.round(flightData.low / 10) * 10;
  if (i === 2) return Math.round(flightData.high / 10) * 10;
  return flightTypical;
});

// PRODUCTION BLOCKER, resolved: the full supported country list. Every entry in
// src/data/index.js with live:true (59 of 59 today; see data/index.js itself), sorted for
// the destination step's radio list, current country pinned so a reader arriving from a
// country guide sees their own destination already selected rather than searching for it.
const liveCountries = countries.filter(x => x.live);
const destinationCountries = [c, ...liveCountries.filter(x => x.slug !== c.slug).sort((a, b) => a.name.localeCompare(b.name))];

// PRODUCTION BLOCKER, resolved: the style enum. Every country carries exactly three styles,
// in this order, under these names: Budget, Mid-range, Comfort (never "Higher comfort", a
// guess in an earlier brief). Help copy is site-wide modeling policy, not a per-country fact,
// so it lives here rather than in calc-engine.js or the country data files.
const STYLE_HELP = {
  Budget: 'Simple meals and lower everyday spending.',
  'Mid-range': 'A comfortable everyday spending allowance.',
  Comfort: 'More room for meals, transport and activities.',
};
const styleOptions = styles.map((s, i) => ({
  value: String(i),
  label: s.n,
  help: STYLE_HELP[s.n] || '',
  selected: i === defaultStyleIndex,
}));

// FIX 2 (BRIEF-input-step2a): one quiet icon per question, drawn to the exact construction
// rules Symbol.astro already uses site-wide (flat shapes, no strokes where a filled shape
// reads fine that small, one amber accent, this same five-color palette: #0E7A5F/#16302C/
// #B45309/#F5F4EF/#6F8079). Seven of these ten are the SAME icon Symbol.astro already draws
// elsewhere on the site (passport, plane, calendar, card, phoneok, train, wheel); they are
// copied here as plain SVG strings rather than imported, because Symbol.astro keeps its own
// icon map private to that component, and re-exporting it is outside this step's file scope
// (CalcWizard.astro and QuestionPanel.astro only). Three (people, suitcase, bed) are new,
// since nothing in the existing set covers travelers, travel style or a room price. Flagged
// to MAIN: if the pattern holds up, promoting all ten into Symbol.astro itself so every
// consumer shares one copy is a natural follow-up, just outside what this step touches.
const QUESTION_ICON = {
  destination: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="11" y="6" width="26" height="36" rx="4" fill="#16302C"/><rect x="11" y="6" width="4.5" height="36" rx="2" fill="#0A5644"/><circle cx="25.5" cy="20" r="6.5" fill="none" stroke="#0E7A5F" stroke-width="2.2"/><circle cx="25.5" cy="20" r="2.4" fill="#B45309"/><rect x="18" y="31" width="15" height="2.6" rx="1.3" fill="#6F8079"/><rect x="20" y="36" width="11" height="2.6" rx="1.3" fill="#6F8079"/></svg>',
  travelers: '<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="32" cy="17" r="6" fill="#6F8079"/><path d="M22 41 a10 10 0 0 1 19 -3 Z" fill="#6F8079"/><circle cx="17" cy="15" r="7" fill="#0E7A5F"/><path d="M5 40 a12 12 0 0 1 24 0 Z" fill="#0E7A5F"/></svg>',
  nights: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="12" width="32" height="28" rx="5" fill="#0E7A5F"/><path d="M8 17 a5 5 0 0 1 5 -5 h22 a5 5 0 0 1 5 5 v2 h-34 Z" fill="#16302C"/><rect x="15.5" y="8" width="3.5" height="8" rx="1.75" fill="#16302C"/><rect x="29" y="8" width="3.5" height="8" rx="1.75" fill="#16302C"/><circle cx="24" cy="30" r="4.5" fill="#B45309"/></svg>',
  style: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="17" y="8" width="14" height="10" rx="3" fill="none" stroke="#16302C" stroke-width="3.4"/><rect x="6" y="16" width="36" height="24" rx="4" fill="#0E7A5F"/><rect x="6" y="24" width="36" height="4" fill="#16302C"/><rect x="21" y="16" width="6" height="24" fill="#B45309"/></svg>',
  flights: '<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 a3 3 0 0 1 3 3 V19 L43 28 V32 L27 27 V37 L32 41 V44 L24 41.5 L16 44 V41 L21 37 V27 L5 32 V28 L21 19 V7 a3 3 0 0 1 3 -3 Z" fill="#0E7A5F"/></svg>',
  hotel: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="17" width="4" height="23" rx="2" fill="#16302C"/><rect x="6" y="27" width="38" height="13" rx="3" fill="#0E7A5F"/><rect x="9" y="20" width="15" height="10" rx="3" fill="#F5F4EF"/><rect x="6" y="35" width="4" height="7" fill="#16302C"/><rect x="40" y="35" width="4" height="7" fill="#16302C"/></svg>',
  card: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="4" y="12" width="40" height="27" rx="5" fill="#16302C"/><rect x="4" y="18" width="40" height="6" fill="#0E7A5F"/><rect x="10" y="30" width="14" height="4" rx="2" fill="#F5F4EF"/><rect x="29" y="30" width="9" height="4" rx="2" fill="#6F8079"/></svg>',
  carrier: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="15" width="3" height="4" rx="1" fill="#129072"/><rect x="10.5" y="12" width="3" height="7" rx="1" fill="#129072"/><rect x="15" y="6" width="20" height="36" rx="5" fill="#16302C"/><rect x="19" y="11" width="12" height="18" rx="2" fill="#0E7A5F"/><path d="M21 20.2 l2.6 2.6 l4.6 -5.4" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="25" cy="35.5" r="2" fill="#F5F4EF"/></svg>',
  rail: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="12" y="5" width="24" height="30" rx="8" fill="#0E7A5F"/><rect x="16.5" y="11" width="15" height="9" rx="3" fill="#F5F4EF"/><rect x="16" y="24.5" width="6" height="3" rx="1.5" fill="#F5F4EF"/><rect x="26" y="24.5" width="6" height="3" rx="1.5" fill="#F5F4EF"/><circle cx="24" cy="30" r="2.3" fill="#B45309"/><rect x="14" y="34" width="3" height="5" rx="1.5" fill="#6F8079"/><rect x="31" y="34" width="3" height="5" rx="1.5" fill="#6F8079"/><rect x="8" y="39" width="32" height="3.2" rx="1.6" fill="#16302C"/></svg>',
  rental: '<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="17" fill="none" stroke="#0E7A5F" stroke-width="4"/><line x1="10" y1="24" x2="38" y2="24" stroke="#0E7A5F" stroke-width="3.5" stroke-linecap="round"/><line x1="24" y1="24" x2="24" y2="40" stroke="#0E7A5F" stroke-width="3.5" stroke-linecap="round"/><circle cx="24" cy="24" r="5" fill="#16302C"/></svg>',
  // BRIEF-input-step2b: four more, same reuse-first approach. 'paw' and 'health' are the
  // SAME icons Symbol.astro already draws elsewhere; 'goods' reuses 'tag' (already in this
  // map's own fallback role for row icons, and a plain price tag fits "goods to declare"
  // reasonably); 'date' reuses 'calendar', already in this map for the nights question,
  // since a calendar fits a leaving date at least as well as a trip length.
  pet: '<svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="24" cy="32" rx="10" ry="8" fill="#0E7A5F"/><circle cx="12.5" cy="20" r="4.2" fill="#129072"/><circle cx="35.5" cy="20" r="4.2" fill="#129072"/><circle cx="19.5" cy="13.5" r="4.2" fill="#129072"/><circle cx="28.5" cy="13.5" r="4.2" fill="#129072"/></svg>',
  goods: '<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M22 7 Q24 3 27 7" fill="none" stroke="#0E7A5F" stroke-width="2.4" stroke-linecap="round"/><path d="M21 9 H38 a4 4 0 0 1 4 4 V33 a4 4 0 0 1 -4 4 H21 L7 23 Z" fill="#0E7A5F"/><circle cx="16" cy="23" r="3" fill="#F5F4EF"/></svg>',
  medical: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="8" width="32" height="32" rx="9" fill="#0E7A5F"/><rect x="21.25" y="15" width="5.5" height="18" rx="2.75" fill="#F5F4EF"/><rect x="15" y="21.25" width="18" height="5.5" rx="2.75" fill="#F5F4EF"/></svg>',
  date: '<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="12" width="32" height="28" rx="5" fill="#0E7A5F"/><path d="M8 17 a5 5 0 0 1 5 -5 h22 a5 5 0 0 1 5 5 v2 h-34 Z" fill="#16302C"/><rect x="15.5" y="8" width="3.5" height="8" rx="1.75" fill="#16302C"/><rect x="29" y="8" width="3.5" height="8" rx="1.75" fill="#16302C"/><circle cx="24" cy="30" r="4.5" fill="#B45309"/></svg>',
};

// FIX 3 (BRIEF-input-step2a): "the wizard already has the country name... include it in the
// question wording where natural... do not force it where it reads awkwardly." Destination
// is the one step left untouched: naming the country before the reader has chosen it reads
// backwards, and DestinationChoice's own list already shows a flag beside every option.
const Q_TRAVELERS = 'How many people are traveling to ' + c.name + '?';
const Q_NIGHTS = 'How many nights are you staying in ' + c.name + '?';
const Q_STYLE = 'How do you expect to travel in ' + c.name + '?';
const Q_FLIGHTS = 'What is your round-trip airfare to ' + c.name + '?';
const Q_HOTEL = 'How did you book your hotel in ' + c.name + '?';
const Q_CARD = 'Does your card charge a purchase fee in ' + c.name + '?';
// BRIEF-input-step2b: same treatment as rail/rental in FIX 3 above, since these four read
// just as naturally with the country woven in.
const Q_PET = 'Are you traveling with a pet on this ' + c.name + ' trip?';
const Q_GOODS = 'Planning to buy goods in ' + c.name + ' to bring home?';
const Q_MEDICAL = 'Do you have a health condition that needs attention while traveling to ' + c.name + '?';
const Q_DATE = 'When are you planning to travel to ' + c.name + '?';
// The three wizard-gated questions' base wording lives in avoidable.js (a data file this
// step must not touch), so the country name is woven in here instead, at the point this
// file already renders each one, never editing that source string itself.
const WIZARD_GATED_TITLE = {
  carrier: (name) => 'Which US carrier are you using on this ' + name + ' trip?',
  rail: (name) => 'Are you planning intercity train travel on this ' + name + ' trip?',
  rental: (name) => 'Are you renting a car on this ' + name + ' trip?',
};

// BRIEF-input-step2b: five new questions, collection only (state + Edit trip; nothing
// renders on the result card yet, see the questionItems/wizardGatedExtras comment below
// for the exact boundary that keeps it that way). avoidable.js is deliberately NOT touched
// for any of these: pet, goods, a health condition, a hotel booking channel and a leaving
// date are trip CONTEXT, not avoidable COSTS, so they do not belong in a registry whose own
// header defines its scope as "costs a traveler can refuse to pay"; the brief's own
// carve-out only asks for a registry entry where that is the cleanest path, and it is not
// here. Pet and medical reuse the exact registry-question SHAPE (and, in calc-wizard.js,
// the exact generic wiring/validation/snapshot/summary machinery) carrier/rail/rental
// already established: a single yes/no radio group. Goods (an amount) and date (a date
// input) do not fit that shape and are hand-authored as their own QuestionPanel blocks
// below instead; they still carry an editTitle/summaryLabel here so Edit-trip treats them
// consistently, and calc-wizard.js gives each its own small, explicit branch layered on
// top of the same STEP_ORDER machinery rather than replacing it.
const petEntry = {
  key: 'pet',
  question: {
    stepKey: 'pet', stepLabel: 'Pet',
    panelTitle: 'Are you traveling with a pet?',
    panelIntro: 'This decides whether pet travel guidance applies to this trip.',
    legend: 'Traveling with a pet',
    options: [
      { value: 'no', label: 'No', help: '', selected: true },
      { value: 'yes', label: 'Yes', help: '', selected: false },
    ],
    moreOptions: null, moreLabel: null, moreLegend: null,
    fieldHelp: 'Change this anytime from Edit trip.',
    editTitle: 'Change your pet answer',
    summaryLabel: 'Traveling with a pet',
  },
};
const medicalEntry = {
  key: 'medical',
  question: {
    stepKey: 'medical', stepLabel: 'Health',
    panelTitle: 'Do you have a health condition that needs attention while traveling?',
    // Calm, practical wording throughout, per the brief: this names a planning fact, not
    // a diagnosis, and never reads as alarming.
    panelIntro: 'This helps shape practical guidance on medical costs and coverage abroad. Not medical advice.',
    legend: 'A health condition needing attention while traveling',
    options: [
      { value: 'no', label: 'No', help: '', selected: true },
      { value: 'yes', label: 'Yes', help: '', selected: false },
    ],
    moreOptions: null, moreLabel: null, moreLegend: null,
    fieldHelp: 'Change this anytime from Edit trip.',
    editTitle: 'Change your health answer',
    summaryLabel: 'Health condition needing attention',
  },
};
// Meta-only entries for the two hand-authored questions (see above): just enough for
// wizData's questionMeta/questionDefaults, since their actual controls are not the generic
// ChoiceRows shape and are rendered separately, below.
const NEW_QUESTION_META = {
  goods: { editTitle: 'Change your goods answer' },
  date: { editTitle: 'Change your travel date' },
};
const NEW_QUESTION_DEFAULTS = { goods: 'no', date: '' };

// FIX 6 (BRIEF-input-step2b): the named carriers must appear ABOVE "Other or not sure",
// not just in the primary list (they already are: avoidable.js's own primaryOptions array
// already lists them before 'other') but above the ENTIRE list including the collapsed
// "More carriers" disclosure, which today renders AFTER 'other' and so reads as an
// afterthought below the already-highlighted default. This never edits avoidable.js's own
// option array (a data file this step must not touch beyond adding new entries); it only
// changes how CalcWizard.astro lays out the SAME options it already received: the primary
// carriers first, then "More carriers", then "Other or not sure" on its own, last, as the
// genuine fallback it is. Every radio still shares one name, so the native exclusive-choice
// behavior is unaffected regardless of DOM position.
function splitCarrierOptions(options) {
  return {
    named: options.filter(o => o.value !== 'other'),
    other: options.find(o => o.value === 'other') || null,
  };
}

const flightModeOptions = [
  { value: 'known', label: 'I have a price', help: 'Round-trip airfare, per person.', selected: true },
  { value: 'exclude', label: 'Leave flights out for now', help: 'The result will clearly say they are not included.', selected: false },
];
const cardOptions = [
  { value: 'no-fee', label: 'No foreign-transaction fee', help: 'My card does not charge this fee on purchases.', selected: false },
  { value: 'assumed', label: 'Use the typical fee assumption', help: 'My card charges a fee, or I have not checked.', selected: true },
];
// NEW QUESTION 1 (BRIEF-input-step2b): the hotel step's own new booking-method question,
// augmenting rather than replacing the existing room-price step (same stepKey 'hotel', same
// form). "Online" is the default, since it is the most common real-world case and matches
// how "known" already defaults for the flights step above; the room price question still
// follows, exactly as before, for either real hotel answer. "Skip" is a genuine third
// answer AND has its own convenience skip button, the same redundant-but-convenient shape
// flights already uses for "exclude".
// BRIEF-result-card-step3: a third real booking channel, alongside online/direct, ahead
// of the "skip" escape hatch that stays last either way. Selecting it does not change the
// room-price question that follows (an Airbnb night still has a nightly rate to enter);
// it only reveals the Airbnb result-card row below, keyed on this same answer.
const hotelBookingOptions = [
  { value: 'online', label: 'Through an online booking site', help: '', selected: true },
  { value: 'direct', label: 'Directly with the hotel', help: '', selected: false },
  { value: 'airbnb', label: 'Airbnb or a short-term rental', help: '', selected: false },
  { value: 'skip', label: "Skip, I'm not staying in paid lodging", help: '', selected: false },
];

// BRIEF-calc-result-registry-rebuild, PART 2 "generic engine": the three wizard-gated
// items, ONE array, in registry order (carrier, then rail if this country has a verdict,
// then rental), instead of three separately hand-tracked booleans/arrays. Everything
// downstream, the step count, the step order, the QuestionPanel loop and the edit-dialog
// titles, all key off this ONE array so they can never disagree with each other. Adding a
// fourth wizard-gated item (see avoidable.js's airRegistryEntryExample) means pushing one
// more entry here; nothing else on this page would need to change.
const carrierEntry = carrierRegistryEntryFor(c);
const railEntry = railRegistryEntryFor(c);
const rentalEntry = rentalRegistryEntry();
// Rail is genuinely absent (not merely hidden) on a country rail-passes.js has no verdict
// for, so it is simply missing from this array there, the same clean "never asked" outcome
// the old hasRail gate produced. Carrier and rental are unconditional.
const questionItems = [carrierEntry, railEntry, rentalEntry].filter(Boolean);
// Wizard-gated items whose RESULT card stays outside the hard/soft pool (see avoidable.js's
// registry header for why): rail and rental share one dedicated card shape and one render
// loop below; carrier keeps its own, richer block (a dynamic day-pass figure, an eSIM link,
// a Mexico/Canada special case) unchanged in substance from before this refactor.
const wizardGatedExtras = [railEntry, rentalEntry].filter(Boolean);
// Every QuestionPanel on this page is given this explicitly, rather than relying on the
// component's own default, because that default is shared with the standalone /calculator
// landing page and cannot itself vary per country the way this page's real step count does.
// BRIEF-input-step2b: +4 for pet, goods, medical and date, unconditional on every country
// page (unlike rail, none of the four are gated on anything country-specific), so the
// count grows by exactly 4 everywhere, keeping WizardProgress's "Step X of Y" honest.
const NEW_STEP_COUNT = 4;
const totalSteps = 7 + questionItems.length + NEW_STEP_COUNT;

// PRODUCTION BLOCKER, resolved: material unpriced categories (spec section 7). Travel
// insurance is a named tier on every country (never priced, by design: a premium depends on
// age, cover and trip length, none of which this calculator asks); a real unpriced entry
// cost is engine-supplied for the few countries that carry one. Airfare is deliberately NOT
// in this list: it gets its own first-class, mandatory strip when excluded (spec section 7),
// not a line buried in a generic list.
const L = calcLinesFor(c);
const materialExclusions = [
  'Travel insurance',
  ...((L.entryUnpriced || []).map(e => e.label)),
];

// BRIEF-calc-result-registry-rebuild, PART 1: the HARD/SOFT tier pool, read once from the
// registry (avoidableRegistryFor(c) wraps avoidableFor(c) byte-for-byte; see that
// function's own header in avoidable.js). Tiering itself is unchanged from before this
// refactor: HARD = a real figure exists, SOFT = it genuinely does not.
const avoidablePool = avoidableRegistryFor(c);
const hardItems = avoidablePool.filter(a => a.tier === 'hard');
const softItems = avoidablePool.filter(a => a.tier === 'soft');
// PRODUCTION BLOCKER, resolved (flag carried forward from Cluster A): the calm outcome's
// real trigger is still "this country's only HARD item is the card/ATM fee line itself",
// so a no-foreign-fee card genuinely leaves nothing with a real dollar figure attached.
// Unaffected by the registry rebuild: carrier/rail/rental never contribute to this count,
// deliberately (see avoidable.js's registry header on why they stay outside this split).
const otherHardCount = hardItems.filter(a => a.figureKind !== 'liveFees').length;
const calmEligible = otherHardCount === 0;

// BRIEF-result-card-step1: one icon per row, keyed by the item's own registry `key` (the
// same key avoidableRegistryFor(c)/carrierRegistryEntryFor/railRegistryEntryFor/
// rentalRegistryEntry already carry, never a new field added to avoidable.js). Purely
// presentational and local to this file; a pool item added later with a key not listed
// here still renders, just with the 'tag' fallback, rather than breaking the build.
const ROW_ICON = {
  dcc: 'card', fees: 'atm', exchange: 'cash', vat: 'refund', form: 'passport',
  reseller: 'receipt', dead: 'tag', doubletip: 'tip', exemption: 'cash',
  carrier: 'phoneok', rail: 'train', rental: 'wheel',
  // BRIEF-result-card-step3: five more, same reuse-first rule as every icon above. No new
  // icon is drawn for any of these; Symbol.astro already has one that fits each topic.
  // 'goods' reuses 'tag' (a price tag, already this map's own fallback role); 'airbnb'
  // reuses 'receipt' (the same itemized-bill shape the reseller markup row already uses,
  // which fits "the nightly rate isn't the bill" well).
  pet: 'paw', goods: 'tag', medical: 'health', airbnb: 'receipt', date: 'calendar',
};
// The fallback matters in practice: avoidable.js also carries dozens of uniquely-keyed
// named scam/tactic items (e.g. "gem-tour-scam", "closed-hotel-detour"), one set per
// country, which is too many distinct keys to enumerate above by hand. Every OTHER real
// key in the pool is already listed explicitly, so this fallback is reached only by that
// scam/tactic set today, and 'alert' (an existing warning-triangle icon) fits what they
// actually are far better than a generic price tag.
const iconFor = (key) => ROW_ICON[key] || 'alert';

// BRIEF-result-card-step3: THE TWO-MARK SYSTEM. Every soft (figureless) row now carries
// one of two small marks, because "worth knowing, no set price" was quietly doing two
// different jobs: a scam or an on-the-spot tactic to REFUSE (the burnt-orange hand-coin
// mark), and a real thing to PREPARE for ahead of time (the brand-green shield-$ mark).
// Existing soft rows (the static per-country list, carrier while it has no live figure,
// rail, rental) all get the hand mark: every one of them is a "decline this" moment, not
// a "get ready for this" one. The five new rows this step adds are the first "prepare
// ahead" items on this card, so they get the shield. Drawn here as raw SVG (the same
// set:html pattern QUESTION_ICON above already uses) rather than added to Symbol.astro,
// which this step's brief does not touch.
//
// BRIEF-vectorize-mark-icons: both are traced from Gary's own bespoke artwork
// (prepare-shield-dollar.png, refuse-hand-coin.png), not a generic icon-set substitute.
// Traced with OpenCV contour extraction against the source PNGs rather than eyeballed, so
// the proportions are the real drawing's, then rasterized and visually checked at the
// actual row (18px) and legend (16px) sizes before this file was edited. Two hairline
// details from the source were deliberately dropped because they would not survive at
// 18px (confirmed by that same rasterized check), per that brief's own explicit rule that
// a simplified icon legible small beats a faithful one that muddies: the dollar sign's two
// tiny enclosed loops (kept as one solid glyph instead), and the coin's inner shading arc
// and the small motion-arc beside it (kept as a plain tilted ellipse, still clearly "a
// coin", without the hairline swoosh that would just be noise at this size).
//
// SHIELD: traced as ONE evenodd-fill path with three subpaths (the shield's own outer
// edge, its inner edge, and the dollar sign), so currentColor fills the ring and the
// glyph in a single declaration with no separate stroke to keep in sync. Color is now the
// brand green (#16302C, the same dark green calculator.css's own brandbar already uses)
// via .ttc-card-row-mark-shield below, repointed off --amber per this brief.
//
// HAND: traced as one continuous outline path (fill:none, stroke:currentColor) plus a
// tilted ellipse for the coin, matching the shield's stroke weight so the two read as one
// family. Still --amber-dark (burnt orange), unchanged.
const MARK_SHIELD = '<svg viewBox="0 0 24 27.48" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M11.69 0.0 L7.04 2.19 L1.56 3.52 L0.51 4.22 L0.0 5.36 L0.0 13.99 L1.09 18.21 L3.99 22.4 L8.09 25.68 L11.06 27.32 L12.43 27.48 L15.64 25.88 L18.76 23.57 L20.79 21.5 L22.51 18.96 L23.92 14.5 L24.0 5.79 L23.61 4.42 L22.67 3.6 L18.41 2.7 L12.86 0.16 Z M11.88 1.52 L17.08 3.87 L21.93 4.96 L22.48 5.63 L22.44 14.31 L21.15 18.25 L17.55 22.55 L12.23 25.95 L8.05 23.8 L4.46 20.6 L2.27 17.08 L1.49 13.56 L1.6 5.32 L7.19 3.79 Z M11.88 6.25 L11.37 6.72 L11.34 7.54 L10.08 7.97 L9.22 8.72 L8.64 10.24 L8.72 11.3 L9.3 12.43 L10.08 13.09 L11.37 13.64 L11.37 17.24 L10.51 16.89 L9.38 15.52 L8.72 15.64 L8.44 16.46 L9.11 17.67 L9.93 18.37 L11.34 18.84 L11.45 19.9 L12.12 20.17 L12.59 19.82 L12.66 18.84 L13.92 18.45 L14.93 17.55 L15.4 16.61 L15.52 15.36 L14.85 13.72 L13.92 12.98 L12.63 12.43 L12.63 9.15 L13.33 9.46 L13.99 10.51 L14.38 10.75 L15.13 10.51 L15.24 9.58 L14.15 8.13 L12.66 7.54 L12.55 6.53 Z"/></svg>';
const MARK_STOP = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M8.1 2.5 H15.9 L21.5 8.1 V15.9 L15.9 21.5 H8.1 L2.5 15.9 V8.1 Z"/><line x1="7.5" y1="12" x2="16.5" y2="12" stroke-linecap="round"/></svg>';



// BRIEF-result-card-step3: the five new cards themselves, one call each into avoidable.js.
// pet/medical/airbnb are fully known at build time; goods/date carry a template or a raw
// fact for calc-wizard.js to finish client-side (see avoidable.js's own header on this
// split). seasonCheapest is calc-lines.js's own already-computed L.season.cheapest (this
// file already reads L for materialExclusions above), read here for a second, unrelated
// purpose rather than recomputed: calc-lines.js itself stays byte-identical.
const petCard = petAvoidableCard(c);
const goodsVatCard = goodsVatCardFor(c);
const medicalCard = medicalAvoidableCard(c);
const airbnbCard = airbnbAvoidableCard();
const dateCard = leavingDateCardFor(c, L.season ? L.season.cheapest : null);

// BRIEF-result-card-step1, the card's "checked {Month Year}" stamp. A later step wires
// this to a real per-country checked date; for now it is a static build-time stamp (this
// site is fully static, so every build already regenerates it fresh), rendered only so
// the slot exists on the approved mock, per the brief.
const checkedStamp = new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const wizData = {
  countryName: c.name,
  countrySlug: c.slug,
  styles: styles.map((s, i) => ({ i, n: s.n, room: s.room })),
  defaultStyleIndex,
  flightTypical,
  flightVerified: !!flightData,
  // FIX 4 (BRIEF-input-step2a): the same style-seeded figures computed above, passed
  // through so calc-wizard.js's resyncBeforeShow('flights') can reseed the airfare price
  // whenever the reader changes style before typing their own fare, exactly the way
  // roomTypical/applyStyleRoom already does for the hotel step.
  flightByStyle,
  roomTypical,
  calmEligible,
  carriers: carrierEntry.clientData,
  carrierFallbackText: carrierEntry.fallback ? carrierEntry.fallback.detail : '',
  // BRIEF-calc-result-registry-rebuild: replaces the old single hasRailVerdict flag. The
  // client's STEP_ORDER is now FIXED_STEPS.concat(WD.questionSteps), so adding a fourth
  // wizard-gated item needs no change in calc-wizard.js at all; questionMeta/questionDefaults
  // carry the small per-item facts (the edit-dialog title, the default answer) that used to
  // be hardcoded per key in that file.
  // BRIEF-input-step2b: questionSteps grows by four (pet, goods, medical, date, in the
  // order the brief's own RULES section asks for), appended after the existing avoidable.js
  // -driven trio so carrier/rail/rental's own order and behavior are completely unaffected.
  // questionMeta/questionDefaults are merged the same way: the existing registry items'
  // own entries, plus pet/medical's (built the exact same way, from THEIR options array)
  // and goods/date's (hand-built above, since neither has an options array of its own).
  questionSteps: [...questionItems.map(q => q.question.stepKey), petEntry.question.stepKey, 'goods', medicalEntry.question.stepKey, 'date'],
  questionMeta: {
    ...Object.fromEntries(questionItems.concat([petEntry, medicalEntry]).map(q => [q.question.stepKey, { editTitle: q.question.editTitle }])),
    ...NEW_QUESTION_META,
  },
  questionDefaults: {
    ...Object.fromEntries(questionItems.concat([petEntry, medicalEntry]).map(q => {
      const opts = q.question.options.concat(q.question.moreOptions || []);
      const def = opts.find(o => o.selected) || opts[0];
      return [q.question.stepKey, def ? def.value : ''];
    })),
    ...NEW_QUESTION_DEFAULTS,
  },
  // NEW QUESTION 1 (BRIEF-input-step2b): the hotel step's own new booking-method default,
  // read by calc-wizard.js the same way flightMode's own default already is (a plain
  // top-level wizData field, not part of the generic questionDefaults map, since this
  // question augments an existing FIXED step rather than adding a new one).
  hotelBookingDefault: hotelBookingOptions.find(o => o.selected).value,
  // BRIEF-result-card-step3: goods and date are the two new rows whose real text depends
  // on what the reader typed, so only the build-time-known half of each travels here
  // (a template with a {{AMOUNT}} token, or this country's own season fact); calc-wizard.js's
  // renderGoodsItem()/renderDateItem() finish the sentence client-side. Nothing else in
  // either object is guessed or recomputed; see avoidable.js's own header on this split.
  goodsVat: { status: goodsVatCard.status, template: goodsVatCard.template, escape: goodsVatCard.escape, secondary: goodsVatCard.secondary, href: goodsVatCard.href, hrefLabel: goodsVatCard.hrefLabel },
  leavingDate: { seasonCheapest: dateCard.seasonCheapest, href: dateCard.href, hrefLabel: dateCard.hrefLabel },
};
const wizJson = JSON.stringify(wizData).replace(/</g, '\\u003c');
---
<!-- ================= THE NEW SURFACE ================= -->

<QuestionPanel stepKey="destination" stepNumber={1} totalSteps={totalSteps} stepLabel="Destination"
  title="Where are you going?" intro="Choose one country for this trip estimate." isFirst showFootnote
  icon={QUESTION_ICON.destination} flagSrc={destinationFlag}>
  <DestinationChoice countries={destinationCountries} selectedSlug={c.slug} />
</QuestionPanel>

<QuestionPanel stepKey="travelers" stepNumber={2} totalSteps={totalSteps} stepLabel="Travelers" initiallyVisible
  title={Q_TRAVELERS} intro="Count everyone in your travel party."
  icon={QUESTION_ICON.travelers} flagSrc={destinationFlag}>
  <QuantityControl name="travelers" unitLabel="travelers" unitLabelSingular="traveler" value={2} min={1} max={12} presets={[1, 2, 3, 4]} helpText="This is people, not rooms." />
</QuestionPanel>

<QuestionPanel stepKey="nights" stepNumber={3} totalSteps={totalSteps} stepLabel="Trip length"
  title={Q_NIGHTS} intro="Count nights away, not calendar days."
  icon={QUESTION_ICON.nights} flagSrc={destinationFlag}>
  <QuantityControl name="nights" unitLabel="nights" unitLabelSingular="night" value={7} min={1} max={60} presets={[5, 7, 14, 21]} />
</QuestionPanel>

<QuestionPanel stepKey="style" stepNumber={4} totalSteps={totalSteps} stepLabel="Travel style"
  title={Q_STYLE} intro={'Start with the closest fit. It sets a typical daily-spending figure and hotel price for ' + c.name + '.'}
  icon={QUESTION_ICON.style} flagSrc={destinationFlag}>
  <ChoiceRows name="style" legend="Travel style" options={styleOptions} />
</QuestionPanel>

<QuestionPanel stepKey="flights" stepNumber={5} totalSteps={totalSteps} stepLabel="Airfare" showFootnote
  title={Q_FLIGHTS} intro="Use the price per person, in US dollars." skipLabel="Leave flights out"
  icon={QUESTION_ICON.flights} flagSrc={destinationFlag}>
  <ChoiceRows name="flight-mode" legend="Airfare information" options={flightModeOptions} />
  <div class="conditional-field" data-flight-price-wrap>
    {/* FIX 4 (BRIEF-input-step2a): the value now seeds from the style already chosen
        (flightByStyle[defaultStyleIndex], built above; calc-wizard.js's own
        resyncBeforeShow('flights') keeps it in step with a later style change, the same
        way the hotel step's roomTypical/applyStyleRoom already works). The help text no
        longer says "economy": that word is exactly what contradicted a Comfort traveler's
        own answer, which is the bug this fix exists to close. */}
    <PriceControl name="flight" label="Round-trip price per person (USD)" value={flightByStyle[defaultStyleIndex]}
      helpText={flightData
        ? ('A typical round trip from major US gateways for your chosen travel style, checked ' + (flightData.checked || '') + '. Enter what you actually paid and it takes over.')
        : ('We do not yet track a verified fare for ' + c.name + '. This is a rough, region-based placeholder, not a quote: change it to your own fare.')} />
  </div>
</QuestionPanel>

<QuestionPanel stepKey="hotel" stepNumber={6} totalSteps={totalSteps} stepLabel="Accommodation" showFootnote
  title={Q_HOTEL} intro="This decides whether book-direct-versus-booking-site guidance applies to your stay." skipLabel="Skip, I'm not staying in paid lodging"
  icon={QUESTION_ICON.hotel} flagSrc={destinationFlag}>
  {/* NEW QUESTION 1 (BRIEF-input-step2b): the new, primary question this step asks. The
      room-price question that used to lead here still follows, unchanged in substance,
      for either real hotel answer; it is simply not asked at all when the reader picks
      "skip" (RULES: "the room price is simply not asked"). The hidden engine still holds
      SOME number in #hnRoom either way (it has no concept of "not staying at a hotel" and
      this step does not touch it), so the total is not itself adjusted here; that is a
      later step's concern, not this one's, which is collection only. */}
  <ChoiceRows name="hotel-booking" legend="How you booked your hotel" options={hotelBookingOptions} />
  <div class="conditional-field" data-hotel-price-wrap>
    <PriceControl name="hotel" label="Room price per night (USD)" value={roomTypical} helpText="This estimate uses one room throughout the stay for one or two travelers." />
    {/* BRIEF-rooms-autosuggest: shown only for 3+ travelers, toggled by calc-wizard.js's
        applyRoomsVisibility the same way data-hotel-price-wrap itself already toggles on
        the hotel-booking answer above. Pre-filled with Math.ceil(travelers / 2), fully
        overwritable: the traveler's own typed count wins from then on, the same pattern
        the room price and flight fields above already use. Nested inside
        data-hotel-price-wrap so it also hides automatically whenever the reader is not
        staying in paid lodging at all. */}
    <div class="conditional-field" data-rooms-wrap hidden>
      <label class="field-label" for="q-rooms">Rooms for your party</label>
      <div class="count-input">
        <input id="q-rooms" name="rooms" type="text" inputmode="numeric" autocomplete="off" value="1" aria-describedby="q-rooms-help" data-rooms-input />
      </div>
      <p class="field-help" id="q-rooms-help" data-rooms-note>&nbsp;</p>
    </div>
    <div class="assumption-note" data-room-price-note><strong>This is the nightly price for your room, taken as entered.</strong><br />We assume a single room for one or two travelers. If you need more than one, enter the combined nightly price.</div>
  </div>
</QuestionPanel>

<QuestionPanel stepKey="card" stepNumber={7} totalSteps={totalSteps} stepLabel="Payment fees" showFootnote
  title={Q_CARD} intro="Check for a foreign-transaction fee on purchases."
  icon={QUESTION_ICON.card} flagSrc={destinationFlag}>
  <ChoiceRows name="card" legend="Foreign-transaction fee on purchases" options={cardOptions} />
  <p class="field-help">No bank login or card details are collected here.</p>
</QuestionPanel>

<!-- ===== BRIEF-calc-result-registry-rebuild: ONE loop generates every wizard-gated
     item's QuestionPanel, in registry order (carrier, then rail where this country has a
     verdict, then rental). A country with no rail verdict simply has no 'rail' entry in
     questionItems, so it never renders this question at all, the same clean outcome the
     old hasRail-gated block produced by hand. Adding a fourth item (see avoidable.js's
     airRegistryEntryExample) needs no new block here: it would just be one more entry in
     questionItems, rendered by this same loop. ===== -->
{questionItems.map((item, i) => {
  // FIX 6 (BRIEF-input-step2b): for carrier only, split the SAME options array
  // carrierRegistryEntryFor(c) already returns (unchanged, avoidable.js untouched) into the
  // named carriers and the lone 'other' fallback, so 'other' can render AFTER the "More
  // carriers" disclosure instead of before it. Every other item (rail, rental) has no
  // 'other' entry at all, so this is a no-op for them: `other` is null and `named` is just
  // their own options array, unchanged.
  const { named, other } = item.key === 'carrier' ? splitCarrierOptions(item.question.options) : { named: item.question.options, other: null };
  return (
    <QuestionPanel stepKey={item.question.stepKey} stepNumber={8 + i} totalSteps={totalSteps}
      stepLabel={item.question.stepLabel} isLast={false}
      title={(WIZARD_GATED_TITLE[item.key] && WIZARD_GATED_TITLE[item.key](c.name)) || item.question.panelTitle}
      intro={item.question.panelIntro}
      icon={QUESTION_ICON[item.key]} flagSrc={destinationFlag}>
      <ChoiceRows name={item.question.stepKey} legend={item.question.legend} options={named} />
      {item.question.moreOptions && item.question.moreOptions.length > 0 && (
        <details class="carrier-more" data-more-options={item.question.stepKey}>
          <summary>{item.question.moreLabel}</summary>
          <ChoiceRows name={item.question.stepKey} legend={item.question.moreLegend} options={item.question.moreOptions} />
        </details>
      )}
      {other && (
        <ChoiceRows name={item.question.stepKey} legend={item.question.legend} options={[other]} />
      )}
      <p class="field-help">{item.question.fieldHelp}</p>
    </QuestionPanel>
  );
})}

<!-- ===== BRIEF-input-step2b: pet, goods, medical grouped together as "before you go"
     style questions (RULES section), right after the existing wizard-gated trio so
     carrier/rail/rental's own position and behavior are unaffected; date follows last.
     Pet and medical are ChoiceRows-only, same shape as rail/rental, hand-authored here
     rather than folded into the questionItems loop above only because they would need to
     render BETWEEN goods (an amount input, not a fit for that loop's ChoiceRows-only
     shape) and each other in a specific order the array-map loop cannot interleave; their
     wiring in calc-wizard.js is still the fully generic WD.questionSteps mechanism, same
     as if they had come through that loop. ===== -->
<QuestionPanel stepKey="pet" stepNumber={8 + questionItems.length} totalSteps={totalSteps} stepLabel="Pet"
  title={Q_PET} intro={petEntry.question.panelIntro}
  icon={QUESTION_ICON.pet} flagSrc={destinationFlag}>
  <ChoiceRows name="pet" legend={petEntry.question.legend} options={petEntry.question.options} />
  <p class="field-help">{petEntry.question.fieldHelp}</p>
</QuestionPanel>

<!-- NEW QUESTION 3 (BRIEF-input-step2b): a skippable amount, defaulting to skipped (RULES:
     "Light copy, most people skip"). Same shape as the flights step above: a mode radio
     (here 'goods', matching its own stepKey so the generic wiring loop in calc-wizard.js
     picks it up for free) plus a conditional amount field, shown only for 'yes'. No skip
     button needed: the default IS the skip, and pressing Continue on it is already the one
     tap the RULES section asks for. -->
<QuestionPanel stepKey="goods" stepNumber={9 + questionItems.length} totalSteps={totalSteps} stepLabel="Goods"
  title={Q_GOODS} intro="Most people skip this. It only helps if you plan to declare or budget for it.">
  <ChoiceRows name="goods" legend="Buying goods to bring home" options={[
    { value: 'no', label: 'No, skip this', help: '', selected: true },
    { value: 'yes', label: 'Yes, roughly', help: '', selected: false },
  ]} />
  <div class="conditional-field" data-goods-amount-wrap hidden>
    <PriceControl name="goods-amount" label="Roughly how much (USD)" value="" helpText="A rough figure is fine." />
  </div>
  <p class="field-help">Change this anytime from Edit trip.</p>
</QuestionPanel>

<QuestionPanel stepKey="medical" stepNumber={10 + questionItems.length} totalSteps={totalSteps} stepLabel="Health"
  title={Q_MEDICAL} intro={medicalEntry.question.panelIntro}
  icon={QUESTION_ICON.medical} flagSrc={destinationFlag}>
  <ChoiceRows name="medical" legend={medicalEntry.question.legend} options={medicalEntry.question.options} />
  <p class="field-help">{medicalEntry.question.fieldHelp}</p>
</QuestionPanel>

<!-- NEW QUESTION 4 (BRIEF-input-step2b): near the end, per the RULES section, so it is the
     last thing asked before the result. A native date input, no radio group (there is
     nothing to default to "yes" or "no" on), with its own skip button that clears the
     field and resubmits, the same one-tap convenience flights already established for its
     own "exclude" answer. -->
<QuestionPanel stepKey="date" stepNumber={11 + questionItems.length} totalSteps={totalSteps} stepLabel="Travel date" isLast
  title={Q_DATE} intro="Optional. Helps flag anything time-sensitive for your dates." skipLabel="Skip, not sure yet"
  icon={QUESTION_ICON.date} flagSrc={destinationFlag}>
  <label class="field-label" for="q-date-input">Travel date</label>
  <input id="q-date-input" name="date" type="date" class="form-input" data-date-input="date" />
  <p class="field-help">Change this anytime from Edit trip.</p>
</QuestionPanel>

<!-- ================= THE RESULT VIEW, hidden until the wizard completes ================= -->
<div class="results" data-result-view hidden>
  <div class="result-layout">
    <div class="result-main">
      <!-- BRIEF-result-card-step1: the page's one required h1 stays, exactly as before
           (calc-wizard.js's finish()/mirror() still focuses it once the result is ready).
           The approved mock shows no visible "Your {country} trip." text anywhere above
           the card, so this block is sr-only rather than removed: same semantics, no
           visual footprint. The trip-meta line that used to sit here moved into the card's
           own trip header below, so it is not repeated twice for a screen reader. -->
      <div class="result-heading sr-only">
        <p class="eyebrow">Your trip estimate</p>
        <h1 tabindex="-1">Your {c.name} trip.</h1>
      </div>

      <!-- ===== BRIEF-result-card-step1: THE FOLDED, BRANDED, SHAREABLE RESULT CARD =====
           Replaces the old wall of separately badged cards with the one bordered card the
           brief specifies, top to bottom: branded header bar, trip header, a HARD group
           (a real figure), a SOFT group (named, no set price, the whole band amber-tinted),
           the no-sum line with the trip total demoted onto it, two actions, a branded
           footer. Every existing avoidable item still appears, now as ONE row shape used
           everywhere: icon, name, an amount only where a real figure exists, and a chevron
           every row carries, hard or soft alike (the brief's own "a visible chevron on
           every row, not just some"). Tapping a row is a native <details>/<summary>
           disclosure, so it opens in place, needs no client script to toggle it, and stays
           keyboard- and screen-reader-operable for free.
           Carrier, rail and rental (avoidable.js's three wizard-gated items, previously
           three separately hand-styled cards living OUTSIDE this hard/soft split entirely)
           now render as rows in this SAME shape, physically inside whichever group fits:
           rail and rental are always SOFT rows (never priced, by design), hidden by default
           and shown by the same yes/no toggle as before, unchanged. Carrier is the one item
           whose figure is only known once the wizard is answered, so its row starts in the
           SOFT group and calc-wizard.js's renderCarrierItem() moves that SAME row into the
           HARD group the instant it computes a real figure, never a second, differently
           styled carrier card (see that function's own comment in calc-wizard.js). -->
      <div class="ttc-card" data-result-card>
        <div class="ttc-card-brandbar">
          <span class="ttc-card-wordmark">true trip costs<span>.</span></span>
          <span class="ttc-card-checked">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5 L8 14.5 L16 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            checked {checkedStamp}
          </span>
        </div>
        <div class="ttc-card-body">
          <div class="ttc-card-triphead">
            <h2 id="avoid-heading" class="ttc-card-title">What you can refuse to pay in {c.name}.</h2>
            <p class="ttc-card-meta"><span data-mirror="partyLabel">2 travelers</span> &middot; <span data-mirror="durationLabel">7 nights</span><span data-mirror="metaExtra"></span></p>
          </div>

          <!-- The calm framing (BRIEF-calc-v2-clusterA's "little to refuse" outcome) is now
               a single quiet note inside this same card, not a second, differently shaped
               block: WD.calmEligible is unchanged, a build-time per-country fact (this
               country's only HARD item is the fee line itself), and the reader's own
               no-fee card answer is what actually reveals the note in mirror(). The fee row
               below still shows its own real, now-smaller figure either way, so the card is
               a calm card, never an empty one. -->
          {calmEligible && (
            <p class="ttc-card-calm-note" data-avoid-calm-note hidden>Based on your answers, few refusable charges stand out for {c.name}. This is not a guarantee that every travel cost is covered.</p>
          )}

          <div class="ttc-card-group ttc-card-group-hard" data-avoid-tier="hard">
            <p class="ttc-card-group-label">Real money, shown as amounts</p>
            {hardItems.map(a => (
              <details class="ttc-card-row" data-avoid-item={a.key} data-avoid-kind={a.figureKind}
                data-avoid-pct-lo={a.figureKind === 'pctCardBase' ? a.figureLo : null}
                data-avoid-pct-hi={a.figureKind === 'pctCardBase' ? a.figureHi : null}
                data-avoid-usd-lo={a.figureKind === 'usd' ? a.figureLo : null}
                data-avoid-usd-hi={a.figureKind === 'usd' ? a.figureHi : null}
                data-avoid-usd-pp={a.figureKind === 'usd' ? (a.figurePerPerson ? '1' : '0') : null}>
                <summary>
                  <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name={iconFor(a.key)} /></span>
                  <span class="ttc-card-row-name" id={'item-' + a.key}>{a.title}</span>
                  <span class="ttc-card-row-amount">
                    {a.figureKind === 'liveFees' ? (
                      <strong data-avoid-amount={a.key}>&nbsp;</strong>
                    ) : (
                      <strong><span data-avoid-amount-lo={a.key}>$0</span><span data-avoid-amount-sep={a.key}>&nbsp;to&nbsp;</span><span data-avoid-amount-hi={a.key}>$0</span></strong>
                    )}
                  </span>
                  <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </summary>
                <div class="ttc-card-row-detail">
                  <p><strong>{a.escape}</strong></p>
                  <p>{a.detail}</p>
                  <p class="small muted"><a href={a.href} target="_blank" rel="noopener">{a.hrefLabel}</a></p>
                </div>
              </details>
            ))}
          </div>

          <div class="ttc-card-group ttc-card-group-soft" data-avoid-tier="soft">
            <p class="ttc-card-group-label">Worth knowing, no set price</p>
            <!-- BRIEF-result-card-step3: the two-mark system's own tiny legend, optional
                 per the brief ("if it helps"), included since it costs one quiet line and
                 removes any doubt about what the two marks below mean. -->
            <p class="ttc-card-mark-legend">
              <span class="ttc-card-mark-legend-item"><span class="ttc-card-row-mark ttc-card-row-mark-shield" aria-hidden="true" set:html={MARK_SHIELD} />Prepare ahead</span>
              <span class="ttc-card-mark-legend-item"><span class="ttc-card-row-mark ttc-card-row-mark-hand" aria-hidden="true" set:html={MARK_STOP} />Refuse to pay</span>
            </p>
            {softItems.map(a => (
              <details class="ttc-card-row" data-avoid-mark="hand">
                <summary>
                  <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name={iconFor(a.key)} /></span>
                  <span class="ttc-card-row-name" id={'item-' + a.key}>{a.title}</span>
                  <span class="ttc-card-row-mark ttc-card-row-mark-hand" aria-hidden="true" set:html={MARK_STOP} />
                  <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </summary>
                <div class="ttc-card-row-detail">
                  <p><strong>{a.escape}</strong></p>
                  <p>{a.detail}</p>
                  <p class="small muted"><a href={a.href} target="_blank" rel="noopener">{a.hrefLabel}</a></p>
                </div>
              </details>
            ))}

            <!-- ===== Carrier connectivity (BRIEF-carrier-honest-build), now one row of
                 the same shape (see this card's own header comment for how it moves
                 between groups). Its config (options, edit title, client-safe carrier
                 data, fallback text, eSIM link) still comes from carrierRegistryEntryFor(c),
                 unchanged. BRIEF-result-card-step3: carries the hand mark like every other
                 pre-existing soft row; the mark hides itself automatically once
                 renderCarrierItem() moves this same row into the HARD group, via
                 calculator.css's own ancestor scoping, never a script change here. ===== -->
            <details class="ttc-card-row" data-avoid-carrier data-avoid-mark="hand">
              <summary>
                <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name="phoneok" /></span>
                <span class="ttc-card-row-name" id="carrier-item-heading">Your phone plan abroad</span>
                <span class="ttc-card-row-amount" data-carrier-amount-wrap hidden><strong data-carrier-amount>&nbsp;</strong></span>
                <span class="ttc-card-row-mark ttc-card-row-mark-hand" aria-hidden="true" set:html={MARK_STOP} />
                <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="ttc-card-row-detail">
                <p data-carrier-detail>&nbsp;</p>
                {carrierEntry.esimUrl && (
                  <p class="small muted" data-carrier-esim-wrap hidden>
                    <a href={carrierEntry.esimUrl} target="_blank" rel="noopener sponsored">Check live eSIM prices for {c.name}</a> <span class="tg earn">we may earn a commission</span>
                  </p>
                )}
                {carrierEntry.fallback && (
                  <p class="small muted">
                    <a href={carrierEntry.fallback.href} target="_blank" rel="noopener">{carrierEntry.fallback.hrefLabel}</a>
                  </p>
                )}
                <button class="text-link" type="button" data-edit="carrier">Change phone carrier</button>
              </div>
            </details>

            <!-- ===== rail/rental, ONE shared render loop over wizardGatedExtras (built
                 above from railRegistryEntryFor(c) and rentalRegistryEntry()), same as
                 before this rebuild: hidden by default and toggled client-side, keyed on
                 the reader's OWN yes/no answer to each, nothing computed or assembled
                 beyond that toggle. Adding a fourth item of this same shape (see
                 avoidable.js's airRegistryEntryExample) means adding it to the
                 wizardGatedExtras array above; this loop renders it with no further
                 change. BRIEF-result-card-step3: both carry the hand mark (existing
                 tactics, unchanged in substance); the secondary paragraph is now
                 conditional, a defensive guard for the new rows below that can genuinely
                 have none, and a no-op here since rail/rental always populate it. ===== -->
            {wizardGatedExtras.map(item => (
              <details class="ttc-card-row" data-avoid-extra={item.question.stepKey} data-avoid-mark="hand" hidden>
                <summary>
                  <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name={iconFor(item.key)} /></span>
                  <span class="ttc-card-row-name" id={item.question.stepKey + '-item-heading'}>{item.card.title}</span>
                  <span class="ttc-card-row-mark ttc-card-row-mark-hand" aria-hidden="true" set:html={MARK_STOP} />
                  <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </summary>
                <div class="ttc-card-row-detail">
                  <p><strong>{item.card.escape}</strong></p>
                  {item.card.secondary && <p>{item.card.secondary}</p>}
                  <p class="small muted"><a href={item.card.href} target="_blank" rel="noopener">{item.card.hrefLabel}</a></p>
                  <button class="text-link" type="button" data-edit={item.question.stepKey}>{item.question.editTitle}</button>
                </div>
              </details>
            ))}

            <!-- ===== BRIEF-result-card-step3: THE FIVE NEW ROWS. Pet and medical are
                 genuine yes/no answers, so the SAME generic toggle loop that already
                 handles rail/rental keys off WD.questionSteps for them with no calc-
                 wizard.js change at all (see that file's own comment on this). Airbnb,
                 goods and date each need their own explicit toggle (a hotel-booking
                 sub-answer, an amount, a date, none of them a plain yes/no), added there
                 alongside the three summary lines that already get the same explicit
                 treatment. All five carry the shield mark: every one is a "get ready for
                 this" fact, never an on-the-spot refusal. Goods and date render empty
                 placeholders here (data-goods-*, data-date-*): the real sentence is filled
                 in by calc-wizard.js's renderGoodsItem()/renderDateItem() the moment the
                 reader's own amount or date is known, never composed at build time. ===== -->
            <details class="ttc-card-row" data-avoid-extra="pet" data-avoid-mark="shield" hidden>
              <summary>
                <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name={iconFor('pet')} /></span>
                <span class="ttc-card-row-name" id="item-pet">{petCard.title}</span>
                <span class="ttc-card-row-mark ttc-card-row-mark-shield" aria-hidden="true" set:html={MARK_SHIELD} />
                <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="ttc-card-row-detail">
                <p><strong>{petCard.escape}</strong></p>
                {petCard.secondary && <p>{petCard.secondary}</p>}
                <p class="small muted"><a href={petCard.href} target="_blank" rel="noopener">{petCard.hrefLabel}</a></p>
                <button class="text-link" type="button" data-edit="pet">{petEntry.question.editTitle}</button>
              </div>
            </details>

            <details class="ttc-card-row" data-avoid-extra="goods" data-avoid-mark="shield" hidden>
              <summary>
                <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name={iconFor('goods')} /></span>
                <span class="ttc-card-row-name" id="item-goods">{goodsVatCard.title}</span>
                <span class="ttc-card-row-mark ttc-card-row-mark-shield" aria-hidden="true" set:html={MARK_SHIELD} />
                <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="ttc-card-row-detail">
                <p><strong data-goods-escape>&nbsp;</strong></p>
                <p data-goods-secondary hidden>&nbsp;</p>
                <p class="small muted"><a data-goods-link href={goodsVatCard.href} target="_blank" rel="noopener">{goodsVatCard.hrefLabel}</a></p>
                <button class="text-link" type="button" data-edit="goods">Change your goods answer</button>
              </div>
            </details>

            <details class="ttc-card-row" data-avoid-extra="medical" data-avoid-mark="shield" hidden>
              <summary>
                <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name={iconFor('medical')} /></span>
                <span class="ttc-card-row-name" id="item-medical">{medicalCard.title}</span>
                <span class="ttc-card-row-mark ttc-card-row-mark-shield" aria-hidden="true" set:html={MARK_SHIELD} />
                <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="ttc-card-row-detail">
                <p><strong>{medicalCard.escape}</strong></p>
                {medicalCard.secondary && <p>{medicalCard.secondary}</p>}
                <p class="small muted"><a href={medicalCard.href} target="_blank" rel="noopener">{medicalCard.hrefLabel}</a></p>
                <button class="text-link" type="button" data-edit="medical">{medicalEntry.question.editTitle}</button>
              </div>
            </details>

            <details class="ttc-card-row" data-avoid-extra="airbnb" data-avoid-mark="shield" hidden>
              <summary>
                <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name={iconFor('airbnb')} /></span>
                <span class="ttc-card-row-name" id="item-airbnb">{airbnbCard.title}</span>
                <span class="ttc-card-row-mark ttc-card-row-mark-shield" aria-hidden="true" set:html={MARK_SHIELD} />
                <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="ttc-card-row-detail">
                <p><strong>{airbnbCard.escape}</strong></p>
                {airbnbCard.secondary && <p>{airbnbCard.secondary}</p>}
                <p class="small muted"><a href={airbnbCard.href} target="_blank" rel="noopener">{airbnbCard.hrefLabel}</a></p>
                <button class="text-link" type="button" data-edit="hotel">Change how you booked</button>
              </div>
            </details>

            <details class="ttc-card-row" data-avoid-extra="date" data-avoid-mark="shield" hidden>
              <summary>
                <span class="ttc-card-row-icon" aria-hidden="true"><Symbol name={iconFor('date')} /></span>
                <span class="ttc-card-row-name" id="item-date">{dateCard.title}</span>
                <span class="ttc-card-row-mark ttc-card-row-mark-shield" aria-hidden="true" set:html={MARK_SHIELD} />
                <svg class="ttc-card-row-chevron" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 7.5 L10 13 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="ttc-card-row-detail">
                <p><strong data-date-escape>&nbsp;</strong></p>
                <p class="small muted" data-date-link-wrap hidden><a data-date-link href={dateCard.href} target="_blank" rel="noopener">{dateCard.hrefLabel}</a></p>
                <button class="text-link" type="button" data-edit="date">Change your travel date</button>
              </div>
            </details>
          </div>

          <!-- ===== The no-sum line (RULES: "NO summed avoidable total, ever"). The trip
               total lives here, demoted to one quiet line, never the hero; "See the full
               breakdown" points at the untouched CostBreakdown section further down this
               same page. ===== -->
          <p class="ttc-card-nosum">
            Each line stands alone. We never add these into one total, because money you were never going to spend is not a saving.
            Your whole trip runs about <span data-mirror="rangeLow">$0</span><span>&nbsp;to&nbsp;</span><span data-mirror="rangeHigh">$0</span>. <a class="text-link" href="#breakdown-heading">See the full breakdown</a>
          </p>

          <div class="result-actions ttc-card-actions">
            {/* STEP 1 of 5: "Edit trip" wires to the existing edit flow below (unchanged).
                "Save / share this card" is present but deliberately inert this step, per
                the brief ("real behaviour is step 5"): it carries no data-share attribute,
                so it does not trigger the older, differently styled share/print dialog
                that data-share still wires up elsewhere in this file for a later step to
                either reuse or replace. */}
            <button class="btn btn-primary" type="button" data-share-placeholder>Save / share this card</button>
            <button class="btn btn-secondary" type="button" data-jump-edit>Edit trip</button>
          </div>
        </div>
        <div class="ttc-card-footer">truetripcosts.com &middot; the money side of travel &middot; no sales pitch, ever</div>
      </div>

      {/* BRIEF-result-card-step1: material unpriced categories (travel insurance and any
          engine-supplied unpriced entry charge) are real exclusions from the total above,
          and dropping them from the page entirely would be a real loss of the honesty
          this site is built around, so they stay, just outside the card's own bordered
          edge (the approved mock does not show this line, so it is not inside the seven
          numbered elements the brief lists for the card itself). Flagged to MAIN: confirm
          this placement, or fold it back inside the card in a later step. */}
      {materialExclusions.length > 0 && (
        <p class="ttc-card-below-note"><strong>Not priced:</strong> {materialExclusions.join('; ')}.</p>
      )}

      <!-- ===== Where the money goes (CostBreakdown, spec section 9) ===== -->
      <section class="section" aria-labelledby="breakdown-heading">
        <h2 id="breakdown-heading">Where the money goes</h2>
        <p class="section-intro">Open only the detail you need.</p>
        <div class="breakdown">
          <details class="breakdown-item" id="breakdown-flights">
            <summary><strong>Getting there</strong><span class="breakdown-amount" data-breakdown-amount="flights">Not included</span></summary>
            <div class="breakdown-body">
              <p data-breakdown-desc="flights">The round-trip airfare you gave in step 5, if any. Paid in dollars at booking, so it carries no foreign-transaction fee.</p>
              <div class="detail-line">
                <div class="line-heading"><span>Round-trip airfare</span><span data-breakdown-line-amount="flights">Not included</span></div>
                <div class="evidence-row"><span class="provenance" data-breakdown-line-provenance="flights">Basis</span> <span class="status" data-breakdown-line-status="flights">Not included</span></div>
              </div>
              {L.entryCharges && L.entryCharges.map(e => (
                <div class="detail-line">
                  <div class="line-heading"><span>{e.label}</span><span>{e.value}</span></div>
                  <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span> <span class="status">Included</span></div>
                  {e.source && <p class="small muted">One-off, per person. <a href={e.source} target="_blank" rel="noopener">Official source</a></p>}
                </div>
              ))}
              {L.namedZeros && L.namedZeros.map(z => (
                <div class="detail-line">
                  <div class="line-heading"><span>{z.label}</span><span>$0</span></div>
                  <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span><span class="status avoided">Already refused</span></div>
                  <p class="small muted">{z.value}</p>
                </div>
              ))}
              <button class="text-link" type="button" data-edit="flights">Change airfare</button>
            </div>
          </details>

          <details class="breakdown-item" id="breakdown-accommodation">
            <summary><strong>Accommodation</strong><span class="breakdown-amount" data-breakdown-amount="accommodation">$0</span></summary>
            <div class="breakdown-body">
              <p>Room price for the stay. Separately modeled taxes appear in the tax section, not twice.</p>
              <div class="detail-line">
                <div class="line-heading"><span>Room price for the stay</span><span data-breakdown-line-amount="accommodation">$0</span></div>
                <div class="evidence-row"><span class="provenance" data-breakdown-line-provenance="accommodation">Basis</span> <span class="status">Included</span></div>
                <p class="small muted" data-breakdown-line-note="accommodation">&nbsp;</p>
              </div>
              <!-- ===== BRIEF-calc-v2-clusterA #7: sourced checkout uplift ===== -->
              <!-- The room rate is not the bill: where this country's engine-computed tourist
                   tax is non-zero (a sourced rule, never invented here), state it as an amount
                   added on top of the room figure above, not as a full checkout total, since
                   resort or other property fees are not modeled by the engine and are named as
                   unknown rather than priced. Hidden entirely, no "$0 tax" placeholder, wherever
                   the engine's own tax comes back zero or the country carries no tax block: see
                   calc-wizard.js mirror() for the one-line gate on this element. -->
              <p class="small muted checkout-uplift" data-checkout-uplift hidden>&nbsp;</p>
              <button class="text-link" type="button" data-edit="hotel">Change accommodation</button>
            </div>
          </details>

          <details class="breakdown-item" id="breakdown-daily">
            <summary><strong>Daily spending</strong><span class="breakdown-amount" data-breakdown-amount="daily">$0</span></summary>
            <div class="breakdown-body">
              <p>Food, local transport, activities and tips, for your travel style, party size and trip length.</p>
              <div class="detail-line">
                <div class="line-heading"><span>On-the-ground spend</span><span data-breakdown-line-amount="daily-2">$0</span></div>
                <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Our estimate</span> <span class="status">Included</span></div>
              </div>
              <button class="text-link" type="button" data-edit="style">Change travel style</button>
            </div>
          </details>

          <details class="breakdown-item" id="breakdown-taxes">
            <summary><strong>Taxes &amp; payment fees</strong><span class="breakdown-amount" data-breakdown-amount="taxes">$0</span></summary>
            <div class="breakdown-body">
              <p>Tourist tax, card purchase fee and ATM fee, added together for this row only; each is its own line below and none of them are added into any other group.</p>
              <div class="detail-line">
                <div class="line-heading"><span data-breakdown-tax-label>Tourist tax</span><span data-breakdown-line-amount="tax">$0</span></div>
                <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span> <span class="status">Included</span></div>
              </div>
              <div class="detail-line">
                <div class="line-heading"><span>Card purchase fee</span><span data-breakdown-line-amount="cardfee">$0</span></div>
                <div class="evidence-row"><span class="provenance" data-breakdown-line-provenance="cardfee">Basis</span> <span class="status" data-breakdown-line-status="cardfee">Included</span></div>
                <p class="small muted">On the room and the card-paid half of daily spend.</p>
              </div>
              <div class="detail-line">
                <div class="line-heading"><span>ATM operator fee</span><span data-breakdown-line-amount="atmfee">$0</span></div>
                <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span> <span class="status">Included</span></div>
                <p class="small muted">A flat per-withdrawal charge. This is separate from the card purchase fee above and always applies, regardless of your step 7 answer.</p>
              </div>
              <button class="text-link" type="button" data-edit="card">Change payment fees</button>
            </div>
          </details>
        </div>
        <p class="method-note"><strong>Three kinds of information.</strong> Your figures, our estimates and sourced rules are labeled separately. Whether a cost is in the total is a different label.</p>
        <details class="assumptions-accordion">
          <summary>Modeling assumptions</summary>
          <ul>
            <li>People and rooms are counted separately. This estimate does not assume a specific number of rooms for your party.</li>
            <li>Every priced night of the stay is treated the same; there is no separate arrival- or departure-day adjustment.</li>
            <li>Changing your travel style will not replace a flight or room price you have already entered; only typing a new figure does.</li>
            <li>This estimate uses one room throughout the stay. If your own booking has more than one room, check the count and enter the combined nightly price on the accommodation step.</li>
          </ul>
        </details>
      </section>
    </div>

    <!-- ===== TripSummary / Edit trip (spec section 9 "Edit trip") ===== -->
    <aside class="trip-summary" id="edit-trip" aria-labelledby="edit-trip-title" tabindex="-1">
      <h2 id="edit-trip-title">Edit your trip</h2>
      <p>Change one answer. Keep the rest.</p>
      <dl>
        <div class="summary-row"><dt>Destination</dt><dd>{c.name}</dd><button class="text-link" type="button" data-edit="destination" aria-label="Change destination">Change</button></div>
        <div class="summary-row"><dt>Travelers</dt><dd data-mirror="summaryTravelers">2 people</dd><button class="text-link" type="button" data-edit="travelers" aria-label="Change travelers">Change</button></div>
        <div class="summary-row"><dt>Trip length</dt><dd data-mirror="summaryNights">7 nights</dd><button class="text-link" type="button" data-edit="nights" aria-label="Change trip length">Change</button></div>
        <div class="summary-row"><dt>Travel style</dt><dd data-mirror="summaryStyle">Mid-range</dd><button class="text-link" type="button" data-edit="style" aria-label="Change travel style">Change</button></div>
        <div class="summary-row"><dt>Round-trip airfare</dt><dd data-mirror="summaryFlight">Not included</dd><button class="text-link" type="button" data-edit="flights" aria-label="Change round-trip airfare">Change</button></div>
        <div class="summary-row"><dt>How you booked</dt><dd data-mirror="summaryHotelBooking">Online</dd><button class="text-link" type="button" data-edit="hotel" aria-label="Change how you booked your hotel">Change</button></div>
        <div class="summary-row"><dt>Accommodation</dt><dd data-mirror="summaryHotel">$0 / room / night</dd><button class="text-link" type="button" data-edit="hotel" aria-label="Change accommodation">Change</button></div>
        <div class="summary-row"><dt>Card purchase fee</dt><dd data-mirror="summaryCard">Use the typical fee assumption</dd><button class="text-link" type="button" data-edit="card" aria-label="Change payment fees">Change</button></div>
        <div class="summary-row"><dt>Phone carrier</dt><dd data-mirror="summaryCarrier">Other or not sure</dd><button class="text-link" type="button" data-edit="carrier" aria-label="Change phone carrier">Change</button></div>
        {/* BRIEF-calc-result-registry-rebuild: rail and rental share one loop here too,
            same as their result card above; a fourth item of this shape needs no new row
            hand-authored, only an entry in wizardGatedExtras. */}
        {wizardGatedExtras.map(item => (
          <div class="summary-row"><dt>{item.question.summaryLabel}</dt><dd data-mirror={'summary' + item.question.stepKey.charAt(0).toUpperCase() + item.question.stepKey.slice(1)}>No or not sure</dd><button class="text-link" type="button" data-edit={item.question.stepKey} aria-label={'Change your ' + item.question.summaryLabel.toLowerCase() + ' answer'}>Change</button></div>
        ))}
        {/* BRIEF-input-step2b: pet and medical get the exact same generic summary row
            rail/rental already use above (mirror()'s generic "Yes"/"No or not sure" loop
            covers them too, since both are genuine yes/no answers). Goods, hotel-booking
            and date each need their own mirrored text (an amount, a channel, a date), so
            calc-wizard.js sets those three explicitly instead of through that generic loop
            (see this file's own exclusion list there). */}
        <div class="summary-row"><dt>{petEntry.question.summaryLabel}</dt><dd data-mirror="summaryPet">No or not sure</dd><button class="text-link" type="button" data-edit="pet" aria-label="Change your pet answer">Change</button></div>
        <div class="summary-row"><dt>Goods to bring home</dt><dd data-mirror="summaryGoods">Skipped</dd><button class="text-link" type="button" data-edit="goods" aria-label="Change your goods answer">Change</button></div>
        <div class="summary-row"><dt>{medicalEntry.question.summaryLabel}</dt><dd data-mirror="summaryMedical">No or not sure</dd><button class="text-link" type="button" data-edit="medical" aria-label="Change your health answer">Change</button></div>
        <div class="summary-row"><dt>Travel date</dt><dd data-mirror="summaryDate">Not sure yet</dd><button class="text-link" type="button" data-edit="date" aria-label="Change your travel date">Change</button></div>
      </dl>
      <div class="summary-footer">Your inputs stay available while you explore. No need to repeat the wizard.</div>
    </aside>
  </div>
</div>

<!-- ===== Error state (spec section 5 "Errors, pending and disabled") =====
     A defensive guard, not a state with a real production trigger today: the engine is
     synchronous and always present on every built country page (calc-regression-test.mjs
     asserts this), so there is no network call or async gap that can fail. This exists only
     to satisfy "never show zero, a partial calculation, or the demo fixture as a production
     fallback" in the one case the mirror script itself throws (e.g. an id genuinely missing). -->
<div class="results" data-error-view hidden>
  <div class="result-heading"><p class="eyebrow">Your trip estimate</p><h2 class="recovery-title" tabindex="-1">Your answers are still here.</h2></div>
  <section class="stale-state" role="status">
    <h2>The estimate is unavailable.</h2>
    <p>We could not read a complete result. No partial or zero total is shown. Your answers have been preserved.</p>
    <button class="btn btn-secondary" type="button" data-retry>Try again</button>
  </section>
</div>

<!-- ================= THE REAL ENGINE, permanently hidden ================= -->
<div class="wiz-underlay" data-engine-root hidden>
  <script type="application/json" id="hn-data" set:html={calcJson}></script>
  <script type="application/json" id="wiz-data" set:html={wizJson}></script>

  <div class="estimator" id="hn-app" hidden>
    <div class="erow">
      <div class="ef ef-room">
        <label for="hnRoom">Hotel price a night</label>
        <span class="moneyin"><span class="mny">$</span><input id="hnRoom" type="text" inputmode="numeric" value="150" aria-label="Hotel price per night in US dollars" /></span>
      </div>
      <label class="hn-toggle hn-toggle-inline" id="hnPaidWrap">
        <input type="checkbox" id="hnPaid" />
        <span class="hn-switch" aria-hidden="true"></span>
        <span class="hn-toggle-l">Already paid for the room</span>
      </label>
    </div>
    <p class="ef-hint-room" id="hnRoomHint" hidden></p>
    {/* BRIEF-rooms-autosuggest: the hidden engine's own rooms count, read by
        calc-engine.js via querySelector rather than its id() helper (see that file's own
        comment on this), which is why this id is not part of calc-regression-test.mjs's
        DOM contract and does not need to exist on the per-country inline calculator. Its
        visible counterpart lives on the wizard's own accommodation step below, wired to
        this one by calc-wizard.js the same way the room price and flight fields already
        are. */}
    <input id="hnRooms" type="text" inputmode="numeric" value="1" aria-hidden="true" tabindex="-1" />

    <label class="cf hn-region" id="hnRegionWrap" hidden style="display:none">
      <span class="cf-l">Where are you staying?</span>
      <span class="selwrap"><select id="hnRegion"></select></span>
    </label>

    <div class="erow erow-flight">
      <div class="ef ef-flight">
        <label for="hnFlight">Flights, round trip a person</label>
        <span class="moneyin"><span class="mny">$</span><input id="hnFlight" type="text" inputmode="numeric" value="" aria-label="Round trip flight price per traveler in US dollars" /></span>
      </div>
      <p class="ef-hint" id="hnFlightHint">Optional. Enter your round trip fare per traveler to fold flights into the total.</p>
    </div>

    <div class="erow">
      <div class="ef ef-num"><label>Travelers</label>
        <span class="stepper">
          <button type="button" class="stp" data-step="hnTrav" data-dir="-1" aria-label="One fewer traveler">&#8722;</button>
          <span class="stp-v" id="hnTrav" data-v="2">2</span>
          <button type="button" class="stp" data-step="hnTrav" data-dir="1" aria-label="One more traveler">+</button>
        </span>
      </div>
      <div class="ef ef-num"><label>Nights</label>
        <span class="stepper">
          <button type="button" class="stp" data-step="hnNights" data-dir="-1" aria-label="One fewer night">&#8722;</button>
          <span class="stp-v" id="hnNights" data-v="7">7</span>
          <button type="button" class="stp" data-step="hnNights" data-dir="1" aria-label="One more night">+</button>
        </span>
      </div>
      <div class="ef ef-style"><label>Style</label>
        <div class="seg" role="group" aria-label="Travel style">
          {styles.map((s, i) => (
            <button id={'hnStyle' + i} class={i === defaultStyleIndex ? 'on' : ''} type="button" data-per={s.per} data-cash={s.cash} data-room={s.room}>{s.n}</button>
          ))}
        </div>
      </div>
    </div>

    <CalcResult country={c} tipCalc={tipCalc} hideWizardCta={true} />
  </div>
</div>

<script>
  import { initCalcWizard } from '../scripts/calc-wizard.js';
  initCalcWizard();
</script>
<script>
  // The calculator engine, shared with the inline per-country calculator. Imported for its
  // side effects: it hydrates from #hn-data and #hn-app the moment both exist, which they do
  // above, permanently kept out of view.
  import '../scripts/calc-engine.js';
</script>
<!-- BRIEF-input-step2b: the old inline skip-button script that used to live here (BRIEF-
     calc-tier1-review-fixes, Fix 4) covered only the flights step, via a single global
     querySelector('[data-wizard-skip]') that would only ever find the FIRST such button in
     the document. Now that hotel and date also carry a skip button, that assumption no
     longer holds, so this moved into calc-wizard.js as a real per-step mechanism (see its
     own SKIP_ACTIONS map) instead of growing a second one-off script here. -->

<style>
  /* Component-specific overrides beyond calculator.css, kept minimal on purpose: nearly
     everything is already in the scoped stylesheet CalculatorLayout.astro loads. */
  .wiz-underlay { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
</style>
