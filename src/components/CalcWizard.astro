---
// THE CALCULATOR WIZARD, rebuilt to TTC-design-specification.md (BRIEF-calculator-final-build.md).
//
// THE CENTRAL FACT, unchanged from every prior pass: the honest calc engine
// (src/scripts/calc-engine.js) already exists and does all the math. This component is a
// front end that feeds it and reads it back, one question at a time. It does not compute
// anything itself.
//
// ARCHITECTURE. Two DOM trees live on this page at all times:
//   1. THE REAL ENGINE, permanently hidden (`data-engine-root hidden`): the exact same
//      estimator inputs and the exact same <CalcResult country={c} hideWizardCta={true} />
//      the site has always used, byte-for-byte the same markup, ids and classes
//      calc-regression-test.mjs already asserts against every country page. It is never
//      shown to a reader. Its only job is to be a correct, already-tested calculator that
//      happens to render its inputs and outputs as real DOM nodes instead of returning a
//      value from a function.
//   2. THE NEW SURFACE, everything the reader actually sees: the seven QuestionPanel steps,
//      the result view, the edit dialog. It is pre-rendered at build time (every step's real
//      copy and controls are known per-country before any JS runs) and a single client
//      script (src/scripts/calc-wizard.js) shows/hides the right step, wires each control's
//      native events into the hidden engine's inputs via the same apply()-style event
//      simulation the site has always used, and MIRRORS the hidden engine's already-computed
//      output text into the new surface's own elements. That mirror step is a plain text
//      copy, never a recomputation: see calc-wizard.js's own header for the full accounting
//      of which hidden id feeds which new element, and which few things (input provenance,
//      the flights-excluded flag, the calm-outcome trigger) are the surface's own state
//      because the engine has no such concept and none should be invented for it.
//
// WHY NOT REGENERATE STEP MARKUP FROM A CLIENT TEMPLATE, unlike the specialist's own
// framework-free reference (which has no server and so must build every screen from a JS
// string at runtime): this site is fully static and every country's data is already known
// at build time, so Astro renders the real, semantic, server-rendered controls for all seven
// steps up front. The client only ever toggles which one is visible. QuantityControl,
// PriceControl, ChoiceRows and DestinationChoice are literally the same DOM node whether a
// step is showing in the wizard or has been relocated into the edit dialog (see
// calc-wizard.js's openEdit()): there is exactly one control per question, never two
// differently-styled copies, matching the spec's explicit instruction on this point.
// BRIEF-calc-result-registry-rebuild: this file used to hand-assemble three separate
// wizard-gated systems (carrier's option list, rail's country gate, rental's constant)
// plus its own hard/soft split of avoidableFor(c)'s static items. All four are now ONE
// registry, read from src/data/avoidable.js: avoidableRegistryFor(c) for the HARD/SOFT
// tier pool (country-only items, byte-identical to avoidableFor(c)'s own output), and
// carrierRegistryEntryFor/railRegistryEntryFor/rentalRegistryEntry for the three
// wizard-gated items, which keep their own dedicated result slot (see that section's own
// header in avoidable.js for why) but now share ONE step generator and ONE QuestionPanel
// loop below instead of three hand-authored blocks.
import CalcResult from './CalcResult.astro';
import QuestionPanel from './calc/QuestionPanel.astro';
import QuantityControl from './calc/QuantityControl.astro';
import PriceControl from './calc/PriceControl.astro';
import ChoiceRows from './calc/ChoiceRows.astro';
import DestinationChoice from './calc/DestinationChoice.astro';
import { calcSetupFor } from '../data/calc-setup.js';
import { calcLinesFor } from '../data/calc-lines.js';
import {
  avoidableRegistryFor,
  carrierRegistryEntryFor,
  railRegistryEntryFor,
  rentalRegistryEntry,
} from '../data/avoidable.js';
import { flightPlaceholderFor } from '../data/flight-defaults.js';
import { countries } from '../data/index.js';

const { country: c } = Astro.props;
const { calcJson, tipCalc } = calcSetupFor(c);
const styles = (c.cash && c.cash.styles) || [];
const defaultStyleIndex = (c.cash && c.cash.defaultIndex) || 0;

// Flight and hotel starting figures. Flight uses this country's own verified round-trip
// range where one exists; otherwise the SAME rough, region-derived placeholder
// calc-engine.js itself will prefill into the hidden #hnFlight field (flightPlaceholderFor,
// from src/data/flight-defaults.js), so the wizard's displayed "typical" figure can never
// drift from what the engine actually holds if the reader never touches this step.
const flightData = c.flight || null;
const flightRough = flightPlaceholderFor(c);
const flightTypical = flightData
  ? Math.round((flightData.low + flightData.high) / 2 / 10) * 10
  : (flightRough ? flightRough.usd : 700);
const roomTypical = (styles[defaultStyleIndex] && styles[defaultStyleIndex].room) || 150;

// PRODUCTION BLOCKER, resolved: the full supported country list. Every entry in
// src/data/index.js with live:true (59 of 59 today; see data/index.js itself), sorted for
// the destination step's radio list, current country pinned so a reader arriving from a
// country guide sees their own destination already selected rather than searching for it.
const liveCountries = countries.filter(x => x.live);
const destinationCountries = [c, ...liveCountries.filter(x => x.slug !== c.slug).sort((a, b) => a.name.localeCompare(b.name))];

// PRODUCTION BLOCKER, resolved: the style enum. Every country carries exactly three styles,
// in this order, under these names: Budget, Mid-range, Comfort (never "Higher comfort", a
// guess in an earlier brief). Help copy is site-wide modeling policy, not a per-country fact,
// so it lives here rather than in calc-engine.js or the country data files.
const STYLE_HELP = {
  Budget: 'Simple meals and lower everyday spending.',
  'Mid-range': 'A comfortable everyday spending allowance.',
  Comfort: 'More room for meals, transport and activities.',
};
const styleOptions = styles.map((s, i) => ({
  value: String(i),
  label: s.n,
  help: STYLE_HELP[s.n] || '',
  selected: i === defaultStyleIndex,
}));

const flightModeOptions = [
  { value: 'known', label: 'I have a price', help: 'Round-trip airfare, per person.', selected: true },
  { value: 'exclude', label: 'Leave flights out for now', help: 'The result will clearly say they are not included.', selected: false },
];
const cardOptions = [
  { value: 'no-fee', label: 'No foreign-transaction fee', help: 'My card does not charge this fee on purchases.', selected: false },
  { value: 'assumed', label: 'Use the typical fee assumption', help: 'My card charges a fee, or I have not checked.', selected: true },
];

// BRIEF-calc-result-registry-rebuild, PART 2 "generic engine": the three wizard-gated
// items, ONE array, in registry order (carrier, then rail if this country has a verdict,
// then rental), instead of three separately hand-tracked booleans/arrays. Everything
// downstream, the step count, the step order, the QuestionPanel loop and the edit-dialog
// titles, all key off this ONE array so they can never disagree with each other. Adding a
// fourth wizard-gated item (see avoidable.js's airRegistryEntryExample) means pushing one
// more entry here; nothing else on this page would need to change.
const carrierEntry = carrierRegistryEntryFor(c);
const railEntry = railRegistryEntryFor(c);
const rentalEntry = rentalRegistryEntry();
// Rail is genuinely absent (not merely hidden) on a country rail-passes.js has no verdict
// for, so it is simply missing from this array there, the same clean "never asked" outcome
// the old hasRail gate produced. Carrier and rental are unconditional.
const questionItems = [carrierEntry, railEntry, rentalEntry].filter(Boolean);
// Wizard-gated items whose RESULT card stays outside the hard/soft pool (see avoidable.js's
// registry header for why): rail and rental share one dedicated card shape and one render
// loop below; carrier keeps its own, richer block (a dynamic day-pass figure, an eSIM link,
// a Mexico/Canada special case) unchanged in substance from before this refactor.
const wizardGatedExtras = [railEntry, rentalEntry].filter(Boolean);
// Every QuestionPanel on this page is given this explicitly, rather than relying on the
// component's own default, because that default is shared with the standalone /calculator
// landing page and cannot itself vary per country the way this page's real step count does.
const totalSteps = 7 + questionItems.length;

// PRODUCTION BLOCKER, resolved: material unpriced categories (spec section 7). Travel
// insurance is a named tier on every country (never priced, by design: a premium depends on
// age, cover and trip length, none of which this calculator asks); a real unpriced entry
// cost is engine-supplied for the few countries that carry one. Airfare is deliberately NOT
// in this list: it gets its own first-class, mandatory strip when excluded (spec section 7),
// not a line buried in a generic list.
const L = calcLinesFor(c);
const materialExclusions = [
  'Travel insurance',
  ...((L.entryUnpriced || []).map(e => e.label)),
];

// BRIEF-calc-result-registry-rebuild, PART 1: the HARD/SOFT tier pool, read once from the
// registry (avoidableRegistryFor(c) wraps avoidableFor(c) byte-for-byte; see that
// function's own header in avoidable.js). Tiering itself is unchanged from before this
// refactor: HARD = a real figure exists, SOFT = it genuinely does not.
const avoidablePool = avoidableRegistryFor(c);
const hardItems = avoidablePool.filter(a => a.tier === 'hard');
const softItems = avoidablePool.filter(a => a.tier === 'soft');
// PRODUCTION BLOCKER, resolved (flag carried forward from Cluster A): the calm outcome's
// real trigger is still "this country's only HARD item is the card/ATM fee line itself",
// so a no-foreign-fee card genuinely leaves nothing with a real dollar figure attached.
// Unaffected by the registry rebuild: carrier/rail/rental never contribute to this count,
// deliberately (see avoidable.js's registry header on why they stay outside this split).
const otherHardCount = hardItems.filter(a => a.figureKind !== 'liveFees').length;
const calmEligible = otherHardCount === 0;

// BRIEF-calc-result-registry-rebuild, PART 4 "the result reframe": the one-line shape
// sentence that leads the section, naming how many items carry a real number versus how
// many are named but unpriced, BEFORE the reader scans the list. Both counts are the pool
// built above, which is purely a function of this COUNTRY (never the wizard's answers), so
// this is safe to compute once, at build time, exactly like the rest of this section's
// static copy; nothing here needs a client-side mirror.
function shapeSentence(hardCount, softCount) {
  const hardClause = hardCount === 1 ? 'One fee carries a real number' : (hardCount + ' fees carry a real number');
  if (softCount === 0) return hardClause + '.';
  const softClause = softCount === 1 ? 'one more trap carries' : (softCount + ' more traps carry');
  return hardClause + ', ' + softClause + ' no set price but real money.';
}
const avoidShapeSentence = shapeSentence(hardItems.length, softItems.length);

const wizData = {
  countryName: c.name,
  countrySlug: c.slug,
  styles: styles.map((s, i) => ({ i, n: s.n, room: s.room })),
  defaultStyleIndex,
  flightTypical,
  flightVerified: !!flightData,
  roomTypical,
  calmEligible,
  carriers: carrierEntry.clientData,
  carrierFallbackText: carrierEntry.fallback ? carrierEntry.fallback.detail : '',
  // BRIEF-calc-result-registry-rebuild: replaces the old single hasRailVerdict flag. The
  // client's STEP_ORDER is now FIXED_STEPS.concat(WD.questionSteps), so adding a fourth
  // wizard-gated item needs no change in calc-wizard.js at all; questionMeta/questionDefaults
  // carry the small per-item facts (the edit-dialog title, the default answer) that used to
  // be hardcoded per key in that file.
  questionSteps: questionItems.map(q => q.question.stepKey),
  questionMeta: Object.fromEntries(questionItems.map(q => [q.question.stepKey, { editTitle: q.question.editTitle }])),
  questionDefaults: Object.fromEntries(questionItems.map(q => {
    const opts = q.question.options.concat(q.question.moreOptions || []);
    const def = opts.find(o => o.selected) || opts[0];
    return [q.question.stepKey, def ? def.value : ''];
  })),
};
const wizJson = JSON.stringify(wizData).replace(/</g, '\\u003c');
---
<!-- ================= THE NEW SURFACE ================= -->

<QuestionPanel stepKey="destination" stepNumber={1} totalSteps={totalSteps} stepLabel="Destination"
  title="Where are you going?" intro="Choose one country for this trip estimate." isFirst showFootnote>
  <DestinationChoice countries={destinationCountries} selectedSlug={c.slug} />
</QuestionPanel>

<QuestionPanel stepKey="travelers" stepNumber={2} totalSteps={totalSteps} stepLabel="Travelers" initiallyVisible
  title="How many people are traveling?" intro="Count everyone in your travel party.">
  <QuantityControl name="travelers" unitLabel="travelers" unitLabelSingular="traveler" value={2} min={1} max={12} presets={[1, 2, 3, 4]} helpText="This is people, not rooms." />
</QuestionPanel>

<QuestionPanel stepKey="nights" stepNumber={3} totalSteps={totalSteps} stepLabel="Trip length"
  title="How many nights are you staying?" intro="Count nights away, not calendar days.">
  <QuantityControl name="nights" unitLabel="nights" unitLabelSingular="night" value={7} min={1} max={60} presets={[5, 7, 14, 21]} />
</QuestionPanel>

<QuestionPanel stepKey="style" stepNumber={4} totalSteps={totalSteps} stepLabel="Travel style"
  title="How do you expect to travel?" intro={'Start with the closest fit. It sets a typical daily-spending figure and hotel price for ' + c.name + '.'}>
  <ChoiceRows name="style" legend="Travel style" options={styleOptions} />
</QuestionPanel>

<QuestionPanel stepKey="flights" stepNumber={5} totalSteps={totalSteps} stepLabel="Airfare" showFootnote
  title="What is your round-trip airfare?" intro="Use the price per person, in US dollars." skipLabel="Leave flights out">
  <ChoiceRows name="flight-mode" legend="Airfare information" options={flightModeOptions} />
  <div class="conditional-field" data-flight-price-wrap>
    <PriceControl name="flight" label="Round-trip price per person (USD)" value={flightTypical}
      helpText={flightData
        ? ('A typical economy round trip from major US gateways, checked ' + (flightData.checked || '') + '. Enter what you actually paid and it takes over.')
        : ('We do not yet track a verified fare for ' + c.name + '. This is a rough, region-based placeholder, not a quote: change it to your own fare.')} />
  </div>
</QuestionPanel>

<QuestionPanel stepKey="hotel" stepNumber={6} totalSteps={totalSteps} stepLabel="Accommodation"
  title="What is the room price per night?" intro="Use the price for one room, per night, in US dollars, before separately modeled taxes.">
  <PriceControl name="hotel" label="Room price per night (USD)" value={roomTypical} helpText="This estimate uses one room throughout the stay." />
  <div class="assumption-note"><strong>This is the nightly price for your room, taken as entered.</strong><br />We do not model how many rooms your party needs, so this figure is not divided or multiplied by the traveler count from step 2. If you need more than one room, enter the combined nightly price.</div>
</QuestionPanel>

<QuestionPanel stepKey="card" stepNumber={7} totalSteps={totalSteps} stepLabel="Payment fees" showFootnote
  title="Does your card charge a purchase fee abroad?" intro="Check for a foreign-transaction fee on purchases.">
  <ChoiceRows name="card" legend="Foreign-transaction fee on purchases" options={cardOptions} />
  <p class="field-help">No bank login or card details are collected here.</p>
</QuestionPanel>

<!-- ===== BRIEF-calc-result-registry-rebuild: ONE loop generates every wizard-gated
     item's QuestionPanel, in registry order (carrier, then rail where this country has a
     verdict, then rental). A country with no rail verdict simply has no 'rail' entry in
     questionItems, so it never renders this question at all, the same clean outcome the
     old hasRail-gated block produced by hand. Adding a fourth item (see avoidable.js's
     airRegistryEntryExample) needs no new block here: it would just be one more entry in
     questionItems, rendered by this same loop. ===== -->
{questionItems.map((item, i) => (
  <QuestionPanel stepKey={item.question.stepKey} stepNumber={8 + i} totalSteps={totalSteps}
    stepLabel={item.question.stepLabel} isLast={i === questionItems.length - 1}
    title={item.question.panelTitle} intro={item.question.panelIntro}>
    <ChoiceRows name={item.question.stepKey} legend={item.question.legend} options={item.question.options} />
    {item.question.moreOptions && item.question.moreOptions.length > 0 && (
      <details class="carrier-more" data-more-options={item.question.stepKey}>
        <summary>{item.question.moreLabel}</summary>
        <ChoiceRows name={item.question.stepKey} legend={item.question.moreLegend} options={item.question.moreOptions} />
      </details>
    )}
    <p class="field-help">{item.question.fieldHelp}</p>
  </QuestionPanel>
))}

<!-- ================= THE RESULT VIEW, hidden until the wizard completes ================= -->
<div class="results" data-result-view hidden>
  <div class="result-layout">
    <div class="result-main">
      <div class="result-heading">
        <p class="eyebrow">Your trip estimate</p>
        <h1 tabindex="-1">Your {c.name} trip.</h1>
        <p class="trip-meta"><span data-mirror="partyLabel">2 travelers</span> &middot; <span data-mirror="durationLabel">7 nights</span></p>
      </div>

      <!-- ===== BRIEF-calc-result-registry-rebuild, PART 4 "lead with avoidance" =====
           The hero heading now names the country directly, and a one-line shape sentence
           (avoidShapeSentence, built once above from this country's own pool) sets
           expectations before the reader scans a single card: how many items carry a real
           number versus how many are named but genuinely unpriced. Neither count is a
           guess; both are the same hardItems/softItems arrays the cards below render from. -->
      <section class="section" aria-labelledby="avoid-heading" data-avoid-section>
        <div data-avoid-normal hidden={calmEligible}>
          <h2 id="avoid-heading" class="avoid-hero-heading">What you can refuse to pay in {c.name}.</h2>
          <p class="avoid-shape">{avoidShapeSentence}</p>

          {hardItems.length > 0 && (
            <div class="avoid-tier avoid-tier-hard" data-avoid-tier="hard">
              <p class="tier-subhead tier-subhead-hard">Fees we can price. Refuse each one.</p>
              {hardItems.map(a => (
                <article class="avoid-card avoid-card-hard" aria-labelledby={'item-' + a.key}
                  data-avoid-item={a.key} data-avoid-kind={a.figureKind}
                  data-avoid-pct-lo={a.figureKind === 'pctCardBase' ? a.figureLo : null}
                  data-avoid-pct-hi={a.figureKind === 'pctCardBase' ? a.figureHi : null}
                  data-avoid-usd-lo={a.figureKind === 'usd' ? a.figureLo : null}
                  data-avoid-usd-hi={a.figureKind === 'usd' ? a.figureHi : null}
                  data-avoid-usd-pp={a.figureKind === 'usd' ? (a.figurePerPerson ? '1' : '0') : null}>
                  <div class="evidence-row">
                    {a.liveFigureId === 'avFees' ? (
                      <Fragment>
                        <span class="provenance" data-avoid-provenance={a.key}><span class="meta-key">Basis</span> Sourced rule</span>
                        <span class="status" data-avoid-status={a.key}>Included</span>
                      </Fragment>
                    ) : (
                      <Fragment>
                        <span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span>
                        <span class="status not-included">Not included</span>
                      </Fragment>
                    )}
                  </div>
                  <div class="item-amount-hard">
                    {a.figureKind === 'liveFees' ? (
                      <strong class="amount-big" data-avoid-amount={a.key}>&nbsp;</strong>
                    ) : (
                      <strong class="amount-big">
                        <span data-avoid-amount-lo={a.key}>$0</span><span data-avoid-amount-sep={a.key}>&nbsp;to&nbsp;</span><span data-avoid-amount-hi={a.key}>$0</span>
                      </strong>
                    )}
                    <span>{a.figureNote}</span>
                  </div>
                  <h3 id={'item-' + a.key}>{a.title}</h3>
                  {/* One-line action only (BRIEF-calc-v2-A2 #2): the fuller detail prose
                      that used to sit here is exactly the quiet-prose problem that brief
                      existed to fix, so it stays dropped from the card; "How this works"
                      still links out for anyone who wants it. */}
                  <p>{a.escape}</p>
                  <details class="source-details"><summary>How this works</summary><p>See the full explanation: <a href={a.href} target="_blank" rel="noopener">{a.hrefLabel}</a></p></details>
                </article>
              ))}
            </div>
          )}

          {softItems.length > 0 && (
            <div class="avoid-tier avoid-tier-soft" data-avoid-tier="soft">
              <p class="tier-subhead tier-subhead-soft">Traps worth knowing - real, but no set price.</p>
              <p class="soft-tier-note">We do not invent a dollar for these, because the amount depends on you. But each is money you keep by spotting it.</p>
              {softItems.map((a, i) => (
                <article class={'avoid-card avoid-card-soft' + (i >= 3 ? ' avoid-card-extra' : '')} aria-labelledby={'item-' + a.key}>
                  <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span><span class="status not-estimated">No set price</span></div>
                  <h3 id={'item-' + a.key}>{a.title}</h3>
                  <p>{a.escape}</p>
                  <details class="source-details"><summary>How this works</summary><p>See the full explanation: <a href={a.href} target="_blank" rel="noopener">{a.hrefLabel}</a></p></details>
                </article>
              ))}
              {softItems.length > 3 && (
                <details class="soft-more" data-soft-more>
                  <summary>Show {softItems.length - 3} more</summary>
                </details>
              )}
            </div>
          )}

          <p class="method-note">Each fee stands alone. We never add them into one total, because money you were never going to spend is not a saving.</p>
        </div>

        {calmEligible && (
          <div data-avoid-calm hidden>
            <h2 class="avoid-hero-heading">Little to refuse.</h2>
            <p class="section-intro">A few simple checks. Nothing extra suggested.</p>
            <div class="calm-result">
              <p class="eyebrow">Nothing extra suggested</p>
              <h3>Nothing here suggests you need to buy another product.</h3>
              <p>Based on your answers, few refusable charges stand out for {c.name}. This is not a guarantee that every travel cost is covered.</p>
            </div>
            <div class="calm-checks">
              <div class="calm-check">
                <span class="calm-check-mark" aria-hidden="true">&#10003;</span>
                <div>
                  <strong>Card purchase fee</strong>
                  <p>Your card has no foreign-transaction fee on purchases. The ATM operator's own flat fee is separate and still applies.</p>
                  <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Your figure</span><span class="status avoided">Already refused</span></div>
                </div>
              </div>
              {softItems.map(a => (
                <div class="calm-check">
                  <span class="calm-check-mark" aria-hidden="true">&#10003;</span>
                  <div>
                    <strong>{a.title}</strong>
                    <p>{a.escape} {a.detail}</p>
                    <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span><span class="status not-estimated">No set price</span></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- ===== Carrier connectivity (BRIEF-carrier-honest-build) =====
             Filled in client-side by calc-wizard.js's renderCarrierItem(), from the reader's
             own carrier-step answer and the trip length already set in step 3. Sits outside
             data-avoid-normal / data-avoid-calm above and shows either way: it is a separate
             question from whether this country's OTHER fees are refusable. It stays outside
             the hard/soft pool above for the same reason rail and rental do (see avoidable.js's
             registry header), plus a second reason of its own: unlike every pool item, whether
             it carries a real figure depends on WHICH carrier the reader names, only known
             once the wizard is answered. Its config (options, edit title, client-safe carrier
             data, fallback text, eSIM link) now comes from carrierRegistryEntryFor(c) instead
             of being hand-assembled in this file's own frontmatter. -->
        <div class="avoid-tier avoid-tier-carrier" data-avoid-carrier>
          <p class="tier-subhead tier-subhead-carrier">Your phone plan abroad</p>
          <article class="avoid-card" aria-labelledby="carrier-item-heading">
            <div class="evidence-row">
              <span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span>
              <span class="status not-estimated" data-carrier-status>No set price</span>
            </div>
            <div class="item-amount-hard" data-carrier-amount-wrap hidden>
              <strong class="amount-big" data-carrier-amount>&nbsp;</strong>
              <span>this pass, this trip</span>
            </div>
            <h3 id="carrier-item-heading">Your phone plan abroad</h3>
            <p data-carrier-detail>&nbsp;</p>
            {carrierEntry.esimUrl && (
              <p class="small muted" data-carrier-esim-wrap hidden>
                <a href={carrierEntry.esimUrl} target="_blank" rel="noopener sponsored">Check live eSIM prices for {c.name}</a> <span class="tg earn">we may earn a commission</span>
              </p>
            )}
            {carrierEntry.fallback && (
              <p class="small muted">
                <a href={carrierEntry.fallback.href} target="_blank" rel="noopener">{carrierEntry.fallback.hrefLabel}</a>
              </p>
            )}
            <button class="text-link" type="button" data-edit="carrier">Change phone carrier</button>
          </article>
        </div>

        <!-- ===== BRIEF-calc-result-registry-rebuild: rail and rental, ONE shared render
             loop over wizardGatedExtras (built above from railRegistryEntryFor(c) and
             rentalRegistryEntry()). Both stay outside data-avoid-normal / data-avoid-calm,
             deliberately: a reader who says yes here still needs this guidance even in an
             otherwise fee-calm country (see avoidable.js's registry header for the full
             reasoning). Each is hidden by default and toggled client-side, keyed on its OWN
             question answer, nothing computed or assembled beyond that toggle. Adding a
             fourth item of this same shape (see avoidable.js's airRegistryEntryExample)
             would mean adding it to the wizardGatedExtras array above; this loop would
             render it with no further change. -->
        {wizardGatedExtras.map(item => (
          <div class={'avoid-tier avoid-tier-soft avoid-tier-extra'} data-avoid-extra={item.question.stepKey} hidden>
            <p class="tier-subhead tier-subhead-soft">Traps worth knowing - real, but no set price.</p>
            <article class="avoid-card avoid-card-soft" aria-labelledby={item.question.stepKey + '-item-heading'}>
              <div class="evidence-row">
                <span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span>
                <span class="status not-estimated">No set price</span>
              </div>
              <h3 id={item.question.stepKey + '-item-heading'}>{item.card.title}</h3>
              <p>{item.card.escape}</p>
              <p class="small muted">{item.card.secondary}</p>
              <details class="source-details"><summary>How this works</summary><p>See the full picture: <a href={item.card.href} target="_blank" rel="noopener">{item.card.hrefLabel}</a></p></details>
              <button class="text-link" type="button" data-edit={item.question.stepKey}>{item.question.editTitle}</button>
            </article>
          </div>
        ))}
      </section>

      <!-- ===== BRIEF-calc-result-registry-rebuild, PART 4 "total demoted" =====
           This used to be the page's hero figure (BRIEF-calc-v2-clusterA #6 already
           demoted it once, below the avoidance section); it is now demoted a second time,
           visually: a small "for context" strip rather than a big serif number, with a
           forward link into the breakdown below instead of standing alone. No content,
           data binding or honesty treatment changed here, only presentation
           (calculator.css's .answer-context). -->
      <section class="answer answer-context" aria-label="Estimated cost and scope">
        <p class="eyebrow">For context</p>
        <div class="range-prefix">About</div>
        <p class="range" aria-label="Estimated trip range">
          <span data-mirror="rangeLow">$0</span><span>&nbsp;to&nbsp;</span><span data-mirror="rangeHigh">$0</span>
        </p>
        <p class="range-scope">USD &middot; for the whole party, not per person &middot; <a class="text-link" href="#breakdown-heading">See the breakdown</a></p>
        <div class="scope-alert compact-scope" data-flight-alert>
          <strong data-mirror="flightNotice">Flights not included.</strong>
          <button class="text-link" type="button" data-edit="flights" data-flight-alert-action>Add flights &rarr;</button>
        </div>
        {materialExclusions.length > 0 && (
          <p class="unpriced"><strong>Not priced:</strong> {materialExclusions.join('; ')}.</p>
        )}
      </section>

      <div class="result-actions">
        <button class="btn btn-primary" type="button" data-share>Save / share</button>
        <button class="btn btn-secondary" type="button" data-jump-edit>Edit trip</button>
      </div>

      <!-- ===== Where the money goes (CostBreakdown, spec section 9) ===== -->
      <section class="section" aria-labelledby="breakdown-heading">
        <h2 id="breakdown-heading">Where the money goes</h2>
        <p class="section-intro">Open only the detail you need.</p>
        <div class="breakdown">
          <details class="breakdown-item" id="breakdown-flights">
            <summary><strong>Getting there</strong><span class="breakdown-amount" data-breakdown-amount="flights">Not included</span></summary>
            <div class="breakdown-body">
              <p data-breakdown-desc="flights">The round-trip airfare you gave in step 5, if any. Paid in dollars at booking, so it carries no foreign-transaction fee.</p>
              <div class="detail-line">
                <div class="line-heading"><span>Round-trip airfare</span><span data-breakdown-line-amount="flights">Not included</span></div>
                <div class="evidence-row"><span class="provenance" data-breakdown-line-provenance="flights">Basis</span><span class="status" data-breakdown-line-status="flights">Not included</span></div>
              </div>
              {L.entryCharges && L.entryCharges.map(e => (
                <div class="detail-line">
                  <div class="line-heading"><span>{e.label}</span><span>{e.value}</span></div>
                  <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span><span class="status">Included</span></div>
                  {e.source && <p class="small muted">One-off, per person. <a href={e.source} target="_blank" rel="noopener">Official source</a></p>}
                </div>
              ))}
              {L.namedZeros && L.namedZeros.map(z => (
                <div class="detail-line">
                  <div class="line-heading"><span>{z.label}</span><span>$0</span></div>
                  <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span><span class="status avoided">Already refused</span></div>
                  <p class="small muted">{z.value}</p>
                </div>
              ))}
              <button class="text-link" type="button" data-edit="flights">Change airfare</button>
            </div>
          </details>

          <details class="breakdown-item" id="breakdown-accommodation">
            <summary><strong>Accommodation</strong><span class="breakdown-amount" data-breakdown-amount="accommodation">$0</span></summary>
            <div class="breakdown-body">
              <p>Room price for the stay. Separately modeled taxes appear in the tax section, not twice.</p>
              <div class="detail-line">
                <div class="line-heading"><span>Room price for the stay</span><span data-breakdown-line-amount="accommodation">$0</span></div>
                <div class="evidence-row"><span class="provenance" data-breakdown-line-provenance="accommodation">Basis</span><span class="status">Included</span></div>
                <p class="small muted" data-breakdown-line-note="accommodation">&nbsp;</p>
              </div>
              <!-- ===== BRIEF-calc-v2-clusterA #7: sourced checkout uplift ===== -->
              <!-- The room rate is not the bill: where this country's engine-computed tourist
                   tax is non-zero (a sourced rule, never invented here), state it as an amount
                   added on top of the room figure above, not as a full checkout total, since
                   resort or other property fees are not modeled by the engine and are named as
                   unknown rather than priced. Hidden entirely, no "$0 tax" placeholder, wherever
                   the engine's own tax comes back zero or the country carries no tax block: see
                   calc-wizard.js mirror() for the one-line gate on this element. -->
              <p class="small muted checkout-uplift" data-checkout-uplift hidden>&nbsp;</p>
              <button class="text-link" type="button" data-edit="hotel">Change accommodation</button>
            </div>
          </details>

          <details class="breakdown-item" id="breakdown-daily">
            <summary><strong>Daily spending</strong><span class="breakdown-amount" data-breakdown-amount="daily">$0</span></summary>
            <div class="breakdown-body">
              <p>Food, local transport, activities and tips, for your travel style, party size and trip length.</p>
              <div class="detail-line">
                <div class="line-heading"><span>On-the-ground spend</span><span data-breakdown-line-amount="daily-2">$0</span></div>
                <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Our estimate</span><span class="status">Included</span></div>
              </div>
              <button class="text-link" type="button" data-edit="style">Change travel style</button>
            </div>
          </details>

          <details class="breakdown-item" id="breakdown-taxes">
            <summary><strong>Taxes &amp; payment fees</strong><span class="breakdown-amount" data-breakdown-amount="taxes">$0</span></summary>
            <div class="breakdown-body">
              <p>Tourist tax, card purchase fee and ATM fee, added together for this row only; each is its own line below and none of them are added into any other group.</p>
              <div class="detail-line">
                <div class="line-heading"><span data-breakdown-tax-label>Tourist tax</span><span data-breakdown-line-amount="tax">$0</span></div>
                <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span><span class="status">Included</span></div>
              </div>
              <div class="detail-line">
                <div class="line-heading"><span>Card purchase fee</span><span data-breakdown-line-amount="cardfee">$0</span></div>
                <div class="evidence-row"><span class="provenance" data-breakdown-line-provenance="cardfee">Basis</span><span class="status" data-breakdown-line-status="cardfee">Included</span></div>
                <p class="small muted">On the room and the card-paid half of daily spend.</p>
              </div>
              <div class="detail-line">
                <div class="line-heading"><span>ATM operator fee</span><span data-breakdown-line-amount="atmfee">$0</span></div>
                <div class="evidence-row"><span class="provenance"><span class="meta-key">Basis</span> Sourced rule</span><span class="status">Included</span></div>
                <p class="small muted">A flat per-withdrawal charge. This is separate from the card purchase fee above and always applies, regardless of your step 7 answer.</p>
              </div>
              <button class="text-link" type="button" data-edit="card">Change payment fees</button>
            </div>
          </details>
        </div>
        <p class="method-note"><strong>Three kinds of information.</strong> Your figures, our estimates and sourced rules are labeled separately. Whether a cost is in the total is a different label.</p>
        <details class="assumptions-accordion">
          <summary>Modeling assumptions</summary>
          <ul>
            <li>People and rooms are counted separately. This estimate does not assume a specific number of rooms for your party.</li>
            <li>Every priced night of the stay is treated the same; there is no separate arrival- or departure-day adjustment.</li>
            <li>Changing your travel style will not replace a flight or room price you have already entered; only typing a new figure does.</li>
            <li>This estimate uses one room throughout the stay. If your own booking has more than one room, check the count and enter the combined nightly price on the accommodation step.</li>
          </ul>
        </details>
      </section>
    </div>

    <!-- ===== TripSummary / Edit trip (spec section 9 "Edit trip") ===== -->
    <aside class="trip-summary" id="edit-trip" aria-labelledby="edit-trip-title" tabindex="-1">
      <h2 id="edit-trip-title">Edit your trip</h2>
      <p>Change one answer. Keep the rest.</p>
      <dl>
        <div class="summary-row"><dt>Destination</dt><dd>{c.name}</dd><button class="text-link" type="button" data-edit="destination" aria-label="Change destination">Change</button></div>
        <div class="summary-row"><dt>Travelers</dt><dd data-mirror="summaryTravelers">2 people</dd><button class="text-link" type="button" data-edit="travelers" aria-label="Change travelers">Change</button></div>
        <div class="summary-row"><dt>Trip length</dt><dd data-mirror="summaryNights">7 nights</dd><button class="text-link" type="button" data-edit="nights" aria-label="Change trip length">Change</button></div>
        <div class="summary-row"><dt>Travel style</dt><dd data-mirror="summaryStyle">Mid-range</dd><button class="text-link" type="button" data-edit="style" aria-label="Change travel style">Change</button></div>
        <div class="summary-row"><dt>Round-trip airfare</dt><dd data-mirror="summaryFlight">Not included</dd><button class="text-link" type="button" data-edit="flights" aria-label="Change round-trip airfare">Change</button></div>
        <div class="summary-row"><dt>Accommodation</dt><dd data-mirror="summaryHotel">$0 / room / night</dd><button class="text-link" type="button" data-edit="hotel" aria-label="Change accommodation">Change</button></div>
        <div class="summary-row"><dt>Card purchase fee</dt><dd data-mirror="summaryCard">Use the typical fee assumption</dd><button class="text-link" type="button" data-edit="card" aria-label="Change payment fees">Change</button></div>
        <div class="summary-row"><dt>Phone carrier</dt><dd data-mirror="summaryCarrier">Other or not sure</dd><button class="text-link" type="button" data-edit="carrier" aria-label="Change phone carrier">Change</button></div>
        {/* BRIEF-calc-result-registry-rebuild: rail and rental share one loop here too,
            same as their result card above; a fourth item of this shape needs no new row
            hand-authored, only an entry in wizardGatedExtras. */}
        {wizardGatedExtras.map(item => (
          <div class="summary-row"><dt>{item.question.summaryLabel}</dt><dd data-mirror={'summary' + item.question.stepKey.charAt(0).toUpperCase() + item.question.stepKey.slice(1)}>No or not sure</dd><button class="text-link" type="button" data-edit={item.question.stepKey} aria-label={'Change your ' + item.question.summaryLabel.toLowerCase() + ' answer'}>Change</button></div>
        ))}
      </dl>
      <div class="summary-footer">Your inputs stay available while you explore. No need to repeat the wizard.</div>
    </aside>
  </div>
</div>

<!-- ===== Error state (spec section 5 "Errors, pending and disabled") =====
     A defensive guard, not a state with a real production trigger today: the engine is
     synchronous and always present on every built country page (calc-regression-test.mjs
     asserts this), so there is no network call or async gap that can fail. This exists only
     to satisfy "never show zero, a partial calculation, or the demo fixture as a production
     fallback" in the one case the mirror script itself throws (e.g. an id genuinely missing). -->
<div class="results" data-error-view hidden>
  <div class="result-heading"><p class="eyebrow">Your trip estimate</p><h2 class="recovery-title" tabindex="-1">Your answers are still here.</h2></div>
  <section class="stale-state" role="status">
    <h2>The estimate is unavailable.</h2>
    <p>We could not read a complete result. No partial or zero total is shown. Your answers have been preserved.</p>
    <button class="btn btn-secondary" type="button" data-retry>Try again</button>
  </section>
</div>

<!-- ================= THE REAL ENGINE, permanently hidden ================= -->
<div class="wiz-underlay" data-engine-root hidden>
  <script type="application/json" id="hn-data" set:html={calcJson}></script>
  <script type="application/json" id="wiz-data" set:html={wizJson}></script>

  <div class="estimator" id="hn-app" hidden>
    <div class="erow">
      <div class="ef ef-room">
        <label for="hnRoom">Hotel price a night</label>
        <span class="moneyin"><span class="mny">$</span><input id="hnRoom" type="text" inputmode="numeric" value="150" aria-label="Hotel price per night in US dollars" /></span>
      </div>
      <label class="hn-toggle hn-toggle-inline" id="hnPaidWrap">
        <input type="checkbox" id="hnPaid" />
        <span class="hn-switch" aria-hidden="true"></span>
        <span class="hn-toggle-l">Already paid for the room</span>
      </label>
    </div>
    <p class="ef-hint-room" id="hnRoomHint" hidden></p>

    <label class="cf hn-region" id="hnRegionWrap" hidden style="display:none">
      <span class="cf-l">Where are you staying?</span>
      <span class="selwrap"><select id="hnRegion"></select></span>
    </label>

    <div class="erow erow-flight">
      <div class="ef ef-flight">
        <label for="hnFlight">Flights, round trip a person</label>
        <span class="moneyin"><span class="mny">$</span><input id="hnFlight" type="text" inputmode="numeric" value="" aria-label="Round trip flight price per traveler in US dollars" /></span>
      </div>
      <p class="ef-hint" id="hnFlightHint">Optional. Enter your round trip fare per traveler to fold flights into the total.</p>
    </div>

    <div class="erow">
      <div class="ef ef-num"><label>Travelers</label>
        <span class="stepper">
          <button type="button" class="stp" data-step="hnTrav" data-dir="-1" aria-label="One fewer traveler">&#8722;</button>
          <span class="stp-v" id="hnTrav" data-v="2">2</span>
          <button type="button" class="stp" data-step="hnTrav" data-dir="1" aria-label="One more traveler">+</button>
        </span>
      </div>
      <div class="ef ef-num"><label>Nights</label>
        <span class="stepper">
          <button type="button" class="stp" data-step="hnNights" data-dir="-1" aria-label="One fewer night">&#8722;</button>
          <span class="stp-v" id="hnNights" data-v="7">7</span>
          <button type="button" class="stp" data-step="hnNights" data-dir="1" aria-label="One more night">+</button>
        </span>
      </div>
      <div class="ef ef-style"><label>Style</label>
        <div class="seg" role="group" aria-label="Travel style">
          {styles.map((s, i) => (
            <button id={'hnStyle' + i} class={i === defaultStyleIndex ? 'on' : ''} type="button" data-per={s.per} data-cash={s.cash} data-room={s.room}>{s.n}</button>
          ))}
        </div>
      </div>
    </div>

    <CalcResult country={c} tipCalc={tipCalc} hideWizardCta={true} />
  </div>
</div>

<script>
  import { initCalcWizard } from '../scripts/calc-wizard.js';
  initCalcWizard();
</script>
<script>
  // The calculator engine, shared with the inline per-country calculator. Imported for its
  // side effects: it hydrates from #hn-data and #hn-app the moment both exist, which they do
  // above, permanently kept out of view.
  import '../scripts/calc-engine.js';
</script>
<script>
  // BRIEF-calc-tier1-review-fixes, Fix 4 (step 5): "Leave flights out" as a real button
  // next to Continue, instead of a caveat sentence describing a skip. This does not
  // duplicate or reimplement any wizard logic: it checks the SAME "exclude" radio
  // calc-wizard.js already listens on (firing a real change event so that listener runs),
  // then resubmits the SAME form calc-wizard.js already validates and advances. Exactly
  // the sequence a reader would produce by hand, simulated once on a click.
  (function () {
    const form = document.querySelector('[data-step-form="flights"]');
    const skipBtn = document.querySelector('[data-wizard-skip]');
    if (!form || !skipBtn) return;
    skipBtn.addEventListener('click', () => {
      const excludeRadio = form.querySelector('[data-choice-fieldset="flight-mode"] input[value="exclude"]');
      if (excludeRadio) {
        excludeRadio.checked = true;
        excludeRadio.dispatchEvent(new Event('change', { bubbles: true }));
      }
      form.requestSubmit();
    });
  })();
</script>

<style>
  /* Component-specific overrides beyond calculator.css, kept minimal on purpose: nearly
     everything is already in the scoped stylesheet CalculatorLayout.astro loads. */
  .wiz-underlay { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
</style>
