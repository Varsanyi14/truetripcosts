  .cc-taxseg{position:absolute;top:0;bottom:0;left:0;width:0;border-radius:0 5px 5px 0;background-color:var(--amber);background-image:repeating-linear-gradient(135deg,rgba(255,255,255,.5) 0 3px,rgba(255,255,255,0) 3px 7px);transition:width .62s cubic-bezier(.22,.61,.36,1)}
  /* The bar clips its segments to get its rounded ends. A taxed bar has to let the
