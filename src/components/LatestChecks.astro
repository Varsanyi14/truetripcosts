---
// LATEST CHECKS: a quiet strip of real, dated facts under the front-door entry.
//
// Every item is a fact stated in a country's own guide, selected by
// src/data/latest-checks.js. Read that file's header before changing anything here: it
// carries the filter rule and the reason the staleness scanner is not its source.
// This component only lays the items out. It never phrases, rounds or supplements them,
// and the "checked" pill is the fact's own date, never today's.
//
// TONE. Calm fact, no urgency. No flames, no "just changed", no counters ticking up.
// If an item cannot be read as a plain dated statement, it belongs off the strip, which
// is a data decision made in latest-checks.js, not a styling one made here.
//
// WHY IT DOES NOT LINK. The front door has exactly one action. Items are plain text so
// the strip stays a freshness signal rather than a second, moving set of links competing
// with the picker above it. That also spares us a row of focusable targets sliding out
// from under the pointer. If linking is ever wanted, wrap .lc-item in an anchor to
// /{slug} and give the marquee a real pause before it ships.
//
// MOTION. One line per item, so the strip has a fixed height and can never jump or
// reflow. It pauses on hover, it pauses on the toggle, and prefers-reduced-motion turns
// the animation off entirely and leaves the row hand-scrollable instead. Speed is set in
// px per second by the script, so adding countries lengthens the loop rather than
// speeding the text up. With JS off it falls back to the CSS duration and still scrolls.
//
// The pause control stays hidden until the script adds `lc-js`, the same way HomePreview
// handles its turner, so a no-JS visitor is never shown a button that does nothing.
import fs from 'node:fs';
import { latestChecks } from '../data/latest-checks.js';

const items = latestChecks();

// Same auto-detect the rail and the typeahead use: drop public/flags/<slug>.svg and it
// appears on the next build, and a missing file falls back to the globe.
const flagDir = process.cwd() + '/public/flags/';
const flagSrc = (slug) => fs.existsSync(flagDir + slug + '.svg') ? `/flags/${slug}.svg` : '/flags/world.svg';
---

{items.length > 0 && (
  <section class="lc" id="lc" aria-label="Latest checked money facts">
    <div class="lc-head">
      <p class="lc-lab">Latest checks</p>
      <a class="lc-all" href="/what-changed">See what changed</a>
      <button type="button" class="lc-pause" id="lc-pause" aria-pressed="false" aria-label="Pause the latest checks strip" hidden>
        <svg class="lc-ic-pause" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg class="lc-ic-play" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M8 5.2v13.6L19 12z"/></svg>
        <span class="lc-pause-t">Pause</span>
      </button>
    </div>

    <div class="lc-strip">
      <div class="lc-track" id="lc-track">
        {[0, 1].map(pass => (
          <div class="lc-run" aria-hidden={pass === 1 ? 'true' : null}>
            {items.map(it => (
              <span class="lc-item">
                <img class="lc-flag" src={flagSrc(it.slug)} alt="" width="20" height="15" loading="lazy" />
                <span class="lc-country">{it.country}</span>
                <span class="lc-fact">{it.text}</span>
                <span class="lc-chk">checked {it.checkedShort}</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .lc{margin:20px 0 2px}
  .lc-head{display:flex;align-items:center;gap:12px;margin:0 0 8px}
  .lc-lab{margin:0;font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--muted,#6F6E66)}
  /* One calm static link to the full log. The moving items stay plain text on purpose
     (see the WHY IT DOES NOT LINK note above); this sits in the header instead, so the
     freshness strip has a "see all of this" destination without turning the marquee into
     a row of sliding links. mr-auto pushes the pause button to the far right. */
  .lc-all{margin-right:auto;font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.02em;color:var(--teal-deep,#0A5644);text-decoration:none}
  .lc-all:hover{text-decoration:underline;text-underline-offset:2px}
  .lc-pause{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border:1px solid var(--line,#E5E3DB);border-radius:999px;background:transparent;color:var(--muted,#6F6E66);font:inherit;font-size:11px;line-height:1.7;cursor:pointer}
  .lc-pause:hover{color:var(--teal-deep,#0A5644);border-color:var(--teal,#0E7A5F)}
  .lc-pause .lc-ic-play{display:none}
  .lc-pause[aria-pressed="true"] .lc-ic-pause{display:none}
  .lc-pause[aria-pressed="true"] .lc-ic-play{display:inline}

  /* One line, fixed height, overflow hidden. The mask fades both ends so items enter and
     leave rather than being chopped at the edge. Both stops are 44px: at 13.5px text a
     22px left fade was about one character wide, so items arrived already sliced through
     a word and the strip read as broken rather than moving. */
  /* text-size-adjust: the reason two rounds of shrinking .lc-item did not land on a
     phone. Mobile WebKit and Blink default this to `auto` and inflate text inside blocks
     that are much wider than the viewport. .lc-track is width:max-content, so the run is
     several viewport widths across and is the only block on the front door that trips
     that heuristic: 15px hero copy in a normal-width block renders at 15px while 12px
     ticker text renders larger than its declared size. Cutting the px only scaled the
     inflated result, which is why the strip kept reading as dominant. Pinning this to
     100% opts the strip out, so the size set below is the size that ships. Do not remove
     it, or the next size change will not land either.

     PREFIXED ONLY, ON PURPOSE. Safari supports `-webkit-text-size-adjust` and not the
     unprefixed property, and the CSS minifier collapses the pair to the unprefixed one
     and drops the prefix, verified in dist. Adding `text-size-adjust:100%` alongside this
     therefore deletes the only declaration iOS reads and puts the inflation straight
     back. Blink honors the prefixed form too, so this one line covers both. */
  .lc-strip{position:relative;overflow:hidden;-webkit-text-size-adjust:100%;
    -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 44px,#000 calc(100% - 44px),transparent 100%);
    mask-image:linear-gradient(90deg,transparent 0,#000 44px,#000 calc(100% - 44px),transparent 100%)}
  .lc-track{display:flex;width:max-content;animation:lc-scroll 90s linear infinite}
  .lc-strip:hover .lc-track{animation-play-state:paused}
  .lc-track.is-paused{animation-play-state:paused}
  .lc-run{display:flex;align-items:center}
  @keyframes lc-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  .lc-item{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;padding-right:38px;font-size:12px;line-height:2.1;color:#3B4A46}
  .lc-flag{flex:none;border-radius:2px;box-shadow:0 0 0 1px rgba(22,48,44,.08)}
  .lc-country{font-weight:600;color:var(--ink,#16302C)}
  .lc-fact{color:#3B4A46}
  .lc-chk{font-family:var(--mono);font-size:10.5px;letter-spacing:.03em;color:var(--muted,#6F6E66);background:var(--green-bg,#E7F3E9);border-radius:999px;padding:1px 8px}

  @media (max-width:560px){
    /* 11.5px is the floor: these are real dated facts and stay legible while scrolling.
       Below this the checked pill (10.5px) and the label (11px) stop reading as the
       smaller type, which is the inversion the size relationship exists to avoid. */
    .lc-item{font-size:11.5px;padding-right:30px}
    .lc-fact{color:#4A5A55}
  }

  /* Reduced motion: no animation at all, and the row becomes hand-scrollable so every
     item is still reachable. The duplicate run is dropped so nothing reads twice. */
  @media (prefers-reduced-motion:reduce){
    .lc-track{animation:none;width:auto}
    .lc-run[aria-hidden="true"]{display:none}
    .lc-strip{overflow-x:auto;-webkit-mask-image:none;mask-image:none}
  }
</style>

<script>
  // Sets the marquee speed in px per second and wires the pause toggle. Self-contained
  // with an early return, so it stays inert if the strip is absent (zero qualifying
  // facts) or if the visitor asked for reduced motion.
  (function () {
    var track = document.getElementById('lc-track');
    var btn = document.getElementById('lc-pause');
    if (!track) return;

    var reduce = false;
    try {
      reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (e) {}
    if (reduce) return;

    var PX_PER_SEC = 60;
    var run = track.firstElementChild;

    function tune() {
      if (!run) return;
      var w = run.getBoundingClientRect().width;
      if (w > 0) track.style.animationDuration = Math.round(w / PX_PER_SEC) + 's';
    }
    tune();
    // Webfonts land after first paint and change the run's width, so measure again once
    // they are ready. Guarded: not every browser exposes document.fonts.
    if (document.fonts && document.fonts.ready && typeof document.fonts.ready.then === 'function') {
      document.fonts.ready.then(tune).catch(function () {});
    }

    if (btn) {
      btn.hidden = false;
      btn.addEventListener('click', function () {
        var paused = track.classList.toggle('is-paused');
        btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
        btn.setAttribute('aria-label', paused ? 'Play the latest checks strip' : 'Pause the latest checks strip');
        var t = btn.querySelector('.lc-pause-t');
        if (t) t.textContent = paused ? 'Play' : 'Pause';
      });
    }
  })();
</script>
