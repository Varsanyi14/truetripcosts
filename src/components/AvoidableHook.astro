---
// THE COUNTRY-GUIDE AVOIDABLE HOOK (BRIEF-v2-experience-build, Part 2). A compact teaser
// near the top of every country guide's money content that pulls the reader toward the
// calculator, in real dollars, without ever summing avoidable items (the honesty spine's
// rule 1: never a total, even a typical range).
//
// The one figure it shows is the country's SINGLE LARGEST HARD avoidable item at the
// engine's own default trip (nights: 7, trav: 2, this country's own default travel
// style), never a sum: src/data/avoidable-highlight.js computes it, re-deriving the same
// arithmetic calc-engine.js performs, cross-checked against the real engine by
// scripts/check-avoidable-highlight.mjs. This file adds no numbers of its own.
//
// Locked copy (Decision 1 of the v2 experience build). The calm-country variant's "See
// why" is an inline link ending its one sentence, not a separate button, unlike the
// priced variant's own "Calculate what you can avoid on your trip" button below its
// paragraph: that asymmetry is the locked copy as given, not an oversight.
import { avoidableHighlightFor } from '../data/avoidable-highlight.js';

const { country: c } = Astro.props;
const highlight = avoidableHighlightFor(c);

function money(n) {
  return '$' + Math.round(n).toLocaleString('en-US');
}
// The established house range pattern: "to" with non-breaking spaces, never a dash.
// Collapses to a single figure when low and high round to the same dollar (true for
// every country whose largest item is the flat card/ATM fee line rather than a range).
function moneyRange(lo, hi) {
  return (Math.round(lo) === Math.round(hi)) ? money(lo) : (money(lo) + '&nbsp;to&nbsp;' + money(hi));
}

const hookHtml = highlight.calmEligible
  ? `The room rate isn't the bill, but in ${c.name}, it's close. Your card and a bit of care cover it, with little to refuse. <a class="ah-seewhy" href="/calculator/${c.slug}">See why <span aria-hidden="true">&rarr;</span></a>`
  : `The room rate isn't the bill, and the sticker rate isn't the price. In ${c.name}, ${highlight.largest.phrase} alone can quietly cost a typical traveler about ${moneyRange(highlight.largest.lo, highlight.largest.hi)}, and it's one of several fees you can refuse.`;
---
<div class="avoid-hook">
  <p class="ah-eyebrow">What you can avoid here</p>
  <p set:html={hookHtml} />
  {!highlight.calmEligible && (
    <div class="ah-cta">
      <a class="btn" href={'/calculator/' + c.slug}>Calculate what you can avoid on your trip <span aria-hidden="true">&rarr;</span></a>
    </div>
  )}
</div>
