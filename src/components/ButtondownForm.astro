---
// THE SUBSCRIBE FORM: a native HTML form posting straight to Buttondown, with no
// JavaScript at all.
//
// HOW IT WORKS. Buttondown's embed-subscribe endpoint is built to be the `action` of a
// plain <form method="post">. The browser posts the email, Buttondown handles
// validation, CAPTCHA if needed, the double opt-in confirmation email, and unsubscribe,
// all on their side. The form simply navigates there on submit, which is expected
// behavior for this endpoint, not a degraded fallback. No fetch, no SDK, no iframe, no
// third-party script, no API key in the page. Do NOT swap this for Buttondown's iframe
// or web-component embeds: those pull third-party rendering into the page, and the
// whole point of this form is that it adds zero runtime JavaScript to the site.
//
// THE ENDPOINT. Buttondown addresses the endpoint by account username. GARY FILLS THIS
// IN before deploy, from his Buttondown account, in exactly one place: the
// BUTTONDOWN_USERNAME constant below. It is deliberately a loud placeholder rather than
// a guess, because a wrong username would post readers' addresses to someone else's
// list. The changelog gate warns while the placeholder is still present.
//
// THE TAG. Buttondown lets a hidden input tag subscribers at signup, which is how the
// worker-based signup already labels its subscribers (general, country:<slug>). This
// form tags everyone `changelog` by default so these signups are distinguishable in the
// same account. The `tag` prop exists so a future per-page form ("tell me when THIS
// country's facts change") can pass its own value, e.g. country:japan to match the
// worker's convention, with no rework here. That per-page capture is a later build; do
// not add it page-wide now.
//
// THE VOICE. The pitch is the one thing an AI answer cannot give: we tell you when a
// fact you might rely on changes. No urgency, no subscriber counts, no exclamation
// marks. Keep it that way.
const {
  tag = 'changelog',
  heading = 'Get told when a travel-money fact changes',
  sub = 'An occasional email, built from this log: what changed, why it matters, and nothing else. No hype, no sales pitch, unsubscribe in one click.',
  compact = false,
} = Astro.props;

// Gary's Buttondown username, from the account dashboard. Fill before deploy.
   const BUTTONDOWN_USERNAME = 'truetripcosts';
const action = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`;
const emailId = compact ? 'bd-email-footer' : 'bd-email';
---

<form class={'bd' + (compact ? ' bd-compact' : '')} action={action} method="post" target="_blank"> rel="noopener"
  <label class="bd-h" for={emailId}>{heading}</label>
  {!compact && <p class="bd-sub">{sub}</p>}
  <div class="bd-row">
    <input id={emailId} class="bd-in" type="email" name="email" required placeholder="you@example.com" autocomplete="email" inputmode="email" />
    <input type="hidden" name="tag" value={tag} />
    <button class="bd-btn" type="submit">Subscribe</button>
  </div>
  <p class="bd-fine">We keep your email only to send what you asked for. Leave anytime. See our <a href="/privacy">privacy note</a>.</p>
</form>

<style>
  .bd{background:var(--card,#FFFFFF);border:1px solid var(--line,#E5E3DB);border-radius:var(--radius,14px);padding:22px 24px;max-width:560px}
  .bd-h{display:block;font-weight:600;font-size:17px;color:var(--ink,#16302C);margin:0 0 6px;cursor:pointer}
  .bd-sub{font-size:14.5px;line-height:1.55;color:var(--muted,#6F6E66);margin:0 0 14px}
  .bd-row{display:flex;gap:8px;flex-wrap:wrap}
  .bd-in{flex:1 1 220px;font-family:inherit;font-size:15px;color:var(--ink,#16302C);background:#fff;border:1px solid var(--line,#E5E3DB);border-radius:999px;padding:10px 16px;min-width:0}
  .bd-in:focus{outline:2px solid var(--teal,#0E7A5F);outline-offset:1px;border-color:var(--teal,#0E7A5F)}
  .bd-btn{font-family:inherit;font-size:14.5px;font-weight:500;border-radius:999px;padding:10px 20px;border:1px solid var(--teal,#0E7A5F);background:var(--teal,#0E7A5F);color:#fff;cursor:pointer;white-space:nowrap}
  .bd-btn:hover{background:var(--teal-deep,#0A5644);border-color:var(--teal-deep,#0A5644)}
  .bd-fine{font-size:12px;color:var(--muted,#6F6E66);margin:10px 0 0}
  .bd-fine a{color:var(--teal-deep,#0A5644)}

  /* The quiet footer variant: no card chrome, smaller heading, one line where it fits. */
  .bd-compact{background:transparent;border:0;border-radius:0;padding:0;max-width:480px}
  .bd-compact .bd-h{font-size:13.5px;margin-bottom:8px}
  .bd-compact .bd-in{font-size:13.5px;padding:8px 14px}
  .bd-compact .bd-btn{font-size:13px;padding:8px 16px}
  .bd-compact .bd-fine{font-size:11.5px}
</style>
