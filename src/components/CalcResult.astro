     put "claim" on a line by itself. Unsupported browsers just wrap normally. */
  .cs-hint{flex:1;min-width:0;font-size:13.5px;color:var(--muted);line-height:1.35;text-wrap:balance}
  .cs-chev{flex:none;color:var(--muted);transition:transform .2s ease}
  .cs[open] .cs-chev{transform:rotate(180deg)}
  .cs-body{padding:2px 15px 15px}

  /* THE PREVIEW FIGURE. This is what replaced the always-open fees section: the number on a
     closed row is the hook, so it has to be legible enough to stop a reader without shouting
     at them. Tabular figures keep the four rows' numbers aligned down the right edge. */
  .cs-prev{flex:none;font-family:var(--serif);font-size:17px;font-weight:500;color:var(--ink);line-height:1.2;font-variant-numeric:tabular-nums}
  /* The methodology row's tag, which sits where the others' figures sit so the column still
     reads as a column, without pretending to be a figure. */
  .cs-prev-tag{font-family:var(--mono);font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
  .cs-fees .cs-prev{color:var(--teal-deep)}

  /* The fees section is closed like the rest now, so it keeps only a left edge and a faint
     tint: enough to say "this is the one that matters" without the always-open treatment doing
     that job. No --bg-accent token exists on the site, so this reuses the teal tint the region
     bars and the guide prompt already use, at the same values. */
  .cs-fees{border-color:rgba(14,122,95,.3);background:rgba(14,122,95,.04);border-left:3px solid var(--teal)}
  .cs-fees .cs-ic{background:#fff;border:1px solid rgba(14,122,95,.2)}
  .cs-fees .cs-t{color:var(--teal-deep)}

  /* ----- the two halves of the fees section ----- */
  .cs-half{margin:12px 0 8px;font-family:var(--mono);font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.09em}
  .cs-half-pay{color:var(--muted)}
  .cs-half-keep{color:#10502C;margin-top:0}
  .cs-xref{margin:10px 0 0;font-size:13.5px;color:var(--muted);line-height:1.55}

  /* The avoidable half, set on its own ground so the split is visible at a glance: costs
     above, refusals below. Green, because this is the only block on the page that is about
     money staying put. */
  .cs-keep{margin:16px 0 0;padding:13px 15px;background:var(--green-bg);border:1px solid #C2E0C8;border-radius:10px}
  .cs-keep-lead{margin:0 0 11px;font-size:13.5px;color:#3B4A46;line-height:1.55}
  .cs-keep-list{list-style:none;margin:0;padding:0;display:grid;gap:11px}
  .cs-keep-item{padding:11px 13px;background:#fff;border:1px solid #D3E7D8;border-radius:9px}
  .cs-keep-top{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
  .cs-keep-h{font-size:14.5px;font-weight:600;color:var(--ink);line-height:1.35}
  /* A figure appears here only where a sourced field supports one, so this style is used by
