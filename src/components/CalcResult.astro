  .ex-seg-payband{background:repeating-linear-gradient(135deg,rgba(180,83,9,.85) 0 3px,rgba(180,83,9,.3) 3px 6px)}
  .ex-seg-dodgeband{background:repeating-linear-gradient(135deg,rgba(21,128,61,.85) 0 3px,rgba(21,128,61,.3) 3px 6px)}
  .ex-scale{margin:7px 0 0;font-size:12.5px;color:var(--muted);line-height:1.5}

  /* ----- the itemized drop-down ----- */
  .ex-list{margin:13px 0 0;border-top:1px solid var(--line)}
  .ex-sum{display:flex;align-items:center;gap:10px;padding:11px 0 0;cursor:pointer;list-style:none}
  .ex-sum::-webkit-details-marker{display:none}
  .ex-sum:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
  .ex-sum-t{flex:1;min-width:0;font-size:14px;font-weight:600;color:var(--teal-deep);line-height:1.35}
  .ex-sum-n{flex:none;font-family:var(--mono);font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}
  .ex-list[open] .cs-chev{transform:rotate(180deg)}
  .ex-body{padding:2px 0 0}
  .ex-body-lead{margin:9px 0 2px;font-size:13px;color:var(--muted);line-height:1.55}
  .ex-group{margin:12px 0 0}
  .ex-group .cs-half{margin-top:0}

  /* ----- a sourced line: a label, its unit, its detail ----- */
  .cs-line{display:block;padding:11px 0 0;margin:11px 0 0;border-top:1px solid var(--line)}
  .cs-line-h{display:block;font-size:14.5px;font-weight:600;color:var(--ink);line-height:1.35}
  /* The unit is not decoration. A per-person one-off and a per-night charge are different
     money on the same trip, and this line is what stops the two being read as one. */
  .cs-line-u{display:block;margin-top:2px;font-family:var(--mono);font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}
  .cs-line-d{display:block;margin-top:5px;font-size:14px;color:#3B4A46;line-height:1.55}
