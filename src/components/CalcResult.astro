  .cs-keep-fig{flex:none;font-family:var(--serif);font-size:16px;font-weight:500;color:#10502C;line-height:1.2;white-space:nowrap}
  .cs-keep-fnote{display:block;margin-top:1px;font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);text-align:right}
