        {exHasFigure && (
          <div class="ex-barwrap" id="exBarWrap" hidden>
            <div class="ex-bar" aria-hidden="true">
              <div class="ex-seg ex-seg-pay" id="exSegPay"></div>
              <div class="ex-seg ex-seg-payband" id="exSegPayBand"></div>
              <div class="ex-seg ex-seg-dodge" id="exSegDodge"></div>
              <div class="ex-seg ex-seg-dodgeband" id="exSegDodgeBand"></div>
            </div>
            <p class="ex-scale" id="exScale">&nbsp;</p>
          </div>
        )}

        {/* THE DROP-DOWN: every element itemized, each with its link to the page that
            explains the way out. The rows are unchanged from the block that used to sit at
