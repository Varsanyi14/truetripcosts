        {exHasFigure && (
          <div
            class="ex-nums"
            id="exNums"
            data-pay-live={EX.payLive ? '1' : '0'}
            data-pay-pct-lo={String(EX.payPctLo)}
            data-pay-pct-hi={String(EX.payPctHi)}
            data-pay-flat-lo={String(EX.payFlatLo)}
            data-pay-flat-hi={String(EX.payFlatHi)}
            data-pay-pp-lo={String(EX.payPpLo)}
            data-pay-pp-hi={String(EX.payPpHi)}
            data-pay-unpriced={String(EX.payUnpriced)}
            data-dodge-flat-lo={String(EX.dodgeFlatLo)}
            data-dodge-flat-hi={String(EX.dodgeFlatHi)}
            data-dodge-pp-lo={String(EX.dodgePpLo)}
            data-dodge-pp-hi={String(EX.dodgePpHi)}
            data-dodge-unpriced={String(EX.dodgeUnpriced)}
          >
            {/* AMBER. Avoidable but real: money that genuinely leaves the account if the
                reader does nothing. Hidden rather than shown as $0 where a country has no
                priced pay-side item. */}
            <div class="ex-n ex-n-pay" id="exPay" hidden>
              <span class="ex-n-v num" id="exPayV">&nbsp;</span>
              <span class="ex-n-l">you'll pay unless you act</span>
              <span class="ex-n-n" id="exPayN">&nbsp;</span>
            </div>
            {/* GREEN, and the hero. Where nothing on this side carries a sourced price the
                value is a COUNT rather than a dollar figure, and it says so: a scam with no
                published price is still worth naming, and is never worth pricing. */}
            <div class="ex-n ex-n-dodge" id="exDodge" hidden>
              <span class="ex-n-v" id="exDodgeV">&nbsp;</span>
              <span class="ex-n-l" id="exDodgeL">&nbsp;</span>
              <span class="ex-n-n" id="exDodgeN">&nbsp;</span>
            </div>
          </div>
        )}

        {/* THE EXPOSURE BAR. Full width is the trip total, so the blocks are a proportion and
