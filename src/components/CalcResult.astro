  .ex{border:1px solid rgba(14,122,95,.3);border-radius:12px;background:var(--card);padding:15px 15px 13px;border-left:3px solid var(--teal)}
  .ex-top{display:flex;align-items:center;gap:11px}
  .ex-ic{flex:none;width:29px;height:29px;border-radius:999px;background:#fff;border:1px solid rgba(14,122,95,.2);color:var(--teal-deep);display:flex;align-items:center;justify-content:center}
  .ex-h{margin:0;font-size:15.5px;font-weight:600;color:var(--teal-deep);line-height:1.3}
  .ex-lead{margin:9px 0 0;font-size:13.5px;color:#3B4A46;line-height:1.55}

