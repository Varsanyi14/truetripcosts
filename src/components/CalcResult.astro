  .ex-nums:has(.ex-n[hidden]) .ex-n:not([hidden]){grid-column:1 / -1}
  .ex-n-pay{background:var(--amber-bg);border-color:rgba(180,83,9,.22)}
  .ex-n-dodge{background:var(--green-bg);border-color:#C2E0C8}
  .ex-n-v{display:block;font-family:var(--serif);font-size:22px;font-weight:500;line-height:1.15;font-variant-numeric:tabular-nums}
  .ex-n-pay .ex-n-v{color:var(--amber)}
  .ex-n-dodge .ex-n-v{color:#10502C}
  .ex-n-l{display:block;margin-top:3px;font-size:13px;font-weight:600;color:var(--ink);line-height:1.4}
  .ex-n-n{display:block;margin-top:4px;font-size:12px;color:var(--muted);line-height:1.45}

  /* THE BAR. Full width is the trip total, so a block can only ever be a proportion of a
     real number. The track is the rest of the trip and is deliberately neutral: colouring it
     would turn a proportion into a verdict. */
  .ex-barwrap{margin:12px 0 0}
