<script>
  // The calculator engine now lives in its own module (src/scripts/calc-engine.js) so the
  // /calculator wizard can drive the same render() without a second copy. This import is
  // for its side effects only: same ids, same math, no behaviour change. See that file's
  // header for the id contract it depends on.
  import '../scripts/calc-engine.js';
</script>

<script>
  // Open the curated card shortlist when an in-page link points at it, and honour a
  // #calcNoFee deep link on load or hash change. It is a native <details>, so it still
  // opens without this; this just wires the "see cards" links and the cash-helper link.
  (function () {
    const box = document.getElementById('calcNoFee');
    if (!box) return;
    function open() {
      box.open = true;
      try { box.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) { box.scrollIntoView(); }
    }
    document.querySelectorAll('a[href="#calcNoFee"]').forEach(a => {
      a.addEventListener('click', () => { box.open = true; });
    });
    if (location.hash === '#calcNoFee') open();
    window.addEventListener('hashchange', () => { if (location.hash === '#calcNoFee') open(); });
  })();
</script>

<style>
  .crumb{font-family:var(--mono);font-size:11.5px;letter-spacing:.01em;color:var(--muted);margin:20px 0 20px;display:flex;flex-wrap:wrap;align-items:center;gap:8px}
  .crumb a{color:var(--teal-deep);text-decoration:none;font-weight:500}
  .crumb a:hover{text-decoration:underline}
  .crumb-sep{color:var(--line)}
  .rel-hlink{color:inherit;text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px}
  .rel-hlink:hover{text-decoration-color:var(--teal)}
  /* Pairs with the optional /updates/ hook on the change card. Sized below the card's own
     prose so the card still reads as a fact rather than as a link. */
  .rclink{display:inline-block;margin:7px 0 0;font-family:var(--mono);font-size:11.5px;font-weight:500;color:var(--teal-deep);text-decoration:none}
  .rclink:hover{text-decoration:underline;text-underline-offset:2px}
  /* The thin banner crop. 5:1 against the asset's native 16:9, so the strip is a little under
     a third of its old height: warm enough to keep, short enough to scroll past. The crop is
     pulled slightly below centre because the subject of these illustrations sits low in the
     frame, so a dead-centre crop would show mostly empty wall. */
  .secart-thin{aspect-ratio:5/1;overflow:hidden}
  .secart-thin img{width:100%;height:100%;object-fit:cover;object-position:center 62%;display:block}
  /* Slightly taller on a phone, where 5:1 across a narrow viewport becomes a sliver. */
  @media (max-width:560px){ .secart-thin{aspect-ratio:3/1} }

  #cards{scroll-margin-top:74px}
  /* Every in-page jump target has to clear the sticky nav, or it lands with its first line
     tucked underneath. The site already does this for #cards and .cardlist at 74px; #calc
     never got it, so every "Check yours" and "Estimate your daily costs" link in the guides
     and the country data files has been landing clipped. Same figure, so all the jumps on
