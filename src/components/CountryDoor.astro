---
// THE DOOR. The calculator's opening, replacing what used to be a plain form top.
//
// Two jobs, in order. It invites the traveler to name a destination and run the number,
// and below a hairline it shows what the desk actually holds, by rolling one real fact at
// a time from other countries. The teaser is the proof: it says "we did this for 59
// places" without a marketing sentence claiming it.
//
// WHY THE CURRENT COUNTRY IS NOT IN THE TEASER. On a country page the destination is
// already named, and that country's fact is the gut-punch immediately below this. So the
// teaser deliberately shows OTHERS: the fact for the country you are on gives way to the
// full frame beneath, and the sample never duplicates it a few pixels apart.
//
// THE POOL IS NARROWER THAN THE FACT MAP ON PURPOSE. A fact on the front door is the most
// public claim the site makes and the worst place to go stale, so the teaser draws only
// from facts marked doorPool in hero-facts.js. Argentina is excluded there, by its own
// flag rather than by a name check here, so the rule holds for the next volatile fact
// somebody adds without anyone remembering to come back to this file.
//
// FLAGS ARE IMAGES, NEVER EMOJI. Emoji flags do not render at all on Windows and vanish
// on some screens, which would leave the teaser rows visibly broken for a large share of
// a US audience. These are the /flags/<slug>.svg assets the homepage and hubs already
// use, with the ISO country code as a text fallback if a file is ever missing, so a row
// can degrade to readable rather than to nothing.
//
// THE ROLL IS CALM, AND IT STOPS WHEN LOOKED AT. It pauses on hover and on keyboard focus
// so a reader can actually finish a line, and under prefers-reduced-motion it does not
// animate at all: it renders as a short static list instead. A restless carousel would
// contradict the whole posture of the site.
import { heroFacts, doorPool } from '../data/hero-facts.js';
import { countries } from '../data/index.js';
import fs from 'node:fs';

const { country: c } = Astro.props;

// Every live guide, for the picker, with the current country preset.
const pickable = countries.filter(x => x.live && !x.blocked).sort((a, b) => a.name.localeCompare(b.name));

// The teaser rows: door-pool facts for countries other than this one. Each row carries
// the country's own flag asset, its name, and the first sentence of its locked fact,
// which is the one-liner. Nothing is rewritten for the teaser.
const flagDir = process.cwd() + '/public/flags/';
const byslug = new Map(countries.map(x => [x.slug, x]));
const firstSentence = (s) => {
  const t = String(s || '').trim();
  const m = t.match(/^(.*?[.?!])(\s|$)/s);
  return m ? m[1] : t;
};
const teaser = doorPool
  .filter(slug => slug !== c.slug)
  .map(slug => {
    const country = byslug.get(slug);
    if (!country || !country.live || country.blocked) return null;
    return {
      slug,
      name: country.name,
      // The ISO code is the non-emoji fallback when a flag file is missing.
      iso: String(country.iso2 || slug.slice(0, 2)).toUpperCase(),
      flag: fs.existsSync(flagDir + slug + '.svg') ? '/flags/' + slug + '.svg' : null,
      line: firstSentence(heroFacts[slug].fact),
    };
  })
  .filter(Boolean);
---
<div class="door">
  <div class="door-invite">
    <h2 class="door-h">What will your trip really cost?</h2>
    <p class="door-sub">Name where you are going. We will show you what nobody quotes.</p>

    <div class="door-pick">
      <label class="cf door-sel">
        <span class="cf-l">Destination</span>
        <span class="selwrap">
          <select id="doorSel" aria-label="Choose a destination">
            {pickable.map(t => (
              <option value={t.slug} selected={t.slug === c.slug}>{t.name}</option>
            ))}
          </select>
        </span>
      </label>
      {/* The verb, seeded quietly and only here. On this country it scrolls to the
          number; on any other it opens that guide at its calculator. */}
      <button type="button" class="btn door-go" id="doorGo" data-here={c.slug}>TTC it
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>

  {teaser.length > 0 && (
    <div class="door-taste" id="doorTaste" data-dwell="2600">
      <p class="door-taste-lab">For instance, right now</p>

      {/* The rolling window. One row visible at a time, the next sliding up under it.
          Under reduced motion the whole viewport is unclipped by CSS and the first few
          rows simply stack as a static list, with no script running at all. */}
      <div class="door-roll" id="doorRoll" tabindex="0" role="region" aria-label="Sample facts from other country guides" aria-live="off">
        <ul class="door-track" id="doorTrack">
          {teaser.map(t => (
            <li class="door-row">
              <span class="door-flag">
                {t.flag
                  ? <img src={t.flag} alt="" width="22" height="16" loading="lazy" decoding="async" />
                  : <span class="door-iso">{t.iso}</span>}
              </span>
              <a class="door-cty" href={'/' + t.slug}>{t.name}</a>
              <span class="door-line">{t.line}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}
</div>

<script>
  // The door: the picker button, and the roll-up teaser with its three guardrails.
  (function () {
    // ----- the picker -----
    // Same country: scroll to the number already on this page. Different country: open
    // that guide at its calculator. Falls through to a plain link-free no-op if either
    // element is missing, so a partial render can never throw.
    const sel = document.getElementById('doorSel');
    const go = document.getElementById('doorGo');
    if (sel && go) {
      const here = go.dataset.here;
      const run = () => {
        const to = sel.value;
        if (!to) return;
        if (to === here) {
          const target = document.getElementById('calc') || document.getElementById('hn-app');
          if (target) { try { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) { target.scrollIntoView(); } }
          return;
        }
        window.location.href = '/' + to + '#calc';
      };
      go.addEventListener('click', run);
      // Enter on the select is the same gesture as pressing the button.
      sel.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); run(); } });
    }

    // ----- the roll -----
    const roll = document.getElementById('doorRoll');
    const track = document.getElementById('doorTrack');
    const taste = document.getElementById('doorTaste');
    if (!roll || !track || !taste) return;

    const rows = Array.from(track.children);
    if (rows.length < 2) return;   // nothing to roll between

    // GUARDRAIL 3: reduced motion. Not a slower animation, no animation: the class
    // switches the clipped window into a plain static list and the timer never starts.
    const mq = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
    let timer = 0;
    let i = 0;
    let paused = false;

    const DWELL = Math.max(1200, parseInt(taste.dataset.dwell, 10) || 2600);

    function stop() { if (timer) { clearTimeout(timer); timer = 0; } }

    function step() {
      stop();
      if (paused) return;                       // hover or focus is holding it
      i = (i + 1) % rows.length;
      // The transition itself lives in CSS (.55s ease-in-out), so this only moves the
      // track. Row height is uniform, so one row is one step.
      track.style.transform = 'translateY(-' + (i * 100 / rows.length) + '%)';
      timer = setTimeout(step, DWELL);
    }

    function start() {
      if (mq && mq.matches) return;             // reduced motion: stay static
      stop();
      timer = setTimeout(step, DWELL);
    }

    function reset() {
      stop();
      i = 0;
      track.style.transform = 'translateY(0%)';
    }

    function apply() {
      if (mq && mq.matches) {
        taste.classList.add('door-static');
        reset();
      } else {
        taste.classList.remove('door-static');
        start();
      }
    }

    // GUARDRAIL 1: pause on hover and on keyboard focus. It is a calm desk, so a reader
    // who reaches for a line gets to finish it. focusin/out covers the container and the
    // country links inside it.
    const hold = () => { paused = true; stop(); };
    const release = () => { paused = false; start(); };
    roll.addEventListener('mouseenter', hold);
    roll.addEventListener('mouseleave', release);
    roll.addEventListener('focusin', hold);
    roll.addEventListener('focusout', release);

    // Stop entirely when the tab is hidden, so a backgrounded page is not animating.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop(); else if (!paused) start();
    });

    if (mq && mq.addEventListener) mq.addEventListener('change', apply);
    apply();
  })();
</script>

<style>
  .door{margin:0 0 4px}
  .door-h{font-family:var(--serif);font-weight:500;font-size:27px;line-height:1.2;color:var(--ink);letter-spacing:-.01em;margin:0}
  .door-sub{margin:8px 0 0;font-size:16px;color:var(--muted);line-height:1.5}

  .door-pick{display:flex;align-items:flex-end;gap:11px;margin:18px 0 0}
  .door-sel{flex:1;min-width:0}
  .door-go{flex:none;padding:11px 22px}

  /* The hairline, then the taste. Quiet by construction: a mono label, small type, and
     no border of its own beyond the rule that separates it from the invitation. */
  .door-taste{margin:20px 0 0;padding:16px 0 0;border-top:1px solid var(--line)}
  .door-taste-lab{margin:0 0 8px;font-family:var(--mono);font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}

  /* The clipped window. One row tall, so the track slides a row at a time. The fixed
     height is what makes a uniform step possible; it is generous enough for two lines of
     the fact on a phone. */
  .door-roll{height:52px;overflow:hidden;position:relative;border-radius:8px}
  .door-roll:focus-visible{outline:2px solid var(--teal);outline-offset:3px}
  .door-track{list-style:none;margin:0;padding:0;transition:transform .55s ease-in-out;will-change:transform}
  .door-row{height:52px;display:flex;align-items:center;gap:10px;padding:0 2px}

  .door-flag{flex:none;width:22px;height:16px;display:flex;align-items:center;justify-content:center}
  .door-flag img{display:block;width:22px;height:16px;border-radius:2px;object-fit:cover}
  /* The non-emoji fallback: the ISO code as text, so a missing asset degrades to
     something readable rather than to blank space. */
  .door-iso{font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.04em;color:var(--muted);border:1px solid var(--line);border-radius:2px;padding:1px 3px;line-height:1.1}

  .door-cty{flex:none;font-family:var(--mono);font-size:12px;font-weight:600;color:var(--ink);text-decoration:none;letter-spacing:.02em}
  .door-cty:hover{color:var(--teal-deep);text-decoration:underline}
  .door-line{flex:1;min-width:0;font-size:14px;color:var(--muted);line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}

  /* Reduced motion: unclip the window, drop the transition, show a short static list.
     Nothing moves and no timer runs. */
  .door-static .door-roll{height:auto;overflow:visible}
  .door-static .door-track{transform:none !important;transition:none}
  .door-static .door-row{height:auto;padding:7px 2px;align-items:flex-start}
  .door-static .door-flag{margin-top:2px}
  /* A static list of everything would bury the calculator, so the still version shows a
     handful and stops. It is a taste either way. */
  .door-static .door-row:nth-child(n+5){display:none}

  @media (max-width:560px){
    .door-h{font-size:23px}
    .door-sub{font-size:15px}
    /* The button drops under the picker rather than squeezing it to a stub. */
    .door-pick{flex-direction:column;align-items:stretch;gap:10px}
    .door-go{justify-content:center}
    .door-roll{height:58px}
    .door-row{height:58px}
    .door-line{font-size:13.5px}
  }
</style>
