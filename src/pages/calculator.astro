---
// STEP 1 OF THE WIZARD: DESTINATION, standalone.
//
// Why this is its own page rather than a first screen inside CalcWizard.astro: this is a
// static site (astro.config.mjs sets no `output`, so every route is pre-rendered at build
// time), and each country's calc data (tax rules, flight ranges, travel styles) is baked into
// that country's own static page. There is no server to answer "give me Japan's data" at
// request time, and shipping every country's data into one client bundle just to pick a name
// would be the wrong tradeoff. So destination picks here are cheap (just names and slugs, the
// same list the destination switcher on every guide already uses) and a choice is a real
// navigation to /calculator/<slug>, a full static page with that country's real numbers
// already in it. Steps 2 through 7 live there, in CalcWizard.astro.
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import QuestionPanel from '../components/calc/QuestionPanel.astro';
import DestinationChoice from '../components/calc/DestinationChoice.astro';
import { countries } from '../data/index.js';

const live = countries.filter(c => c.live).slice().sort((a, b) => a.name.localeCompare(b.name));
---
<CalculatorLayout
  title="Trip cost calculator: what will your trip really cost?"
  description="A one-question-at-a-time trip cost calculator. Pick a destination and get a ranged total, never a false-precise number, plus every fee you can refuse to pay."
>
  <QuestionPanel stepKey="destination" stepNumber={1} stepLabel="Destination" initiallyVisible isFirst
    title="Where are you going?" intro="Choose one country for this trip estimate. Search narrows this list; it never chooses for you.">
    <DestinationChoice countries={live} selectedSlug={null} />
  </QuestionPanel>
</CalculatorLayout>

<script is:inline>
  (function () {
    function norm(s) { return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
    const search = document.querySelector('[data-destination-search]');
    const list = document.querySelector('[data-destination-list]');
    const empty = document.querySelector('[data-destination-empty]');
    const form = document.querySelector('[data-step-form="destination"]');
    if (!search || !list || !form) return;
    const rows = Array.prototype.slice.call(list.querySelectorAll('.choice'));
    search.addEventListener('input', () => {
      const q = norm(search.value.trim());
      let shown = 0;
      rows.forEach((row) => {
        const hit = q === '' || norm(row.dataset.name).indexOf(q) !== -1;
        row.hidden = !hit;
        if (hit) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const checked = form.querySelector('input[name="destination"]:checked');
      const errEl = form.querySelector('.field-error');
      if (!checked) {
        if (errEl) errEl.textContent = 'Choose a destination before continuing.';
        search.setAttribute('aria-invalid', 'true');
        search.focus();
        return;
      }
      window.location.href = '/calculator/' + checked.value;
    });
  })();
</script>
