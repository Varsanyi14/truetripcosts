---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Spoke from '../../components/Spoke.astro';
import { countries } from '../../data/index.js';
import { rulesFor } from '../../data/money-rules.js';

// One page per spoke, at /{countrySlug}/{spokeSlug}, generated from the spokes array on
// each live country. Mirrors [slug].astro, one level deeper, so there is no collision:
// [slug].astro owns /{slug}, this owns /{slug}/{spoke}. A spoke can be hidden with
// live:false the same way a country is gated by .live.
export function getStaticPaths() {
  return countries
    .filter(c => c.live)
    .flatMap(c => (c.spokes || [])
      .filter(s => s.live !== false)
      .map(s => ({ params: { slug: c.slug, spoke: s.slug }, props: { country: c, spoke: s } })));
}
const { country, spoke } = Astro.props;
// Spokes are the deepest pages in the cluster, and a reader on one of them is the exact
// person who wants the pocket card. Linking from here also stops the card being an
// orphan reachable only from the country hub.
const moneyRules = rulesFor(country.slug);
---
<Base title={spoke.title} description={spoke.description}>
  <Nav />
  <main class="wrap">
    <Spoke country={country} spoke={spoke} />
    {moneyRules && (
      <a class="rulesbar" href={'/' + country.slug + '/rules'}>
        <span class="rulesbar-mk" aria-hidden="true"><span></span><span></span></span>
        <span class="rulesbar-tx">Heading to {country.name}? The <b>{country.name} money rules</b> card is the short version, built to keep on your phone.</span>
        <svg class="rulesbar-arw" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    )}
  </main>
  <Footer />
</Base>
