---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SearchBox from '../components/SearchBox.astro';
import { indexCounts } from '../data/search-index.js';

// The full-page version of the search box, and the place the nav panel sends a reader who
// wants the whole list. It accepts ?q= so a set of results can be shared or bookmarked.
//
// The counts below are read from the index at build time rather than typed, so the page
// cannot claim to search more of the site than it does. If a spoke wave lands, the number
// moves on its own.
const counts = indexCounts();
const title = 'Search True Trip Costs: find a country, a topic or a tool';
const description = 'Find any page on True Trip Costs by typing: ' + counts.country
  + ' country money guides, the ' + counts.spoke + ' topic pages inside them, '
  + counts.card + ' money rules cards and ' + counts.page
  + ' hubs, comparison tools and reference pages. If a subject is not covered yet, this says so.';
---
<Base title={title} description={description} robots="noindex,follow">
  <Nav />
  <main class="wrap sr-main">
    <section class="sr-head">
      <p class="lab">Find a page</p>
      <h1>Search the site.</h1>
    </section>

    {/* WHAT THIS SEARCHES. Its own block rather than the third paragraph of .sr-head, purely
        so the mobile rule below can order it after the box. Same words, same counts, read
        from the index exactly as before: nothing here is a copy change, and on desktop it
        still sits between the heading and the box, which is where it reads best.

        On a phone it goes BELOW the box. A reader on a narrow screen arrives wanting to
        type, and this paragraph runs to about five lines there, which was pushing the input
        itself to roughly 460px down the page: past the fold once the keyboard is up. It is
        honest and worth keeping, so it moves rather than going away. */}
    <p class="sub sr-what">
      Type a country, a city, or a subject like tipping, eSIM or hotel tax. This looks across {counts.country} country
      guides, the {counts.spoke} topic pages inside them, {counts.card} money rules cards and {counts.page} hubs,
      comparison tools and reference pages. It searches nothing else, so if we have not covered something it will
      tell you plainly instead of guessing.
    </p>

    <section class="sr-box" aria-label="Search">
      <SearchBox variant="page" id="pagesearch" autofocus={true} limit={60} />
    </section>

    <section class="sr-else">
      <p class="lab">Or browse</p>
      <p class="sub">
        Know where you are going? <a href="/countries">Every country guide</a> is listed A to Z, and the
        <a href="/">home page</a> opens a guide in one tap. Weighing up a region instead?
        <a href="/compare">Compare countries by region</a>. Traveling soon?
        <a href="/rules">The money rules cards</a> are built for your phone.
      </p>
    </section>
  </main>
  <Footer />

  <style>
    .sr-head{padding:48px 0 4px}
    .sr-head h1{margin:0 0 12px}
    .sr-box{padding:6px 0 0;border-top:0;margin-top:0}
    .sr-else{padding-bottom:64px}
    .sr-else .sub{margin-bottom:0}

    /* ---------------------------------------------------------------------------
       MOBILE: THE INPUT COMES FIRST.

       Confirmed on a real phone: in source order the reader met the heading, then about
       five lines of grey explanation, and only then the input, which put the field
       roughly 460px down a 664px viewport and left nothing above the keyboard to read.
       Typing did not help, because the paragraph stayed above the input and went on
       eating the space the results needed.

       So at narrow widths the column is reordered: heading, box, then the explanation,
       then the browse block. Order only. Nothing is deleted, nothing is hidden, and the
       DOM order is unchanged, which matters because it is also the tab order. The
       paragraph being reordered holds no links and nothing focusable, so moving it
       visually cannot separate a reader's focus from what they can see.

       560px is the breakpoint the jump list and the calculator's own mobile rules
       already use, so this adds no new one.
       --------------------------------------------------------------------------- */
    @media (max-width:560px){
      .sr-main{display:flex;flex-direction:column}
      .sr-head{order:1;padding:22px 0 2px}
      .sr-head h1{margin:0}
      .sr-box{order:2;padding:14px 0 0}
      /* Below the results, with a rule above it so it reads as a footnote to the box
         rather than a stranded paragraph. */
      .sr-what{order:3;margin:26px 0 0;padding-top:16px;border-top:1px solid var(--line);font-size:14.5px}
      .sr-else{order:4;padding-top:22px;padding-bottom:48px}
    }
  </style>
</Base>
