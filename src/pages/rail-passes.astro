---
import fs from 'fs';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CompareByRegion from '../components/CompareByRegion.astro';
import { railPasses, railPassesChecked, TIERS, CONF_TITLE } from '../data/rail-passes.js';

// Everything reads from rail-passes.js live. Nothing is re-typed here and nothing is
// counted by hand, so adding a country row is a data change and this page follows.
// Flags come from the local set with a fallback, the same approach TipChart uses, so
// the page makes no external image request.
const rows = railPasses;
const flagDir = process.cwd() + '/public/flags/';
const flagSrc = (slug) => fs.existsSync(flagDir + slug + '.svg') ? '/flags/' + slug + '.svg' : '/flags/world.svg';

const tierOf = (key) => TIERS.find(t => t.key === key) || null;

// Sort by how strongly a pass is justified, strongest first, so the reader reads down
// the page from "there is a case here" toward "just buy the tickets".
const sorted = [...rows].sort((a, b) => {
  const ra = tierOf(a.tier), rb = tierOf(b.tier);
  return (rb ? rb.rank : 0) - (ra ? ra.rank : 0) || a.country.localeCompare(b.country);
});

// Only tiers a row actually uses appear in the legend. `not-rail` is defined in the
// data and stays hidden until a country needs it.
const usedTiers = TIERS.filter(t => rows.some(r => r.tier === t.key)).sort((a, b) => b.rank - a.rank);
const noPass = rows.filter(r => r.tier === 'point-to-point' || r.tier === 'not-rail');

function niceDate(iso) {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00');
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
}
const checkedLabel = niceDate(railPassesChecked);

const title = 'Rail passes by country: worth it, or buy tickets?';
// Kept short on purpose. This string is assembled, so its RENDERED length moves with
// the row count and the month name: measure the built tag, not this source line. At 2
// rows and a 6-letter month it lands near 146, leaving room for a 3-digit count and a
// 9-letter month before it reaches the 155 limit.
const description = 'Whether a rail pass beats buying tickets in ' + rows.length +
  ' countries, with our confidence in each call. The decision, not invented prices. Checked ' + checkedLabel + '.';
---

<Base title={title} description={description}>
  <Nav />
  <main class="wrap rp">
    <Hero
      img="/hero/rail-passes.jpg"
      alt="Illustration of a departure board and a folded rail ticket on a station bench, for a guide to whether rail passes are worth buying"
      title="Do you actually need a rail pass?"
      stamp={"Checked " + checkedLabel}
      slim />

    <p class="rp-lede">
      A rail pass is the classic thing travelers buy before checking whether they need it. Here is our
      honest call for each country we have looked at, and in
      {noPass.length === 1 ? ' one of them' : ' ' + noPass.length + ' of them'} the answer is that
      individual tickets simply cost less.
    </p>

    <section class="rp-matrix" aria-label="Is a rail pass worth it, by country">
      <ol class="rp-rows">
        {sorted.map(r => {
          const t = tierOf(r.tier);
          return (
            <li class="rp-row">
              <div class="rp-top">
                <span class="rp-flag"><img src={flagSrc(r.slug)} alt="" width="24" height="18" loading="lazy" /></span>
                <a class="rp-country" href={r.railSpoke}>{r.country}</a>
                <span class={'rp-chip rp-' + r.tier}>{t ? t.short : r.tier}</span>
              </div>
              <p class="rp-reason">{r.reason}</p>
              <div class="rp-meta">
                <span class="rp-pt"><span class="rp-pt-k">Pass on offer</span>{r.passType}</span>
                <span class={'rp-conf rp-conf-' + r.confidence} title={CONF_TITLE[r.confidence] || ''}>
                  <span class="rp-conf-dot" aria-hidden="true"></span>
                  {r.confidence} confidence
                </span>
              </div>
            </li>
          );
        })}
      </ol>

      <dl class="rp-legend" aria-label="What each verdict means">
        {usedTiers.map(t => (
          <Fragment>
            <dt class="rp-leg-t"><span class={'rp-chip rp-' + t.key}>{t.short}</span></dt>
            <dd class="rp-leg-d"><strong>{t.label}.</strong> {t.gloss}</dd>
          </Fragment>
        ))}
      </dl>
    </section>

    <div class="rp-honest">
      <p class="rp-honest-h">Why there is no price chart on this page</p>
      <p>
        The version of this page you have seen elsewhere is a table of rail-pass prices, one figure per
        country, sorted cheapest to dearest. We are not going to build that, because the number would be
        fiction. What rail costs you depends on your exact route, how far ahead you book, which operator you
        pick and whether your legs are long or short, so there is no single honest answer to what a country
        costs by train. A pass price on its own is worse than useless: it tells you what the product costs
        without telling you what you would have paid instead, which is the only comparison that matters.
      </p>
      <p>
        What we can tell you truthfully is the decision. For a normal trip, does a pass beat buying the
        tickets? That is a real question with a real answer per country, and we rate our confidence in each
        one rather than presenting all of them as equally settled. The verdict is the honest signal, not the
        number. The same reasoning is why <a href="/when-to-go">the seasons page carries no price chart</a>.
      </p>
    </div>

    <section class="rp-more" aria-labelledby="railmore">
      <h2 id="railmore">What the matrix cannot show you</h2>

      <div class="rm">
        <h3>The reservation fee is where passes quietly lose</h3>
        <p>
          A pass covers the seat only in the sense that it lets you occupy one. On fast trains across much of
          Europe a reservation is compulsory and is charged on top, per leg, and that is usually what turns a
          close call into a loss. It is also the cost travelers leave out when they do the math at home,
          because the pass price is advertised and the reservation fee is not.
        </p>
      </div>

      <div class="rm">
        <h3>The narrower pass is often the honest answer</h3>
        <p>
          The choice is rarely a national pass against individual tickets. Regional passes cover a smaller map
          for a good deal less, and on a trip that stays in one area they can beat both. The common way to
          overpay is to compare the national pass with tickets, conclude that no pass is worth it, and never
          look at the regional option sitting between them.
        </p>
      </div>

      <div class="rm">
        <h3>Buy from the operator, not a reseller</h3>
        <p>
          This holds nearly everywhere and it is the most reliable money advice on this page. National
          operators sell their own tickets and passes at the official price. Resellers sell the same seat with
          a margin, sometimes as a booking fee at checkout. Japan is now a sharp example: from October 1, 2026
          passes bought through overseas agencies cost more than the same pass on the official site.
        </p>
      </div>

      <div class="rm">
        <h3>What a pass buys that is not money</h3>
        <p>
          Worth naming honestly, because it is the real argument for a pass once the arithmetic is against it.
          A pass removes decisions: no fare to check, no booking window to catch, no commitment to a specific
          train on a specific day. If that flexibility is worth paying a premium for on your trip, that is a
          legitimate choice. It is just a different choice from the pass being cheaper, and the two get
          blurred together constantly.
        </p>
      </div>
    </section>

    <p class="rp-rel">
      Rail is one line in the budget. For the rest of what a trip costs day to day, see
      <a href="/cost-comparison">the cost of a day, compared</a>, and
      <a href="/tipping-compared">how tipping compares to home</a>.
    </p>
    <p class="rp-foot">
      Compiled by the True Trip Costs desk and checked {checkedLabel}. Each verdict is our own read of whether
      a pass beats buying tickets for a typical US visitor, drawn from operator pricing and published pass
      rules rather than a single register, and the confidence mark tells you how firmly each one is supported.
      Rail pricing and pass conditions move, so this page is on a quarterly re-check. Country names link to
      our full rail page for that country.
    </p>
    <CompareByRegion />
  </main>
  <Footer />

  <style>
    .rp{max-width:820px}
    .rp-lede{font-size:17.5px;color:#3B4A46;line-height:1.55;max-width:620px;margin:22px 0 22px}

    .rp-matrix{margin:0 0 26px}
    .rp-rows{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
    .rp-row{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;box-shadow:var(--shadow)}
    .rp-top{display:flex;align-items:center;flex-wrap:wrap;gap:10px}
    .rp-flag{flex:none;display:inline-flex;width:24px;height:18px;border-radius:3px;overflow:hidden;border:1px solid var(--line)}
    .rp-flag img{width:100%;height:100%;object-fit:cover;display:block}
    .rp-country{font-family:var(--serif);font-size:20px;font-weight:500;color:var(--ink);text-decoration:none}
    .rp-country:hover{text-decoration:underline}

    /* One chip per verdict. The colour is the encoding: teal where a pass has a case,
       deepening amber as the answer moves toward "do not buy one". */
    .rp-chip{margin-left:auto;font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;border-radius:999px;padding:4px 10px;white-space:nowrap}
    .rp-worth{background:var(--green-bg);color:#10502C}
    .rp-depends{background:rgba(14,122,95,.12);color:var(--teal-deep)}
    .rp-point-to-point{background:var(--amber-bg);color:#7A3D08}
    .rp-not-rail{background:var(--line);color:var(--muted)}

    .rp-reason{font-size:14.5px;color:var(--ink);line-height:1.55;margin:9px 0 0;max-width:640px}

    /* Bottom-aligned, not centred. The pass-type cell is two lines (a small label above
       its value) and the confidence is one, so centring floated the confidence between
       the two and it lined up with neither. Aligning to the end puts it on the value's
       line, which is the thing it belongs beside. */
    .rp-meta{display:flex;flex-wrap:wrap;align-items:end;gap:8px 18px;margin:11px 0 0}
    .rp-pt{font-size:13px;color:var(--muted);line-height:1.4}
    .rp-pt-k{display:block;font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--teal-deep)}
    .rp-conf{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:var(--muted);text-transform:capitalize}
    .rp-conf-dot{flex:none;width:8px;height:8px;border-radius:50%;background:var(--teal)}
    .rp-conf-medium .rp-conf-dot{background:var(--teal);opacity:.45}
    .rp-conf-low .rp-conf-dot{background:none;border:1.5px dashed var(--muted);width:9px;height:9px}

    /* One grid for the whole legend, not a flex row per line. That is what keeps the
       gloss column aligned: `max-content` sizes the chip column to the WIDEST chip and
       every row then shares it, so a longer tier label can never push one line's text
       out of step with the others again. Adding a tier needs no measurement here. */
    .rp-legend{margin:18px 0 0;padding:14px 16px;background:var(--paper);border:1px solid var(--line);border-radius:12px;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;row-gap:10px;align-items:start}
    .rp-leg-t{margin:0;padding-top:1px}
    .rp-leg-t .rp-chip{margin-left:0}
    .rp-leg-d{margin:0;font-size:13.5px;color:var(--muted);line-height:1.5}
    .rp-leg-d strong{color:var(--ink);font-weight:700}

    .rp-honest{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--teal);border-radius:12px;padding:14px 18px;margin:0 0 34px;max-width:720px;box-shadow:var(--shadow)}
    .rp-honest-h{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--teal-deep);margin:0 0 6px}
    .rp-honest p{font-size:14px;color:var(--muted);line-height:1.55;margin:0 0 9px}
    .rp-honest p:last-child{margin-bottom:0}

    .rp-more h2{font-family:var(--serif);font-weight:500;font-size:clamp(21px,3.2vw,28px);letter-spacing:-.01em;margin:0 0 16px}
    .rm{margin:0 0 22px;max-width:700px}
    .rm h3{font-size:15.5px;font-weight:700;color:var(--ink);margin:0 0 6px}
    .rm p{font-size:14.5px;color:var(--muted);line-height:1.6;margin:0}

    .rp-rel{font-size:14.5px;color:#3B4A46;line-height:1.55;margin:30px 0 0;max-width:700px}
    .rp-rel a{color:var(--teal-deep);font-weight:600}
    .rp-foot{font-size:13.5px;color:var(--muted);line-height:1.55;margin:16px 0 8px;max-width:700px}

    @media (max-width:560px){
      .rp-lede{font-size:16.5px}
      .rp-country{font-size:18px}
      .rp-chip{margin-left:0}
      .rm p{font-size:14px}
      /* On a phone a max-content chip column would take most of the width, so the chip
         goes on its own line and the gloss runs full width. Tight gap between a chip and
         its own gloss, wider gap between entries, so the pairing stays obvious. */
      .rp-legend{grid-template-columns:1fr;row-gap:4px}
      .rp-leg-t{padding-top:0}
      .rp-leg-d{margin:0 0 8px}
      .rp-leg-d:last-child{margin-bottom:0}
    }
  </style>
</Base>
