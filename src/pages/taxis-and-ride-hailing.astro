---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CompareByRegion from '../components/CompareByRegion.astro';
import USBadge from '../components/USBadge.astro';
import Hero from '../components/Hero.astro';
import { caution } from '../data/topics.js';
import { countries } from '../data/index.js';

// Taxi and ride-hailing spokes, gathered from every guide by topic. A country
// appears here only when it has a written-up taxi wrinkle worth walking through:
// a meter trick, the right app to install, or the airport-rank trap. Same single
// source as everything else; adding a topic:"taxis" spoke to any guide surfaces
// it here automatically, mirroring how cash-or-card gathers the cash spokes.
const taxiSpokes = countries
  .filter(c => c.live)
  .flatMap(c => (c.spokes || [])
    .filter(s => s.topic === 'taxis' && s.live !== false)
    .map(s => ({ h1: s.h1, lede: s.lede, spokeSlug: s.slug, country: c.name, countrySlug: c.slug, caution: s.caution })))
  .sort((a, b) => a.country.localeCompare(b.country));
---
<Base ogImage="/og/taxis-and-ride-hailing.jpg"
  title="Taxis and ride-hailing by country, for US travelers"
  description="Which taxi app to install, how the meter and airport scams actually work, and the official cheap way from the airport into town, country by country. For US travelers.">
  <Nav />
  <main class="wrap">

    <Hero
      img="/hero/taxis.jpg"
      alt="Illustration of a vintage taxi on a city street with a phone showing a map pin, for a guide to taxis and ride-hailing by country"
      eyebrow="Getting around"
      title="Taxis and ride-hailing, country by country." />

    <section class="fx-intro">
      <p class="fx-lede">Written for travelers leaving the US, this is the calm version of a question every trip raises: is the taxi a rip-off, which app should I install, and how do I get from the airport into town without overpaying. The answer changes by country, so we write one up wherever the meter, the app, or the airport rank has a specific trick worth knowing. We name the official or cheapest safe route first, and we take nothing from any taxi or app company.</p>
    </section>

    {taxiSpokes.length > 0 && (
      <section class="fx-sec">
        <h2>Taxi questions, country by country</h2>
        <p class="fx-note">Where a place has a specific taxi or ride-hailing wrinkle worth walking through, we have written it up. Each one lives in that country's guide.</p>

        <div class="tx-toolbar">
          <div class="tx-filter">
            <svg class="tx-filter-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="tx-filter-in" class="tx-filter-in" placeholder="Filter by country, like Japan" aria-label="Filter countries by name" autocomplete="off" />
          </div>
          <div class="tx-legend">
            <span class="tx-legend-lab">How careful to be</span>
            <span class="cx-chip cx-low">{caution.low.label}</span>
            <span class="cx-chip cx-medium">{caution.medium.label}</span>
            <span class="cx-chip cx-high">{caution.high.label}</span>
          </div>
        </div>

        <div class="tx-grid" id="tx-grid">
          {taxiSpokes.map(s => (
            <a class="tx-card" href={'/' + s.countrySlug + '/' + s.spokeSlug} data-name={(s.country + ' ' + s.h1).toLowerCase()}>
              <span class="tx-card-top">
                <span class="tx-country">{s.country}</span>
                {s.caution && caution[s.caution] && <span class={'cx-chip cx-' + s.caution}>{caution[s.caution].label}</span>}
              </span>
              <span class="tx-title">{s.h1}</span>
              <span class="tx-lede">{s.lede}</span>
            </a>
          ))}
        </div>

        <p class="tx-nomatch" id="tx-nomatch" hidden>No country by that name here yet. See <a href="/#guides">all country guides</a>.</p>
      </section>
    )}

    <p class="fx-keep">These are our own reads from experience and each country's guide, not official figures, and they are checked when we check the guide. Ride-hailing apps have no travel booking to sell, so we earn nothing here. For the fees behind a trip, see <a href="/tourist-taxes">tourist taxes and entry fees</a>, and for how each place pays, see <a href="/cash-or-card">cash or card</a>. More on how we work is on our <a href="/methodology">methodology page</a>.</p>

    <CompareByRegion />
  </main>
  <Footer />

  <style>
    .fx-intro{max-width:680px;margin:22px 0 0}
    .fx-lede{font-size:18px;color:#3B4A46;line-height:1.55;margin:0}
    .fx-sec{margin:34px 0}
    .fx-sec h2{font-family:var(--serif);font-weight:500;font-size:clamp(21px,3.2vw,27px);letter-spacing:-.01em;margin:0 0 6px}
    .fx-note{font-size:14.5px;color:var(--muted);margin:0 0 16px;line-height:1.5;max-width:680px}
    .tx-toolbar{display:flex;flex-wrap:wrap;gap:12px 16px;align-items:center;justify-content:space-between;margin:0 0 18px}
    .tx-filter{display:flex;align-items:center;gap:10px;flex:1 1 260px;max-width:380px;padding:10px 14px;border:1px solid var(--line);border-radius:12px;background:var(--card);transition:border-color .15s ease,box-shadow .15s ease}
    .tx-filter:focus-within{border-color:var(--teal-deep);box-shadow:0 0 0 3px rgba(14,122,95,.12)}
    .tx-filter-ic{color:var(--muted);flex:none;opacity:.6}
    .tx-filter-in{flex:1;min-width:0;border:0;outline:0;background:transparent;font:inherit;font-size:1rem;color:var(--ink)}
    .tx-filter-in::placeholder{color:var(--muted);opacity:.8}
    .tx-legend{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .tx-legend-lab{font-size:12.5px;color:var(--muted)}
    .tx-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
    .tx-card{display:flex;flex-direction:column;padding:16px 18px;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);text-decoration:none;transition:border-color .15s ease,box-shadow .15s ease}
    .tx-card:hover{border-color:#DAD7CD;box-shadow:0 1px 2px rgba(16,48,44,.05),0 10px 26px rgba(16,48,44,.10)}
    .tx-card.is-hidden{display:none}
    .tx-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
    .tx-country{font-family:var(--serif);font-weight:600;font-size:18px;color:var(--ink);line-height:1.2}
    .tx-card .cx-chip{flex:none;margin-top:1px}
    .tx-title{display:block;font-family:var(--serif);font-weight:500;font-size:15px;color:var(--teal-deep);line-height:1.35;margin:4px 0 0}
    .tx-card:hover .tx-title{text-decoration:underline}
    .tx-lede{display:block;font-size:13.5px;color:var(--muted);line-height:1.5;margin:7px 0 0}
    .tx-nomatch{font-size:14px;color:var(--muted);margin:16px 0 0}
    .tx-nomatch a{color:var(--teal-deep);font-weight:500;text-decoration:none}
    .tx-nomatch a:hover{text-decoration:underline}
    @media (max-width:560px){
      .fx-lede{font-size:16.5px}
      .tx-grid{grid-template-columns:1fr}
    }
  </style>

  <script>
    (function () {
      var input = document.getElementById('tx-filter-in');
      var grid = document.getElementById('tx-grid');
      if (!input || !grid) return;
      var none = document.getElementById('tx-nomatch');
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.tx-card'));
      function norm(s) { return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
      input.addEventListener('input', function () {
        var q = norm(input.value.trim());
        var shown = 0;
        for (var i = 0; i < cards.length; i++) {
          var hit = q === '' || norm(cards[i].getAttribute('data-name')).indexOf(q) !== -1;
          cards[i].classList.toggle('is-hidden', !hit);
          if (hit) shown++;
        }
        if (none) none.hidden = shown !== 0;
      });
    })();
  </script>
</Base>
