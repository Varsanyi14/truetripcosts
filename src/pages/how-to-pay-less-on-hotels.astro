  {/* The copy button reveals itself only where the Clipboard API exists, so a reader with
      JavaScript off, or on a browser without it, never sees a button that does nothing. The
      snippet is a readonly textarea and selectable by hand either way, which is the path that
      always works. Same script as /hotel-tax-map, against this page's own ids. */}
  {/* THE COUNTRY SEARCH. Deliberately a near-copy of the typeahead in HotelTaxMap.astro rather
      than a new design: same normalisation, same two-tier ranking, same keys, same close-on-
      outside-click, so the two maps behave identically. The one difference is what a pick
      resolves to, a table row id here rather than a country iso, which is why the id comes from
      parityRowId() in the data file and is never built here.

      Every branch is guarded on the elements existing, so this is inert anywhere the search is
      not rendered. */}
  <script is:inline>
    (function () {
      var norm = function (x) { return (x || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); };
      var input = document.getElementById('pty-filter');
      var panel = document.getElementById('pty-ta');
      var listEl = document.getElementById('pty-ta-list');
      if (!input || !panel || !listEl) return;
      var noneEl = document.getElementById('pty-ta-none');
      var items = Array.prototype.slice.call(listEl.querySelectorAll('.bt-ta-item'));
      var jumpWrap = document.querySelector('[data-pty-jump]');
      var jumpBtn = document.querySelector('[data-pty-jump-b]');
      var jumpLabel = document.querySelector('[data-pty-jump-label]');
      var active = -1;
      var chosen = null;

      var visible = function () {
        return Array.prototype.slice.call(listEl.querySelectorAll('.bt-ta-item'))
          .filter(function (it) { return !it.classList.contains('is-hidden'); });
      };
      var clearActive = function () { items.forEach(function (it) { it.classList.remove('is-active'); }); active = -1; };
      var openPanel = function () { panel.hidden = false; input.setAttribute('aria-expanded', 'true'); };
      var closePanel = function () { panel.hidden = true; input.setAttribute('aria-expanded', 'false'); clearActive(); };

      // Name-starts-with, then name-contains, then matched-on-a-member-name only. That third
      // tier is what puts the EU and EEA row below Germany when somebody types "germany", and
      // at the top when they type "poland", which has no row of its own.
      function rank(q) {
        var rows = visible().map(function (el) {
          var span = el.querySelector('.bt-ta-name');
          var nm = norm(span ? span.textContent.trim() : '');
          return { el: el, name: nm, tier: nm.indexOf(q) === 0 ? 0 : (nm.indexOf(q) !== -1 ? 1 : 2) };
        });
        rows.sort(function (a, b) { return a.tier !== b.tier ? a.tier - b.tier : (a.name < b.name ? -1 : (a.name > b.name ? 1 : 0)); });
        rows.forEach(function (r) { listEl.appendChild(r.el); });
      }
      function run() {
        var q = norm(input.value.trim());
        if (q === '') { closePanel(); if (jumpWrap) { jumpWrap.hidden = true; chosen = null; } return; }
        var shown = 0;
        items.forEach(function (it) {
          var hit = norm(it.getAttribute('data-name')).indexOf(q) !== -1;
          it.classList.toggle('is-hidden', !hit);
          if (hit) shown++;
        });
        clearActive();
        if (noneEl) noneEl.hidden = shown !== 0;
        rank(q);
        openPanel();
      }
      function setActive(next) {
        var vis = visible();
        if (!vis.length) return;
        clearActive();
        if (next < 0) next = vis.length - 1;
        if (next >= vis.length) next = 0;
        vis[next].classList.add('is-active');
        active = next;
        try { vis[next].scrollIntoView({ block: 'nearest' }); } catch (e) {}
      }
      // One place that scrolls and lights, shared by a pick and by the jump button.
      function goToRow(id) {
        var row = document.getElementById(id);
        if (!row) return false;
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        row.classList.add('is-lit');
        setTimeout(function () { row.classList.remove('is-lit'); }, 1600);
        return true;
      }
      function pick(item) {
        if (!item) return;
        var id = item.getAttribute('data-row');
        var nm = item.querySelector('.bt-ta-name');
        var name = nm ? nm.textContent.trim() : '';
        if (nm) input.value = name;
        closePanel();
        goToRow(id);
        // Only offer the jump where the row is really there. A button that scrolls nowhere is
        // worse than no button.
        if (jumpWrap && jumpBtn && document.getElementById(id)) {
          chosen = id;
          if (jumpLabel) jumpLabel.textContent = 'Go to ' + name;
          jumpWrap.hidden = false;
        }
      }

      input.addEventListener('input', run);
      input.addEventListener('focus', function () { if (input.value.trim() !== '') run(); });
      input.addEventListener('keydown', function (e) {
        if (panel.hidden) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
        else if (e.key === 'Enter') {
          e.preventDefault();
          var vis = visible();
          pick((active >= 0 && vis[active]) ? vis[active] : (vis.length === 1 ? vis[0] : null));
        } else if (e.key === 'Escape') { closePanel(); }
      });
      listEl.addEventListener('click', function (e) {
        var item = e.target.closest('.bt-ta-item');
        if (item) { e.preventDefault(); pick(item); }
      });
      document.addEventListener('click', function (e) {
        if (!panel.hidden && !e.target.closest('.bt-ta-wrap')) closePanel();
      });
      if (jumpBtn) jumpBtn.addEventListener('click', function () { if (chosen) goToRow(chosen); });
    })();
  </script>

  <script is:inline>
    (function () {
      var box = document.getElementById('bt-esnip');
      var btn = document.querySelector('[data-copy-snippet]');
      var msg = document.querySelector('[data-copy-msg]');
      if (!box) return;

      box.addEventListener('focus', function () { box.select(); });
      box.addEventListener('click', function () { box.select(); });

      if (!btn || !navigator.clipboard || !navigator.clipboard.writeText) return;
      btn.hidden = false;

      var timer = null;
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(box.value).then(function () {
          btn.textContent = 'Copied';
          if (msg) msg.textContent = 'Snippet copied to your clipboard.';
        }).catch(function () {
          box.select();
          if (msg) msg.textContent = 'Could not copy automatically. The snippet is selected, so copy it now.';
        }).then(function () {
          clearTimeout(timer);
          timer = setTimeout(function () {
            btn.textContent = 'Copy the snippet';
            if (msg) msg.textContent = '';
          }, 2600);
        });
      });
    })();
  </script>

  <style>
