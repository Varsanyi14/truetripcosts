---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import StackBar from '../components/StackBar.astro';
import BandBar from '../components/BandBar.astro';
import ParityMap from '../components/ParityMap.astro';
import CompareByRegion from '../components/CompareByRegion.astro';
import {
  bookingTacticsChecked,
  OTA_COMMISSION,
  PLATFORM_TAKE_RATE,
  DIRECT_COST,
  DRIP_AVERAGES,
  REFUNDABLE_PREMIUM,
  MEMBER_SAVING,
  PROPERTY_FEE_BAND,
  PARITY_BY_REGION,
  PARITY_STATUS,
  JUNKFEE_RULES,
  TIMING_MYTHS,
  parityRowId,
  EU_EEA_SOURCE_ROW,
  parityFinding,
  PARITY_PRESS,
  METHODOLOGY_US_PARITY,
} from '../data/booking-tactics.js';
import { hotelTaxMap, colours, bandFor, BANDS } from '../data/hotel-tax-map.js';
import { countries } from '../data/index.js';
import fs from 'node:fs';

// Flag per country, the same lookup the homepage, /cash-or-card and /hotel-taxes-and-fees use:
// /flags/<slug>.svg, falling back to the globe.
const flagDir = process.cwd() + '/public/flags/';
const flagSrc = (slug) => (fs.existsSync(flagDir + slug + '.svg') ? '/flags/' + slug + '.svg' : '/flags/world.svg');

// THE JUMP LIST, AND WHY ITS IDS LIVE HERE.
//
// This page is long, and a reader arriving with one question ("can I ask for a lower rate in the
// US?") should not have to scroll past six tactics to reach the answer. Same reasoning as the
// "On this page" list on every country guide, and the same markup and classes, so the two read
// as one site.
//
// The ids are held in ONE object that both the nav and the sections read, which is what makes a
// dead anchor impossible by construction rather than by review. CountryBriefing.astro states the
// same rail for its own JUMP list. Cross-reference anchors used only inside the prose
// (#book-direct, #check-the-hotel, #drip) are deliberately NOT here: they are targets for links
// in the copy, not destinations a reader navigates to from the top.
const SEC = {
  price:   { id: 'whats-in-a-price', label: 'What is in a hotel price' },
  tactics: { id: 'tactics', label: 'The seven tactics' },
  how:     { id: 'the-practical-how', label: 'The practical how' },
  parity:  { id: 'rate-parity', label: 'Where direct can legally be cheaper' },
  sources: { id: 'sources', label: 'Sources, and how this was checked' },
};
const JUMP = Object.values(SEC);

// THE ACTION LAYER OVER WORK THIS SITE ALREADY DOES.
//
// /hotel-tax-map says what a government adds. Its #property-fees section says what the hotel
// adds. /cash-or-card says what a bank adds. None of them tells a reader what to DO at the
// moment of booking, which is the one moment where knowing any of it can still change the
// number. This page is that layer, and it is the reason it links down to all three rather
// than restating their figures.
//
// ============================================================================
// THE LINE THIS PAGE DOES NOT CROSS, and it is worth writing down because every future
// edit will be tempted across it.
// ============================================================================
// This page teaches HOW to be smart wherever somebody books. It never says WHERE to book. It
// carries no live rates, compares no prices, frames no intermediary as good or bad to book
// with, and is not a booking funnel. An OTA here is a mechanism whose commission and drip
// behaviour we explain, in the same voice we use for a government tax.
//
// The practical test for any edit: if the change would make this page rot when prices move,
// it has crossed the line. A tactic does not go stale. A price does. Everything on this page
// is therefore a mechanism, a statute or a published band, and every figure is drawn as a
// band or a range from a named source rather than as a point.
//
// ============================================================================
// WHY THE TAX SEGMENT IN THE FLAGSHIP VISUAL IS DERIVED, AND WHY IT IS TWO ROWS.
// ============================================================================
// The visual needs a government-tax segment that is representative rather than invented, so
// it is computed here from hotel-tax-map.js at build time. A figure hand-typed on this page
// would be a second copy of a number that lives somewhere else, and a second copy is a copy
// that goes stale.
//
// THE FIRST ATTEMPT DREW ONE ROW AT THE MEDIAN AND IT WAS THE WRONG CHART. The median added
// tax across the whole map is under 2%, because most of the countries currently shaded are
// European, and in Europe VAT is embedded in the displayed price by law so only a small
// tourist tax lands on top (that is Rail 7 in hotel-tax-map.js). Drawing that single median
// produced a sliver of a segment and, worse, told the reader that government tax is never
// the big number. In the Gulf and the Caribbean it is the biggest number on the bill.
//
// SO THE SPLIT IS THE FINDING, and it is drawn as two rows. The split point is 10%, which is
// not chosen for this page: it is an existing boundary in the map's own BANDS scale, so the
// two groups are the map's own shape rather than a cut made to flatter a chart. Each row is
// drawn at ITS OWN GROUP'S MEDIAN and labelled with THAT GROUP'S FULL RANGE from the data,
// so no row asserts a precision the group does not have, and neither end is hidden.
const colouredEntries = hotelTaxMap.filter((e) => colours(e));
const SPLIT_PCT = 10;
// A band boundary, asserted rather than assumed. If BANDS is ever rescaled and 10 stops being
// an edge, this fails the build instead of quietly splitting the data somewhere arbitrary.
if (!BANDS.some((b) => b.from === SPLIT_PCT)) {
  throw new Error(
    `how-to-pay-less-on-hotels: the flagship visual splits the tax map at ${SPLIT_PCT}%, which is `
    + 'no longer a band boundary in hotel-tax-map.js BANDS. Pick the new boundary deliberately '
    + 'rather than leaving the split at a figure the scale no longer recognises.'
  );
}

function taxGroup(entries) {
  const pcts = entries.map((e) => e.addedPct).sort((a, b) => a - b);
  const median = pcts[Math.floor(pcts.length / 2)];
  return {
    count: pcts.length,
    low: pcts[0],
    high: pcts[pcts.length - 1],
    median,
    band: bandFor(median),
    label: `${pcts[0]} to ${pcts[pcts.length - 1]}%`,
  };
}

const taxInside = taxGroup(colouredEntries.filter((e) => e.addedPct < SPLIT_PCT));
const taxOnTop = taxGroup(colouredEntries.filter((e) => e.addedPct >= SPLIT_PCT));

const propMid = Math.round(((PROPERTY_FEE_BAND.lowPct + PROPERTY_FEE_BAND.highPct) / 2) * 10) / 10;

// Every total is a RANGE, because every addition is a range. Printing a single total would be
// the exact fabricated precision the whole page is built to avoid.
const totalRange = (g) => `${Math.round(100 + g.low + PROPERTY_FEE_BAND.lowPct)} to ${Math.round(100 + g.high + PROPERTY_FEE_BAND.highPct)}`;

const BASE_FILL = '#0A5644';
const TAX_FILL = '#7FB8A5';
const PROP_FILL = '#B45309';
const DRIP_MAND_FILL = '#B45309';
const DRIP_OPT_FILL = '#E3B98A';

// VIZ A. What is actually in a hotel price.
const priceRows = [
  {
    label: 'The price you compared',
    segments: [{ label: 'base room rate', value: 100, fill: BASE_FILL, figure: '100' }],
    totalFigure: '100',
    note: 'Indexed to 100 so this is a shape, not a price. Whatever your room costs, that is the 100.',
  },
  {
    label: 'What you pay where the tax is already inside the rate',
    segments: [
      { label: 'base room rate', value: 100, fill: BASE_FILL, figure: '100' },
      { label: 'government tax landing on top', value: taxInside.median, fill: TAX_FILL, figure: taxInside.label },
      { label: 'the property\u2019s own mandatory charge', value: propMid, fill: PROP_FILL, figure: PROPERTY_FEE_BAND.headline },
    ],
    totalFigure: totalRange(taxInside),
    note: `${taxInside.count} of the ${colouredEntries.length} countries shaded on our map sit here, most of Europe among them. VAT is inside the displayed price by law, so only a small tourist tax arrives on top, and the property\u2019s own charge is the larger of the two additions. Drawn at this group\u2019s median, labelled with its full range.`,
  },
  {
    label: 'What you pay where the tax is added on top',
    segments: [
      { label: 'base room rate', value: 100, fill: BASE_FILL, figure: '100' },
      { label: 'government tax landing on top', value: taxOnTop.median, fill: TAX_FILL, figure: taxOnTop.label },
      { label: 'the property\u2019s own mandatory charge', value: propMid, fill: PROP_FILL, figure: PROPERTY_FEE_BAND.headline },
    ],
    totalFigure: totalRange(taxOnTop),
    note: `The other ${taxOnTop.count} countries, the Gulf and the Caribbean above all, where a quoted rate routinely excludes the whole stack. Here the government charge is the bigger surprise, and the gap between the price you compared and the price you pay runs from ${Math.round(taxOnTop.low + PROPERTY_FEE_BAND.lowPct)}% to ${Math.round(taxOnTop.high + PROPERTY_FEE_BAND.highPct)}%. Same two additions as the row above, same source, completely different answer.`,
  },
  {
    kind: 'span',
    label: 'And inside that base rate, if you booked through an intermediary',
    from: OTA_COMMISSION.lowPct,
    to: OTA_COMMISSION.highPct,
    totalFigure: OTA_COMMISSION.headline,
    note: `Between ${OTA_COMMISSION.lowPct} and ${OTA_COMMISSION.highPct} of those first 100 units is the intermediary\u2019s commission. Read this one carefully: it does NOT add to your bill, which is why it is drawn hatched and apart rather than stacked. It is money already inside the price, and it is the only thing on this chart that a booking decision can recover.`,
  },
];

// VIZ B. The commission band, and the metric it keeps getting confused with.
const commissionGroups = [
  {
    label: 'What a hotel pays on one booking',
    measures: 'The commission deducted from a single reservation. This is the money a direct booking can recover, so it is the figure the book-direct tactic actually rests on.',
    rows: [
      { label: 'The band across the major platforms', lo: OTA_COMMISSION.lowPct, hi: OTA_COMMISSION.highPct, figure: OTA_COMMISSION.headline, tone: 'lead', eyebrow: 'The full band', breakdown: 'How it breaks down' },
      ...OTA_COMMISSION.detail.map((d) => ({
        label: d.label,
        lo: d.lowPct,
        hi: d.highPct,
        figure: `${d.lowPct} to ${d.highPct}%`,
        tone: 'quiet',
        note: d.note,
      })),
    ],
  },
  {
    label: 'A company-level metric, which is not the same thing',
    measures: PLATFORM_TAKE_RATE.whatItIs,
    rows: PLATFORM_TAKE_RATE.detail.map((d) => ({
      label: d.label,
      lo: d.lowPct,
      hi: d.highPct,
      // A row that declares its own figure keeps it, because "about 14%" says something
      // "14%" does not: these are approximations off an annual report, and rounding one
      // into a bare percentage would dress a ratio up as a rate.
      figure: d.figure || `${d.lowPct} to ${d.highPct}%`,
      tone: 'other',
      note: d.note,
    })),
  },
  {
    label: 'What the hotel\u2019s own channel costs it',
    measures: 'A property\u2019s all-in cost of taking the booking itself, card processing and booking engine included. The gap between this and the commission at the top is the room a direct rate has to move.',
    rows: [
      { label: 'Direct booking, all-in cost to the hotel', lo: DIRECT_COST.lowPct, hi: DIRECT_COST.highPct, figure: DIRECT_COST.headline, tone: 'low', note: DIRECT_COST.note },
    ],
  },
];

// VIZ D. Drip pricing, the number climbs.
const dripMand = DRIP_AVERAGES.mandatoryPct;
const dripOpt = DRIP_AVERAGES.optionalPct;
const dripRows = [
  {
    label: 'The price in the search results',
    segments: [{ label: 'advertised base price', value: 100, fill: BASE_FILL, figure: '100' }],
    totalFigure: '100',
  },
  {
    label: 'Plus the mandatory fees revealed later',
    segments: [
      { label: 'advertised base price', value: 100, fill: BASE_FILL, figure: '100' },
      { label: 'mandatory dripped fees', value: dripMand, fill: DRIP_MAND_FILL, figure: `+${dripMand}%` },
    ],
    totalFigure: String(100 + dripMand),
    note: 'Mandatory means you cannot decline it and still buy the thing, so this is not an upsell you can refuse. It is part of the price, disclosed late.',
  },
  {
    label: 'Plus the optional extras offered at checkout',
    segments: [
      { label: 'advertised base price', value: 100, fill: BASE_FILL, figure: '100' },
      { label: 'mandatory dripped fees', value: dripMand, fill: DRIP_MAND_FILL, figure: `+${dripMand}%` },
      { label: 'optional dripped fees', value: dripOpt, fill: DRIP_OPT_FILL, figure: `+${dripOpt}%` },
    ],
    totalFigure: String(100 + dripMand + dripOpt),
    note: 'The optional layer is more than twice the mandatory one, which is the part most people underestimate. Every item in it can be declined, and declining it is the single easiest saving on this page.',
  },
];

// The parity table, in the order the data declares.
//
// A row's optional `slug` does TWO DIFFERENT JOBS and they resolve separately here.
//
//   FLAG  identification. Shown whenever the row is a single country and a real flag file
//         exists. Belgium has no guide on this site, and showing no flag beside it while every
//         neighbour carried one read as a gap in the data rather than as the absence of a
//         guide, which is what it actually is.
//   LINK  a promise there is something at the other end. Added ONLY where the slug is also a
//         live country guide. A hand-typed slug in a table of legal citations is the
//         /brazil/e-visa class of bug waiting to happen, and site-urls.js exists because that
//         has already shipped once on this site.
//
// THE FLAG GUARD MATTERS MORE THAN IT LOOKS. flagSrc falls back to /flags/world.svg, a generic
// globe. Falling back silently would put a globe next to "Belgium" and present it as Belgium's
// flag, which is worse than the gap it was meant to fix: a wrong flag is a claim, an absent one
// is not. So a slug with no flag file fails the build and the row can be left slug-less instead.
const liveSlugs = new Set(countries.filter((c) => c.live && !c.blocked).map((c) => c.slug));
const parityRows = PARITY_BY_REGION.slice()
  .sort((a, b) => a.order - b.order)
  .map((r) => {
    // An unknown status used to surface as "TypeError: Cannot read properties of undefined
    // (reading 'tone')" from the chip below, which fails the build safely and tells whoever hit
    // it nothing. PARITY_STATUS is the only place a status gets a label, a colour and a chip
    // tone, so a row outside it cannot be rendered by either the table or the map.
    if (!PARITY_STATUS[r.status]) {
      throw new Error(
        `how-to-pay-less-on-hotels: the parity row "${r.jurisdiction}" carries status "${r.status}", `
        + `which has no entry in PARITY_STATUS. Valid statuses are: ${Object.keys(PARITY_STATUS).join(', ')}. `
        + 'Add the status to PARITY_STATUS with its label, chip tone, map fill and meaning, or correct the row.'
      );
    }
    if (!r.slug) return { ...r, flag: null, guideUrl: null };
    if (!fs.existsSync(flagDir + r.slug + '.svg')) {
      throw new Error(
        `how-to-pay-less-on-hotels: the parity row "${r.jurisdiction}" carries slug "${r.slug}" but `
        + `there is no public/flags/${r.slug}.svg. flagSrc would fall back to the generic globe and `
        + 'present it as that country\u2019s flag. Add the flag file, or remove the slug.'
      );
    }
    return {
      ...r,
      flag: flagSrc(r.slug),
      // Not live means no guide to link to. The flag still shows; the name stays plain text.
      guideUrl: liveSlugs.has(r.slug) ? `/${r.slug}` : null,
    };
  });
// THE COUNTRY SEARCH LIST, built the same way HotelTaxMap.astro builds its own: one entry per
// row, a display name, a flag where there is one, and a lowercase match blob.
//
// EVERY ROW IS SEARCHABLE, including the three bloc rows, because a reader typing "Ireland" or
// "Poland" is asking a question this page answers and the answer lives on the EU and EEA row.
// So the bloc rows carry their member country NAMES in the match blob while displaying their own
// label, which is how "Poland" finds the row that actually rules on Poland. The alternative was
// to leave the blocs unsearchable and have a third of Europe come back "no match", which would
// be false: we do hold a position on Poland.
//
// A bloc row shows NO FLAG. Twenty-seven states cannot wear one, which is the same rule the
// table itself follows.
const EU_EEA_NAMES = 'Austria Belgium Bulgaria Croatia Cyprus Czechia Denmark Estonia Finland France Germany Greece Hungary Ireland Italy Latvia Lithuania Luxembourg Malta Netherlands Poland Portugal Romania Slovakia Slovenia Spain Sweden Iceland Liechtenstein Norway';
const searchRows = parityRows.map((r) => ({
  id: parityRowId(r),
  name: r.jurisdiction,
  flag: r.flag,
  // ONLY THE ROW THE MAP COLOURS FROM carries the member names, not all three bloc rows. The
  // first version gave the blob to every row with no iso, so typing "Poland" returned three
  // suggestions: the DMA row, the contractual-waiver row and the competition-law row. All three
  // are true about Poland, and offering a reader three near-identical rows to choose between is
  // still the wrong answer to "where is Poland". So the search follows the same precedence the
  // map does: one row stands for the footprint, the other two are context you meet in the table.
  match: [r.jurisdiction, r.jurisdiction === EU_EEA_SOURCE_ROW ? EU_EEA_NAMES : ''].join(' ').toLowerCase(),
})).sort((a, b) => a.name.localeCompare(b.name));

// THE QUOTABLE FINDING. Derived in booking-tactics.js from the per-country resolution the map
// paints from, so the sentence above the map, the map itself, the social card and the CSV all
// count the same way. It is the one line on this page built to be lifted, which is exactly why
// none of its numbers may be typed: a hardcoded count is what gets screenshotted and then
// outlives its own data.
//
// NOTE THE TWO DIFFERENT DENOMINATORS ON THIS PAGE, because they look like a mistake and are
// not. `finding.total` is 36 COUNTRIES. `parityRows.length` is 15 ROWS. One ruling covers
// thirty countries, so the row count and the country count are different facts and the page
// states both: the sentence counts countries, the table caption counts rows.
const finding = parityFinding();

const freeCount = parityRows.filter((r) => r.status === 'free').length;
const flaggedCount = parityRows.filter((r) => r.flag).length;
const linkedCount = parityRows.filter((r) => r.guideUrl).length;

// SOURCES, AND HOW MANY ARE LINKED. Counted at build time rather than claimed, because the
// honest state of this page is that the load-bearing legal citations carry their primary
// document and several of the softer trade figures do not yet. A reader is told the count
// instead of being left to notice the pattern. See the RAIL 3 note in booking-tactics.js.
const allSources = [
  OTA_COMMISSION.source,
  PLATFORM_TAKE_RATE.source,
  DIRECT_COST.source,
  DRIP_AVERAGES.source,
  REFUNDABLE_PREMIUM.source,
  MEMBER_SAVING.source,
  PROPERTY_FEE_BAND.source,
  ...parityRows.map((r) => r.source),
  ...JUNKFEE_RULES.map((r) => r.source),
];
const linkedSources = allSources.filter((s) => s && s.url);
const unlinkedCount = allSources.length - linkedSources.length;
// How many of the fifteen parity rows now carry their primary document, counted rather than
// claimed. The page prints this beside the table, because "sourced and dated" is the promise
// this section is making and a reader is entitled to the score.
const parityLinked = parityRows.filter((r) => r.source && r.source.url).length;

// De-duplicated primary documents for the sources panel, keyed on URL so the DMA rows and the
// tax-map reference do not each list themselves twice.
const seenUrl = new Set();
const panelSources = [];
for (const s of linkedSources) {
  if (seenUrl.has(s.url)) continue;
  seenUrl.add(s.url);
  panelSources.push(s);
}

// THE EMBED SNIPPET, a const rather than typed into the markup for the same reason
// /hotel-tax-map keeps its own here: the height has to agree with the real height of
// /embed/rate-parity or the frame scrolls internally on a stranger's article, so it is a number
// somebody will need to retune when that page changes, and keeping it here named means it gets
// found.
//
// 760 IS AN ESTIMATE AND SHOULD BE CONFIRMED AGAINST THE LIVE FRAME. It is built up rather than
// guessed: the map is 1000 by 439.1, so in a typical 640px article column the SVG is about 259px
// and the wrap with its stamp about 300px; the four-line legend adds roughly 90px at two columns,
// the caption about 90px, and EmbedFrame's own head and credit bar about 120px together. That is
// roughly 600px, and the margin covers a narrow column, where the map shortens but the legend
// goes to one column and the caption wraps to more lines. Erring high is deliberate: too much
// height leaves white space inside the frame, too little makes the frame scroll internally,
// which is much worse.
//
// loading=lazy so the embed costs the host page nothing until it scrolls near. The referrer
// policy is the browser default spelled out, so TTC can still see which sites embed the map
// without leaking a full URL to an http host.
const SNIPPET = `<iframe src="https://truetripcosts.com/embed/rate-parity" width="100%" height="760"
  style="border:0" title="Where a hotel can legally undercut a booking site, from True Trip Costs"
  loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>`;

const ICONS = {
  court: '<path d="M12 3v18"></path><path d="M4 8h16"></path><path d="M7 8l-3 6h6z"></path><path d="M17 8l-3 6h6z"></path>',
  reg: '<path d="M6 3v18"></path><path d="M6 4h12l-2 3.5L18 11H6"></path>',
  filing: '<path d="M6 2h9l3 3v17H6z"></path><path d="M9 12h6"></path><path d="M9 16h6"></path>',
  study: '<path d="M4 19h16"></path><path d="M7 19V9"></path><path d="M12 19V5"></path><path d="M17 19v-7"></path>',
  trade: '<path d="M3 6h18"></path><path d="M5 6v13h14V6"></path><path d="M9 10h6"></path>',
  ttc: '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"></path>',
};
const iconFor = (type) => ICONS[type] || ICONS.reg;
---
{/* THE OG IMAGE IS PAGE-SPECIFIC, and it is the parity finding rather than the site's generic
    card. This page's strongest asset is a data finding, and a share of it was landing with the
    house illustration and no number on it, which wastes the one thing a writer would share it
    for. public/og/rate-parity.png is generated by scripts/build-parity-png.py from the same
    data the map paints from, so the card cannot state a count the page no longer holds.

    THE CARD MAKES NO PROMISE. It carries the three counts, the checked month and the line
    "legal freedom to undercut, not a promise of a lower price", because a social card travels
    with no page around it to add the caveat. Nothing on it says "book cheaper". */}
<Base
  ogImage="/og/rate-parity.png"
  title="How to pay less on hotels: the tactics that work, and when they do not | True Trip Costs"
  description="A tactics playbook for the hotel booking moment. How to recover the intermediary commission by booking direct, negotiate perks into a rate, use refundable rates without abusing them, and read past drip pricing. Each tactic bounded by when it works and when it does not, each figure sourced, with a dated rate-parity table by country. Not a rate-comparison tool."
>
  <Nav />
  <main class="wrap">

    <Hero
      img="/hero/how-to-pay-less-on-hotels.jpg"
      alt="Illustration of a traveler comparing a hotel booking screen against a written confirmation, for a guide to paying less at the hotel booking moment"
      eyebrow="Paying for a hotel"
      title="How to pay less on hotels."
      stamp={`Checked ${bookingTacticsChecked}`}
      slim={true} />

    <section class="bt-prose">
      <p class="bt-lede">The price you compare is almost never the price you pay. A government adds a tax you did not see, the property adds a charge it set itself, and somewhere inside the number you were quoted sits a commission that has nothing to do with your room. This page is about seeing through all of that and paying less, wherever you book.</p>

      {/* THE THIRTY-SECOND VERSION, and it is here rather than lower down because of what a
          reader used to meet first. Above the fold they got the promise, a five-line box about
          what this page is NOT, the contents list, and then the whole price-composition
          section before the first thing they could actually DO. Somebody arriving from a
          search for "is it cheaper to book direct" had to scroll past three screens of
          honesty to reach an answer, which is the honesty costing them the thing it was
          protecting.

          FOUR LINES, EACH LINKING TO ITS OWN SECTION. It is a summary with a route back into
          the detail, not a replacement for it: the ordering matters (compare properly BEFORE
          you ask for anything, because an unnormalised comparison makes a worse rate look
          better), and each line goes to the section that qualifies it.

          DELIBERATELY NOT A CTA. No colour block, no imperative headline, no "start saving".
          It is the same card furniture the rest of the site uses, because the moment this
          reads as a conversion device the page has crossed the line its own header sets out. */}
      <div class="bt-quick">
        <p class="bt-qk">The 30-second version</p>
        <ol class="bt-qlist">
          <li><a href="#same-room">Compare the final total for the same room</a>, matching cancellation terms, meals, taxes and mandatory fees before you compare two numbers.</li>
          <li><a href="#check-the-hotel">Check the hotel's own site once.</a> It takes a minute and it is the only way to see whether the total you were shown is the total.</li>
          <li>If it is an independent property, <a href="#book-direct">ask for a better direct rate or a useful inclusion.</a> The ask is free and the answer is often no.</li>
          <li><a href="#in-writing">Get the total, the inclusions, the payment currency and the cancellation deadline in writing.</a> This is worth more than any rate you negotiate.</li>
        </ol>
        <p class="bt-qfoot">Every one of those is bounded below by where it stops working. If you are booking in the US, read the <a href="#rate-parity">rate-parity row for the United States</a> first: it is the reason tactic one is weaker here than in Europe.</p>
      </div>

      {/* REDUCED TO ONE SENTENCE WITH THE REST BEHIND A DETAILS, and moved below the card
          above. The full text is unchanged and one tap away, because the commitment in it is
          load-bearing and this page should not get to quietly drop it. What changed is that it
          no longer stands between a reader and the first thing they can act on. A native
          <details> so the reveal needs no JavaScript. */}
      <details class="bt-not">
        <summary class="bt-not-sum">
          <span class="bt-not-k">What this page is not</span>
          <span class="bt-not-one">It is not about <b>where</b> to book, and it never will be.</span>
          <svg class="bt-not-chev" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <p>We do not compare rates, we do not surface live prices, and we will never tell you a booking site is a good or a bad place to buy a room. Every tactic below works the same whichever site you end up on. Where we explain how an intermediary makes its money, that is mechanism, not a verdict.</p>
      </details>

      <nav class="onpage" aria-label="On this page">
        <p class="lab">On this page</p>
        <ul>
          {JUMP.map((j) => (
            <li><a href={`#${j.id}`}>{j.label}</a></li>
          ))}
        </ul>
      </nav>
    </section>

    <section class="bt-sec" id={SEC.price.id}>
      <h2>What is actually in a hotel price</h2>
      <p class="bt-note">Three things make up the number you actually pay, and only one of them is the room. Indexed to 100 so it reads as a shape rather than a price, with every figure printed beside its own bar. There are two paid rows rather than one because the answer genuinely splits in two: where a country folds its tax into the displayed rate, and where it does not.</p>
      <div class="bt-figure">
        <StackBar rows={priceRows} axisMax={130} ticks={[0, 25, 50, 75, 100, 125]} id="whats-in-a-price-chart" />
        <p class="bt-src">Government band from our own <a href="/hotel-tax-map">hotel tax map</a>, {colouredEntries.length} countries shaded and dated. Property charge from the same map's <a href="/hotel-tax-map#property-fees">property-fee data</a>. Commission band from {OTA_COMMISSION.source.label}. Illustrative bands, not one country's figure and not any hotel's.</p>
      </div>
    </section>

    <section class="bt-sec" id={SEC.tactics.id}>
      <h2>The tactics, and where each one stops working</h2>
      <p class="bt-note">Every one of these has a boundary. A tactic presented without its boundary is a promise, and we are not in a position to make you one, so each comes with when it works and when it does not. If a tactic below sounds like a guarantee, read the second half again.</p>

      <article class="bt-tac" id="book-direct">
        <p class="bt-tacn">Tactic one</p>
        <h3>Book direct to recover the commission</h3>
        <p>Book through an intermediary and the hotel pays a commission on your reservation. Book with the hotel and it does not, and its own cost of taking that booking is a fraction of what it just saved. That gap is real money and some of it is available to you, which is why the ask is worth making.</p>
        <p>What you are actually asking for is a share of a saving you just created. That framing matters, because it is true, and because it is the difference between a reasonable request and a shakedown.</p>
        <div class="bt-bounds">
          <div class="bt-bound is-works">
            <span class="bt-bk">When it works</span>
            <ul>
              <li>Independent and family-run properties, which pay the top of the commission band and have the most to recover.</li>
              <li>Longer stays and family bookings, where the saving is worth a manager's attention.</li>
              <li>Off-peak dates and soft occupancy, where an empty room is worth more than a held rate.</li>
            </ul>
          </div>
          <div class="bt-bound is-not">
            <span class="bt-bk">When it does not</span>
            <ul>
              <li>Revenue-managed chains on peak dates. The rate is set by a system with no incentive to move and often no authority delegated to move it.</li>
              <li>A sold-out or nearly sold-out property. There is nothing to negotiate for.</li>
              <li><b>The US, where rate parity still binds.</b> A US hotel can be contractually held to the price it shows on a platform, so it may be unable to quote you less even when it would like to. See <a href={`#${SEC.parity.id}`}>the parity table</a>.</li>
            </ul>
          </div>
        </div>
      </article>

      <div class="bt-figure">
        <p class="bt-figh">The commission, and the number it keeps getting confused with</p>
        <p class="bt-note">Two measurements sit within a few points of each other and mean completely different things. The top group is what a hotel pays on your booking. The middle group is a company-wide ratio off an annual report, covering flights and cars as well as rooms. Quoting the second as though it were the first is the most common error in writing on this subject, and it always understates the first.</p>
        <BandBar groups={commissionGroups} axisMax={32} ticks={[0, 5, 10, 15, 20, 25, 30]} id="commission-band-chart" />
        <p class="bt-src">Per-booking bands from {OTA_COMMISSION.source.label}. Platform take rates from {PLATFORM_TAKE_RATE.source.label}. Direct cost from {DIRECT_COST.source.label}. Published bands and company-level ratios, not any single property's negotiated rate.</p>
      </div>

      <article class="bt-tac">
        <p class="bt-tacn">Tactic two</p>
        <h3>Negotiate perks into the rate, not a lower number</h3>
        <p>A hotel guards its published rate harder than it guards its margin. Ask for a lower number and you are asking it to undercut a price it may be contractually or strategically committed to. Ask for breakfast, a late checkout, a room upgrade or parking and you are asking it to spend something it has plenty of, at a cost to itself well below what those things are worth to you.</p>
        <p>This is usually the higher-yield ask, and it is almost always the easier yes.</p>
        <div class="bt-bounds">
          <div class="bt-bound is-works">
            <span class="bt-bk">When it works</span>
            <ul>
              <li>Direct contact with a person who has authority, which usually means the property rather than a central line.</li>
              <li>Independents, where the person answering can simply decide.</li>
              <li>Longer stays and low occupancy, where the marginal cost of a breakfast is trivial next to keeping your booking.</li>
            </ul>
          </div>
          <div class="bt-bound is-not">
            <span class="bt-bk">When it does not</span>
            <ul>
              <li>Peak dates, when the room sells regardless and there is no reason to sweeten anything.</li>
              <li>Properties where the perk is already bundled, in which case you are asking for what you have.</li>
              <li>Third-party booking flows, where nobody in the conversation can authorise anything.</li>
            </ul>
          </div>
        </div>
      </article>

      <article class="bt-tac">
        <p class="bt-tacn">Tactic three</p>
        <h3>Book refundable, then rebook if the price falls</h3>
        <p>A refundable rate is an option, and the premium on it is what the option costs. {REFUNDABLE_PREMIUM.note} So the tactic only pays when the drop you catch is bigger than the premium you paid, and you will not know that in advance.</p>
        <div class="bt-hardline">
          <span class="bt-hk">The line we will not help you cross</span>
          <p>Rebook only within the hotel's own posted cancellation terms, cancelling properly and inside the deadline. We will not help with anything that leans on a pricing error, abuses a policy, or disputes a charge you owe. Beyond the ethics, all three end the same way in practice: the property is entitled to enforce its terms, and you are the one standing at a front desk with no room.</p>
        </div>
        <div class="bt-bounds">
          <div class="bt-bound is-works">
            <span class="bt-bk">When it works</span>
            <ul>
              <li>Volatile dates booked well ahead, where there is time for a rate to move.</li>
              <li>Markets with visible oversupply, where the direction of travel is downward.</li>
              <li>When the refundable premium is at the low end, so the option is cheap.</li>
            </ul>
          </div>
          <div class="bt-bound is-not">
            <span class="bt-bk">When it does not</span>
            <ul>
              <li>Peak dates and events, where prices climb and the premium is dead money.</li>
              <li>Short lead times, where the cancellation window closes before anything changes.</li>
              <li>Any stay where you will not actually check the price again. The tactic is work, and unworked it is just a more expensive room.</li>
            </ul>
          </div>
        </div>
      </article>

      <article class="bt-tac">
        <p class="bt-tacn">Tactic four</p>
        <h3>Member, loyalty and app-only rates</h3>
        <p>{MEMBER_SAVING.note} Both halves of that sentence are true and the second half is the one nobody prints.</p>
        <p>The price of the saving is not money. It is a marketing relationship: an email address, a profile, a preference history and a nudge to book through one brand next time. That may be a fine trade. It is still a trade, and it is worth naming before you make it.</p>
        <div class="bt-bounds">
          <div class="bt-bound is-works">
            <span class="bt-bk">When it works</span>
            <ul>
              <li>Chains you already use, where you are paying the data cost anyway.</li>
              <li>Where the member rate carries a real perk, such as free breakfast or waived parking, rather than a few dollars off.</li>
            </ul>
          </div>
          <div class="bt-bound is-not">
            <span class="bt-bk">When it does not</span>
            <ul>
              <li>One-off stays at a brand you will not return to, where you are handing over data for a rounding error.</li>
              <li>When the member rate turns out to be the same rate wearing a badge, which happens often enough to check rather than assume.</li>
            </ul>
          </div>
        </div>
      </article>

      <article class="bt-tac" id="check-the-hotel">
        <p class="bt-tacn">Tactic five</p>
        <h3>Check the hotel's own site before trusting any total</h3>
        <p>This one has become materially more worth doing, and not because hotels changed. The law did. Across the EU and EEA, and earlier than that in a run of individual countries, the clauses that stopped a hotel offering a better price on its own site are void or prohibited. {freeCount} of the {parityRows.length} jurisdictions in <a href={`#${SEC.parity.id}`}>the table below</a> now sit that way.</p>
        <div class="bt-caveat">
          <span class="bt-ck">The caveat that has to travel with this</span>
          <p>Legal freedom is not a lower price. A hotel that may now undercut can simply choose not to, and a platform is free to fund a discount of its own and close the gap. The table says who <b>may</b>, not who <b>does</b>. Treat it as a reason to spend thirty seconds looking, not as a promise of what you will find.</p>
        </div>
        <div class="bt-bounds">
          <div class="bt-bound is-works">
            <span class="bt-bk">When it works</span>
            <ul>
              <li>The EU and EEA, plus Germany, France, Austria, Italy, Belgium and Switzerland, which got there first by their own routes.</li>
              <li>Japan and South Korea, where parity has been unwound by competition authorities.</li>
              <li>Independents anywhere, which are the properties most likely to price their own channel differently.</li>
            </ul>
          </div>
          <div class="bt-bound is-not">
            <span class="bt-bk">When it does not</span>
            <ul>
              <li><b>The US.</b> No federal or state parity ban is in force, so the freedom this tactic leans on does not exist there.</li>
              <li>The UK and Australia, where wide clauses went but a narrow clause covering the hotel's own site may still bind.</li>
              <li>Wherever the platform is discounting from its own pocket, which closes the gap without the hotel doing anything.</li>
            </ul>
          </div>
        </div>
      </article>

      <article class="bt-tac" id="same-room">
        <p class="bt-tacn">Tactic six</p>
        <h3>Break the same room, same night illusion</h3>
        <p>Two listings for one room on one night are routinely not the same product, and the cheaper one is often cheaper because it is less. Before you compare two totals, normalise six things, because any one of them can account for the whole difference.</p>
        <ol class="bt-six">
          <li><b>Cancellation terms.</b> Refundable against non-refundable is not a discount, it is a different product.</li>
          <li><b>Board.</b> Room only, breakfast, half board. Breakfast for two for four nights is not a rounding error.</li>
          <li><b>Bed type and occupancy.</b> A twin at the double rate, or a rate priced for one when there are two of you.</li>
          <li><b>Prepay against pay at the hotel.</b> Prepaid rates carry a currency risk and a rigidity that the number does not show.</li>
          <li><b>Whether tax is shown.</b> A rate quoted before tax will always beat the same rate quoted after it.</li>
          <li><b>Whether mandatory fees are shown.</b> The resort fee is the classic, and it is mandatory whether or not it is in the headline.</li>
        </ol>
        <p class="bt-tacfoot">Once those six match, the comparison is real. Until they do, you are comparing two different rooms and calling one of them a bargain.</p>
      </article>

      <article class="bt-tac" id="drip">
        <p class="bt-tacn">Tactic seven</p>
        <h3>Read past the drip</h3>
        <p>Drip pricing is the practice of showing a headline number and then adding to it as you move toward paying. Some of what appears is mandatory, which means it was always part of the price and was simply disclosed late. Some is optional, which means it is an upsell you can decline. The second category is bigger than most people expect.</p>
        <p>Regulators have been moving on this, but on the disclosure question only, and the distinction matters to you: the rules below decide whether a fee has to be shown up front. None of them makes a fee smaller, refundable, or illegal.</p>
        <div class="bt-figure">
          <p class="bt-figh">The number climbs</p>
          <StackBar rows={dripRows} axisMax={130} ticks={[0, 25, 50, 75, 100, 125]} unitWord="percent of the advertised base price" id="drip-chart" />
          <p class="bt-src">{DRIP_AVERAGES.source.url ? <a href={DRIP_AVERAGES.source.url} target="_blank" rel="noopener">{DRIP_AVERAGES.source.label}</a> : DRIP_AVERAGES.source.label}. {DRIP_AVERAGES.scope}</p>
        </div>

        <div class="bt-rules">
          {JUNKFEE_RULES.map((r) => (
            <div class="bt-rule">
              <span class="bt-rj">{r.jurisdiction}</span>
              <span class="bt-rn">{r.rule}</span>
              <p class="bt-rw">{r.what}</p>
              <p class="bt-rl"><b>The limit:</b> {r.limit}</p>
              <p class="bt-rd">
                {/* A rule with no single commencement date carries its own complete phrase,
                    because prefixing one produced "In force in force". */}
                <span class="bt-rdate">{r.effectiveISO ? `In force ${r.effective}` : r.effective}</span>
                {r.source.url
                  ? <a href={r.source.url} target="_blank" rel="noopener">{r.source.label}</a>
                  : <span class="bt-nosrc">{r.source.label}</span>}
              </p>
            </div>
          ))}
        </div>

        <p class="bt-tacfoot">This is the same family of charge our <a href="/hotel-taxes-and-fees">hotel taxes and fees guide</a> takes apart, and the resort fee at the centre of it is the one the tax map deliberately <a href="/hotel-tax-map#property-fees">cannot colour</a>, because no government sets it.</p>
      </article>
    </section>

    <section class="bt-sec" id={SEC.how.id}>
      <h2>The practical how</h2>
      <p class="bt-note">Four things: reaching the property, what to say, getting it in writing, and when to book. The first three are skills. The fourth is mostly folklore, and it is named as folklore below.</p>

      <div class="bt-panel bt-pad">
        <h3>Reaching the property, cheaply and in writing</h3>
        <p>You want a written record and you want to avoid an international call. In practice that means one of three channels, and which one works depends on where you are asking.</p>
        <p><b>Messaging apps, WhatsApp above all.</b> Common at independent and family-run properties across much of Europe, and often the fastest route to a person who can actually decide something. Thin at US chains, where the number on the website usually reaches a central reservations line rather than the property. So: here is the tool, and here is where it tends to work. Not "just message them," because at a large chain that advice wastes your evening.</p>
        <p><b>Email.</b> Slower, universal, and the best written record of the four things below. If you only do one, do this.</p>
        <p><b>The booking site's own message-the-property feature.</b> Underused. It reaches the property, it is written, and it works before you have any other contact details.</p>
        <p class="bt-do">One thing we will not give you is a statistic about what share of hotels answer on messaging apps. The figures circulating for that are untraceable, and we are not going to launder one into a number just because it would make this section punchier.</p>
      </div>

      <div class="bt-panel bt-pad">
        <h3>What to actually say</h3>
        <p>Two scripts. Both are firm, both give the property a real reason to say yes, and neither pretends you are doing it a favour.</p>
        <div class="bt-script">
          <span class="bt-sk">Asking for a direct rate</span>
          <p>"Hello, I am looking at a [dates] booking for a [room type], and I can see it at [rate] on the booking sites. I would rather book with you directly, which saves you the commission on it. Is there a better rate or a better inclusion if I book direct? Happy either way, I just wanted to ask first."</p>
          <p class="bt-sn">Why it works: it names the saving you are creating rather than just asking for a discount, and it gives an easy exit, which makes a yes cheaper to give.</p>
        </div>
        <div class="bt-script">
          <span class="bt-sk">Asking for perks instead</span>
          <p>"Understood on the rate. If it cannot move, could you include breakfast for two, or a late checkout? Either would make the decision easy for me."</p>
          <p class="bt-sn">Why it works: it accepts the no you just got, which lowers the temperature, and it asks for something the property can give without touching a published price. Naming two options lets it pick the cheaper one and still say yes.</p>
        </div>
      </div>

      <div class="bt-panel bt-pad" id="in-writing">
        <h3>Getting it in writing: the four things to confirm</h3>
        <ol class="bt-four">
          <li><b>The rate</b>, in the currency it will be charged in.</li>
          <li><b>Exactly what is included</b>, itemised. "Breakfast included" is not the same as "breakfast for two included".</li>
          <li><b>Taxes and mandatory fees</b>, and whether they are inside that rate or added at checkout. This is the question that moves the total most.</li>
          <li><b>The cancellation deadline</b>, as a date and a time. Note that it is almost always in the hotel's own local time zone, not yours, which is how people miss it by a few hours from another continent.</li>
        </ol>
        <p class="bt-do">A confirmation covering those four is worth more than any rate you negotiate, because it is the thing you can point at when the bill does not match the conversation.</p>
      </div>

      <div class="bt-panel bt-pad">
        <h3>Timing: tendencies, not rules</h3>
        <p>A hotel room is perishable. Tonight's unsold room is worth nothing tomorrow, and that single fact is the whole of the honest case for booking late. It cuts the other way just as hard: on a peak date, in a tight market, or during an event, the perishable room sells anyway and the late buyer pays for the privilege.</p>
        <p>So the honest version is a tendency. Last-minute can win off-peak or where there is oversupply, and it loses on peak dates. That is as far as the evidence goes, and everything below is folklore that has been repeated into the shape of a rule.</p>
        <ul class="bt-myths">
          {TIMING_MYTHS.map((m) => (
            <li class="bt-myth">
              <span class="bt-mc">{m.claim}</span>
              <span class="bt-ma">{m.answer}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bt-sec" id={SEC.parity.id}>
      <h2>Where booking direct can legally be cheaper</h2>
      <p class="bt-note">Rate parity is the contractual term that stopped a hotel offering a better price on its own site than on a platform. Across most of Europe it is now void or prohibited, which is what makes tactic five worth the thirty seconds. In the US there is no parity ban at all, which is the single most important row in this table for anyone reading this from home.</p>

      {/* THE FINDING, ONE SENTENCE, ABOVE THE MAP. It used to be spread across a three-status
          legend and a fifteen-row table, which meant a reader had to assemble it and a writer
          had to count it themselves. Real selectable text, never an image, so it can be
          quoted without being retyped, and every number in it is derived. "In our checked
          set" is not padding: the set is a named list of jurisdictions where somebody ruled on
          parity, not the world, and without that clause this becomes the page overclaiming in
          its most repeatable line. */}
      <p class="bt-finding">{finding.sentence}</p>

      <p class="bt-mapline">The map shows where a hotel is <b>legally free</b> to offer a cheaper direct rate. That is not a promise the direct rate will be cheaper. Grey means a country is not in our checked set, which is not the same as parity applying there.</p>

      {/* THE COUNTRY SEARCH. Deliberately the same markup, the same .cfilter box, the same
          dropdown behaviour and the same script shape as the typeahead on /hotel-tax-map, so a
          reader who has used one already knows this one. It sits above the map for the same
          reason it does there.

          IT LIVES ON THE PAGE, NOT IN ParityMap.astro, and that is what makes it inert in the
          embed by construction rather than by a guard somebody has to remember: the embed page
          renders the map component alone, so it cannot pick this up. It also keeps the search,
          the row ids it scrolls to, and the highlight style in one file. */}
      <div class="bt-find">
        <label class="bt-find-lab" for="pty-filter">Find a country on the map</label>
        <div class="bt-ta-wrap">
          <div class="cfilter bt-ta-box">
            <svg class="cfilter-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="pty-filter" class="cfilter-in" placeholder="Type a country, like Germany" aria-label="Find a country on the map" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="pty-ta-list" aria-autocomplete="list" />
          </div>
          <div class="bt-ta" id="pty-ta" hidden>
            <div class="bt-ta-list" id="pty-ta-list" role="listbox" aria-label="Matching jurisdictions">
              {searchRows.map((r) => (
                <button type="button" class="bt-ta-item" data-row={r.id} data-name={r.match}>
                  {r.flag
                    ? <img class="bt-ta-flag" src={r.flag} alt="" width="22" height="16" loading="lazy" />
                    : <span class="bt-ta-flag is-none" aria-hidden="true"></span>}
                  <span class="bt-ta-name">{r.name}</span>
                  <span class="bt-ta-go" aria-hidden="true">&#8594;</span>
                </button>
              ))}
            </div>
            <p class="bt-ta-none" id="pty-ta-none" hidden>No ruling on that country in our set. That is not the same as parity applying there, only that nobody we track has ruled on it.</p>
          </div>
        </div>

        {/* Revealed once a country resolves, so the reader is not left at the box with no way
            back to the row they asked for. Same control, same wording, as the tax map. */}
        <p class="bt-ta-jump" hidden data-pty-jump>
          <button type="button" class="bt-ta-jump-b" data-pty-jump-b>
            <span data-pty-jump-label>Go to the row</span>
            <span class="bt-ta-jump-i" aria-hidden="true">&#8595;</span>
          </button>
          <span class="bt-ta-jump-n">Jumps to its sourced row below.</span>
        </p>
      </div>

      <ParityMap tableAnchor={SEC.parity.id} />

      {/* THE EMBED CONTROL, directly under the map. Identical in shape, wording and behaviour to
          the one under the hotel-tax map: a collapsed <details>, so the reveal needs no
          JavaScript, with the copy button inside as enhancement on top. It used to sit below the
          table, which meant the code was a scroll away from the thing it embeds.

          Collapsed rather than open because it sits between the map and the sourced table, and
          that reading path is the honesty pattern of this section: map to see the shape, table
          to read the ruling. A code box open by default would wedge itself into the middle of
          it. Closed, it is one line. */}
      <details class="bt-embed">
        <summary class="bt-embed-sum">
          <span class="bt-embed-sum-t">Use this map on your own site</span>
          <svg class="bt-embed-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="bt-embed-body">
          <p class="bt-embed-t">Free to embed anywhere, including commercially, and it stays current on your page: as the law moves and we recheck it, an embedded copy updates itself with no re-paste. A credit link back is appreciated and not required, because the frame carries one already.</p>

          <label class="bt-esnip-lab" for="bt-esnip">Paste this where you want the map</label>
          <textarea class="bt-esnip" id="bt-esnip" readonly rows="4" spellcheck="false" aria-describedby="bt-ecopy-hint">{SNIPPET}</textarea>

          <div class="bt-erow">
            <button class="bt-ecopy" type="button" data-copy-snippet hidden>Copy the snippet</button>
            <span class="bt-ecopy-msg" data-copy-msg role="status" aria-live="polite"></span>
            <a class="bt-eprev" href="/embed/rate-parity" target="_blank" rel="noopener">See what it looks like</a>
          </div>
          <p class="bt-ehint" id="bt-ecopy-hint">Clicking the box selects the whole snippet, so it copies with one keystroke if the button is not there.</p>
        </div>
      </details>

