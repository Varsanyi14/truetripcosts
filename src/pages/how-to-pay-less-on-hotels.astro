    /* Under 700px the table stops being a table. Four columns of legal citation cannot fit
       a phone, and a horizontally scrolling table hides the column that matters. Each row
       becomes a card and every cell carries its own label from data-l, so nothing is lost
       and no cell is left unlabelled. */
    @media (max-width:700px){
      /* As cards there is nothing to scroll, so the min-width and the scroll container both
         come off. Leaving min-width on a display:block table would have forced a horizontal
         scrollbar under the cards for no reason. */
      .bt-tablewrap{overflow-x:visible}
      .bt-table{min-width:0}
      .bt-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
