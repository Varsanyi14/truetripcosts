    /* A visual and its source line are one unit, so they sit in one bordered block and
       cannot be screenshotted apart. */
    .bt-figure{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);padding:20px 20px 14px;margin:0}
    .bt-figh{font-family:var(--serif);font-weight:500;font-size:17px;color:var(--ink);margin:0 0 6px;line-height:1.3}
    /* Was 16px of margin on top of 12px of padding, which read as a gap rather than a rule
       separating the chart from its citation. */
    .bt-src{font-size:12px;color:var(--muted);line-height:1.55;margin:14px 0 0;padding-top:11px;border-top:1px solid var(--line)}
    .bt-src a{color:var(--teal-deep);font-weight:500;text-decoration:none}
    .bt-src a:hover{text-decoration:underline}

    .bt-tac{margin:26px 0 0;padding:22px 0 0;border-top:1px solid var(--line)}
    .bt-tac:first-of-type{border-top:none;padding-top:0}
    .bt-tacn{font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--teal-deep);margin:0 0 5px}
    .bt-tac h3{font-family:var(--serif);font-weight:500;font-size:clamp(18px,2.6vw,22px);color:var(--ink);margin:0 0 10px;line-height:1.25}
    .bt-tac p{font-size:15.5px;color:#3B4A46;line-height:1.62;margin:0 0 12px;max-width:720px}
    .bt-tac a{color:var(--teal-deep);font-weight:500;text-decoration:underline;text-underline-offset:2px}
    .bt-tacfoot{font-size:14px;color:var(--muted);border-top:1px solid var(--line);padding-top:12px;margin:16px 0 0}

    /* The bounding pair. Side by side on desktop so neither half can be read without the
       other, which is the whole point of publishing them together. */
    .bt-bounds{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:16px 0 0}
    .bt-bound{border:1px solid var(--line);border-radius:12px;background:var(--card);padding:15px 17px}
    .bt-bound.is-works{border-left:3px solid var(--teal)}
    .bt-bound.is-not{border-left:3px solid var(--amber)}
    .bt-bk{display:block;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin:0 0 9px}
    .bt-bound.is-works .bt-bk{color:var(--teal-deep)}
    .bt-bound.is-not .bt-bk{color:var(--amber)}
    .bt-bound ul{list-style:none;margin:0;padding:0}
    .bt-bound li{position:relative;font-size:13.5px;line-height:1.55;color:#3B4A46;padding:0 0 0 15px;margin:0 0 9px}
    .bt-bound li:last-child{margin-bottom:0}
    .bt-bound li::before{content:"";position:absolute;left:0;top:8px;width:5px;height:5px;border-radius:50%}
    .bt-bound.is-works li::before{background:var(--teal)}
    .bt-bound.is-not li::before{background:var(--amber)}
    .bt-bound li b{font-weight:600;color:var(--ink)}
    .bt-bound a{color:var(--teal-deep);font-weight:500}

    .bt-hardline{border:1px solid rgba(180,83,9,.35);border-left:3px solid var(--amber);background:var(--amber-bg);border-radius:12px;padding:15px 17px;margin:4px 0 0}
    .bt-hk{display:block;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--amber);margin:0 0 7px}
    .bt-hardline p{font-size:14px;line-height:1.6;color:var(--ink);margin:0;max-width:none}

    .bt-caveat{border:1px solid var(--line);border-left:3px solid var(--teal);background:var(--green-bg);border-radius:12px;padding:15px 17px;margin:4px 0 0}
    .bt-ck{display:block;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--teal-deep);margin:0 0 7px}
    .bt-caveat p{font-size:14px;line-height:1.6;color:var(--ink);margin:0;max-width:none}
    .bt-caveat b{font-weight:700}

    .bt-six{margin:4px 0 0;padding:0 0 0 20px}
    .bt-six li{font-size:14.5px;line-height:1.6;color:#3B4A46;margin:0 0 9px;padding-left:4px}
    .bt-six li b{color:var(--ink);font-weight:600}

    .bt-rules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:18px 0 0}
    .bt-rule{border:1px solid var(--line);border-radius:12px;background:var(--card);padding:15px 17px;box-shadow:var(--shadow)}
    .bt-rj{display:block;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--teal-deep);margin:0 0 4px}
    .bt-rn{display:block;font-family:var(--serif);font-weight:500;font-size:15.5px;color:var(--ink);line-height:1.3;margin:0 0 8px}
    .bt-rw{font-size:13.5px;line-height:1.55;color:#3B4A46;margin:0 0 8px}
    .bt-rl{font-size:13px;line-height:1.55;color:var(--muted);margin:0 0 10px}
    .bt-rl b{color:var(--amber);font-weight:600}
    .bt-rd{font-size:12px;line-height:1.5;color:var(--muted);margin:0;padding-top:9px;border-top:1px solid var(--line)}
    .bt-rdate{display:block;font-family:var(--mono);font-size:10.5px;font-weight:600;color:var(--ink);margin:0 0 3px}
    .bt-rd a{color:var(--teal-deep);font-weight:500;text-decoration:none}
    .bt-rd a:hover{text-decoration:underline}
    .bt-nosrc{font-style:italic}

    .bt-panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);margin:0 0 14px}
    .bt-pad{padding:18px 20px}
    .bt-panel h3{font-family:var(--serif);font-weight:500;font-size:17.5px;color:var(--ink);margin:0 0 10px;line-height:1.3}
    .bt-panel p{font-size:14.5px;line-height:1.62;color:#3B4A46;margin:0 0 11px}
    .bt-panel p:last-child{margin-bottom:0}
    .bt-panel b{font-weight:600;color:var(--ink)}
    .bt-do{border-top:1px solid var(--line);padding-top:12px;color:var(--muted);font-size:13.5px;line-height:1.6;margin:14px 0 0}
    .bt-do a{color:var(--teal-deep);font-weight:500}

    .bt-script{border:1px solid var(--line);border-left:3px solid var(--teal);border-radius:10px;background:var(--paper);padding:14px 16px;margin:0 0 12px}
    .bt-script:last-child{margin-bottom:0}
    .bt-sk{display:block;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--teal-deep);margin:0 0 8px}
    .bt-script p{font-size:14.5px;line-height:1.65;color:var(--ink);margin:0}
    .bt-sn{font-size:12.5px;color:var(--muted);line-height:1.55;margin:9px 0 0;padding-top:9px;border-top:1px solid var(--line)}

    .bt-four{margin:2px 0 0;padding:0 0 0 20px}
    .bt-four li{font-size:14.5px;line-height:1.6;color:#3B4A46;margin:0 0 9px;padding-left:4px}
    .bt-four li b{color:var(--ink);font-weight:600}

    .bt-myths{list-style:none;margin:14px 0 0;padding:0}
    .bt-myth{border-top:1px solid var(--line);padding:11px 0}
    .bt-myth:last-child{padding-bottom:0}
    .bt-mc{display:block;font-size:14px;font-weight:600;color:var(--amber);line-height:1.45;margin:0 0 3px}
    .bt-ma{display:block;font-size:13.5px;color:#3B4A46;line-height:1.6}

    .bt-legend{margin:0 0 16px}
    .bt-lg{border-left:3px solid var(--line);padding:2px 0 2px 12px;margin:0 0 10px}
    .bt-lg:last-child{margin-bottom:0}
    .bt-lg.is-good{border-left-color:var(--teal)}
    .bt-lg.is-mixed{border-left-color:#C99A2E}
    .bt-lg.is-bad{border-left-color:var(--amber)}
    .bt-lgk{display:block;font-size:13px;font-weight:700;color:var(--ink);margin:0 0 2px}
    .bt-lgm{display:block;font-size:13px;color:var(--muted);line-height:1.55}

    /* The one calm line above the map. Bordered on the left so it reads as a qualification of
       the visual rather than as body copy, and short on purpose: the full nuance is under the
       table and repeating it here would bury the map. */
    .bt-mapline{font-size:14px;line-height:1.6;color:var(--ink);border-left:3px solid var(--teal);background:var(--green-bg);border-radius:0 10px 10px 0;padding:12px 15px;margin:0 0 16px;max-width:720px}
    .bt-mapline b{font-weight:700}
    .bt-th{font-family:var(--serif);font-weight:500;font-size:18px;color:var(--ink);margin:28px 0 10px;line-height:1.3}

    /* overflow-x:auto rather than overflow:hidden. The old rule clipped the table when its
       columns could not compress further, which hid the right-hand column entirely at the
       widths just above the card breakpoint. Scrolling keeps every column at a readable width
       and keeps the border radius. */
    .bt-tablewrap{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow);overflow-x:auto}
    .bt-table{width:100%;border-collapse:collapse;text-align:left;min-width:560px;table-layout:fixed}
    .bt-cap{font-size:12.5px;color:var(--muted);line-height:1.55;margin:0 0 10px;max-width:720px}
    .bt-table th,.bt-table td{padding:13px 14px;vertical-align:top;border-bottom:1px solid var(--line)}

    /* The jurisdiction cell: flag, then name, on one baseline. A row with no guide uses the same
       cell without the flag or the link, so the column stays aligned either way. */
    .bt-j{display:inline-flex;align-items:center;gap:9px;text-decoration:none;color:var(--teal-deep)}
    .bt-j.is-plain{color:var(--ink)}
    .bt-j:hover .bt-jname{text-decoration:underline}
    .bt-jflag{display:inline-flex;line-height:0;flex:none}
    .bt-jflag img{width:22px;height:16px;border-radius:3px;border:1px solid var(--line);object-fit:cover;display:block}
    .bt-jname{line-height:1.3;overflow-wrap:normal;word-break:normal}
    .bt-table thead th{font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--teal-deep);background:var(--paper);white-space:nowrap}
    .bt-table tbody th{font-size:14px;font-weight:600;color:var(--ink);line-height:1.35}
    .bt-table tbody tr:last-child th,.bt-table tbody tr:last-child td{border-bottom:none}
    /* The US row is the exception the whole table exists to name, so it is tinted rather
       than left to be found by reading fifteen rows. */
    .bt-table tbody tr.is-us{background:var(--amber-bg)}
    /* PART 5, AND IT WAS NOT A PADDING PROBLEM. Measured before fixing, which changed the fix.
       The table is table-layout:fixed inside a 760px .wrap, so the content width is about
       714px and the Status column's 17% is about 121px, giving a 93px content box after
       padding. The widest chip, "Direct can undercut" at 11.5px semibold in a pill with 10px
       side padding, is about 133px. So the pill was not merely tight against the date: it was
       OVERFLOWING its own column by roughly 40px and landing in the Since column's space.

       WHICH MEANS PADDING ALONE MAKES IT WORSE, not better. More right padding shrinks the
       content box the pill is already too big for, so the pill overflows further. That was the
       first fix attempted here and it was wrong.

       SO THE PILL IS CONSTRAINED TO ITS COLUMN INSTEAD, and the crowding becomes impossible by
       construction rather than avoided by arithmetic: max-width:100% plus a normal white-space
       lets "Direct can undercut" take two lines inside the pill when the column cannot hold it
       on one. Tall rows are exactly the case the tweak was reported on and they have the
       vertical room by definition. The padding is kept as well, at a modest 18px, so there is
       visible air between pill and date rather than only the absence of a collision.

       WHY NOT WIDEN THE STATUS COLUMN. It would need about 24% to hold the pill on one line,
       and the only column with room to give is the ruling column, which the colgroup note
       above defends as the one a reader is actually there for. Trading 7 points of the ruling
       for a single-line pill is the wrong way round.

       SCOPED TO THE TABLE, because .bt-chip could later be reused elsewhere and a bare rule
       would follow it. The legend above the table uses .bt-lgk, not this class, so it is
       unaffected either way.

       MOBILE UNTOUCHED, as instructed. Below 700px every cell is display:block at full width,
       so the pill fits on one line there and neither rule changes what renders.

       NOT VERIFIED IN A BROWSER: the numbers above are measured from the real font metrics and
       the real column arithmetic, not from a rendered page. Worth one look at 1000px+ before
       this ships. */
    .bt-table td[data-l="Status"]{padding-right:18px}
    .bt-since{font-family:var(--mono);font-size:11.5px;color:var(--muted);white-space:normal;line-height:1.35;padding-left:2px}
    .bt-ruling{display:block;font-size:13.5px;color:#3B4A46;line-height:1.55}
    .bt-tsrc{display:block;font-size:12px;line-height:1.5;color:var(--teal-deep);font-weight:500;text-decoration:none;margin-top:7px}
    a.bt-tsrc:hover{text-decoration:underline}
    /* white-space:normal and max-width, not nowrap, per the Part 5 note above: the pill has to
       be able to take two lines rather than overflow a fixed-width column into the date beside
       it. This class is used in exactly one place, the Status cell of the parity table, so the
       constraint is set here rather than as a descendant rule. It was a descendant rule first
       and that did not survive: minification dropped the .bt-table ancestor and the flattened
       rule then lost the cascade to this one. */
    .bt-chip{display:inline-block;font-size:11.5px;font-weight:600;border-radius:999px;padding:4px 10px;line-height:1.25;white-space:normal;max-width:100%}
    .bt-chip.is-good{color:var(--teal-deep);background:var(--green-bg)}
    .bt-chip.is-mixed{color:#7A5B10;background:#FAF0D6}
    .bt-chip.is-bad{color:var(--amber);background:#F7DFC6}

    .bt-hub{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .bt-hubcard{display:block;border:1px solid var(--line);border-top:3px solid var(--teal);border-radius:12px;background:var(--card);box-shadow:var(--shadow);padding:16px 18px;text-decoration:none;transition:background-color .15s ease}
    .bt-hubcard:hover{background:var(--paper)}
    .bt-hubh{display:block;font-family:var(--serif);font-weight:500;font-size:16.5px;color:var(--teal-deep);line-height:1.3;margin:0 0 5px}
    .bt-hubcard:hover .bt-hubh{text-decoration:underline}
    .bt-hubd{display:block;font-size:13.5px;color:var(--muted);line-height:1.55}

    @media (max-width:700px){
      .bt-bounds{grid-template-columns:1fr}
      .bt-rules{grid-template-columns:1fr}
      .bt-hub{grid-template-columns:1fr}
    }

    /* Under 700px the table stops being a table. Four columns of legal citation cannot fit
       a phone, and a horizontally scrolling table hides the column that matters. Each row
       becomes a card and every cell carries its own label from data-l, so nothing is lost
       and no cell is left unlabelled. */
    @media (max-width:700px){
      /* As cards there is nothing to scroll, so the min-width and the scroll container both
         come off. Leaving min-width on a display:block table would have forced a horizontal
         scrollbar under the cards for no reason. */
      .bt-tablewrap{overflow-x:visible}
      .bt-table{min-width:0}
      /* The colgroup's percentages describe table columns, and there are none left once the
         rows become blocks. Left live they do nothing visible, but display:none states the
         intent so nobody later wonders whether 18% is still binding here. */
      .bt-table colgroup{display:none}
      .bt-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
      .bt-table,.bt-table tbody,.bt-table tr,.bt-table th,.bt-table td{display:block;width:auto}
      .bt-table tr{border-bottom:1px solid var(--line);padding:14px 16px}
      .bt-table tbody tr:last-child{border-bottom:none}
      .bt-table th,.bt-table td{border-bottom:none;padding:0 0 9px}
      .bt-table tbody th{font-size:15px;padding-bottom:8px}
      .bt-table td:last-child{padding-bottom:0}
      .bt-table td[data-l="Since"]::before{content:attr(data-l) ": ";font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--teal-deep)}
      .bt-since{white-space:normal}
    }

    /* THE COUNTRY SEARCH. The .cfilter box itself comes from HotelTaxMap.astro's own scoped
       styles on the other page, so those rules are repeated here rather than imported; see the
       hand-back note, which proposes lifting .cfilter into global.css since three surfaces now
       want it. Everything below is matched to that map deliberately, down to the row heights,
       so the two searches are the same control. */
    .bt-find{margin:0 0 16px;max-width:520px}
    .bt-find-lab{display:block;font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--teal-deep);margin:0 0 7px}
    .bt-ta-wrap{position:relative}
    .cfilter{display:flex;align-items:center;gap:10px;padding:11px 15px;border:1px solid var(--line);border-radius:12px;background:var(--card);transition:border-color .15s ease,box-shadow .15s ease}
    .cfilter:focus-within{border-color:var(--ink);box-shadow:0 0 0 3px rgba(14,122,95,.12)}
    .cfilter-ic{color:var(--muted);flex:none;opacity:.6}
    /* 16px, because anything smaller makes iOS Safari zoom the page on focus. */
    .cfilter-in{flex:1;border:0;outline:0;background:transparent;font:inherit;font-size:16px;color:var(--ink);-webkit-text-size-adjust:100%}
    .cfilter-in::placeholder{color:var(--muted);opacity:.8}
    .bt-ta{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:40;max-height:300px;overflow-y:auto;padding:6px;background:var(--card);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow)}
    .bt-ta[hidden]{display:none}
    .bt-ta-item{display:flex;align-items:center;gap:10px;width:100%;padding:9px 10px;border:0;border-radius:8px;background:transparent;text-align:left;cursor:pointer;color:var(--ink);font:inherit}
    .bt-ta-item:hover,.bt-ta-item.is-active{background:var(--green-bg)}
    .bt-ta-item.is-hidden{display:none}
    .bt-ta-flag{flex:none;width:22px;height:16px;border-radius:2px;box-shadow:0 0 0 1px rgba(22,48,44,.08)}
    /* A bloc row has no flag, so it holds the same 22px of space empty rather than letting its
       name slide left out of the column the other rows keep. */
    .bt-ta-flag.is-none{display:inline-block;box-shadow:none}
    .bt-ta-name{flex:1;font-size:15px;font-weight:500}
    .bt-ta-go{color:var(--teal-deep);font-weight:700}
    .bt-ta-none{margin:0;padding:12px 14px;font-size:14px;color:var(--muted);line-height:1.5}

    /* The persistent jump, hidden in markup and revealed only by the script. */
    .bt-ta-jump{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;margin:10px 0 0}
    .bt-ta-jump[hidden]{display:none}
    .bt-ta-jump-b{display:inline-flex;align-items:center;gap:7px;font:inherit;font-size:14px;font-weight:600;color:#F5F4EF;background:var(--teal-deep);border:0;border-radius:999px;padding:8px 16px;cursor:pointer;transition:background-color .15s ease}
    .bt-ta-jump-b:hover{background:var(--teal)}
    .bt-ta-jump-b:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
    .bt-ta-jump-i{font-weight:700}
    .bt-ta-jump-n{font-size:12.5px;color:var(--muted)}

    /* The searched row, lit briefly on arrival. The class is added by the script above and
       styled here because the table lives here; the tax map does the same with .htm-row-lit. */
    .bt-table tbody tr.is-lit{background:var(--green-bg);transition:background-color .4s ease}
    .bt-table tbody tr.is-us.is-lit{background:var(--green-bg)}
    @media (prefers-reduced-motion: reduce){
      .bt-table tbody tr.is-lit{transition:none}
    }

    /* THE EMBED BLOCK, now a collapsed details directly under the map rather than a section
       below the table. Same shape as the one on /hotel-tax-map. */
    /* THE QUOTABLE FINDING, above the map. Sized up rather than down: it is the answer and
       the map is the evidence, so it should not read as a caption. Left rule and paper tone
       mark it as a pull-out without turning it into a banner. */
    .bt-finding{font-size:clamp(16px,2.2vw,18.5px);line-height:1.5;font-weight:500;color:var(--ink);margin:0 0 14px;padding:14px 17px;background:var(--green-bg);border-left:3px solid var(--teal);border-radius:8px;max-width:760px}

    /* THE METHOD BLOCK ON THE US ROW. Inside the ruling cell, marked off so it does not read
       as more of the ruling, and quieter than the ruling because it is about our work rather
       than about the law. */
    .bt-meth{margin:10px 0 0;padding:10px 12px;background:var(--paper);border:1px solid var(--line);border-radius:8px}
    .bt-meth-k{display:block;font-family:var(--mono);font-size:9.5px;font-weight:600;color:var(--teal-deep);text-transform:uppercase;letter-spacing:.05em;margin:0 0 6px}
    .bt-meth p{font-size:12.5px;line-height:1.5;color:#3B4A46;margin:0 0 6px}
    .bt-meth p:last-child{margin-bottom:0}
    .bt-meth-gap{color:var(--muted);font-style:normal}
    .bt-meth-d{font-family:var(--mono);font-size:10.5px;color:var(--muted);letter-spacing:.03em}

    /* THE DOWNLOAD LIST in the writers block. A list rather than a row of buttons: each file
       needs a sentence saying what it is for and whether it stays current, and a button row
       has nowhere to put that. */
    .bt-dl{list-style:none;margin:0 0 16px;padding:0;display:flex;flex-direction:column;gap:11px}
    .bt-dl li{display:flex;align-items:flex-start;gap:12px;flex-wrap:wrap}
    .bt-dl-a{flex:none;font-family:var(--mono);font-size:11.5px;font-weight:600;letter-spacing:.03em;color:var(--teal-deep);background:var(--green-bg);border:1px solid rgba(14,122,95,.22);border-radius:999px;padding:6px 13px;text-decoration:none;white-space:nowrap}
    .bt-dl-a:hover{background:#D7F4EB}
    .bt-dl-n{font-size:13px;line-height:1.5;color:#3B4A46;min-width:220px;flex:1}
    .bt-dl-n b{font-weight:600;color:var(--ink)}
    .bt-press-m,.bt-press-at{font-size:13px;line-height:1.55;color:#3B4A46;margin:0 0 9px;padding-top:11px;border-top:1px solid var(--line)}
    .bt-press-at{margin-bottom:0}
    .bt-press-line{display:block;font-family:var(--mono);font-size:12px;color:var(--teal-deep);line-height:1.5;margin-top:4px;word-break:break-word}
    .bt-press{margin-top:10px}

