---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CompareByRegion from '../components/CompareByRegion.astro';
import USBadge from '../components/USBadge.astro';
import Hero from '../components/Hero.astro';
import CostChart from '../components/CostChart.astro';
import { countries } from '../data/index.js';

// Everything on this page reads from the live country data. Adding a country or
// changing a cost figure in a guide updates this page on the next build. Nothing
// is re-typed here.
const live = countries.filter(c => c.live && !c.blocked);

// Honest checked date, derived from the data rather than hardcoded. If the guides
// were all checked in one month we say that month; otherwise we show a range.
const isoDates = live.map(c => c.checkedISO).filter(Boolean).sort();
function niceMonth(iso) {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00');
  if (isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
}
const firstMonth = niceMonth(isoDates[0]);
const lastMonth = niceMonth(isoDates[isoDates.length - 1]);
const checkedLabel = firstMonth === lastMonth ? firstMonth : `${firstMonth} to ${lastMonth}`;

const REGION_ORDER = ['Europe', 'Asia', 'Americas', 'Middle East', 'Africa', 'Oceania'];
const midOf = c => {
  const t = (c.cash && c.cash.styles || []).find(s => s.n === 'Mid-range');
  return t ? t.per + t.room : null;
};
const regions = REGION_ORDER
  .map(name => {
    const rows = live
      .filter(c => c.region === name)
      .map(c => ({ slug: c.slug, name: c.name, total: midOf(c) }))
      .filter(r => r.total != null)
      .sort((a, b) => a.total - b.total);
    return { name, rows };
  })
  .filter(r => r.rows.length);

// A shared min/max for the region color scale, so shading is comparable across
// regions rather than each region rescaling to itself.
const allTotals = live.map(midOf).filter(v => v != null);
const gMin = Math.min(...allTotals);
const gMax = Math.max(...allTotals);

const title = 'How much a day costs by country, compared, for US travelers | True Trip Costs';
const description = 'A ranked comparison of the typical daily cost for a US traveler in ' + live.length + ' countries: room plus on-the-ground spending, cheapest to priciest. Our own estimates for planning, not an official index. Checked ' + checkedLabel + '.';

// STRUCTURED DATA. dateModified is the most recent checkedISO across the live countries, the
// same figure checkedLabel is built from above, never a separate or newer date invented for
// the markup. This is our own comparative estimate rather than a government or price feed,
// so variableMeasured says so plainly.
const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Cost of a day, compared by country",
  "description": "A ranked comparison of the typical daily cost for a US traveler, room plus on-the-ground spending, across " + live.length + " countries.",
  "url": "https://truetripcosts.com/cost-comparison",
  "dateModified": isoDates[isoDates.length - 1],
  "creator": { "@type": "Organization", "name": "True Trip Costs" },
  "variableMeasured": "Typical daily cost for a US traveler (room rate plus on-the-ground spending), the True Trip Costs desk's own comparative estimate",
};
---

<Base ogImage="/og/cost-comparison.jpg" title={title} description={description}>
  <Nav />
  <main class="wrap ccpage">
    <Hero
      img="/hero/cost-comparison.jpg"
      alt="Illustration of a balance scale weighing a stack of coins against a small suitcase, for a guide comparing the daily cost of travel by country"
      title="How much does a day cost, country by country?"
      stamp={"Checked " + checkedLabel}
      slim />
    <p class="ccpage-lede">
      A typical day's cost for a US traveler, {live.length} countries ranked cheapest to priciest.
      Each bar is a room rate plus the on-the-ground spending (food, local transport, activities) for one day.
      The room rate here is the <b>rate a hotel or booking site displays</b>, not the final invoice. What gets
      added on top of that rate varies a lot by country, so use a country's own calculator for an all-in figure.
    </p>

    <p class="ccpage-honest">
      These are the True Trip Costs desk's own estimates of a typical day for a US traveler, room plus
      on-the-ground spending. They are meant for comparison and planning, not an official cost-of-living
      index and not a precise quote. <b>What these bars leave out is whatever a country adds on top of a
      displayed rate</b>, and that differs by market rather than by tax level. Across most of Europe and in
      Japan a displayed rate already includes the sales tax, so only a small nightly city tax is added at
      checkout. In much of the Caribbean, the Gulf and Mexico the displayed rate excludes tax and a fifth or
      more lands on the bill. So a destination that bills its taxes separately sits lower in this ranking
      than it would on an all-in basis, and one that folds them into the rate sits about where it belongs.
      Each country's guide has a calculator that adds its own charges to a room figure you choose.
      Checked <time datetime={isoDates[isoDates.length - 1]}>{checkedLabel}</time>. Switch the travel style to see how the ranking shifts.
    </p>

    <section class="ccpage-chart" aria-label="Daily cost ranking">
      <CostChart countries={live} defaultTier="Mid-range" id="daily-cost" />
    </section>

    <section class="ccpage-map" aria-labelledby="byregion">
      <h2 id="byregion">The same costs, by region</h2>
      <p class="ccpage-sub">
        Pick a region to see its covered countries shaded by typical daily cost: lighter is cheaper,
        darker is pricier. Mid-range travel style.
      </p>

      <div class="rg-toolbar" role="group" aria-label="Choose a region" id="rg-toolbar">
        {regions.map((r, i) => (
          <button type="button" class:list={["rg-tab", { 'is-active': i === 0 }]}
            data-region-btn={r.name} aria-pressed={i === 0 ? 'true' : 'false'}>{r.name}</button>
        ))}
      </div>

      {regions.map((r, i) => (
        <div class:list={["rg-panel", { 'is-active': i === 0 }]} data-region-panel={r.name} hidden={i !== 0}>
          <div class="rg-grid">
            {r.rows.map(row => {
              const t = gMax > gMin ? (row.total - gMin) / (gMax - gMin) : 0;
              return (
                <a class="rg-tile" href={`/${row.slug}`} style={`--t:${t.toFixed(3)}`}>
                  <span class="rg-name">{row.name}</span>
                  <span class="rg-cost num">${row.total}</span>
                </a>
              );
            })}
          </div>
        </div>
      ))}
      <p class="rg-scalenote" aria-hidden="true">
        <span class="rg-swatch rg-lo"></span> ${gMin}
        <span class="rg-scalebar"></span>
        ${gMax} <span class="rg-swatch rg-hi"></span>
      </p>
    </section>

    <p class="ccpage-rel">
      Cost is only half the question. For the other half, see which months each country gets
      <a href="/when-to-go">busy and pricey, and which go quiet and cheap</a>. And because a quoted
      room rate is rarely what a hotel bills you, see what
      <a href="/hotel-taxes-and-fees">taxes, levies and resort fees add on top</a>, country by country.
    </p>
    <p class="ccpage-foot">
      Want the detail behind a number? Open any country's guide for how we get to cash, cards and daily
      spend. Figures are the desk's own, checked <time datetime={isoDates[isoDates.length - 1]}>{checkedLabel}</time>, and refreshed as we re-check each country.
    </p>
    <CompareByRegion />
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)}></script>

  <style>
    .ccpage{max-width:860px}
    .ccpage h1{margin-bottom:10px}
    .ccpage-lede{font-size:18px;color:#3B4A46;max-width:640px;margin:22px 0 18px}
    .ccpage-honest{font-size:14px;color:var(--muted);background:var(--card);border:1px solid var(--line);border-left:3px solid var(--teal);border-radius:12px;padding:13px 16px;margin:0 0 30px;max-width:680px;box-shadow:var(--shadow)}
    .ccpage-chart{margin:0 0 46px}
    .ccpage-map h2{font-family:var(--serif);font-weight:500;font-size:clamp(22px,3.4vw,30px);letter-spacing:-.01em;margin:0 0 8px}
    .ccpage-sub{font-size:14.5px;color:var(--muted);margin:0 0 18px;max-width:620px}
    .ccpage-rel{font-size:14.5px;color:#3B4A46;line-height:1.55;margin:32px 0 0;max-width:660px}
    .ccpage-rel a{color:var(--teal-deep);font-weight:600}
    .ccpage-foot{font-size:14px;color:var(--muted);margin:16px 0 8px;max-width:660px}

    /* Region tiles */
    .rg-toolbar{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px}
    .rg-tab{font:inherit;font-size:13.5px;font-weight:600;color:var(--muted);background:var(--card);border:1px solid var(--line);border-radius:999px;padding:7px 14px;cursor:pointer;transition:background .18s ease,border-color .18s ease,color .18s ease,box-shadow .18s ease}
    .rg-tab:hover{border-color:var(--amber);color:var(--amber)}
    .rg-tab.is-active{background:var(--amber);border-color:var(--amber);color:#fff;box-shadow:0 1px 2px rgba(180,83,9,.25)}
    .rg-panel{animation:rg-fade .32s ease}
    .rg-panel[hidden]{display:none}
    @keyframes rg-fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
    .rg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
    /* Color grade from a light sand-teal (cheap) to deep teal (pricey), driven by --t (0..1). */
    .rg-tile{--c2:10,86,68;display:flex;flex-direction:column;gap:4px;justify-content:space-between;min-height:78px;padding:12px 14px;border-radius:12px;border:1px solid var(--line);text-decoration:none;background:rgba(var(--c2),calc(.08 + var(--t) * .82));transition:transform .16s ease,box-shadow .16s ease}
    .rg-tile:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
    .rg-name{font-weight:600;font-size:14.5px;line-height:1.25}
    .rg-cost{font-family:var(--serif);font-size:18px}
    /* Legibility: tiles past the midpoint get light text via a threshold class added in JS-free way. */
    .rg-tile{color:var(--ink)}
    .rg-tile[style*="--t:0.6"],.rg-tile[style*="--t:0.7"],.rg-tile[style*="--t:0.8"],.rg-tile[style*="--t:0.9"],.rg-tile[style*="--t:1"]{color:#EAF0ED}
    .rg-scalenote{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--muted);margin:16px 0 0}
    .rg-swatch{width:14px;height:14px;border-radius:4px;display:inline-block}
    .rg-swatch.rg-lo{background:rgba(10,86,68,.10)}
    .rg-swatch.rg-hi{background:rgba(10,86,68,.90)}
    .rg-scalebar{flex:0 0 90px;height:8px;border-radius:999px;background:linear-gradient(90deg,rgba(10,86,68,.10),rgba(10,86,68,.90))}

    @media (prefers-reduced-motion: reduce){
      .rg-panel{animation:none}
      .rg-tile{transition:none}
    }
  </style>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Ranked bar chart: tier toggle with FLIP reorder + tween ---- */
      var cc = document.getElementById('daily-cost');
      if (cc) {
        var listEl = document.getElementById('daily-cost-list');
        var payloadEl = document.querySelector('script[data-cc-payload="daily-cost"]');
        // Axis scale is per tier (see CostChart.astro): each travel style is
        // scaled to its own highest total so bars fill the width instead of
        // being squeezed by the priciest tier. The axis, gridlines and the
        // labeled scale maximum are all redrawn whenever the tier changes.
        var axisMaxByTier = {};
        try { axisMaxByTier = JSON.parse(cc.getAttribute('data-axismax') || '{}'); } catch (e) { axisMaxByTier = {}; }
        var axisMax = parseFloat(cc.getAttribute('data-scalemax')) || 0;

        var axisEl = cc.querySelector('.cc-axis');
        var gridLayer = cc.querySelector('.cc-gridlayer');
        var scaleMaxEl = cc.querySelector('.cc-scalemax');

        function tickStep(max, want) {
          var ladder = [25, 50, 100, 150, 200, 250, 500, 1000];
          for (var i = 0; i < ladder.length; i++) if (max / ladder[i] <= want) return ladder[i];
          return ladder[ladder.length - 1];
        }
        function ticksFor(max, want) {
          var s = tickStep(max, want), out = [];
          for (var v = 0; v <= max; v += s) out.push(v);
          // Close the axis on its true maximum, but only if that label would not
          // crowd the previous tick (at 320px a near-duplicate reads as a smudge).
          var lastTick = out[out.length - 1];
          if (lastTick !== max) {
            if ((max - lastTick) / s < 0.45) out[out.length - 1] = max;
            else out.push(max);
          }
          return out;
        }
        // Enhancement only. The server already rendered the sparse 4-tick set,
        // which is collision-free at every width. Here we ADD density on wide
        // desktops where there is clearly room; narrow and mid widths keep the
        // safe default. If this script never runs, the axis is still correct.
        function wantTicks() {
          return (window.innerWidth && window.innerWidth >= 768) ? 7 : 4;
        }

        function drawAxis() {
          if (!axisEl) return;
          var vals = ticksFor(axisMax, wantTicks());
          var aHtml = '', gHtml = '';
          for (var i = 0; i < vals.length; i++) {
            var left = axisMax ? (vals[i] / axisMax) * 100 : 0;
            aHtml += '<span class="cc-tick" style="left:' + left + '%">$' + vals[i] + '</span>';
            gHtml += '<span class="cc-grid" style="left:' + left + '%"></span>';
          }
          axisEl.innerHTML = aHtml;
          if (gridLayer) gridLayer.innerHTML = gHtml;
          if (scaleMaxEl) scaleMaxEl.textContent = '$' + axisMax;
        }
        // Draw the axis immediately, before any payload or render logic that
        // could throw, so the enhanced tick count is never blocked by an
        // unrelated failure later in this block.
        drawAxis();

        var payload = {};
        try { payload = payloadEl ? JSON.parse(payloadEl.textContent) : {}; } catch (e) { payload = {}; }
        var btns = cc.querySelectorAll('[data-tier-btn]');
        var current = cc.getAttribute('data-tier') || 'Mid-range';
        var pct = function (v) { return axisMax ? (v / axisMax) * 100 : 0; };

        // Set by the tax-segment block further down, if it runs at all. Held here
        // so render() and the resize handler can redraw a picked country's segment
        // against the new tier scale or the new bar width without knowing whether
        // the enhancement loaded.
        var reapplyTax = function () {};

        function rowsFor(tier) { return payload[tier] || []; }

        function render(tier) {
          var rows = rowsFor(tier);
          if (!rows.length) return;

          // Rescale to this tier's own max, then redraw the axis, gridlines and
          // the labeled scale maximum so the numbers on screen always describe
          // the bars being shown.
          if (axisMaxByTier[tier]) axisMax = axisMaxByTier[tier];
          drawAxis();

          // FLIP step 1: record current positions of existing rows by slug.
          var first = {};
          var existing = listEl.querySelectorAll('.cc-row');
          for (var i = 0; i < existing.length; i++) {
            first[existing[i].getAttribute('data-slug')] = existing[i].getBoundingClientRect().top;
          }

          // Map existing row nodes by slug so we can reorder them, not rebuild.
          var bySlug = {};
          for (var j = 0; j < existing.length; j++) bySlug[existing[j].getAttribute('data-slug')] = existing[j];

          // Reorder + update numbers/segment widths to the new tier.
          rows.forEach(function (r, idx) {
            var node = bySlug[r.slug];
            if (!node) return;
            node.style.setProperty('--rank', idx);
            listEl.appendChild(node); // append in new sorted order
            var room = node.querySelector('.cc-room');
            var per = node.querySelector('.cc-per');
            var total = node.querySelector('.cc-total');
            if (room) room.style.width = pct(r.room) + '%';
            if (per) per.style.width = pct(r.per) + '%';
            if (total) animateNumber(total, r.total);
          });

          // A tax segment is per tier: a percentage of the room scales with the
          // room figure, and Japan's banded rate can land in a different band. So
          // it is recomputed here, before the reduced-motion return below.
          reapplyTax();

          if (reduce) return; // no movement animation for reduced-motion users

          // FLIP step 2+3: measure new positions, invert, then play.
          var last = {};
          var now = listEl.querySelectorAll('.cc-row');
          for (var k = 0; k < now.length; k++) {
            var slug = now[k].getAttribute('data-slug');
            last[slug] = now[k].getBoundingClientRect().top;
          }
          for (var m = 0; m < now.length; m++) {
            var s = now[m].getAttribute('data-slug');
            var dy = (first[s] || last[s]) - last[s];
            if (!dy) continue;
            now[m].style.transition = 'none';
            now[m].style.transform = 'translateY(' + dy + 'px)';
          }
          // Force reflow, then transition all to their natural spot.
          void listEl.offsetHeight;
          for (var n = 0; n < now.length; n++) {
            now[n].style.transition = 'transform .5s cubic-bezier(.22,.61,.36,1)';
            now[n].style.transform = '';
          }
        }

        function animateNumber(el, to) {
          var from = parseFloat((el.textContent || '').replace(/[^0-9.]/g, '')) || 0;
          if (reduce || from === to) { el.textContent = '$' + to; return; }
          var start = null, dur = 420;
          function tick(ts) {
            if (start === null) start = ts;
            var p = Math.min(1, (ts - start) / dur);
            var val = Math.round(from + (to - from) * (0.5 - Math.cos(p * Math.PI) / 2));
            el.textContent = '$' + val;
            if (p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        }

        // Redraw on resize or rotation so the desktop density kicks in or drops
        // as the viewport crosses 768px. The initial draw already happened above.
        var rzT = null;
        window.addEventListener('resize', function () {
          if (rzT) clearTimeout(rzT);
          rzT = setTimeout(function () { drawAxis(); reapplyTax(); }, 150);
        });

        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            var tier = b.getAttribute('data-tier-btn');
            if (tier === current) return;
            current = tier;
            cc.setAttribute('data-tier', tier);
            btns.forEach(function (x) {
              var on = x === b;
              x.classList.toggle('is-active', on);
              x.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            render(tier);
          });
        });

        /* ---- One destination's hotel tax, appended to its own bar ----
           Progressive enhancement on top of the pre-tax chart. The default above
           is untouched until a reader picks a country, and only ever that one
           country's bar changes: nothing is re-sorted and no other bar is taxed.
           Every node comes from the component's template so the scoped styles
           apply, and so a reader without JS sees the plain chart and nothing else. */
        var taxTpl = cc.querySelector('template[data-cc-taxbits="daily-cost"]');
        var taxPayEl = document.querySelector('script[data-cc-taxpayload="daily-cost"]');
        var taxData = null;
        try { taxData = taxPayEl ? JSON.parse(taxPayEl.textContent) : null; } catch (e) { taxData = null; }

        if (taxTpl && taxTpl.content && taxData && taxData.byCountry) {
          var bits = taxTpl.content;
          var ui = bits.querySelector('.cc-taxui').cloneNode(true);
          var scaleEl = cc.querySelector('.cc-scale');
          if (scaleEl && scaleEl.parentNode) {
            scaleEl.parentNode.insertBefore(ui, scaleEl.nextSibling);

            var prompt = ui.querySelector('.cc-taxprompt');
            var openBtn = ui.querySelector('.cc-taxopen');
            var panel = ui.querySelector('.cc-taxpanel');
            var cSel = ui.querySelector('.cc-taxcountry');
            var subWrap = ui.querySelector('.cc-taxsubwrap');
            var subQ = ui.querySelector('.cc-taxsubq');
            var subSel = ui.querySelector('.cc-taxsub');
            var clearBtn = ui.querySelector('.cc-taxclear');

            // The legend gains a key for the hatched amber only while one is drawn.
            var legendEl = cc.querySelector('.cc-legend');
            var legendKey = bits.querySelector('.cc-taxlegend').cloneNode(true);
            legendKey.hidden = true;
            if (legendEl) legendEl.appendChild(legendKey);

            var pick = { slug: '', key: '' };

            cSel.insertBefore(new Option('Pick a destination', ''), cSel.firstChild);
            cSel.value = '';

            function tierIdx() {
              var i = (taxData.tiers || []).indexOf(current);
              return i < 0 ? 0 : i;
            }
            function rowFor(slug) {
              return listEl.querySelector('.cc-row[data-slug="' + slug + '"]');
            }
            function modelRow(slug) {
              var rows = rowsFor(current);
              for (var i = 0; i < rows.length; i++) if (rows[i].slug === slug) return rows[i];
              return null;
            }
            function ensureNode(row, sel, into) {
              var n = row.querySelector(sel);
              if (!n) {
                n = bits.querySelector(sel).cloneNode(true);
                (into || row).appendChild(n);
              }
              return n;
            }
            function hideCap(cap) {
              cap.style.maxHeight = '0px';
              cap.style.opacity = '0';
            }
            function showCap(cap) {
              cap.style.maxHeight = cap.scrollHeight + 'px';
              cap.style.opacity = '1';
            }
            // A roll in flight has to be stopped before anything else writes to the
            // figure. Switching country or travel style mid-roll otherwise leaves the
            // old animation counting toward a number that is no longer the answer, and
            // it wins, because it writes last.
            function stopRoll(el) {
              if (el.ccRaf) { cancelAnimationFrame(el.ccRaf); el.ccRaf = 0; }
            }
            // The dollar figure settles into place rather than snapping, on the same
            // ease-out the segment uses, so the two read as one movement.
            function rollTo(el, to, animate) {
              stopRoll(el);
              var from = parseFloat((el.textContent || '').replace(/[^0-9.]/g, '')) || 0;
              if (!animate || reduce || from === to) { el.textContent = '$' + to; return; }
              var start = null, dur = 620;
              function tick(ts) {
                if (start === null) start = ts;
                var p = Math.min(1, (ts - start) / dur);
                var e = 1 - Math.pow(1 - p, 3);
                el.textContent = '$' + Math.round(from + (to - from) * e);
                el.ccRaf = (p < 1) ? requestAnimationFrame(tick) : 0;
              }
              el.ccRaf = requestAnimationFrame(tick);
            }
            function clearRow(row, animate) {
              row.classList.remove('is-picked', 'is-taxed', 'is-over');
              var seg = row.querySelector('.cc-taxseg');
              var cap = row.querySelector('.cc-cap');
              if (seg) seg.style.width = '0%';
              if (cap) hideCap(cap);
              var drop = function () {
                row.ccDrop = 0;
                if (seg && seg.parentNode) seg.parentNode.removeChild(seg);
                if (cap && cap.parentNode) cap.parentNode.removeChild(cap);
              };
              // The old segment shrinks back to nothing as the new one grows, then
              // the nodes go. Reduced motion skips straight to the end state.
              if (row.ccDrop) clearTimeout(row.ccDrop);
              if (animate && !reduce) row.ccDrop = setTimeout(drop, 660); else drop();
            }
            function clearOthers(slug, animate) {
              var picked = listEl.querySelectorAll('.cc-row.is-picked');
              for (var i = 0; i < picked.length; i++) {
                if (picked[i].getAttribute('data-slug') !== slug) clearRow(picked[i], animate);
              }
            }

            // The picker sits above a 59-bar chart, so the bar you just picked can be a
            // long way down the page. Bring it into view, but only once there is actually
            // something to look at: for a multi-region country that means after the
            // sub-choice, because scrolling away the moment the country is picked would
            // take the sub-picker with it, and that is the reader's next action.
            function revealRow(row) {
              if (typeof row.scrollIntoView !== 'function') return;
              var box = row.getBoundingClientRect ? row.getBoundingClientRect() : null;
              var vh = window.innerHeight || 0;
              // Already comfortably on screen: leave the page where the reader put it.
              // Scrolling a bar that is right in front of them is just a lurch.
              if (box && vh && box.top >= 80 && box.bottom <= vh - 80) return;
              try {
                row.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
              } catch (e) {
                row.scrollIntoView(); // older Safari takes no options object
              }
            }

            function applyTax(animate) {
              clearOthers(pick.slug, animate);
              if (!pick.slug) { legendKey.hidden = true; return; }
              var row = rowFor(pick.slug);
              var mr = modelRow(pick.slug);
              if (!row || !mr) { legendKey.hidden = true; return; }
              var m = taxData.byCountry[pick.slug] || {};

              // Re-picking a country inside the shrink-out window must not have its
              // fresh nodes removed by the previous pick's pending cleanup.
              if (row.ccDrop) { clearTimeout(row.ccDrop); row.ccDrop = 0; }

              row.classList.add('is-picked');
              var cap = ensureNode(row, '.cc-cap');
              var rule = cap.querySelector('.cc-cap-rule');
              var amtWrap = cap.querySelector('.cc-cap-amt');
              var amtEl = cap.querySelector('.cc-taxamt');
              var extraEl = cap.querySelector('.cc-cap-extra');
              var noteEl = cap.querySelector('.cc-cap-n');

              // A country with no charge modelled. Absence is not zero and it is not
              // a gap either: it is a useful answer, so it gets said plainly.
              if (!m.o || !m.o.length) {
                row.classList.remove('is-taxed', 'is-over');
                var s0 = row.querySelector('.cc-taxseg');
                if (s0) s0.style.width = '0%';
                rule.textContent = (m.s || '') + ': ' + (m.n || 'no separate hotel tax here') + '.';
                amtWrap.hidden = true;
                extraEl.textContent = '';
                noteEl.hidden = true;   // nothing was added, so nothing to explain
                legendKey.hidden = true;
                showCap(cap);
                if (animate) revealRow(row);
                return;
              }

              // Multi-region country, no sub-choice yet: the pick registers as a
              // highlight, but no figure is drawn until we know which rate applies.
              if (!pick.key) {
                row.classList.remove('is-taxed', 'is-over');
                var s1 = row.querySelector('.cc-taxseg');
                if (s1) s1.style.width = '0%';
                hideCap(cap);
                legendKey.hidden = true;
                return;
              }

              var opt = null;
              for (var i = 0; i < m.o.length; i++) if (m.o[i].k === pick.key) opt = m.o[i];
              if (!opt) { hideCap(cap); return; }

              var idx = tierIdx();
              var usd = opt.u[idx];
              var phrase = (typeof opt.p === 'string') ? opt.p : opt.p[idx];

              rule.textContent = opt.s + ': ' + phrase + '.';
              extraEl.textContent = opt.t ? (' ' + opt.t) : '';

              var barEl = row.querySelector('.cc-bar');
              var seg = ensureNode(row, '.cc-taxseg', barEl);

              if (!usd || usd <= 0) {
                // A real, sourced zero. London and Munich belong here, and the honest
                // answer is the sentence, not a zero-width segment.
                row.classList.remove('is-taxed', 'is-over');
                seg.style.width = '0%';
                amtWrap.hidden = true;
                noteEl.hidden = true;
                legendKey.hidden = true;
                showCap(cap);
                if (animate) revealRow(row);
                return;
              }

              var leftPct = pct(mr.total);
              var wPct = pct(usd);

              // The gutter between the bar's right edge and the row's is the room the
              // add-on has to run into when a taxed bar passes the axis maximum. It is
              // measured, not assumed, so it survives a resize and the mobile layout.
              var trackEl = row.querySelector('.cc-track');
              var barW = barEl.getBoundingClientRect().width;
              var gutter = trackEl && barW
                ? Math.max(0, trackEl.getBoundingClientRect().right - barEl.getBoundingClientRect().right)
                : 0;
              var maxRight = 100 + (barW ? (gutter / barW) * 100 : 0);
              var over = (leftPct + wPct) > 100.01;
              if (leftPct + wPct > maxRight) wPct = Math.max(0, maxRight - leftPct);

              row.classList.toggle('is-over', over);
              row.classList.add('is-taxed');
              seg.style.left = leftPct + '%';

              if (animate && !reduce) {
                requestAnimationFrame(function () { seg.style.width = wPct + '%'; });
              } else {
                seg.style.transition = 'none';
                seg.style.width = wPct + '%';
                void seg.offsetWidth;
                seg.style.transition = '';
              }

              if (usd < 1) {
                // Rounding a real 60-cent charge to "$1" would overstate it, and to
                // "$0" would deny it. Say what it is instead.
                stopRoll(amtEl);
                amtEl.textContent = 'under $1';
                amtWrap.hidden = false;
              } else {
                amtWrap.hidden = false;
                rollTo(amtEl, Math.round(usd), animate);
              }
              noteEl.hidden = false;
              legendKey.hidden = false;
              showCap(cap);
              // The caption grows as the segment does, so re-measure once the text is set.
              requestAnimationFrame(function () { showCap(cap); });
              // animate is false on a tier change or a resize, where the reader is already
              // looking at the chart and moving the page under them would be an intrusion.
              if (animate) revealRow(row);
            }

            reapplyTax = function () { applyTax(false); };

            function setCountry(slug) {
              clearOthers(slug, true);
              pick.slug = slug;
              pick.key = '';
              subWrap.hidden = true;
              subSel.innerHTML = '';
              clearBtn.hidden = !slug;
              if (!slug) { applyTax(true); return; }
              var m = taxData.byCountry[slug];
              if (m && m.q && m.o && m.o.length > 1) {
                subQ.textContent = m.q;
                subSel.appendChild(new Option('Choose one', ''));
                for (var i = 0; i < m.o.length; i++) {
                  subSel.appendChild(new Option(m.o[i].l || m.o[i].s, m.o[i].k));
                }
                subSel.value = '';
                subWrap.hidden = false;
              } else if (m && m.o && m.o.length === 1) {
                pick.key = m.o[0].k;
              }
              applyTax(true);
            }

            openBtn.addEventListener('click', function () {
              prompt.hidden = true;
              panel.hidden = false;
              cSel.focus();
            });
            cSel.addEventListener('change', function () { setCountry(cSel.value); });
            subSel.addEventListener('change', function () {
              pick.key = subSel.value || '';
              applyTax(true);
            });
            clearBtn.addEventListener('click', function () {
              setCountry('');
              cSel.value = '';
              panel.hidden = true;
              prompt.hidden = false;
              openBtn.focus();
            });
          }
        }
      }

      /* ---- Region switch: cross-fade panels ---- */
      var rgToolbar = document.getElementById('rg-toolbar');
      if (rgToolbar) {
        var tabs = rgToolbar.querySelectorAll('[data-region-btn]');
        var panels = document.querySelectorAll('[data-region-panel]');
        tabs.forEach(function (t) {
          t.addEventListener('click', function () {
            var name = t.getAttribute('data-region-btn');
            tabs.forEach(function (x) {
              var on = x === t;
              x.classList.toggle('is-active', on);
              x.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            panels.forEach(function (p) {
              var on = p.getAttribute('data-region-panel') === name;
              p.hidden = !on;
              p.classList.toggle('is-active', on);
            });
          });
        });
      }
    })();
  </script>
</Base>
