---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HotelTaxMap from '../components/HotelTaxMap.astro';
import CompareByRegion from '../components/CompareByRegion.astro';
import USBadge from '../components/USBadge.astro';
import { hotelTaxMap, computeAddedTax, localToUsd, perUsdFor, hotelTaxMapCheckedISO } from '../data/hotel-tax-map.js';

// The hotel tax world map. A NEW PAGE rather than the hero of /hotel-taxes-and-fees, and
// the reasoning is worth keeping because it will come up again for the next map.
//
// The hub answers the query directly in its opening lines and already ranks on it. Putting
// a whole-world map above that copy pushes the answer below the fold, which is the exact
// failure RegionMap.astro's own note warns about ("so it sets the scene without pushing the
// answer below the fold"), and a world choropleth is far heavier than a locator inset. A
// page that exists to be screenshotted and linked also wants its own canonical URL to
// collect those links, rather than sending them to a hub whose job is the four-part
// explainer. So the hub keeps its opening and gains a prominent link down to here, and the
// map gets a URL of its own.
//
// The map does not try to rank as an island. Every shaded country links to its own hotel
// taxes spoke or its guide, which is where the sourced, dated detail lives and where the
// existing rankings are; the map is the discovery surface that feeds them.
//
// THE EMBED SNIPPET, and why it is a const rather than typed into the markup. The height has
// to agree with the real height of /embed/hotel-tax-map or the frame scrolls internally on a
// stranger's article, so it is a number somebody will need to retune when that page changes.
// Keeping it here, named, means it gets found. 720 is measured against the embed as built:
// the map is 1000 by 439, so at a typical 640px article column the figure is about 325px
// including its frame, and the head, colour scale, legend note and credit bar bring the whole
// thing to roughly 580px. The margin covers narrow columns, where the map shortens but the
// text wraps to more lines.
//
// loading=lazy so the embed costs the host page nothing until it scrolls near. The referrer
// policy is the browser default spelled out, so TTC can still see which sites are embedding
// the map without leaking a full URL to an http host.
// THE CALCULATOR'S SERVER-RENDERED DEFAULT. Computed at build so the section shows one real
// worked answer with JavaScript off rather than an inert form. The default country is chosen
// to teach the counterintuitive case on first sight: France is a FLAT charge, so the total
// does not move when a reader changes the room rate, which is the single least obvious thing
// this whole map has to say. A percentage country would show the behaviour everyone already
// expects and teach nothing.
const CALC_DEFAULT_ISO = 'FR';
const CALC_DEFAULTS = { nightlyUsd: 150, nights: 3, guests: 2 };
// US and Canada are left OUT of the calculator picker on purpose. Both are so federated
// (state and city occupancy taxes in the US, provincial and municipal in Canada) that there
// is no single national number to compute, so the calculator could only shrug at them. They
// stay fully present ON the map, clickable to their own row, where the honest "it depends
// where you stay" explanation belongs. When real per-jurisdiction data exists they come back.
const CALC_EXCLUDE = new Set(['US', 'CA']);
const calcCountries = hotelTaxMap.filter(e => e && e.iso && e.country && !CALC_EXCLUDE.has(e.iso)).slice()
  .sort((a, b) => a.country.localeCompare(b.country));

// The headline sentence per kind. Held here beside the build-time default AND mirrored in the
// inline script, because the two have to agree; the script is the only duplicate of these
// strings on the page and it is annotated as such.
function calcHead(entry, r, inputs) {
  const room = inputs.nightlyUsd * inputs.nights;
  const money = (v) => '$' + Math.round(v).toLocaleString('en-US');
  if (r.kind === 'percent' || r.kind === 'flat') {
    const eff = room > 0 ? (r.addedUsd / room * 100) : 0;
    return `Government tax adds about <b>${money(r.addedUsd)}</b> over ${inputs.nights} night${inputs.nights === 1 ? '' : 's'}, about <b>${eff.toFixed(1)}%</b> of your room.`;
  }
  if (r.kind === 'inclusive') return `Nothing is added at checkout in <b>${entry.country}</b>.`;
  return `No honest single figure for <b>${entry ? entry.country : 'this country'}</b>.`;
}

// WHAT THE SCRIPT GETS, built by asking computeAddedTax rather than by re-reading the entries.
// The kind and the note are taken verbatim from the function, so the client can never
// classify a country differently from the server. Only the raw multipliers are added, and
// they come from the same exported FX wrapper the fill uses.
const calcData = Object.fromEntries(hotelTaxMap.filter(e => e && e.iso && e.country && !CALC_EXCLUDE.has(e.iso)).map(e => {
  const probe = computeAddedTax(e, CALC_DEFAULTS);
  const row = { country: e.country, kind: probe.kind, note: probe.note };
  if (probe.kind === 'flat') {
    let perRoomNight = 0, perPersonNight = 0;
    for (const f of e.modelled) {
      const usd = localToUsd(f.amount, f.currency);
      if (f.unit === 'perPersonPerNight') perPersonNight += usd; else perRoomNight += usd;
    }
    Object.assign(row, { perRoomNight, perPersonNight, basePct: e.basePct || 0 });
  }
  if (probe.kind === 'percent') {
    row.pct = e.addedPct;
    if (Array.isArray(e.rateTiers) && e.tierCurrency) {
      // The rate table is applied ONCE, here, so the client multiplies rather than converts.
      row.tierRate = perUsdFor(e.tierCurrency);
      row.tiers = e.rateTiers.map(t => ({ upTo: t.upTo, pct: t.pct, note: t.note || '' }));
    }
  }
  return [e.iso, row];
}));

const calcDefaultEntry = hotelTaxMap.find(e => e.iso === CALC_DEFAULT_ISO);
const calcResult = computeAddedTax(calcDefaultEntry, CALC_DEFAULTS);
const calcDefault = { head: calcHead(calcDefaultEntry, calcResult, CALC_DEFAULTS), note: calcResult.note };

const SNIPPET = `<iframe src="https://truetripcosts.com/embed/hotel-tax-map" width="100%" height="720"
  style="border:0" title="Hotel tax by country, from True Trip Costs" loading="lazy"
  referrerpolicy="no-referrer-when-downgrade"></iframe>`;

// STRUCTURED DATA, honest and narrow. This is a Dataset: a sourced, per-country tax figure
// held for {calcCountries.length + 2}-ish covered countries (the two US/CA are held on the
// map without a single national figure, so they are named but not counted as variableMeasured
// records). dateModified is the SAME page-level checked date the visible stamp under the map
// already carries, never a separate or newer one invented for the markup. No Review, Offer,
// or AggregateRating: nothing here is a rating or a price, only a checked government figure.
const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Hotel tax by country",
  "description": "Government tax and mandatory levies added on top of a quoted hotel room rate, by country, each figure sourced to the tax authority that sets it and dated.",
  "url": "https://truetripcosts.com/hotel-tax-map",
  "dateModified": hotelTaxMapCheckedISO,
  "creator": { "@type": "Organization", "name": "True Trip Costs" },
  "variableMeasured": "Government hotel tax and mandatory levies added at checkout, as a share of a quoted room rate",
};
---
<Base
  title="Hotel tax by country, mapped: what governments add to a room rate"
  description="A world map of what government tax and mandatory levies add on top of a quoted hotel room rate, country by country. Government charges only, each one sourced and dated, with resort fees kept separate.">
  <Nav />
  <main class="wrap">

    <section class="htx-intro">
      <p class="lab">Hotel taxes and fees</p>
      <div style="margin:2px 0 12px"><USBadge /></div>
      <h1>The world, shaded by what gets added at checkout.</h1>
      <p class="htx-lede">Two hotel rooms can be advertised at the same price and settle hundreds of dollars apart, because what a government adds on top of a quoted rate ranges from nothing to roughly a quarter. This map colours countries by that gap alone: the tax and mandatory levies that appear after you have already compared prices.</p>
      <p class="htx-lede htx-lede2">It is a deliberately narrow question, and the narrowness is the point. A map of total tax burden would shade half of Europe dark and tell you nothing useful, because that tax is already inside the price you were quoted. What costs you a surprise is the part that is not, which is why some of the most heavily taxed countries in Europe sit at the light end here.</p>
    </section>

    {/* THE MAP LEADS. It is the headline asset and the reason this page exists, so it is the
        first substantial thing after the one-line intro, not the third. The stay calculator
        sits immediately under it, because the map raises the question ("how much is that,
        for me?") and the calculator is the answer. The longer scope/methodology framing that
        used to sit here, between the intro and the tool, now sits below both, folded, so it
        is still fully present without pushing the tool below the first screen. */}
    <HotelTaxMap />

    {/* THE STAY CALCULATOR. All arithmetic comes from computeAddedTax in
        src/data/hotel-tax-map.js: nothing on this page does percentage or currency math of
        its own, so the calculator and the fill cannot drift.

        SERVER-RENDERED WITH A REAL WORKED EXAMPLE. The default result below is computed at
        build time, so with JavaScript off this section is not an inert form: it shows one
        honest answer for one country and the inputs still describe what it would do. The
        script only re-computes on input.

        WHY THE COUNTRY LIST IS SHORTER THAN THE MAP LOOKS. Only countries with an entry are
        offered. A picker that lists a country and then shrugs is worse than one that does not
        list it, and an unchecked country has nothing to shrug about honestly. */}
    <section class="htx-calc" id="stay-calculator">
      <p class="lab">Your stay</p>
      <h2>What will the tax actually add?</h2>
      <p class="htx-calc-sub">Enter your own room rate, nights and party size. This is the government tax that lands on top of the rate you were quoted, computed the way that country actually charges it, which is not always a percentage. Where a country cannot honestly produce one number, it says so instead of guessing.</p>

      <div class="htx-calc-grid">
        <div class="htx-calc-f htx-calc-f-wide">
          <label for="calc-country">Where are you staying</label>
          <select id="calc-country" data-calc-country>
            {calcCountries.map(e => (
              <option value={e.iso} selected={e.iso === CALC_DEFAULT_ISO ? true : undefined}>{e.country}</option>
            ))}
          </select>
        </div>
        <div class="htx-calc-f">
          <label for="calc-rate">Your nightly room rate</label>
          <div class="htx-calc-money">
            <span aria-hidden="true">$</span>
            <input id="calc-rate" type="number" inputmode="decimal" min="1" max="20000" step="1" value={CALC_DEFAULTS.nightlyUsd} data-calc-rate />
          </div>
        </div>
        <div class="htx-calc-f">
          <label for="calc-nights">Nights</label>
          <input id="calc-nights" type="number" inputmode="numeric" min="1" max="365" step="1" value={CALC_DEFAULTS.nights} data-calc-nights />
        </div>
        <div class="htx-calc-f">
          <label for="calc-guests">Guests in the room</label>
          <input id="calc-guests" type="number" inputmode="numeric" min="1" max="10" step="1" value={CALC_DEFAULTS.guests} data-calc-guests />
        </div>
      </div>

      <div class="htx-calc-out" data-calc-out data-kind={calcResult.kind} role="status" aria-live="polite">
        <p class="htx-calc-head" data-calc-head set:html={calcDefault.head}></p>
        <p class="htx-calc-note" data-calc-note>{calcDefault.note}</p>
      </div>

      {/* THE STANDING LINE, under every result and never conditional on the country. The
          government figure is the only thing this page can source nationally, and it is
          routinely the smaller half of what a reader actually pays. */}
      <p class="htx-calc-std">This is the government tax only. Resort fees and mandatory service charges are set by the hotel, not a government, so they are not in this figure and are often larger than it. <a href="#property-fees">What hotels add, and how to ask</a>, or see <a href="/cash-or-card">cash or card</a> for the fees a bank adds.</p>
    </section>

    {/* THE SCOPE CALLOUT, MOVED BELOW THE TOOL AND FOLDED. This used to sit between the
        intro and the calculator, which meant a reader met two blocks of framing prose before
        the map or the calculator. The honest boundary it draws (government tax only, not the
        whole surprise) still matters, so nothing here is deleted or reworded; it is a
        <details>, open to a glance at its own summary line and one tap from its full text,
        rather than a wall of prose blocking the tool above it. */}
    <details class="htx-scope">
      <summary class="htx-scope-sum">What this map shows, and what it does not</summary>
      <p class="htx-scope-t">True Trip Costs exists to surface the money you were not quoted, whoever charges it. This map is one slice of that: the government tax and mandatory levies added at checkout, because those are the part we can pin to a single sourced number for a whole country. It is deliberately not the whole surprise. A resort fee, a mandatory service charge, an ATM fee or a card-conversion skim are unquoted costs too, often larger than the tax, and they are set property by property or bank by bank, so no single national figure exists for them. They are covered in the country guides and in <a href="/cash-or-card">cash or card</a>, and the ones a hotel adds are summarised below.</p>
    </details>

    {/* THE EMBED CONTROL, DIRECTLY UNDER THE MAP. It used to be a CTA two sections above the
        map linking down to a section well below it, so a reader who wanted the code was sent
        away from the thing they wanted to embed, and the page carried the promise in one place
        and the snippet in another.

        A <details> rather than a button and a script, deliberately. The reveal works with
        JavaScript off, which the old jump link also did, so no reader loses anything. The copy
        button inside is still progressive enhancement on top: it stays hidden unless the
        Clipboard API is actually present.

        The same block, with the same wording and the same behaviour, sits under the rate-parity
        map on /how-to-pay-less-on-hotels. That is the point of this pass: one control, one
        place, on both maps. */}
    <details class="htx-embed">
      <summary class="htx-embed-sum">
        <span class="htx-embed-sum-t">Use this map on your own site</span>
        <svg class="htx-embed-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="htx-embed-body">
        <p class="htx-embed-t">Free to embed anywhere, including commercially, and it stays current on your page: as we check more countries and correct what changes, an embedded copy updates itself with no re-paste. A credit link back is appreciated and not required, because the frame carries one already.</p>

        <label class="htx-esnip-lab" for="htx-esnip">Paste this where you want the map</label>
        <textarea class="htx-esnip" id="htx-esnip" readonly rows="4" spellcheck="false" aria-describedby="htx-ecopy-hint">{SNIPPET}</textarea>

        <div class="htx-erow">
          <button class="htx-ecopy" type="button" data-copy-snippet hidden>Copy the snippet</button>
          <span class="htx-ecopy-msg" data-copy-msg role="status" aria-live="polite"></span>
          <a class="htx-eprev" href="/embed/hotel-tax-map" target="_blank" rel="noopener">See what it looks like</a>
        </div>
        <p class="htx-ehint" id="htx-ecopy-hint">Clicking the box selects the whole snippet, so it copies with one keystroke if the button is not there.</p>
      </div>
    </details>


    <section class="htx-more">
      <h2>Where the detail lives</h2>
      <p>Each shaded country above links to its own write-up, which is where the rates are kept current, sourced against the authority that sets them and dated. For the four kinds of charge that land on a hotel bill and how to tell them apart, start with the <a href="/hotel-taxes-and-fees">hotel taxes and fees guide</a>. For per-night bed taxes and entry charges specifically, see <a href="/tourist-taxes">tourist taxes and fees</a>, and for what a day costs once the room is paid for, <a href="/cost-comparison">cost of a day, compared</a>.</p>
      <p class="htx-keep">Government rates are read off the tax authority, ministry or city that sets them and dated on the country's row. Service charges and resort fees are set by each property, so where we give a figure it is a range from recent reports rather than a published rate, and it never affects the shading. A country left unshaded has not been checked yet, which is not the same as a country with nothing to pay. More on how we work is on our <a href="/methodology">methodology page</a>.</p>
    </section>

    <section class="htx-prop" id="property-fees">
      <h2>The fees the map cannot colour, and how to get your real number</h2>
      <p>A resort fee or a mandatory service charge is set by the hotel, not a government, so there is no national rate to shade a country by. That does not make them small. A service charge is commonly 10 to 15% of the room, and US resort fees run roughly 30 to 90 dollars a night on their own, so at many properties these outweigh the tax the map shows. We hold a range where the reports support one, on the affected country's row above, always labelled as the property's rather than the government's.</p>
      <p class="htx-prop-do"><b>How to get the exact figure before you book:</b> ask the property directly. A resort fee or service charge is discretionary to the hotel, so the only reliable number is the one they give you. Before you book, call or email and ask two questions: what is the mandatory resort fee or service charge per night, and is it already in the rate you are quoting me or added at checkout. Get it in writing if you can. That one email is the difference between the price you compared and the price you pay, and it is the number to add to whatever this map tells you the government takes.</p>
      <p class="htx-keep">For the rest of the booking conversation, the wording that gets an answer, the four things to confirm in writing, and what a direct booking can actually recover, see <a href="/how-to-pay-less-on-hotels#the-practical-how">how to pay less on hotels</a>.</p>
    </section>

    <CompareByRegion />
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)}></script>

  {/* THE CALCULATOR SCRIPT. Plain DOM, no framework, no external request, and it does no
      arithmetic of its own: the per-country numbers are serialised from computeAddedTax at
      build time into a JSON island below, so the script is a lookup and a multiply rather
      than a second implementation of the tax rules. That is the whole point of keeping the
      math in the data file.

      WHY SERIALISE RATHER THAN SHIP THE FUNCTION. computeAddedTax needs the fx table and four
      predicate helpers, which would mean bundling a slice of the data layer into the page for
      a form. What the UI actually needs per country is small and flat: how the charge behaves,
      the percent or the per-night dollars, and the note. So the build precomputes that and the
      script applies it. If a country's rules change, the data file changes and this rebuilds;
      the script never needs to know. */}
  <script is:inline define:vars={{ CALC: calcData, DEFAULT_ISO: CALC_DEFAULT_ISO }}>
    (function () {
      var sel = document.querySelector('[data-calc-country]');
      var rate = document.querySelector('[data-calc-rate]');
      var nights = document.querySelector('[data-calc-nights]');
      var guests = document.querySelector('[data-calc-guests]');
      var head = document.querySelector('[data-calc-head]');
      var note = document.querySelector('[data-calc-note]');
      var out = document.querySelector('[data-calc-out]');
      if (!sel || !rate || !nights || !guests || !head || !note) return;

      function money(v) { return '$' + Math.round(v).toLocaleString('en-US'); }

      // Clamp to the same bounds the inputs declare, so a pasted or spun value cannot produce
      // a total from a negative room or a 400-night stay.
      function num(el, min, max, fallback) {
        var v = parseFloat(el.value);
        if (!isFinite(v)) return fallback;
        return Math.min(max, Math.max(min, v));
      }

      function render() {
        var c = CALC[sel.value];
        var r = num(rate, 1, 20000, 150);
        var n = Math.floor(num(nights, 1, 365, 3));
        var g = Math.floor(num(guests, 1, 10, 2));
        if (!c) { head.textContent = ''; note.textContent = ''; return; }

        var room = r * n;
        var added = null;

        if (c.kind === 'percent') {
          // A rate-tiered country carries its ladder, so the rung follows the reader's rate
          // exactly as it does at build time. Boundaries are in the local currency the law
          // fixes them in, converted once at build into the perUsd figure below.
          var pct = c.pct;
          if (c.tiers) {
            var local = r * c.tierRate;
            pct = c.tiers[c.tiers.length - 1].pct;
            for (var i = 0; i < c.tiers.length; i++) {
              if (c.tiers[i].upTo === null || local <= c.tiers[i].upTo) { pct = c.tiers[i].pct; break; }
            }
          }
          added = room * (pct / 100);
        } else if (c.kind === 'flat') {
          // Flat dollars per unit, precomputed per country, plus any real percentage part.
          added = c.perRoomNight * n + c.perPersonNight * g * n + room * (c.basePct / 100);
        } else if (c.kind === 'inclusive') {
          added = 0;
        }

        if (c.kind === 'notComputable') {
          head.innerHTML = 'No honest single figure for <b>' + c.country + '</b>.';
        } else if (c.kind === 'inclusive') {
          head.innerHTML = 'Nothing is added at checkout in <b>' + c.country + '</b>.';
        } else {
          var eff = room > 0 ? (added / room * 100) : 0;
          head.innerHTML = 'Government tax adds about <b>' + money(added) + '</b> over ' + n +
            ' night' + (n === 1 ? '' : 's') + ', about <b>' + eff.toFixed(1) + '%</b> of your room.';
        }

        // The note for a tiered country names the rung the reader landed on, so a reader who
        // pushes their rate past a boundary sees the reason the figure jumped.
        var text = c.note;
        if (c.kind === 'percent' && c.tiers) {
          var chosen = c.tiers[c.tiers.length - 1];
          var lc = r * c.tierRate;
          for (var j = 0; j < c.tiers.length; j++) {
            if (c.tiers[j].upTo === null || lc <= c.tiers[j].upTo) { chosen = c.tiers[j]; break; }
          }
          text = c.country + ' taxes a room by what the room costs, and at your rate that is ' +
            chosen.pct + '%. ' + (chosen.note || '');
        }
        note.textContent = text;
        if (out) out.setAttribute('data-kind', c.kind);
      }

      sel.addEventListener('change', render);
      [rate, nights, guests].forEach(function (el) {
        el.addEventListener('input', render);
        el.addEventListener('change', render);
      });
      render();
    })();
  </script>

  {/* The copy button is inline, dependency-free, and starts hidden. It is revealed by the
      script below only once the script has run and the clipboard API is actually present,
      so a reader with JavaScript off, or on a browser without it, never sees a button that
      does nothing. The snippet itself is a readonly textarea and selectable by hand either
      way, which is the path that always works. */}
  <script is:inline>
    (function () {
      var box = document.getElementById('htx-esnip');
      var btn = document.querySelector('[data-copy-snippet]');
      var msg = document.querySelector('[data-copy-msg]');
      if (!box) return;

      // Clicking the box selects all of it. This is the no-button path and it is why the
      // button is allowed to be optional.
      box.addEventListener('focus', function () { box.select(); });
      box.addEventListener('click', function () { box.select(); });

      if (!btn || !navigator.clipboard || !navigator.clipboard.writeText) return;
      btn.hidden = false;

      var timer = null;
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(box.value).then(function () {
          btn.textContent = 'Copied';
          if (msg) msg.textContent = 'Snippet copied to your clipboard.';
        }).catch(function () {
          // Do not claim success that did not happen. Fall back to selecting the text and
          // say so plainly.
          box.select();
          if (msg) msg.textContent = 'Could not copy automatically. The snippet is selected, so copy it now.';
        }).then(function () {
          clearTimeout(timer);
          timer = setTimeout(function () {
            btn.textContent = 'Copy the snippet';
            if (msg) msg.textContent = '';
          }, 2600);
        });
      });
    })();
  </script>

  <style>
    .htx-intro{max-width:720px;margin:22px 0 0}
    /* The scope callout: what this map is, and the honest boundary that it is not the whole
       of what surprises you. A quiet bordered card, not a warning box, because the message is
       orienting rather than alarming. */
    .htx-scope{max-width:720px;margin:28px 0 0;padding:0;background:var(--card);border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:10px}
    .htx-scope-sum{display:flex;align-items:center;gap:10px;padding:13px 16px;font-size:14.5px;font-weight:600;color:var(--ink);cursor:pointer;list-style:none}
    .htx-scope-sum::-webkit-details-marker{display:none}
    .htx-scope-sum:hover{color:var(--teal-deep)}
    .htx-scope-t{font-size:14.5px;line-height:1.55;color:#3B4A46;margin:0;padding:0 16px 15px;border-top:1px solid var(--line);padding-top:13px}
    .htx-scope-t a{color:var(--teal-deep);font-weight:500;text-decoration:none}
    .htx-scope-t a:hover{text-decoration:underline}
    /* THE STAY CALCULATOR. A bordered card because it is an interactive tool sitting in a
       page of prose, and the border is what says "this one does something". The result block
       is tinted by kind: a real total gets the teal that the map's scale uses, and the two
       honest refusals get the same neutral grey the varies fill uses, so the visual language
       of the map carries into the calculator instead of restarting. */
    .htx-calc{max-width:720px;margin:30px 0 0;padding:22px 0 0;border-top:1px solid var(--line)}
    .htx-calc-sub{font-size:15px;line-height:1.6;color:#3B4A46;margin:8px 0 0;max-width:640px}
    .htx-calc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0 0}
    .htx-calc-f-wide{grid-column:1 / -1}
    .htx-calc-f label{display:block;font-size:13px;font-weight:600;color:#3B4A46;margin:0 0 5px}
    .htx-calc-f select,.htx-calc-f input{width:100%;box-sizing:border-box;font:inherit;font-size:15px;padding:9px 10px;color:#16302C;background:#fff;border:1px solid var(--line);border-radius:8px}
    .htx-calc-f select:focus-visible,.htx-calc-f input:focus-visible{outline:2px solid var(--teal);outline-offset:1px}
    .htx-calc-money{position:relative}
    .htx-calc-money span{position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:15px;color:#6B7B76;pointer-events:none}
    .htx-calc-money input{padding-left:24px}
    .htx-calc-out{margin:18px 0 0;padding:16px 18px;background:var(--card);border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:10px}
    /* A refusal is not a failure state, so it is neutral rather than red. It is the same
       grey the map uses for "varies", which is the honest signal, not an error. */
    .htx-calc-out[data-kind="notComputable"]{border-left-color:#8C9A94}
    .htx-calc-out[data-kind="inclusive"]{border-left-color:#B6D4C9}
    .htx-calc-head{font-size:17px;line-height:1.5;color:#16302C;margin:0;font-weight:400}
    .htx-calc-head b{font-weight:650}
    .htx-calc-note{font-size:14.5px;line-height:1.6;color:#3B4A46;margin:9px 0 0}
    .htx-calc-std{font-size:13.5px;line-height:1.6;color:#5A6B66;margin:12px 0 0;max-width:640px}
    .htx-calc-std a{color:var(--teal-deep);font-weight:500;text-decoration:none}
    .htx-calc-std a:hover{text-decoration:underline}
    @media (max-width:560px){
      .htx-calc-grid{grid-template-columns:repeat(2,1fr)}
      .htx-calc-head{font-size:16px}
    }
    .htx-prop{max-width:720px;margin:28px 0 0;padding:22px 0 0;border-top:1px solid var(--line)}
    .htx-prop h2{font-family:var(--serif);font-weight:500;font-size:clamp(21px,3.2vw,27px);letter-spacing:-.01em;margin:0 0 10px}
    .htx-prop p{font-size:15px;color:#3B4A46;line-height:1.6;margin:0 0 12px}
    .htx-prop-do{background:var(--green-bg);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:14px 0 0 !important}
    .htx-prop-do b{color:var(--ink)}
    .htx-intro h1{font-family:var(--serif);font-weight:500;font-size:clamp(26px,4.6vw,38px);letter-spacing:-.015em;line-height:1.15;margin:0 0 12px}
    .htx-lede{font-size:18px;color:#3B4A46;line-height:1.55;margin:0}
    .htx-lede2{font-size:16px;color:var(--muted);margin:12px 0 0}
    .htx-more h2{font-family:var(--serif);font-weight:500;font-size:clamp(21px,3.2vw,27px);letter-spacing:-.01em;margin:0 0 10px}
    .htx-more p{font-size:15px;color:#3B4A46;line-height:1.6;margin:0 0 12px;max-width:720px}
    .htx-more a{color:var(--teal-deep);font-weight:500;text-decoration:none}
    .htx-more a:hover{text-decoration:underline}
    .htx-keep{font-size:14px;color:var(--muted);border-top:1px solid var(--line);padding-top:16px;margin-top:6px}

    /* THE EMBED CONTROL, sitting under the map as a collapsed <details>. The old shape was a
       CTA aside two sections above the map, linking down to a full section below it: the
       promise lived in one place and the code in another, and the reader was sent away from
       the map to find it. This is one block in one place, and the same block appears under the
       rate-parity map.

       Collapsed by default because most readers are here for the tax, not to embed anything,
       and a code box open by default would push the map's own detail down the page. The
       summary is the affordance, and the reveal costs no JavaScript. */
    .htx-embed{max-width:720px;margin:22px 0 0;background:var(--card);border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:10px}
    .htx-embed-sum{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 16px;cursor:pointer;list-style:none}
    .htx-embed-sum::-webkit-details-marker{display:none}
    .htx-embed-sum-t{font-size:14.5px;font-weight:600;color:var(--ink)}
    .htx-embed-sum:hover .htx-embed-sum-t{color:var(--teal-deep)}
    .htx-embed-chev{flex:none;color:var(--muted);transition:transform .2s ease}
    .htx-embed[open] .htx-embed-chev{transform:rotate(180deg)}
    .htx-embed-body{padding:0 16px 16px}
    .htx-embed-t{font-size:14.5px;color:#3B4A46;line-height:1.55;margin:0 0 14px;padding-top:13px;border-top:1px solid var(--line)}
    .htx-esnip-lab{display:block;font-family:var(--mono);font-size:11px;font-weight:600;color:var(--teal-deep);text-transform:uppercase;letter-spacing:.09em;margin:0 0 7px}
    /* Monospace and pre-wrap, because this is code a reader is about to paste and a broken
       line in a proportional font is how a snippet arrives mangled. */
    .htx-esnip{width:100%;font-family:var(--mono);font-size:12px;line-height:1.55;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:11px 12px;resize:vertical;white-space:pre-wrap;overflow-wrap:break-word;-webkit-text-size-adjust:100%}
    .htx-esnip:focus{outline:2px solid var(--teal);outline-offset:1px}
    .htx-erow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:10px 0 0}
    .htx-ecopy{font-family:var(--font);font-size:14px;font-weight:500;color:#F5F4EF;background:var(--teal-deep);border:0;border-radius:9px;padding:9px 15px;cursor:pointer}
    .htx-ecopy:hover{background:var(--teal)}
    .htx-ecopy-msg{font-size:13px;color:var(--muted)}
    .htx-eprev{font-size:14px;color:var(--teal-deep);font-weight:500;text-decoration:none}
    .htx-eprev:hover{text-decoration:underline}
    .htx-ehint{font-size:13px;color:var(--muted);margin:10px 0 0}

    @media (max-width:560px){
      .htx-lede{font-size:16.5px}
      .htx-esnip{font-size:11.5px}
    }
  </style>
</Base>
