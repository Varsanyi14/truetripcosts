---
// STEPS 2 THROUGH 7 OF THE WIZARD, for one destination.
//
// A static page per live country, the same pattern the country guides themselves use
// (src/pages/[slug].astro): getStaticPaths() bakes each country's real numbers into its own
// page at build time, because this is a static site with no server to answer a destination
// query at request time. This route existing separately from /calculator (the destination
// step) is exactly why: destination has to be a real navigation, and this is where it lands.
//
// LAYOUT: CalculatorLayout, not Base/Nav/Footer. Spec section 3 specifies a minimal product
// frame (wordmark, one Exit link, a thin quiet footer) for the whole calculator route, not
// the site's full navigation and search chrome, and section 1 wants the wizard to open
// directly on its first question rather than under a page H1 and an intro paragraph. See
// CalculatorLayout.astro's own header comment for the two reasons this is a deliberate,
// spec-driven departure from every other page on the site.
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import CalcWizard from '../../components/CalcWizard.astro';
import { countries } from '../../data/index.js';

export function getStaticPaths() {
  return countries.filter(c => c.live).map(c => ({ params: { slug: c.slug }, props: { country: c } }));
}

const { country } = Astro.props;
---
<CalculatorLayout
  title={'What you can avoid in ' + country.name + ': your trip\'s real fees'}
  description={'A one-question-at-a-time cost calculator for ' + country.name + ': a ranged total, never a false-precise number, plus every fee you can refuse to pay.'}
>
  <CalcWizard country={country} />
</CalculatorLayout>
