---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { clusters, regionMetaCompare } from '../../data/region-comparisons.js';
import { countries } from '../../data/index.js';

// The comparison hub. Lists every regional comparison, data-driven from the
// clusters list, so a new cluster appears here on its own. Also the target of the
// "Compare" breadcrumb crumb and a natural homepage entry point.
const cards = clusters.map(cl => ({
  ...cl,
  members: cl.slugs.map(s => {
    const c = countries.find(x => x.slug === s);
    return c ? { slug: c.slug, name: c.name, iso2: c.iso2 } : { slug: s, name: s, iso2: '' };
  })
}));

const metas = Object.values(regionMetaCompare);

const title = 'Compare countries by region for travel money (2026) | True Trip Costs';
const description = 'Side-by-side money comparisons of countries by region: cost, cash vs card, tipping, taxis and currency, to help US travelers choose where to go. Checked July 2026.';
---

<Base title={title} description={description}>
  <Nav />
  <main class="wrap cmp">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Compare' }]} />
    <h1>Compare countries, by region</h1>
    <p class="cmp-lede">Still deciding where to go? These side-by-side guides weigh the countries in a region on the money side, cost, cash or card, tipping, taxis and currency, with a clear pick for each. Our read as the True Trip Costs desk.</p>
    {metas.length > 0 && (
      <div class="cmp-metas">
        {metas.map(m => (
          <a class="cmp-meta" href={m.href}>
            <span class="cmp-meta-tx">
              <span class="cmp-meta-h">{m.label}</span>
              <span class="cmp-meta-p">{m.blurb}</span>
            </span>
            <span class="cmp-meta-go" aria-hidden="true">&#8594;</span>
          </a>
        ))}
      </div>
    )}
    <div class="cmp-grid">
      {cards.map(card => (
        <a class="cmp-card" href={card.href}>
          <div class="cmp-flags">
            {card.members.map(m => (m.iso2 && <img src={`https://flagcdn.com/${m.iso2}.svg`} alt="" width="26" height="18" loading="lazy" />))}
          </div>
          <h2 class="cmp-h">{card.region}</h2>
          <p class="cmp-blurb">{card.blurb}</p>
          <span class="cmp-cta">Compare {card.members.length} countries <span class="arw">&rarr;</span></span>
        </a>
      ))}
    </div>
  </main>
  <Footer />

  <style>
    .cmp{max-width:820px}
    .cmp h1{margin:22px 0 12px}
    .cmp-lede{font-size:18px;color:#3B4A46;max-width:640px;margin:0 0 28px}
    .cmp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
    .cmp-card{display:block;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px 22px;text-decoration:none;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
    .cmp-card:hover{border-color:#C2E0C8;transform:translateY(-2px)}
    .cmp-flags{display:flex;gap:5px;margin:0 0 12px}
    .cmp-flags img{border-radius:3px;border:1px solid var(--line);display:block;object-fit:cover}
    .cmp-h{font-family:var(--serif);font-weight:500;font-size:22px;color:var(--ink);margin:0 0 6px;line-height:1.15}
    .cmp-blurb{font-size:14.5px;color:var(--muted);line-height:1.5;margin:0 0 14px}
    .cmp-cta{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:600;color:var(--teal-deep)}
    .cmp-cta .arw{transition:transform .15s ease}
    .cmp-card:hover .cmp-cta .arw{transform:translateX(3px)}
    @media(max-width:560px){.cmp-lede{font-size:16.5px}}

    /* "Which part of X?" meta comparisons, above the country-cluster grid. */
    .cmp-metas{display:flex;flex-direction:column;gap:12px;margin:0 0 24px}
    .cmp-meta{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 20px;border:1px solid rgba(14,122,95,.28);background:rgba(14,122,95,.07);border-radius:var(--radius);text-decoration:none;transition:border-color .2s ease,background .2s ease}
    .cmp-meta:hover{border-color:var(--teal);background:rgba(14,122,95,.1)}
    .cmp-meta-tx{display:flex;flex-direction:column;gap:3px}
    .cmp-meta-h{font-family:var(--serif);font-weight:500;font-size:19px;color:var(--ink);line-height:1.15}
    .cmp-meta-p{font-size:14px;color:var(--muted);line-height:1.45}
    .cmp-meta-go{flex:none;color:var(--teal-deep);font-weight:700;font-size:18px}
  </style>
</Base>
