---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HomePreview from '../components/HomePreview.astro';
import LatestChecks from '../components/LatestChecks.astro';
import { countries } from '../data/index.js';
import fs from 'node:fs';
const live = countries.filter(c => c.live);
// Flags auto-detect: drop public/flags/<slug>.svg and it shows on the next build.
// A missing flag falls back to the globe, so nothing ever renders broken.
const flagDir = process.cwd() + '/public/flags/';
const flagSrc = (slug) => fs.existsSync(flagDir + slug + '.svg') ? `/flags/${slug}.svg` : '/flags/world.svg';
// Region label and one-line rail blurb. NEW countries set `region` and `hook`
// in their own data file (src/data/<slug>.js); these maps are only a fallback for
// the original nine, so you never edit this file when adding a country.
const regionTag = {
  vietnam: 'Asia', japan: 'Asia', thailand: 'Asia',
  mexico: 'Americas',
  italy: 'Europe', france: 'Europe', spain: 'Europe', portugal: 'Europe', 'united-kingdom': 'Europe'
};
const hooks = {
  vietnam: 'A cash country at heart. Cards work in cities, far less beyond them.',
  japan: 'More card-friendly than its reputation, but keep cash for small spots.',
  mexico: 'Cards taken widely at resorts. Watch the peso conversion trick at the till.',
  thailand: 'Cards in malls and hotels, cash for street food and markets.',
  italy: 'Cards almost everywhere, plus a nightly tourist tax to plan for.',
  france: 'Tap and pay is the norm, with a small nightly city tax on top.',
  spain: 'Cards taken widely, with a per-night tourist tax in many regions.',
  portugal: 'Easy on cards, with a small municipal tax in the bigger cities.',
  'united-kingdom': 'A tap-to-pay country. No card-fee worries, just the exchange rate.'
};
const tick = '<svg class="tick" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
---
<Base ogImage="/og/home.jpg" title="True Trip Costs: cards, cash and fees, the money side of travel" description="Independent money guides for US travelers, country by country: cash or card, the fees to dodge, tourist taxes and tipping. The money side, checked and dated.">
  <Nav />
  <main class="wrap">
    <section class="home-hero">
      <div class="hh-body">
        <h1 class="entry-h">Where are you headed?</h1>
        <p class="entry-sub">Pick your country and see what the trip really costs. Checked, dated, and never a sales pitch.</p>
        <div class="entry-row">
          <div class="hero-search">
            <div class="cfilter cfilter-hero">
              <svg class="cfilter-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              <input type="text" id="country-filter-hero" class="cfilter-in" placeholder="Type a country, like Japan" aria-label="Search country guides" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="hero-ta-list" aria-autocomplete="list" />
            </div>
            <div class="hero-ta" id="hero-ta" hidden>
              <div class="hero-ta-list" id="hero-ta-list" role="listbox" aria-label="Matching country guides">
                {live.map(c => (
                  <a class="hero-ta-item" href={'/' + c.slug} data-name={[c.name, ...(c.aliases || [])].join(' ').toLowerCase()}>
                    <img class="hero-ta-flag" src={flagSrc(c.slug)} alt="" width="22" height="16" loading="lazy" />
                    <span class="hero-ta-name">{c.name}</span>
                    <span class="hero-ta-go" aria-hidden="true">&#8594;</span>
                  </a>
                ))}
              </div>
              <p class="hero-ta-none" id="hero-ta-none" hidden>No guide for that one yet. <a href="#" data-open-signup>Get a heads-up as we add countries</a>.</p>
            </div>
          </div>
          {/* PLAIN-VERB FALLBACK, not wired live: for a later A/B test the label below can
              be swapped to "See the real cost". "TTC it" is the shipped default, and the
              definer line under this row is what carries the acronym. Keep the budget on
              this screen to one button use plus one definer: no "your TTC journey", no
              "TTC-powered", and never a bare cold "TTC" anywhere else on the entry. */}
          <button type="button" id="hero-go" class="btn entry-go">TTC it <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </div>
        <p class="entry-def">TTC = True Trip Costs. It runs the real, decomposed cost for the country you pick.</p>
        <p class="entry-browse">or browse <a href="/compare">by region</a>, <a href="#worries">by worry</a>, or <a href="/countries">all countries</a></p>
        <LatestChecks />
      </div>
    </section>

    <HomePreview />

    <section class="rail-wrap" id="guides" aria-label="Browse country guides">
      <p class="rail-lab">Popular guides</p>
      <div class="rail">
        {live.slice(0, 12).map(c => (
          <a class="rcard" href={'/' + c.slug}>
            <span class="rtop">
              <span class="rflag" aria-hidden="true"><img src={flagSrc(c.slug)} alt="" width="26" height="20" loading="lazy" /></span>
              <span class="rtag">{c.region || regionTag[c.slug] || ''}</span>
              {(c.spokes || []).some(s => s.topic === 'pets' && s.live !== false) && (
                <span class="rpet"><svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><ellipse cx="6.4" cy="10.2" rx="1.9" ry="2.5"/><ellipse cx="10.1" cy="7.5" rx="1.9" ry="2.6"/><ellipse cx="13.9" cy="7.5" rx="1.9" ry="2.6"/><ellipse cx="17.6" cy="10.2" rx="1.9" ry="2.5"/><path d="M12 11.3c-2.8 0-5.1 2-5.1 4.4 0 1.9 1.7 3 3.5 2.6.6-.13 1.1-.19 1.6-.19s1 .06 1.6.19c1.8.4 3.5-.7 3.5-2.6 0-2.4-2.3-4.4-5.1-4.4z"/></svg>Pets</span>
              )}
            </span>
            <span class="rname">{c.name}</span>
            <span class="rhook">{c.hook || hooks[c.slug] || ''}</span>
            <span class="rgo">Guide <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        ))}
      </div>
      <a class="btn rail-allbtn" href="/countries">See all {live.length} country guides <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </section>

    <section class="dsc" id="worries" aria-label="Start from your question">
      <p class="dsc-lab">Arriving with a worry, not a country?</p>
      <p class="dsc-intro">Start from the question on your mind.</p>
      <div class="dsc-grid">
        <a class="dsc-chip" href="/cash-or-card">
          <span class="dsc-q">Will my card work abroad?</span>
          <span class="dsc-go" aria-hidden="true">&#8594;</span>
        </a>
        <a class="dsc-chip" href="/cash-or-card">
          <span class="dsc-q">How much cash should I carry?</span>
          <span class="dsc-go" aria-hidden="true">&#8594;</span>
        </a>
        <a class="dsc-chip" href="/rules">
          <span class="dsc-q">What are the money rules where I am going?</span>
          <span class="dsc-go" aria-hidden="true">&#8594;</span>
        </a>
        <a class="dsc-chip" href="/passports-and-visas">
          <span class="dsc-q">Do I need a visa?</span>
          <span class="dsc-go" aria-hidden="true">&#8594;</span>
        </a>
        <a class="dsc-chip" href="/arrival-forms">
          <span class="dsc-q">Do I have to file a form before I fly?</span>
          <span class="dsc-go" aria-hidden="true">&#8594;</span>
        </a>
        <a class="dsc-chip" href="/tourist-taxes">
          <span class="dsc-q">What will tourist taxes cost me?</span>
          <span class="dsc-go" aria-hidden="true">&#8594;</span>
        </a>
        <a class="dsc-chip" href="/hotel-taxes-and-fees">
          <span class="dsc-q">Why is my hotel bill higher than the room rate?</span>
          <span class="dsc-go" aria-hidden="true">&#8594;</span>
        </a>
        <a class="dsc-chip" href="/taxis-and-ride-hailing">
          <span class="dsc-q">Will the taxi overcharge me?</span>
          <span class="dsc-go" aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </section>

    <section class="why" id="why">
      <p class="lab">The money question</p>
      <h2>Booking the trip is the easy part. The money side is a mess.</h2>
      <p class="lead">You search how much cash to bring and get ten-year-old blog posts, contradictory forum threads, and pages quietly written to sell you one credit card. So you guess. Then comes the surprise card surcharge, the bad airport exchange counter, or a tourist tax nobody mentioned. We turn that into one calm, current answer for each country, in about five minutes.</p>
      <div class="qrow">
        <div class="qcard"><h3>Will my card work?</h3><p>We look at the cards you already carry, not a generic one, against how each country actually takes payment day to day.</p></div>
        <div class="qcard"><h3>Do I need cash?</h3><p>A straight read on how much to carry, and the places where the honest answer is almost none.</p></div>
        <div class="qcard"><h3>What will it really cost?</h3><p>The conversion tricks, ATM fees and tourist taxes that creep in, named up front so nothing ambushes you later.</p></div>
      </div>
    </section>

    <section class="honest">
      <p class="lab">How we are different</p>
      <h2>We would rather tell you to do nothing.</h2>
      <div class="hrow">
        <div class="hitem"><p class="hk"><Fragment set:html={tick} />Sometimes the answer is, you are fine</p><p>If the card already in your pocket works with no fee, we say so plainly, and there is nothing for you to buy.</p></div>
        <div class="hitem"><p class="hk"><Fragment set:html={tick} />Labeled, every single time</p><p>Links that earn us a commission are marked as such, and the ones that do not are marked too, so you always know which is which.</p></div>
        <div class="hitem"><p class="hk"><Fragment set:html={tick} />Checked, dated, kept current</p><p>We do not sell hotel rooms, and every guide shows the date we last checked it. Money rules shift, so staying current is the whole point.</p></div>
      </div>
    </section>

    <section class="home-signup" aria-label="Newsletter signup">
      <p class="hs-lab">Before you go</p>
      <h2 class="hs-h">A heads-up when the money side changes.</h2>
      <p class="hs-p">Heading somewhere, or just travel a lot? We will let you know when we add a country or a money rule shifts. Nothing else.</p>
      <button class="btn" type="button" data-open-signup>Get free updates <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </section>
  </main>
  <Footer />

  <style>
    .cfilter{display:flex;align-items:center;gap:10px;max-width:440px;margin:0 0 26px;padding:11px 15px;border:1px solid var(--line,#E5E3DB);border-radius:12px;background:var(--card,#FFFFFF);transition:border-color .15s ease,box-shadow .15s ease}
    .cfilter:focus-within{border-color:var(--ink,#16302C);box-shadow:0 0 0 3px rgba(14,122,95,.12)}
    .cfilter-ic{color:var(--muted,#6F6E66);flex:none;opacity:.6}
    .cfilter-in{flex:1;border:0;outline:0;background:transparent;font:inherit;font-size:1rem;color:var(--ink,#16302C)}
    .cfilter-in::placeholder{color:var(--muted,#6F6E66);opacity:.8}
    /* csec grid-filter and quick-answer styles removed with those sections */
    .dsc{margin:28px 0 10px}
    .dsc-lab{font-size:12px;font-weight:600;color:var(--teal-deep,#0A5644);letter-spacing:.08em;text-transform:uppercase;margin:0 0 4px}
    .dsc-intro{font-size:14px;color:var(--muted,#6F6E66);margin:0 0 12px}
    .dsc-grid{display:flex;flex-wrap:wrap;gap:10px}
    .dsc-chip{display:inline-flex;align-items:center;gap:10px;padding:10px 15px;border:1px solid var(--line,#E5E3DB);border-radius:999px;background:var(--card,#FFFFFF);box-shadow:var(--shadow);text-decoration:none}
    .dsc-chip:hover{border-color:var(--teal,#0E7A5F)}
    .dsc-q{font-weight:600;font-size:14.5px;color:var(--ink,#16302C)}
    .dsc-go{color:var(--teal-deep,#0A5644);font-weight:700}
    .dsc-chip:hover .dsc-q{color:var(--teal-deep,#0A5644)}
    @media (max-width:560px){ .dsc-grid{flex-direction:column} .dsc-chip{justify-content:space-between} }
    /* home-compare band styles removed; the region path now lives in the hero */

    /* Hero top spacing: global.css sets .home-hero{padding:52px 0 6px}, which left a
       dead band under the nav and pushed the search box below the fold on a phone.
       Scoped override only, so other pages keep the roomier hero. The pill row and the
       H1 are untouched: h1 already carries margin:0 0 16px, so the pill-to-H1 gap is
       unchanged and only the space above the pills shrinks. */
    .home-hero{padding-top:18px}

    /* THE ENTRY. One action on land: a country picker and one button, with everything
       else on the screen subordinate to it. The old entry state stacked a pill row, an
       H1, a dark intro card, a two-card paths grid and a ghost link above the fold, which
       is a persuasion wall for a visitor who already knows where they are going. This is
       a re-proportioning of that hero, not a new page: the search control, the flow the
       button leads to and every section below are untouched.

       The prompt stays a question and the support line stays one sentence. Do not grow
       either into a value proposition: the moment this screen argues, it has stopped
       being an entry. */
    .entry-h{font-size:clamp(30px,5vw,42px);margin:0 0 10px}
    .entry-sub{margin:0 0 20px;font-size:15px;line-height:1.55;color:var(--muted,#6F6E66);max-width:52ch}

    /* Picker and button read as one control: side by side with room, stacked on a phone
       so the button stays a full-width target. */
    .entry-row{display:flex;align-items:stretch;gap:10px;max-width:560px}
    .entry-row .hero-search{margin:0;flex:1 1 auto;min-width:0}
    /* min-height stops the button collapsing when the row stacks. On desktop the row is
       align-items:stretch, so the button already takes the row's height (the input's
       ~49.6px box: 1rem text at line-height 1.6, plus 11px padding and a 1px border top
       and bottom) and this floor never applies. Under 560px the row turns into a column,
       stretch stops governing the cross axis, and the button had only horizontal padding
       to give it height. 48px sits just under the input rather than over it, so the two
       read as the same control in both layouts. */
    .entry-go{flex:none;min-height:48px;padding:0 20px;display:inline-flex;align-items:center;justify-content:center;font-size:15px;font-weight:600;background:var(--teal-deep,#0A5644);border-color:var(--teal-deep,#0A5644);box-shadow:0 1px 2px rgba(10,86,68,.12),0 8px 20px rgba(10,86,68,.16)}
    .entry-go:hover{background:#084736;border-color:#084736}
    .entry-go svg{transition:transform .15s ease}
    .entry-go:hover svg{transform:translateX(3px)}
    @media (max-width:560px){
      .entry-row{flex-direction:column;align-items:stretch;max-width:none}
      .entry-go{width:100%;justify-content:center}
    }

    /* The acronym is defined once, next to its only use, via what the button does. */
    /* The quietest line in the entry, on purpose: headline, then support line, then this.
       12px with a touch of opacity puts a visible step between it and .entry-sub above,
       which at 15px was reading as a second support line rather than a footnote. Do not
       go smaller or fainter than this: it still has to be read once. */
    .entry-def{margin:9px 0 0;font-size:12px;line-height:1.5;color:var(--muted,#6F6E66);opacity:.85;max-width:56ch}

    /* The one subordinate way through for an undecided visitor. A text line on purpose:
       not a button, not a card, nothing that competes with the action above it. These
       destinations all still exist in full below the fold. */
    .entry-browse{margin:14px 0 0;font-size:13.5px;color:var(--muted,#6F6E66)}
    .entry-browse a{color:var(--muted,#6F6E66);text-decoration:underline;text-underline-offset:3px;text-decoration-color:rgba(111,110,102,.4)}
    .entry-browse a:hover{color:var(--teal-deep,#0A5644);text-decoration-color:var(--teal,#0E7A5F)}

    /* Hero typeahead: a small list of matching guides under the hero search box. */
    .hero-search{position:relative;max-width:560px;margin:24px 0 4px}
    .hero-search .cfilter{margin-bottom:0}
    .hero-ta{position:absolute;left:0;right:0;top:calc(100% + 6px);z-index:30;background:var(--card,#FFFFFF);border:1px solid var(--line,#E5E3DB);border-radius:12px;box-shadow:0 14px 34px rgba(16,48,44,.16);max-height:328px;overflow-y:auto;padding:6px}
    .hero-ta-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;text-decoration:none;color:var(--ink,#16302C)}
    .hero-ta-item:hover,.hero-ta-item.is-active{background:var(--green-bg,#E7F3E9)}
    .hero-ta-item.is-hidden{display:none}
    .hero-ta-flag{flex:none;border-radius:2px;box-shadow:0 0 0 1px rgba(22,48,44,.08)}
    .hero-ta-name{flex:1;font-size:15px;font-weight:500}
    .hero-ta-go{color:var(--teal-deep,#0A5644);font-weight:700}
    .hero-ta-none{margin:0;padding:12px 14px;font-size:14px;color:var(--muted,#6F6E66)}
    .hero-ta-none a{color:var(--teal-deep,#0A5644);font-weight:600}
    @media (max-width:640px){ .hero-search{max-width:none} }
    /* The .hero-or eyebrow and the two-card .hero-paths grid were removed with the
       persuasion block. The region and worry paths now hang off the one quiet
       .entry-browse line above, and both destinations are still on the page in full
       (the #worries chips below, and /compare). */
    /* "See all" button under the featured rail. */
    .rail-allbtn{margin-top:18px}
    .rail-allbtn svg{transition:transform .15s ease}
    .rail-allbtn:hover svg{transform:translateX(3px)}
    /* Bottom newsletter signup. */
    .home-signup{margin:44px 0 8px;padding:30px 28px;border:1px solid var(--line,#E5E3DB);background:var(--green-bg,#E7F3E9);border-radius:var(--radius,14px);text-align:center}
    .hs-lab{font-size:12px;font-weight:600;color:var(--teal-deep,#0A5644);letter-spacing:.08em;text-transform:uppercase;margin:0 0 8px}
    .hs-h{font-family:var(--serif);font-weight:500;font-size:24px;color:var(--ink,#16302C);margin:0 0 8px;line-height:1.15}
    .hs-p{font-size:15px;color:#3B4A46;line-height:1.55;margin:0 auto 18px;max-width:52ch}
    @media (max-width:600px){ .home-signup{padding:24px 18px} .hs-h{font-size:21px} }
  </style>

  <script>
    import { createComboActivator } from '../scripts/combobox-list.js';

    // Hero search typeahead: lists matching guides under the search box. Self-contained
    // with an early return, so it stays inert (and never errors) if the hero markup is
    // ever absent.
    //
    // KEYBOARD + ARIA now match the global search (SearchBox.astro): ArrowDown/ArrowUp move
    // an active option with aria-activedescendant + aria-selected, and Enter on a highlighted
    // row, or on the one remaining match, navigates straight to it, same as Enter does there.
    // The one thing kept from the old behaviour: with SEVERAL matches and NOTHING
    // highlighted, Enter still does not navigate. That case is what a phone's on-screen Go
    // key fires on its own the moment typing pauses, before a visitor's thumb ever reaches a
    // row, and a phone has no arrow keys to make a highlight ambiguous with. Removing that
    // guard would send a Go tap to whichever guide happens to sort first. A tap on a
    // suggestion row is unambiguous either way and still opens that country immediately.
    (function () {
      function norm(s) {
        return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      }
      var hero = document.getElementById('country-filter-hero');
      var panel = document.getElementById('hero-ta');
      var listEl = document.getElementById('hero-ta-list');
      if (!hero || !panel || !listEl) return;
      var noneEl = document.getElementById('hero-ta-none');
      var items = Array.prototype.slice.call(listEl.querySelectorAll('.hero-ta-item'));
      var activator = createComboActivator(hero, listEl, '.hero-ta-item');
      activator.ensureRoles('hero-opt');

      // Reads the row order from the DOM rather than from the static `items` array,
      // because run() now re-ranks the panel by moving rows. Everything downstream reads
      // its order from here (arrow keys, Enter's pick, the button's top match, the
      // mousemove index), so this has to agree with what the visitor is actually looking
      // at. Filtering `items` instead would leave those reading the original data order
      // while the panel rendered the ranked one.
      function visible() {
        var rows = Array.prototype.slice.call(listEl.querySelectorAll('.hero-ta-item'));
        return rows.filter(function (it) { return !it.classList.contains('is-hidden'); });
      }
      function clearActive() { activator.clearActive(); }
      function openPanel() { panel.hidden = false; hero.setAttribute('aria-expanded', 'true'); }
      function closePanel() { panel.hidden = true; hero.setAttribute('aria-expanded', 'false'); clearActive(); }

      // Orders the matching rows the way someone typing expects to read them. The match
      // test above stays exactly as forgiving as it was; this only decides who goes first.
      // Three tiers, alphabetical inside each: the country NAME starts with what was
      // typed, then the name merely contains it, then rows that matched on an alias alone.
      // Tiering on the name and not on the data-name blob is the whole trick, since that
      // blob is the name plus every alias and matches far too easily to rank on.
      //
      // This RANKS, it never RESTRICTS. An alias-only save still appears, just below any
      // real name match, so "chinatown" still reaches Singapore and "prague" still reaches
      // Czechia. Demoting them only stops them crowding out the country someone actually
      // spelled. appendChild on a row already in the list MOVES it, so the panel is
      // reordered in place: no clones, no rebuild, no duplicated rows across keystrokes.
      function rank(q) {
        var rows = visible().map(function (el) {
          var span = el.querySelector('.hero-ta-name');
          var nm = norm(span ? span.textContent.trim() : '');
          return { el: el, name: nm, tier: nm.indexOf(q) === 0 ? 0 : (nm.indexOf(q) !== -1 ? 1 : 2) };
        });
        rows.sort(function (a, b) {
          if (a.tier !== b.tier) return a.tier - b.tier;
          return a.name < b.name ? -1 : (a.name > b.name ? 1 : 0);
        });
        for (var k = 0; k < rows.length; k++) listEl.appendChild(rows[k].el);
      }

      function run() {
        var q = norm(hero.value.trim());
        if (q === '') { closePanel(); return; }
        var shown = 0;
        for (var i = 0; i < items.length; i++) {
          var hit = norm(items[i].getAttribute('data-name')).indexOf(q) !== -1;
          items[i].classList.toggle('is-hidden', !hit);
          if (hit) shown++;
        }
        clearActive();
        if (noneEl) noneEl.hidden = shown !== 0;
        rank(q);
        openPanel();
      }

      function setActive(next) { activator.setActive(next); }

      hero.addEventListener('input', run);
      hero.addEventListener('focus', function () { if (hero.value.trim() !== '') run(); });
      hero.addEventListener('keydown', function (e) {
        if (panel.hidden) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activator.getActive() + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activator.getActive() - 1); }
        else if (e.key === 'Enter') {
          // ENTER ACTIVATES THE HIGHLIGHTED OPTION, same as the global search: a row
          // reached with the arrow keys, or the single remaining match, navigates straight
          // to it. The one case that still does NOT navigate is several matches with
          // nothing highlighted, which is what a phone's on-screen Go/Search key fires on
          // its own the moment typing pauses, before a visitor's thumb ever reaches a row
          // or an arrow key exists to highlight one. Guessing a destination for that tap
          // would be the one wrong answer available here, so it just closes the panel and
          // leaves the typed text in the field for the button to resolve.
          e.preventDefault();
          var vis = visible();
          var idx = activator.getActive();
          var target = (idx >= 0 && vis[idx]) ? vis[idx] : (vis.length === 1 ? vis[0] : null);
          if (target) { window.location.assign(target.getAttribute('href')); return; }
          closePanel();
        } else if (e.key === 'Escape') { closePanel(); }
      });

      // BEYOND THE BRIEF, flagged for review. Resolving "the top match" as simply the
      // first visible row sends someone who typed China to Singapore, because Singapore's
      // alias list carries "chinatown" and Singapore sits earlier in the list. That was
      // true of the old Enter behaviour too, so it is not new, but the button is now the
      // primary way anyone leaves this screen, and this handler's own promise is that it
      // never navigates to a wrong country. So the top match prefers a row whose country
      // name is exactly what was typed, and falls back to the first visible row otherwise.
      // India has the same collision (Singapore carries "little india") and is already
      // correct by list order; this makes it correct by rule instead of by luck.
      // TO REVERT: delete this function and change the button's `topMatch()` back to
      // `visible()[0] || null`. Nothing else depends on it.
      function topMatch() {
        var vis = visible();
        if (!vis.length) return null;
        var q = norm(hero.value.trim());
        for (var i = 0; i < vis.length; i++) {
          var nm = vis[i].querySelector('.hero-ta-name');
          if (nm && norm(nm.textContent.trim()) === q) return vis[i];
        }
        return vis[0];
      }

      // The button is the primary go action: open the highlighted guide, or the top match
      // if nothing is highlighted. It must never guess. An empty field means no country
      // has been chosen, so every row is still unfiltered and the top match would be
      // whatever happens to sort first, which is the one wrong answer available here.
      // In that case, and when what was typed matches nothing, it keeps focus in the
      // field and navigates nowhere.
      var goBtn = document.getElementById('hero-go');
      if (goBtn) {
        goBtn.addEventListener('click', function () {
          if (hero.value.trim() === '') { hero.focus(); return; }
          var vis = visible();
          var idx = activator.getActive();
          var target = (idx >= 0 && vis[idx]) ? vis[idx] : null;
          if (!target) { run(); target = topMatch(); }
          if (target) window.location.href = target.getAttribute('href');
          else hero.focus();
        });
      }

      // Each suggestion row keeps its real href in the markup, so it stays a link without
      // JS and reads as one to a screen reader. With JS the navigation runs from an
      // explicit click handler instead, so it fires on a completed tap on the row and not
      // as a loose side effect of the thumb travelling toward the button. Tapping a
      // suggestion is unambiguous intent and still goes straight to that country: making
      // that two taps would feel broken, since every search box navigates on a pick.
      for (var j = 0; j < items.length; j++) {
        (function (it) {
          it.addEventListener('mousemove', function () {
            activator.setActive(visible().indexOf(it));
          });
          it.addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = it.getAttribute('href');
          });
        })(items[j]);
      }

      document.addEventListener('click', function (e) {
        var wrap = hero.closest ? hero.closest('.hero-search') : null;
        if (wrap && !wrap.contains(e.target)) closePanel();
      });
    })();
  </script>
</Base>
